---
// SuggestFeatureButton.astro
// Global floating action button that lazy-loads the Suggestion Modal.
---

<button id="suggest-feature-btn" class="suggest-feature-btn" aria-label="Suggest a Feature" title="Suggest a Feature" style="display: none;">
  <span class="btn-icon" aria-hidden="true">💡</span>
  <span class="btn-text">Suggest a Feature</span>
</button>

<style>
  .suggest-feature-btn {
    position: fixed;
    bottom: var(--space-4);
    right: var(--space-4);
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background-color: var(--accent);
    color: var(--accent-on);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.2;
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .suggest-feature-btn:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(140, 82, 255, 0.3);
  }

  .suggest-feature-btn:active {
    transform: translateY(0);
  }

  .suggest-feature-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .suggest-feature-btn {
      bottom: var(--space-4);
      right: var(--space-4);
      width: 46px;
      height: 46px;
      padding: 0;
      border-radius: 50%;
    }
    .suggest-feature-btn .btn-text {
      display: none;
    }
    .suggest-feature-btn .btn-icon {
      font-size: 18px;
    }
  }
</style>

<script>
  import { SuggestionTracker } from '../hooks/useSuggestionTracking';

  // Only run client-side
  if (typeof window !== 'undefined') {
    // Hide Suggestion Button on Admin pages
    if (!window.location.pathname.startsWith('/admin')) {
      const tracker = new SuggestionTracker();
      tracker.start();

      const btn = document.getElementById('suggest-feature-btn');
      if (btn) {
        btn.style.display = 'flex';
        
        btn.addEventListener('click', async () => {
          try {
            // Lazy load the modal generator script
            const { initSuggestFeatureModal } = await import('./SuggestFeatureModal');
            initSuggestFeatureModal(tracker);
          } catch (err) {
            console.error('Failed to load Suggestion Modal:', err);
          }
        }, { once: true }); // We only need to load the modal scripts once
      }

      // Cleanup tracker on page unload
      window.addEventListener('beforeunload', () => {
        tracker.destroy();
      });
    }
  }
</script>
