---
import Icon from './base/Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Column 1: Brand -->
    <div class="footer-column footer-brand">
      <a href="/" class="logo" aria-label="LowKeyDevs Homepage">
        <span class="logo-text">LowKey<span class="logo-accent">Devs</span></span>
      </a>
      <p class="brand-tagline">
        The fastest, cleanest collection of 100% private client-side utilities. Zero trackers, zero server logs.
      </p>
    </div>

    <!-- Column 2: Platform -->
    <div class="footer-column footer-links">
      <h3 class="footer-heading">Platform</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/privacy">Privacy policy</a></li>
      </ul>
    </div>

    <!-- Column 3: Popular Utilities -->
    <div class="footer-column footer-links">
      <h3 class="footer-heading">Popular Tools</h3>
      <ul>
        <li><a href="/tools/json-formatter">JSON Formatter</a></li>
        <li><a href="/tools/password-generator">Password Generator</a></li>
        <li><a href="/tools/base64-converter">Base64 Converter</a></li>
      </ul>
    </div>

    <!-- Column 4: Newsletter -->
    <div class="footer-column footer-newsletter">
      <h3 class="footer-heading">
        <span class="new-tools-badge">New tools</span>
        Stay updated
      </h3>
      <p class="newsletter-text">Receive updates when new offline tools are added.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
        <input
          type="email"
          placeholder="your@email.com"
          required
          aria-label="Email address"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-submit" aria-label="Subscribe">
          <Icon name="ArrowRight" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} LowKeyDevs. All rights reserved.</p>
      <p class="footer-heart">Made for developers worldwide</p>
    </div>
  </div>

  <!-- Layered Claymation Horizon Mountain SVG -->
  <div class="footer-mountain-wrapper" aria-hidden="true">
    <svg class="footer-mountain" viewBox="0 0 1440 200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 200 L0 100 Q 300 20 600 110 Q 900 200 1200 90 Q 1320 30 1440 60 L 1440 200 Z" fill="var(--color-brand-lavender)" opacity="0.6"/>
      <path d="M0 200 L0 130 Q 200 60 450 120 Q 700 180 950 80 Q 1200 10 1440 70 L 1440 200 Z" fill="var(--color-brand-peach)" opacity="0.7"/>
      <path d="M0 200 L0 150 Q 400 100 800 140 Q 1120 50 1440 110 L 1440 200 Z" fill="var(--color-brand-ochre)" opacity="0.8"/>
      <path d="M0 200 L0 175 Q 500 135 1000 170 Q 1220 140 1440 160 L 1440 200 Z" fill="var(--color-canvas)"/>
    </svg>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface-soft);
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    padding: 80px 0 0 0;
    margin-top: auto;
    position: relative;
    overflow: hidden;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: var(--space-8);
    margin-bottom: 60px;
  }

  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-brand .logo {
    display: inline-flex;
    width: fit-content;
  }

  .brand-tagline {
    color: var(--color-body);
    font-size: 14px;
    line-height: 1.7;
    max-width: 320px;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .new-tools-badge {
    background-color: var(--color-surface-card);
    color: var(--color-ink);
    font-size: 11px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    color: var(--color-body);
    font-size: 14px;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    font-weight: 500;
  }

  .footer-links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 360px;
  }

  .newsletter-text {
    color: var(--color-body);
    font-size: 14px;
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    position: relative;
    width: 100%;
  }

  .newsletter-input {
    width: 100%;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    border-radius: var(--radius-md);
    padding: 12px 60px 12px 16px;
    outline: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    transition: border-color var(--duration-fast) var(--ease-out);
    min-height: 44px;
  }

  .newsletter-input:focus {
    border-color: var(--color-ink);
  }

  .newsletter-submit {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .newsletter-submit:hover {
    color: var(--color-ink);
    background-color: var(--color-surface-card);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    font-size: 13px;
    color: var(--color-muted);
  }

  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 480px) {
    .footer-bottom-container {
      flex-direction: column;
      text-align: center;
    }
  }

  .footer-mountain-wrapper {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    margin-top: 20px;
  }

  .footer-mountain {
    width: 100%;
    height: 120px;
    display: block;
  }
</style>
