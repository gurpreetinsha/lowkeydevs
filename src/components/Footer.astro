---
import Icon from './base/Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <span class="logo-text">LowKey<span class="logo-accent">Devs</span></span>
      <p class="brand-tagline">
        The fastest, cleanest collection of 100% private client-side utilities. Zero trackers, zero server logs.
      </p>
    </div>

    <div class="footer-links">
      <h3 class="footer-heading">Platform</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>

    <div class="footer-newsletter">
      <h3 class="footer-heading">
        <span class="new-tools-badge">New Tools</span>
        Stay Updated
      </h3>
      <p class="newsletter-text">Receive updates when new offline tools are added.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
        <input 
          type="email" 
          placeholder="your@email.com" 
          required 
          aria-label="Email address"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-submit" aria-label="Subscribe">
          <Icon name="ArrowRight" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} LowKeyDevs. All rights reserved.</p>
      <p class="footer-heart">Made for developers worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: var(--color-on-dark);
    border-top: 1px solid var(--color-primary-dark);
    padding: 60px 0 30px 0;
    margin-top: auto;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-on-dark);
    letter-spacing: -0.03em;
  }

  .logo-accent {
    color: var(--color-highlight-coral);
  }

  .brand-tagline {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
    max-width: 320px;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-on-dark);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }

  .new-tools-badge {
    background-color: var(--color-highlight-coral);
    color: var(--color-primary-dark);
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    color: var(--color-muted);
    font-size: 14px;
    transition: color 200ms ease;
  }

  .footer-links a:hover {
    color: var(--color-on-dark);
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 360px;
  }

  .newsletter-text {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .newsletter-form {
    display: flex;
    position: relative;
    width: 100%;
  }

  .newsletter-input {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-slate);
    color: var(--color-on-dark);
    border-radius: var(--radius-xs);
    padding: 10px 48px 10px 14px;
    outline: none;
    font-family: var(--font-sans);
    font-size: 14px;
    transition: border-color 200ms ease;
  }

  .newsletter-input:focus {
    border-color: var(--color-highlight-coral);
  }

  .newsletter-submit {
    position: absolute;
    right: 1px;
    top: 1px;
    bottom: 1px;
    width: 40px;
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 200ms ease;
  }

  .newsletter-submit:hover {
    color: var(--color-on-dark);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
    font-size: 12px;
    color: var(--color-muted);
  }

  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
