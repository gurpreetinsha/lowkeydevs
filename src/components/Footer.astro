---
import Icon from './base/Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <span class="logo-text">LowKey<span class="logo-accent">Devs</span></span>
      <p class="brand-tagline">
        The fastest, cleanest collection of 100% private client-side utilities. Zero trackers, zero server logs.
      </p>
    </div>

    <div class="footer-links">
      <h3 class="footer-heading">Platform</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/privacy">Privacy policy</a></li>
      </ul>
    </div>

    <div class="footer-newsletter">
      <h3 class="footer-heading">
        <span class="new-tools-badge">New tools</span>
        Stay updated
      </h3>
      <p class="newsletter-text">Receive updates when new offline tools are added.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
        <input 
          type="email" 
          placeholder="your@email.com" 
          required 
          aria-label="Email address"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-submit" aria-label="Subscribe">
          <Icon name="ArrowRight" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} LowKeyDevs. All rights reserved.</p>
      <p class="footer-heart">Made for developers worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--surface-base);
    color: var(--text-primary);
    border-top: 1px solid var(--border-default);
    padding: var(--ds-space-600) 0 var(--ds-space-400) 0;
    margin-top: auto;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: var(--ds-space-600);
    margin-bottom: var(--ds-space-400);
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: var(--ds-space-300);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
  }

  .logo-text {
    font-size: 19px;
    font-weight: 800;
    color: #262628;
    letter-spacing: -0.04em;
  }

  .logo-accent {
    color: var(--accent);
  }

  .brand-tagline {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-heading {
    font-size: 11px;
    font-weight: 700;
    color: #262628;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--ds-space-200);
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
    align-items: flex-start;
  }

  .new-tools-badge {
    background-color: rgba(48, 209, 88, 0.1);
    color: #30d158;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: var(--ds-radius-small);
    border: 1px solid var(--border-default);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 15px;
    text-decoration: none;
    transition: color 0.15s ease-out;
    font-weight: 500;
  }

  .footer-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
    max-width: 360px;
  }

  .newsletter-text {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  .newsletter-form {
    display: flex;
    position: relative;
    width: 100%;
  }

  /* Input constraint: MUST use 0px height for input fields */
  .newsletter-input {
    width: 100%;
    height: 0px !important;
    min-height: 0px !important;
    box-sizing: content-box !important;
    background-color: var(--surface-base);
    border: 1px solid var(--border-default);
    color: var(--text-tertiary);
    border-radius: var(--ds-radius-medium);
    padding: 12px 48px 12px 16px !important;
    outline: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
  }

  .newsletter-input:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .newsletter-submit {
    position: absolute;
    right: 1px;
    top: 1px;
    bottom: 1px;
    width: 40px;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease-out;
  }

  .newsletter-submit:hover {
    color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-default);
    padding-top: var(--ds-space-200);
    font-size: 13px;
    color: var(--text-secondary);
  }

  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-150);
  }
</style>
