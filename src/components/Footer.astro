---
import Icon from './base/Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <span class="logo-text">LowKey<span class="logo-accent">Devs</span></span>
      <p class="brand-tagline">
        The fastest, cleanest collection of 100% private client-side utilities. Zero trackers, zero server logs.
      </p>
    </div>

    <div class="footer-links">
      <h3 class="footer-heading">Platform</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/privacy">Privacy policy</a></li>
      </ul>
    </div>

    <div class="footer-newsletter">
      <h3 class="footer-heading">
        <span class="new-tools-badge">New tools</span>
        Stay updated
      </h3>
      <p class="newsletter-text">Receive updates when new offline tools are added.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
        <input 
          type="email" 
          placeholder="your@email.com" 
          required 
          aria-label="Email address"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-submit" aria-label="Subscribe">
          <Icon name="ArrowRight" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} LowKeyDevs. All rights reserved.</p>
      <p class="footer-heart">Made for developers worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ds-surface-sunken);
    color: var(--ds-text);
    border-top: var(--ds-border-width-default) solid var(--ds-border);
    padding: var(--ds-space-600) 0 var(--ds-space-400) 0;
    margin-top: auto;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: var(--ds-space-600);
    margin-bottom: var(--ds-space-400);
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: var(--ds-space-300);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
  }

  .logo-text {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ds-text);
    letter-spacing: -0.03em;
  }

  .logo-accent {
    color: var(--ds-text-selected);
  }

  .brand-tagline {
    color: var(--ds-text-subtle);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 320px;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ds-text-subtle);
    text-transform: none; /* MUST NOT use uppercase stretch */
    letter-spacing: normal;
    margin-bottom: var(--ds-space-200);
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
    align-items: flex-start;
  }

  .new-tools-badge {
    background-color: var(--ds-background-success);
    color: var(--ds-text-success-bolder);
    font-size: 0.7rem;
    font-family: var(--font-sans);
    padding: var(--ds-space-025) var(--ds-space-075);
    border-radius: var(--ds-radius-small);
    border: 1px solid var(--ds-border-success);
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none; /* sentence case badge */
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
  }

  .footer-links a {
    color: var(--ds-text-subtle);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--ds-link);
    text-decoration: underline;
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
    max-width: 360px;
  }

  .newsletter-text {
    color: var(--ds-text-subtle);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .newsletter-form {
    display: flex;
    position: relative;
    width: 100%;
  }

  .newsletter-input {
    width: 100%;
    background-color: var(--ds-background-input);
    border: var(--ds-border-width-default) solid var(--ds-border-input);
    color: var(--ds-text);
    border-radius: var(--ds-radius-medium);
    padding: var(--ds-space-100) 48px var(--ds-space-100) var(--ds-space-150);
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .newsletter-input:focus {
    border-color: var(--ds-border-focused);
    box-shadow: 0 0 0 2px var(--ds-border-focused);
  }

  .newsletter-submit {
    position: absolute;
    right: 1px;
    top: 1px;
    bottom: 1px;
    width: 40px;
    background: transparent;
    border: none;
    color: var(--ds-icon-subtle);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .newsletter-submit:hover {
    color: var(--ds-text-selected);
  }

  .footer-bottom {
    border-top: var(--ds-border-width-default) solid var(--ds-border);
    padding-top: var(--ds-space-200);
    font-size: 0.75rem;
    color: var(--ds-text-subtlest);
  }

  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-150);
  }
</style>
