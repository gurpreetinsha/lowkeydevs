---
import Icon from './base/Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Column 1: Brand -->
    <div class="footer-column footer-brand">
      <a href="/" class="logo" aria-label="LowKeyDevs Homepage">
        <span class="logo-text footer-logo-text">LowKey<span class="logo-accent">Devs</span></span>
      </a>
      <p class="brand-tagline">
        The fastest, cleanest collection of 100% private client-side utilities. Zero trackers, zero server logs.
      </p>
    </div>

    <!-- Column 2: Platform -->
    <div class="footer-column footer-links">
      <h4 class="footer-heading">Platform</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About us</a></li>
        <li><a href="/privacy">Privacy policy</a></li>
      </ul>
    </div>

    <!-- Column 3: Popular Utilities -->
    <div class="footer-column footer-links">
      <h4 class="footer-heading">Popular Tools</h4>
      <ul>
        <li><a href="/tools/json-formatter">JSON Formatter</a></li>
        <li><a href="/tools/password-generator">Password Generator</a></li>
        <li><a href="/tools/base64-converter">Base64 Converter</a></li>
      </ul>
    </div>

    <!-- Column 4: Newsletter -->
    <div class="footer-column footer-newsletter">
      <div class="footer-newsletter-label">LowKeyDevs moves fast</div>
      <h4 class="footer-newsletter-headline">Stay updated</h4>
      <p class="newsletter-text micro-text">Receive updates when new offline tools are added.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
        <input
          type="email"
          placeholder="your@email.com"
          required
          aria-label="Email address"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-submit" aria-label="Subscribe">
          <Icon name="ArrowRight" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} LowKeyDevs. All rights reserved.</p>
      <p class="footer-heart">Made for developers worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary); /* #17171c */
    color: var(--color-muted);
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-section) 0 0 0; /* 80px */
    margin-top: auto;
    position: relative;
    overflow: hidden;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: var(--spacing-xxl); /* 32px */
    margin-bottom: 60px;
  }

  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xxl);
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .footer-brand .logo {
    display: inline-flex;
    width: fit-content;
  }

  .footer-logo-text {
    color: var(--color-on-primary) !important;
  }

  .brand-tagline {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 14px; /* caption */
    font-weight: 500;
    color: var(--color-on-primary);
    text-transform: uppercase;
    letter-spacing: 0.28px;
    margin-bottom: var(--spacing-xs);
  }

  .footer-newsletter-label {
    font-family: var(--font-mono);
    color: var(--color-coral);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.28px;
  }

  .footer-newsletter-headline {
    font-family: var(--font-sans);
    font-size: 32px; /* card-heading */
    font-weight: 400;
    color: var(--color-on-primary);
    line-height: 1.2;
    letter-spacing: -0.32px;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-links a {
    color: var(--color-muted);
    font-size: 16px; /* body */
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    font-weight: 400;
  }

  .footer-links a:hover {
    color: var(--color-on-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    max-width: 360px;
  }

  .newsletter-text {
    color: var(--color-muted);
    font-size: 12px; /* micro */
    line-height: 1.4;
  }

  .newsletter-form {
    display: flex;
    position: relative;
    width: 100%;
  }

  .newsletter-input {
    width: 100%;
    background-color: var(--color-cohere-black);
    border: 1px solid var(--color-hairline);
    color: var(--color-on-primary);
    border-radius: var(--radius-xs); /* 4px */
    padding: 12px 60px 12px 16px;
    outline: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    transition: border-color var(--duration-fast) var(--ease-out);
    min-height: 44px;
  }

  .newsletter-input:focus {
    border-color: var(--color-on-primary);
  }

  .newsletter-submit {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-xs);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .newsletter-submit:hover {
    color: var(--color-on-primary);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    font-size: 12px; /* micro */
    color: var(--color-muted);
  }

  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  @media (max-width: 480px) {
    .footer-bottom-container {
      flex-direction: column;
      text-align: center;
    }
  }

  .footer-mountain-wrapper {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    margin-top: 20px;
  }

  .footer-mountain {
    width: 100%;
    height: 120px;
    display: block;
  }
</style>
