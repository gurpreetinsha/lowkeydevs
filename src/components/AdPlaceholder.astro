---
interface Props {
  format?: 'horizontal' | 'sidebar' | 'in-feed';
  adSlot?: string;
  adClient?: string;
  className?: string;
}

const {
  format = 'horizontal',
  adSlot = '1234567890',
  adClient = 'ca-pub-1234567890123456',
  className = '',
} = Astro.props;

const isDev = import.meta.env.DEV;
---

<div class={`ad-container format-${format} ${className}`} data-ad-slot={adSlot}>
  {isDev ? (
    <div class="ad-placeholder-dev">
      <div class="ad-label">Advertisement</div>
      <div class="ad-info">
        <span class="ad-format-tag">{format}</span>
        <span class="ad-spec-tag">AdSense Slot: {adSlot}</span>
      </div>
    </div>
  ) : (
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={adClient}
         data-ad-slot={adSlot}
         data-ad-format={format === 'horizontal' ? 'horizontal' : format === 'sidebar' ? 'vertical' : 'auto'}
         data-full-width-responsive="true"></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  )}
</div>

<style>
  /* Base ad container with reserved height to prevent CLS */
  .ad-container {
    display: block;
    width: 100%;
    margin: var(--space-6) auto;
    overflow: hidden;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  /* Reserved spacing per format to prevent Cumulative Layout Shift */
  .ad-container.format-horizontal {
    min-height: 100px;
    max-height: 280px;
  }

  @media (min-width: 768px) {
    .ad-container.format-horizontal {
      min-height: 90px;
      margin: var(--space-8) auto;
    }
  }

  .ad-container.format-sidebar {
    min-height: 250px;
    max-height: 600px;
    margin: 0;
  }

  .ad-container.format-in-feed {
    min-height: 250px;
    margin: var(--space-8) auto;
  }

  /* Development Mode Styling */
  .ad-placeholder-dev {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    min-height: inherit;
    border: 2px dashed var(--border-hover);
    border-radius: calc(var(--radius-lg) - 1px);
    background: repeating-linear-gradient(
      45deg,
      var(--bg),
      var(--bg) 10px,
      var(--surface-hover) 10px,
      var(--surface-hover) 20px
    );
    color: var(--text-secondary);
    text-align: center;
    gap: var(--space-2);
  }

  .ad-label {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
  }

  .ad-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ad-format-tag, .ad-spec-tag {
    padding: var(--space-0-5) var(--space-2);
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    font-weight: 500;
  }

  .ad-spec-tag {
    background-color: var(--surface-elevated);
    color: var(--text-secondary);
  }

  /* Production Mode styling (Google AdSense fallback) */
  .adsbygoogle {
    background: transparent;
  }
</style>
