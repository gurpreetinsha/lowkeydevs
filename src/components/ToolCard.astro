---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>
  
  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>
  
  <div class="card-bottom">
    <span class="card-action-text">Open tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: var(--ds-space-300);
    gap: var(--ds-space-200);
    background-color: var(--ds-surface);
    border: var(--ds-border-width-default) solid var(--ds-border);
    border-radius: var(--ds-radius-large);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .tool-card:hover {
    border-color: var(--ds-border-bold);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--ds-background-neutral);
    color: var(--ds-icon-selected);
    border-radius: var(--ds-radius-medium);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--ds-background-brand-bold);
    color: var(--ds-text-inverse);
  }

  .card-category {
    font-size: 0.7rem;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--ds-text-subtlest);
    text-transform: none; /* MUST NOT use uppercase stretch */
    letter-spacing: normal;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
    flex: 1;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.125rem; /* heading-small */
    font-weight: 653;
    color: var(--ds-text);
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .tool-card:hover .card-title {
    color: var(--ds-text-selected);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: var(--ds-space-075);
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--ds-link);
    margin-top: auto;
    border-top: var(--ds-border-width-default) solid var(--ds-border);
    padding-top: var(--ds-space-150);
    transition: color 0.15s ease;
  }

  .tool-card:hover .card-bottom {
    color: var(--ds-link-pressed);
  }

  .card-arrow {
    transition: transform 0.15s ease;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
