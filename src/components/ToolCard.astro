---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>

  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>

  <div class="card-bottom">
    <span class="card-action-text">Open tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: var(--spacing-lg); /* 24px */
    gap: var(--space-4);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 16px */
    box-shadow: none;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  .tool-card:hover {
    border-color: var(--color-ink);
    box-shadow: none;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    min-width: 0;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-surface-soft);
    color: var(--color-ink);
    border-radius: var(--radius-md); /* 12px */
    transition: all var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .card-category {
    font-size: 12px;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px; /* caption-uppercase */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 18px; /* title-md */
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
    transition: color var(--duration-fast) var(--ease-out);
    overflow-wrap: anywhere;
  }

  .tool-card:hover .card-title {
    color: var(--color-primary);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 14px; /* body-sm */
    color: var(--color-body);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: 14px; /* button */
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--color-ink);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-hairline);
    transition: color var(--duration-fast) var(--ease-out);
    min-width: 0;
    flex-wrap: wrap;
  }

  .tool-card:hover .card-bottom {
    color: var(--color-primary-active);
  }

  .card-arrow {
    transition: transform var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
    max-width: 100%;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
