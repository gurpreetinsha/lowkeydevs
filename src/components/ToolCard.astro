---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>
  
  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>
  
  <div class="card-bottom">
    <span class="card-action-text">Open Tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: 24px;
    gap: 16px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .tool-card:hover {
    border-color: var(--color-hairline);
    background-color: var(--color-neutral-surface);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-neutral-surface);
    color: var(--color-primary);
    border-radius: var(--radius-xs);
    transition: background-color 200ms ease, color 200ms ease;
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .card-category {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-slate);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-primary-dark);
    line-height: 1.2;
    transition: color 200ms ease;
  }

  .tool-card:hover .card-title {
    color: var(--color-action-blue);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-body-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--color-primary);
    margin-top: auto;
    border-top: 1px solid var(--color-border-light);
    padding-top: 12px;
    transition: color 200ms ease;
  }

  .tool-card:hover .card-bottom {
    color: var(--color-action-blue);
  }

  .card-arrow {
    transition: transform 200ms ease;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
