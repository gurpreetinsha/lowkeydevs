---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper widget-accentable">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>
  
  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title widget-accentable">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>
  
  <div class="card-bottom">
    <span class="card-action-text">Open tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: var(--ds-space-300);
    gap: var(--ds-space-200);
    background-color: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--ds-radius-large);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tool-card:hover {
    border-color: var(--glass-border-hover);
    background-color: var(--glass-bg-hover);
    box-shadow: var(--glass-shadow-hover);
    transform: translateY(-4px) scale(1.02);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background-color: rgba(0, 113, 227, 0.08);
    color: var(--ds-text-selected);
    border: 1px solid rgba(0, 113, 227, 0.15);
    border-radius: var(--ds-radius-medium);
    transition: all 0.2s ease;
  }

  html[data-theme="dark"] .card-icon-wrapper {
    background-color: rgba(41, 151, 255, 0.12);
    border-color: rgba(41, 151, 255, 0.25);
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--ds-background-brand-bold);
    color: #ffffff;
    border-color: transparent;
  }

  .card-category {
    font-size: 0.72rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--ds-text-subtlest);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
    flex: 1;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ds-text);
    line-height: 1.3;
    transition: color 0.15s ease;
  }

  .tool-card:hover .card-title {
    color: var(--ds-text-selected);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: var(--ds-space-075);
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--ds-link);
    margin-top: auto;
    border-top: 1px solid var(--ds-border);
    padding-top: var(--ds-space-150);
    transition: color 0.15s ease;
  }

  .tool-card:hover .card-bottom {
    color: var(--ds-link-pressed);
  }

  .card-arrow {
    transition: transform 0.15s ease;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
