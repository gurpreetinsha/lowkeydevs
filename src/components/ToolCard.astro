---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card glass-panel glass-panel-hover" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={22} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>
  
  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>
  
  <div class="card-bottom">
    <span class="card-action-text">Open Tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: 1.5rem;
    gap: 1.25rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--bg-color);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--primary-glow);
    color: var(--primary-accent);
  }

  .card-category {
    font-size: 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .tool-card:hover .card-title {
    color: var(--primary-accent);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    /* Limit description to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--primary-accent);
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
  }

  .card-arrow {
    transition: transform 0.2s ease;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(3px);
  }
</style>
