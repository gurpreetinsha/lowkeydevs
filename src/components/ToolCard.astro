---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>

  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>

  <div class="card-bottom">
    <span class="card-action-text">Open tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: var(--space-6);
    gap: var(--space-4);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .tool-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-md);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--accent);
    color: var(--accent-on);
  }

  .card-category {
    font-size: 11px;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .tool-card:hover .card-title {
    color: var(--accent);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--accent);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .tool-card:hover .card-bottom {
    color: var(--accent-hover);
  }

  .card-arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
