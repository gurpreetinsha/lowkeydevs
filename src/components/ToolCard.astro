---
import Icon from './base/Icon.astro';
import type { ToolMeta } from '../tools/definitions';
import { getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const categoryDetail = getCategoryDetail(tool.category);
---

<a href={`/tools/${tool.slug}`} class="tool-card" aria-labelledby={`card-title-${tool.slug}`}>
  <div class="card-top">
    <div class="card-icon-wrapper">
      <Icon name={tool.icon} size={20} class="card-icon" />
    </div>
    {categoryDetail && (
      <span class="card-category">
        {categoryDetail.title}
      </span>
    )}
  </div>

  <div class="card-content">
    <h3 id={`card-title-${tool.slug}`} class="card-title">{tool.title}</h3>
    <p class="card-description">{tool.description}</p>
  </div>

  <div class="card-bottom">
    <span class="card-action-text">Open tool</span>
    <Icon name="ArrowRight" size={14} class="card-arrow" />
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
    padding: var(--spacing-xl); /* 24px */
    gap: var(--spacing-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm); /* 8px */
    box-shadow: none;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    box-shadow: none;
    text-decoration: none;
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--color-focus-blue);
    outline-offset: 2px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-soft-stone);
    color: var(--color-ink);
    border-radius: var(--radius-xs); /* 4px */
    transition: all var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
  }

  .tool-card:hover .card-icon-wrapper {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .card-category {
    font-size: 14px;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.28px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 24px; /* feature-heading */
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.3;
    letter-spacing: 0;
    transition: color var(--duration-fast) var(--ease-out);
    overflow-wrap: anywhere;
  }

  .tool-card:hover .card-title {
    color: var(--color-action-blue);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 16px; /* body */
    color: var(--color-body-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 16px; /* button/body link */
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--color-ink);
    margin-top: auto;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-hairline);
    transition: color var(--duration-fast) var(--ease-out);
    min-width: 0;
    flex-wrap: wrap;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tool-card:hover .card-bottom {
    color: var(--color-action-blue);
  }

  .card-arrow {
    transition: transform var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
    max-width: 100%;
  }

  .tool-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
