---
import Icon from './base/Icon.astro';
import { registry } from '../tools/registry';

// Serialize tools metadata for client-side instant search
const searchIndex = registry.map(tool => ({
  title: tool.title,
  slug: tool.slug,
  description: tool.description,
  keywords: tool.keywords,
  category: tool.category,
  icon: tool.icon
}));
---

<header class="site-header">
  <div class="container nav-container">
    <a href="/" class="logo" aria-label="LowKeyDevs Homepage">
      <span class="logo-text">LowKey<span class="logo-accent">Devs</span></span>
    </a>

    <!-- Right Actions: Search + Theme Switcher -->
    <div class="right-header-group">
      <!-- Instant Search Bar -->
      <div class="search-wrapper" id="site-search">
        <div class="search-input-container">
          <Icon name="Search" class="search-icon" size={16} />
          <input 
            type="text" 
            id="search-input" 
            placeholder="Search tools (e.g. json, password)..." 
            autocomplete="off"
            aria-label="Search tools"
          />
          <kbd class="search-kbd">/</kbd>
        </div>
        
        <!-- Results Dropdown -->
        <div class="search-results" id="search-results" hidden>
          <ul id="results-list" role="listbox" aria-label="Search results"></ul>
          <div class="search-empty" id="search-empty" hidden>
            No tools found. Try searching for something else!
          </div>
        </div>
      </div>

      <!-- Theme Switcher -->
      <div class="theme-switcher-wrapper" id="theme-switcher">
        <button class="theme-btn" id="theme-menu-btn" aria-label="Change theme" aria-expanded="false">
          <Icon name="Palette" size={18} />
          <span class="theme-btn-text">Theme</span>
        </button>
        
        <div class="theme-dropdown" id="theme-dropdown" hidden>
          <div class="theme-dropdown-header">Choose theme</div>
          <div class="theme-grid">
            <button class="theme-option" data-theme-val="light" title="Default Light">
              <span class="swatch" style="background: #FFFFFF; border: 1px solid var(--ds-border);"></span>
              <span class="theme-name">Light</span>
            </button>
            <button class="theme-option" data-theme-val="dark" title="Default Dark">
              <span class="swatch" style="background: #1D2125; border: 1px solid var(--ds-border);"></span>
              <span class="theme-name">Dark</span>
            </button>
            <button class="theme-option" data-theme-val="cyberpunk" title="Cyberpunk">
              <span class="swatch" style="background: #080710; border: 1px solid #FF007F;"></span>
              <span class="theme-name">Cyberpunk</span>
            </button>
            <button class="theme-option" data-theme-val="dracula" title="Dracula">
              <span class="swatch" style="background: #282A36; border: 1px solid #BD93F9;"></span>
              <span class="theme-name">Dracula</span>
            </button>
            <button class="theme-option" data-theme-val="solarized-light" title="Solarized Light">
              <span class="swatch" style="background: #FDF6E3; border: 1px solid #268BD2;"></span>
              <span class="theme-name">Solarized L</span>
            </button>
            <button class="theme-option" data-theme-val="solarized-dark" title="Solarized Dark">
              <span class="swatch" style="background: #002B36; border: 1px solid #2AA198;"></span>
              <span class="theme-name">Solarized D</span>
            </button>
            <button class="theme-option" data-theme-val="nord" title="Nord">
              <span class="swatch" style="background: #2E3440; border: 1px solid #88C0D0;"></span>
              <span class="theme-name">Nord</span>
            </button>
            <button class="theme-option" data-theme-val="monokai" title="Monokai">
              <span class="swatch" style="background: #272822; border: 1px solid #A6E22E;"></span>
              <span class="theme-name">Monokai</span>
            </button>
            <button class="theme-option" data-theme-val="forest" title="Forest Green">
              <span class="swatch" style="background: #121B14; border: 1px solid #34D399;"></span>
              <span class="theme-name">Forest</span>
            </button>
            <button class="theme-option" data-theme-val="sakura" title="Sakura">
              <span class="swatch" style="background: #FFF5F5; border: 1px solid #EC4899;"></span>
              <span class="theme-name">Sakura</span>
            </button>
            <button class="theme-option" data-theme-val="oceanic" title="Oceanic">
              <span class="swatch" style="background: #0B132B; border: 1px solid #00B4D8;"></span>
              <span class="theme-name">Oceanic</span>
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</header>

<style>
  .site-header {
    background-color: rgba(255, 255, 255, 0.3);
    border-bottom: 1px solid var(--ds-border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    height: 70px;
    display: flex;
    align-items: center;
  }

  html[data-theme="dark"] .site-header {
    background-color: rgba(10, 6, 20, 0.5);
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--ds-space-200);
  }

  .right-header-group {
    display: flex;
    align-items: center;
    gap: var(--ds-space-150);
    flex: 1;
    max-width: 600px;
    justify-content: flex-end;
  }

  .theme-switcher-wrapper {
    position: relative;
    display: inline-block;
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-075);
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--glass-border);
    color: var(--ds-text-subtle);
    padding: var(--ds-space-100) var(--ds-space-150);
    border-radius: var(--ds-radius-medium);
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  html[data-theme="dark"] .theme-btn {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--ds-text);
  }

  .theme-btn:hover {
    border-color: var(--glass-border-hover);
    background-color: var(--glass-bg-hover);
  }

  .theme-dropdown {
    position: absolute;
    top: calc(100% + var(--ds-space-100));
    right: 0;
    width: 280px;
    background-color: var(--ds-surface-overlay);
    border: 1px solid var(--glass-border);
    border-radius: var(--ds-radius-large);
    box-shadow: var(--ds-shadow-overlay);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    z-index: 1001;
    padding: var(--ds-space-200);
    animation: slideDown 0.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .theme-dropdown-header {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ds-text-subtle);
    margin-bottom: var(--ds-space-150);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--ds-border);
    padding-bottom: var(--ds-space-075);
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ds-space-075);
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: var(--ds-space-075);
    background: transparent;
    border: 1px solid transparent;
    padding: var(--ds-space-075) var(--ds-space-100);
    border-radius: var(--ds-radius-medium);
    cursor: pointer;
    text-align: left;
    width: 100%;
    color: var(--ds-text);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .theme-option:hover {
    background-color: var(--ds-background-neutral-hovered);
  }

  .theme-option.active {
    background-color: var(--ds-background-selected);
    border-color: var(--ds-border-selected);
    font-weight: 700;
    color: var(--ds-text-selected);
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .theme-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .theme-btn-text {
      display: none;
    }
    .theme-btn {
      padding: var(--ds-space-100);
    }
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--ds-text);
    letter-spacing: -0.04em;
  }

  .logo-accent {
    color: var(--ds-text-selected);
  }

  /* Search Bar Styles */
  .search-wrapper {
    position: relative;
    flex: 1;
    max-width: 440px;
    transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .search-input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: var(--ds-space-150);
    color: var(--ds-icon-subtle);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: var(--ds-space-100) var(--ds-space-150) var(--ds-space-100) var(--ds-space-450);
    border-radius: var(--ds-radius-medium);
    background-color: var(--ds-background-input);
    border: 1px solid var(--ds-border-input);
    color: var(--ds-text);
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
  }

  #search-input:focus {
    border-color: var(--ds-border-focused);
    box-shadow: var(--form-focus-ring);
    background-color: var(--ds-background-input-pressed);
  }

  .search-kbd {
    position: absolute;
    right: var(--ds-space-150);
    background-color: var(--ds-background-neutral);
    border: 1px solid var(--ds-border);
    color: var(--ds-text-subtlest);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-family: var(--font-sans);
    font-weight: 700;
    pointer-events: none;
  }

  #search-input:focus ~ .search-kbd {
    display: none;
  }

  /* Search Results Dropdown */
  .search-results {
    position: absolute;
    top: calc(100% + var(--ds-space-075));
    left: 0;
    right: 0;
    background-color: var(--ds-surface-overlay);
    border: 1px solid var(--glass-border);
    border-radius: var(--ds-radius-large);
    box-shadow: var(--ds-shadow-overlay);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    max-height: 380px;
    overflow-y: auto;
    z-index: 1000;
    padding: var(--ds-space-100);
  }

  .search-results ul {
    list-style: none;
  }

  .search-item a {
    display: flex;
    align-items: center;
    gap: var(--ds-space-150);
    padding: var(--ds-space-100) var(--ds-space-150);
    border-radius: var(--ds-radius-medium);
    color: var(--ds-text);
    text-decoration: none;
  }

  .search-item:hover a,
  .search-item.active a {
    background-color: var(--ds-background-neutral-hovered);
    color: var(--ds-text);
  }

  .search-item-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-item-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .search-item-desc {
    font-size: 0.75rem;
    color: var(--ds-text-subtlest);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-item-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--ds-radius-small);
    background-color: var(--ds-background-neutral);
    color: var(--ds-icon-subtle);
    flex-shrink: 0;
  }

  .search-item:hover .search-item-icon-wrapper,
  .search-item.active .search-item-icon-wrapper {
    background-color: var(--ds-background-brand-bold);
    color: #ffffff;
  }

  .search-empty {
    padding: var(--ds-space-300);
    text-align: center;
    color: var(--ds-text-subtlest);
    font-size: 0.85rem;
  }

  /* Responsive Search adjustments */
  @media (max-width: 640px) {
    .logo-text {
      font-size: 1.15rem;
    }
    .search-wrapper {
      max-width: 170px;
    }
    .search-wrapper:focus-within {
      max-width: 220px;
      z-index: 10;
    }
    #search-input {
      font-size: 0.8rem;
      padding-left: var(--ds-space-350);
      padding-right: var(--ds-space-150);
    }
    .search-kbd {
      display: none;
    }
  }
</style>

<script define:vars={{ searchIndex }}>
  // Instant search functionality
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const resultsList = document.getElementById('results-list');
  const searchEmpty = document.getElementById('search-empty');
  
  let activeIndex = -1;
  let items = [];

  function performSearch(query) {
    const term = query.trim().toLowerCase();
    if (!term) {
      hideResults();
      return;
    }

    // Filter tools by title, description, category, keywords
    const filtered = searchIndex.filter(tool => {
      return (
        tool.title.toLowerCase().includes(term) ||
        tool.description.toLowerCase().includes(term) ||
        tool.category.toLowerCase().includes(term) ||
        tool.keywords.some(kw => kw.toLowerCase().includes(term))
      );
    });

    renderResults(filtered);
  }

  function renderResults(results) {
    resultsList.innerHTML = '';
    activeIndex = -1;

    if (results.length === 0) {
      searchEmpty.removeAttribute('hidden');
      resultsList.style.display = 'none';
      resultsContainer.removeAttribute('hidden');
      items = [];
      return;
    }

    searchEmpty.setAttribute('hidden', 'true');
    resultsList.style.display = 'block';
    resultsContainer.removeAttribute('hidden');

    results.forEach((tool, idx) => {
      const li = document.createElement('li');
      li.className = 'search-item';
      li.setAttribute('role', 'option');
      li.id = `search-item-${idx}`;

      // Simple icon map (using basic inline SVGs dynamically generated for search dropdown)
      li.innerHTML = `
        <a href="/tools/${tool.slug}">
          <div class="search-item-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <path d="M9 17H7A2 2 0 0 1 5 15V9A2 2 0 0 1 7 7h2"/>
              <path d="m15 7 5 5-5 5"/>
            </svg>
          </div>
          <div class="search-item-info">
            <span class="search-item-title">${tool.title}</span>
            <span class="search-item-desc">${tool.description}</span>
          </div>
        </a>
      `;
      resultsList.appendChild(li);
    });

    items = resultsList.querySelectorAll('.search-item');
  }

  function hideResults() {
    resultsContainer.setAttribute('hidden', 'true');
    activeIndex = -1;
  }

  // Keyboard navigation inside search results
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (items.length === 0) return;
      if (activeIndex !== -1) items[activeIndex].classList.remove('active');
      activeIndex = (activeIndex + 1) % items.length;
      items[activeIndex].classList.add('active');
      items[activeIndex].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (items.length === 0) return;
      if (activeIndex !== -1) items[activeIndex].classList.remove('active');
      activeIndex = (activeIndex - 1 + items.length) % items.length;
      items[activeIndex].classList.add('active');
      items[activeIndex].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      if (activeIndex !== -1 && items[activeIndex]) {
        e.preventDefault();
        items[activeIndex].querySelector('a').click();
      }
    } else if (e.key === 'Escape') {
      hideResults();
      searchInput.blur();
    }
  });

  searchInput.addEventListener('input', (e) => {
    performSearch(e.target.value);
  });

  // Focus input when "/" key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput.focus();
    }
  });

  // Hide on click outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#site-search')) {
      hideResults();
    }
  });

  // Theme selection logic
  const themeMenuBtn = document.getElementById('theme-menu-btn');
  const themeDropdown = document.getElementById('theme-dropdown');
  const themeOptions = document.querySelectorAll('.theme-option');

  if (themeMenuBtn && themeDropdown) {
    themeMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = themeDropdown.hasAttribute('hidden');
      if (isHidden) {
        themeDropdown.removeAttribute('hidden');
        themeMenuBtn.setAttribute('aria-expanded', 'true');
        highlightActiveTheme();
      } else {
        themeDropdown.setAttribute('hidden', 'true');
        themeMenuBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (!themeDropdown.contains(e.target) && e.target !== themeMenuBtn) {
        themeDropdown.setAttribute('hidden', 'true');
        themeMenuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function highlightActiveTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    themeOptions.forEach(opt => {
      if (opt.getAttribute('data-theme-val') === currentTheme) {
        opt.classList.add('active');
      } else {
        opt.classList.remove('active');
      }
    });
  }

  themeOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      const themeVal = opt.getAttribute('data-theme-val');
      if (themeVal) {
        document.documentElement.setAttribute('data-theme', themeVal);
        localStorage.setItem('lowkeydevs-theme', themeVal);
        highlightActiveTheme();
        themeDropdown.setAttribute('hidden', 'true');
        themeMenuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
