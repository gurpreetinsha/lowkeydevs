---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/base/Icon.astro';
import SponsorCard from '../components/SponsorCard.astro';
import type { ToolMeta } from '../tools/definitions';
import { registry, getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const categoryDetail = getCategoryDetail(tool.category);

// Find related tools (same category first, then fallback to any other tool from registry)
const relatedTools = registry
  .filter(t => t.slug !== tool.slug)
  .sort((a, b) => {
    if (a.category === tool.category && b.category !== tool.category) return -1;
    if (b.category === tool.category && a.category !== tool.category) return 1;
    return 0;
  })
  .slice(0, 3);

// Generate SoftwareApplication JSON-LD schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.title,
  "operatingSystem": "All",
  "applicationCategory": tool.category === 'security' ? 'SecurityApplication' : 'DeveloperApplication',
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": tool.description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Generate FAQPage JSON-LD schema
const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout
  title={`${tool.title} - LowKeyDevs`}
  description={tool.description}
>
  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-sep" aria-hidden="true">
        <Icon name="ChevronRight" size={14} />
      </span>
      {categoryDetail && (
        <>
          <a href={`/tools/category/${tool.category}`} class="breadcrumb-link">
            {categoryDetail.title}
          </a>
          <span class="breadcrumb-sep" aria-hidden="true">
            <Icon name="ChevronRight" size={14} />
          </span>
        </>
      )}
      <span class="breadcrumb-current" aria-current="page">{tool.title}</span>
    </div>
  </nav>

  <main id="main-content" class="tool-main container">
    <div class="tool-grid">
      <!-- Main tool workspace -->
      <section class="tool-section" aria-labelledby="tool-title-heading">
        <header class="tool-header">
          <span class="category-badge">
            <Icon name={categoryDetail?.icon || 'Info'} size={12} />
            {categoryDetail?.title}
          </span>
          <h1 id="tool-title-heading" class="tool-title">{tool.title}</h1>
          <p class="tool-description">{tool.description}</p>
        </header>

        <div class="tool-workspace-wrapper">
          <slot />
        </div>
      </section>

      <!-- Sidebar -->
      <aside class="tool-sidebar">
        <SponsorCard />

        <div class="sidebar-widget">
          <h2 class="widget-title">Related tools</h2>
          <div class="related-list">
            {relatedTools.map(t => (
              <a href={`/tools/${t.slug}`} class="related-item">
                <div class="related-icon">
                  <Icon name={t.icon} size={14} />
                </div>
                <div class="related-info">
                  <span class="related-title">{t.title}</span>
                  <span class="related-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-widget privacy-widget">
          <div class="privacy-header">
            <Icon name="Lock" size={16} />
            <h2 class="widget-title privacy-widget-title">100% client-side</h2>
          </div>
          <p class="privacy-text">
            All conversions and formatting happen strictly in your browser. We never save, upload, or transmit any of your text, JSON, or input data to servers.
          </p>
        </div>
      </aside>
    </div>

    <!-- Educational & FAQ Section -->
    <section class="content-section" aria-label="How to use the tool">
      <div class="edu-grid">
        <!-- Educational Guide -->
        <article class="edu-guide">
          <h2 class="edu-title">What is this tool?</h2>
          <p class="edu-para">{tool.educationalContent.whatIsIt}</p>

          <h2 class="edu-title">How to use it</h2>
          <div class="steps-list">
            {tool.educationalContent.howToUse.split('\n').map(step => (
              <p class="step-item">{step}</p>
            ))}
          </div>

          {tool.educationalContent.proTips && (
            <>
              <h2 class="edu-title pro-tips-title">
                <Icon name="Info" size={14} />
                Pro tips
              </h2>
              <ul class="pro-tips-list">
                {tool.educationalContent.proTips.map(tip => (
                  <li>{tip}</li>
                ))}
              </ul>
            </>
          )}
        </article>

        <!-- FAQs Accordion -->
        {tool.faqs && tool.faqs.length > 0 && (
          <div class="faq-accordion">
            <h2 class="edu-title">Frequently asked questions</h2>
            <div class="accordion-wrapper">
              {tool.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <Icon name="ChevronDown" size={16} class="chevron" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Structured Schema-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    border-bottom: 1px solid var(--color-hairline);
    padding: var(--spacing-sm) 0;
    font-size: 14px; /* body-sm */
    background-color: var(--color-canvas);
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .breadcrumbs-container::-webkit-scrollbar {
    display: none;
  }

  .breadcrumb-link, .breadcrumb-current {
    white-space: nowrap;
    font-family: var(--font-sans);
  }

  .breadcrumb-link {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-sep {
    color: var(--color-muted-soft);
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: var(--color-muted-soft);
    font-weight: 400;
  }

  /* Layout */
  .tool-main {
    padding-top: var(--spacing-xl); /* 32px */
    padding-bottom: var(--spacing-section); /* 96px */
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxl); /* 48px */
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--spacing-lg);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Tool header */
  .tool-header {
    margin-bottom: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .category-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-surface-card); /* #f5f0e0 */
    color: var(--color-ink); /* #0a0a0a */
    border: 1px solid var(--color-hairline);
    padding: 4px 12px; /* badge-pill */
    border-radius: var(--radius-pill); /* rounded.pill */
    font-size: 13px; /* typography.caption */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tool-title {
    font-family: var(--font-heading);
    font-size: 40px; /* display-md */
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .tool-description {
    color: var(--color-body);
    font-size: 16px; /* body-md */
    font-weight: 400;
    max-width: 600px;
    line-height: 1.55;
  }

  /* Tool workspace */
  .tool-workspace-wrapper {
    margin-top: var(--space-2);
  }

  /* Sidebar */
  .tool-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .sidebar-widget {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 16px */
    padding: var(--spacing-lg); /* 24px */
    color: var(--color-ink);
  }

  .widget-title {
    font-family: var(--font-sans);
    font-size: 16px; /* title-sm */
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    color: var(--color-ink);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .related-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md); /* 12px */
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .related-item:hover {
    background-color: var(--color-surface-soft);
    text-decoration: none;
  }

  .related-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--color-surface-card);
    color: var(--color-ink);
    border-radius: var(--radius-sm); /* 8px */
    flex-shrink: 0;
  }

  .related-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    gap: var(--space-0-5);
  }

  .related-title {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-ink);
  }

  .related-desc {
    font-size: 13px;
    color: var(--color-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Privacy widget */
  .privacy-widget {
    background-color: var(--color-surface-card); /* #f5f0e0 */
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 16px */
    padding: var(--spacing-lg); /* 24px */
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-success);
    margin-bottom: var(--space-3);
  }

  .privacy-header .privacy-widget-title {
    margin-bottom: 0;
    color: var(--color-success);
    font-weight: 700;
    font-size: 14px;
  }

  .privacy-text {
    font-size: 14px;
    color: var(--color-body);
    line-height: 1.55;
  }

  /* Educational content */
  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--spacing-lg);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }

  .edu-guide, .faq-accordion {
    background-color: var(--color-surface-card); /* #f5f0e0 */
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 16px */
    padding: var(--spacing-lg); /* 24px */
  }

  .edu-title {
    font-family: var(--font-heading);
    font-size: 32px; /* display-sm */
    font-weight: 500;
    margin-bottom: var(--spacing-sm);
    color: var(--color-ink);
    letter-spacing: -0.5px;
    line-height: 1.15;
  }

  .edu-title:not(:first-child) {
    margin-top: var(--spacing-lg);
  }

  .edu-para {
    color: var(--color-body);
    font-size: 16px; /* body-md */
    line-height: 1.55;
    margin-bottom: var(--space-2);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .step-item {
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.55;
  }

  .pro-tips-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink) !important;
    font-size: 18px !important; /* title-md */
    font-weight: 600 !important;
    font-family: var(--font-sans) !important;
  }

  .pro-tips-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pro-tips-list li {
    font-size: 16px;
    color: var(--color-body);
    position: relative;
    padding-left: var(--space-5);
    line-height: 1.55;
  }

  .pro-tips-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  /* FAQ Accordion */
  .accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md); /* 12px */
    background-color: var(--color-canvas); /* #fffaf0 */
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    user-select: none;
    list-style: none;
    color: var(--color-ink);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .faq-question:hover {
    background-color: var(--color-surface-soft);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question .chevron {
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    border-top: 1px solid var(--color-hairline);
  }

  .faq-answer p {
    font-size: 14px;
    color: var(--color-body);
    line-height: 1.55;
    margin-top: var(--space-3);
  }
</style>
