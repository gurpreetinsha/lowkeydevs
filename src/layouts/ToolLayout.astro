---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/base/Icon.astro';
import SponsorCard from '../components/SponsorCard.astro';
import type { ToolMeta } from '../tools/definitions';
import { registry, getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const categoryDetail = getCategoryDetail(tool.category);

// Find related tools (same category first, then fallback to any other tool from registry)
const relatedTools = registry
  .filter(t => t.slug !== tool.slug)
  .sort((a, b) => {
    if (a.category === tool.category && b.category !== tool.category) return -1;
    if (b.category === tool.category && a.category !== tool.category) return 1;
    return 0;
  })
  .slice(0, 3);

// Generate SoftwareApplication JSON-LD schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.title,
  "operatingSystem": "All",
  "applicationCategory": tool.category === 'security' ? 'SecurityApplication' : 'DeveloperApplication',
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": tool.description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Generate FAQPage JSON-LD schema
const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout 
  title={`${tool.title} - LowKeyDevs`} 
  description={tool.description}
>
  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href="/" class="breadcrumb-item">Home</a>
      <span class="separator">/</span>
      {categoryDetail && (
        <>
          <a href={`/tools/category/${tool.category}`} class="breadcrumb-item">
            {categoryDetail.title}
          </a>
          <span class="separator">/</span>
        </>
      )}
      <span class="breadcrumb-item active" aria-current="page">{tool.title}</span>
    </div>
  </nav>

  <main class="tool-main-layout container">
    <div class="tool-grid-container">
      <!-- Active Tool Workspace -->
      <section class="tool-section" aria-labelledby="tool-title-heading">
        <header class="tool-header-block">
          <span class="category-badge widget-accentable">
            <Icon name={categoryDetail?.icon || 'Info'} size={12} />
            {categoryDetail?.title}
          </span>
          <h1 id="tool-title-heading" class="tool-title widget-accentable">{tool.title}</h1>
          <p class="tool-description">{tool.description}</p>
        </header>

        <div class="tool-workspace-wrapper">
          <slot />
        </div>
      </section>

      <!-- Sidebar / Related tools -->
      <aside class="tool-sidebar">
        <!-- Sidebar Ad/Sponsorship Placement -->
        <SponsorCard />

        <div class="sidebar-widget glass-panel">
          <h2 class="widget-title widget-accentable">Related tools</h2>
          <div class="related-list">
            {relatedTools.map(t => (
              <a href={`/tools/${t.slug}`} class="related-item">
                <div class="related-icon widget-accentable">
                  <Icon name={t.icon} size={14} />
                </div>
                <div class="related-info">
                  <span class="related-title widget-accentable">{t.title}</span>
                  <span class="related-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-widget privacy-widget glass-panel">
          <div class="privacy-header">
            <Icon name="Lock" size={16} class="privacy-icon widget-accentable" />
            <h2 class="widget-title widget-accentable">100% client-side</h2>
          </div>
          <p class="privacy-text">
            All conversions and formatting happen strictly in your browser. We never save, upload, or transmit any of your text, JSON, or input data to servers.
          </p>
        </div>
      </aside>
    </div>

    <!-- Educational & FAQ Accordion Section -->
    <section class="content-section" aria-label="How to use the tool">
      <div class="edu-grid">
        <!-- Educational Guide -->
        <article class="edu-guide glass-panel">
          <h2 class="edu-title widget-accentable">What is this tool?</h2>
          <p class="edu-para">{tool.educationalContent.whatIsIt}</p>

          <h2 class="edu-title widget-accentable">How to use it</h2>
          <div class="steps-list">
            {tool.educationalContent.howToUse.split('\n').map(step => (
              <p class="step-item">{step}</p>
            ))}
          </div>

          {tool.educationalContent.proTips && (
            <>
              <h2 class="edu-title pro-tips-title widget-accentable">
                <Icon name="Info" size={14} />
                Pro tips
              </h2>
              <ul class="pro-tips-list">
                {tool.educationalContent.proTips.map(tip => (
                  <li>{tip}</li>
                ))}
              </ul>
            </>
          )}
        </article>

        <!-- FAQs Accordion -->
        {tool.faqs && tool.faqs.length > 0 && (
          <div class="faq-accordion glass-panel">
            <h2 class="edu-title widget-accentable">Frequently asked questions</h2>
            <div class="accordion-wrapper">
              {tool.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <Icon name="ChevronDown" size={16} class="chevron" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Inject Structured Schema-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid var(--ds-border);
    padding: var(--ds-space-150) 0;
    font-size: 0.8125rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  
  html[data-theme="dark"] .breadcrumbs-nav {
    background-color: rgba(0, 0, 0, 0.2);
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: var(--ds-space-100);
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    color: var(--ds-text-subtle);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-item:hover {
    color: var(--ds-link);
    text-decoration: underline;
  }

  .breadcrumb-item.active {
    color: var(--ds-text-subtlest);
    pointer-events: none;
    text-decoration: none;
  }

  .separator {
    color: var(--ds-text-subtlest);
    user-select: none;
  }

  /* Layout Structure */
  .tool-main-layout {
    padding-top: var(--ds-space-400);
    padding-bottom: var(--ds-space-1000);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-600);
  }

  .tool-grid-container {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--ds-space-400);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tool-grid-container {
      grid-template-columns: 1fr;
    }
  }

  /* Header details */
  .tool-header-block {
    margin-bottom: var(--ds-space-300);
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
  }

  .category-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-075);
    background-color: rgba(0, 113, 227, 0.08);
    color: var(--ds-text-selected);
    border: 1px solid rgba(0, 113, 227, 0.15);
    padding: var(--ds-space-050) var(--ds-space-150);
    border-radius: var(--ds-radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-sans);
  }

  html[data-theme="dark"] .category-badge {
    background-color: rgba(41, 151, 255, 0.12);
    color: var(--ds-text-selected);
    border-color: rgba(41, 151, 255, 0.25);
  }

  .tool-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--ds-text);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .tool-description {
    color: var(--ds-text-subtle);
    font-size: 0.9375rem;
    max-width: 800px;
    line-height: 1.5;
  }

  /* Tool Workspace Frame */
  .tool-workspace-wrapper {
    margin-top: var(--ds-space-200);
  }

  /* Sidebar */
  .tool-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-300);
  }

  .sidebar-widget {
    padding: var(--ds-space-250);
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: var(--ds-space-200);
    color: var(--ds-text);
    letter-spacing: -0.01em;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
  }

  .related-item {
    display: flex;
    align-items: flex-start;
    gap: var(--ds-space-150);
    padding: var(--ds-space-100);
    border-radius: var(--ds-radius-medium);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .related-item:hover {
    background-color: var(--ds-background-neutral-hovered);
  }

  .related-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--ds-background-neutral);
    color: var(--ds-icon-subtle);
    border-radius: var(--ds-radius-small);
    flex-shrink: 0;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .related-item:hover .related-icon {
    color: #ffffff;
    background-color: var(--ds-background-brand-bold);
  }

  .related-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .related-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ds-text);
  }

  .related-desc {
    font-size: 0.75rem;
    color: var(--ds-text-subtlest);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .privacy-widget {
    border-color: var(--ds-border-success-subtle) !important;
    background-color: var(--ds-background-success) !important;
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: var(--ds-space-100);
    color: var(--ds-text-success);
    margin-bottom: var(--ds-space-100);
  }

  .privacy-header .widget-title {
    margin-bottom: 0;
    color: var(--ds-text-success-bolder);
    font-weight: 700;
  }

  .privacy-text {
    font-size: 0.8125rem;
    color: var(--ds-text-subtle);
    line-height: 1.5;
  }

  /* Educational Content & FAQs */
  .edu-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--ds-space-400);
    align-items: start;
  }

  @media (max-width: 900px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }

  .edu-guide, .faq-accordion {
    padding: var(--ds-space-300);
  }

  .edu-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--ds-space-150);
    color: var(--ds-text);
  }

  .edu-title:not(:first-child) {
    margin-top: var(--ds-space-300);
  }

  .edu-para {
    color: var(--ds-text-subtle);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: var(--ds-space-150);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
  }

  .step-item {
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    line-height: 1.6;
  }

  .pro-tips-title {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-100);
    color: var(--ds-text-accent-orange-bolder) !important;
  }

  .pro-tips-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-100);
  }

  .pro-tips-list li {
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    position: relative;
    padding-left: var(--ds-space-250);
  }

  .pro-tips-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--ds-text-accent-orange);
  }

  /* Accordion styling */
  .accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-150);
    margin-top: var(--ds-space-200);
  }

  .faq-item {
    border: var(--ds-border-width-default) solid var(--ds-border);
    border-radius: var(--ds-radius-medium);
    background-color: var(--ds-surface-sunken);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .faq-item:hover {
    border-color: var(--ds-border-bold);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--ds-space-200);
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    user-select: none;
    list-style: none; /* Hide default triangle */
  }

  .faq-question::-webkit-details-marker {
    display: none; /* Hide default triangle in Safari */
  }

  .faq-question .chevron {
    color: var(--ds-icon-subtle);
    transition: transform 0.15s ease;
  }

  .faq-item[open] .faq-question .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--ds-space-200) var(--ds-space-200) var(--ds-space-200);
    border-top: var(--ds-border-width-default) solid var(--ds-border);
    background-color: var(--ds-surface);
  }

  .faq-answer p {
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    line-height: 1.6;
    margin-top: var(--ds-space-150);
  }
</style>
