---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/base/Icon.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import type { ToolMeta } from '../tools/definitions';
import { registry, getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const categoryDetail = getCategoryDetail(tool.category);

// Find related tools (same category first, then fallback to any other tool from registry)
const relatedTools = registry
  .filter(t => t.slug !== tool.slug)
  .sort((a, b) => {
    if (a.category === tool.category && b.category !== tool.category) return -1;
    if (b.category === tool.category && a.category !== tool.category) return 1;
    return 0;
  })
  .slice(0, 3);

// Generate SoftwareApplication JSON-LD schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.title,
  "operatingSystem": "All",
  "applicationCategory": tool.category === 'security' ? 'SecurityApplication' : 'DeveloperApplication',
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": tool.description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Generate FAQPage JSON-LD schema
const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout
  title={`${tool.title} - Lowkeydevs`}
  description={tool.description}
  toolSlug={tool.slug}
  toolCategory={tool.category}
>
  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-sep" aria-hidden="true">
        <Icon name="ChevronRight" size={14} />
      </span>
      {categoryDetail && (
        <>
          <a href={`/tools/category/${tool.category}`} class="breadcrumb-link">
            {categoryDetail.title}
          </a>
          <span class="breadcrumb-sep" aria-hidden="true">
            <Icon name="ChevronRight" size={14} />
          </span>
        </>
      )}
      <span class="breadcrumb-current" aria-current="page">{tool.title}</span>
    </div>
  </nav>

  <main id="main-content" class="tool-main container">
    <div class="tool-grid">
      <!-- Main tool workspace -->
      <section class="tool-section" aria-labelledby="tool-title-heading">
        <header class="tool-header">
          <span class="category-badge">
            <Icon name={categoryDetail?.icon || 'Info'} size={12} />
            {categoryDetail?.title}
          </span>
          <div class="tool-title-row">
            <h1 id="tool-title-heading" class="tool-title">{tool.title}</h1>
            <button class="favorite-btn tool-favorite-btn" data-slug={tool.slug} aria-label="Toggle favorite" title="Toggle favorite">
              <Icon name="Star" size={18} />
            </button>
          </div>
          <p class="tool-description">{tool.description}</p>
        </header>

        <div class="tool-workspace-wrapper">
          <slot />
        </div>

        <!-- Internal Interlinking / Related Tools Footer -->
        <div class="tool-interlinks-footer">
          <h3 class="interlinks-title">Related Tools You Might Need</h3>
          <div class="interlinks-grid">
            {relatedTools.map(t => (
              <a href={`/tools/${t.slug}`} class="interlink-card">
                <div class="interlink-icon">
                  <Icon name={t.icon} size={16} />
                </div>
                <div class="interlink-content">
                  <span class="interlink-name">{t.title}</span>
                  <span class="interlink-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Sidebar -->
      <aside class="tool-sidebar">
        <AdPlaceholder format="sidebar" adSlot="tool-sidebar" />

        <div class="sidebar-widget">
          <h2 class="widget-title">Related tools</h2>
          <div class="related-list">
            {relatedTools.map(t => (
              <a href={`/tools/${t.slug}`} class="related-item">
                <div class="related-icon">
                  <Icon name={t.icon} size={14} />
                </div>
                <div class="related-info">
                  <span class="related-title">{t.title}</span>
                  <span class="related-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-widget privacy-widget">
          <div class="privacy-header">
            <Icon name="Lock" size={16} />
            <h2 class="widget-title privacy-widget-title">100% client-side</h2>
          </div>
          <p class="privacy-text">
            All conversions and formatting happen strictly in your browser. We never save, upload, or transmit any of your text, JSON, or input data to servers.
          </p>
        </div>
      </aside>
    </div>

    <AdPlaceholder format="in-feed" adSlot="tool-infeed" />

    <!-- Educational & FAQ Section -->
    <section class="content-section" aria-label="How to use the tool">
      <div class="edu-grid">
        <!-- Educational Guide -->
        <article class="edu-guide">
          <h2 class="edu-title">What is this tool?</h2>
          <p class="edu-para">{tool.educationalContent.whatIsIt}</p>

          <h2 class="edu-title">How to use it</h2>
          <div class="steps-list">
            {tool.educationalContent.howToUse.split('\n').map(step => (
              <p class="step-item">{step}</p>
            ))}
          </div>

          {tool.educationalContent.proTips && (
            <>
              <h2 class="edu-title pro-tips-title">
                <Icon name="Info" size={14} />
                Pro tips
              </h2>
              <ul class="pro-tips-list">
                {tool.educationalContent.proTips.map(tip => (
                  <li>{tip}</li>
                ))}
              </ul>
            </>
          )}
        </article>

        <!-- FAQs Accordion -->
        {tool.faqs && tool.faqs.length > 0 && (
          <div class="faq-accordion">
            <h2 class="edu-title">Frequently asked questions</h2>
            <div class="accordion-wrapper">
              {tool.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <Icon name="ChevronDown" size={16} class="chevron" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Structured Schema-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <script define:vars={{ toolSlug: tool.slug }}>
    try {
      const slug = toolSlug;
      if (slug) {
        // 1. Log Recent Use
        let recent = [];
        try {
          recent = JSON.parse(localStorage.getItem('recent_tools') || '[]');
        } catch (e) {}
        recent = [slug, ...recent.filter(s => s !== slug)].slice(0, 5);
        localStorage.setItem('recent_tools', JSON.stringify(recent));

        // 2. Log Frequency
        let frequent = {};
        try {
          frequent = JSON.parse(localStorage.getItem('frequent_tools') || '{}');
        } catch (e) {}
        frequent[slug] = (frequent[slug] || 0) + 1;
        localStorage.setItem('frequent_tools', JSON.stringify(frequent));

        // 3. Initialize favorite button state
        const favBtn = document.querySelector(`.tool-favorite-btn[data-slug="${slug}"]`);
        if (favBtn) {
          let favorites = [];
          try {
            favorites = JSON.parse(localStorage.getItem('favorite_tools') || '[]');
          } catch (e) {}
          
          if (favorites.includes(slug)) {
            favBtn.classList.add('active');
            favBtn.setAttribute('aria-label', 'Remove from favorites');
          }

          favBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            let favs = [];
            try {
              favs = JSON.parse(localStorage.getItem('favorite_tools') || '[]');
            } catch (err) {}

            if (favs.includes(slug)) {
              favs = favs.filter(s => s !== slug);
              favBtn.classList.remove('active');
              favBtn.setAttribute('aria-label', 'Add to favorites');
            } else {
              favs.push(slug);
              favBtn.classList.add('active');
              favBtn.setAttribute('aria-label', 'Remove from favorites');
            }
            localStorage.setItem('favorite_tools', JSON.stringify(favs));
          });
        }
      }
    } catch (err) {
      console.error('Error in Lowkeydevs tracking:', err);
    }
  </script>
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) 0;
    font-size: 14px;
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .breadcrumbs-container::-webkit-scrollbar {
    display: none;
  }

  .breadcrumb-link, .breadcrumb-current {
    white-space: nowrap;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: var(--text-tertiary);
    font-weight: 400;
  }

  /* Layout */
  .tool-main {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(16px, 4vw, 32px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Tool header */
  .tool-header {
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .category-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tool-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h1);
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: var(--ls-h1);
    line-height: var(--lh-h1);
  }

  .tool-description {
    color: var(--text-secondary);
    font-size: var(--fs-body-lg);
    font-weight: 400;
    max-width: 600px;
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  /* Tool workspace */
  .tool-workspace-wrapper {
    margin-top: var(--space-2);
  }

  /* Sidebar */
  .tool-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidebar-widget {
    padding: var(--space-5);
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h4);
    font-weight: 500;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
    line-height: var(--lh-h4);
    letter-spacing: var(--ls-h4);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .related-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .related-item:hover {
    background-color: var(--surface-hover);
    text-decoration: none;
  }

  .related-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .related-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    gap: var(--space-0-5);
  }

  .related-title {
    font-weight: 500;
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }

  .related-desc {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Privacy widget */
  .privacy-widget {
    border-color: var(--border);
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--success);
    margin-bottom: var(--space-3);
  }

  .privacy-header .privacy-widget-title {
    margin-bottom: 0;
    color: var(--success);
    font-weight: 500;
    font-size: var(--fs-sm);
  }

  .privacy-text {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-sm);
  }

  /* Educational content */
  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(16px, 4vw, 32px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }

  .edu-guide, .faq-accordion {
    padding: clamp(16px, 4vw, 24px);
  }

  .edu-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .edu-title:not(:first-child) {
    margin-top: var(--space-8);
  }

  .edu-para {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
    margin-bottom: var(--space-2);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .step-item {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  .pro-tips-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
  }

  .pro-tips-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pro-tips-list li {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    position: relative;
    padding-left: var(--space-5);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  .pro-tips-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* FAQ Accordion */
  .accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--bg);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: 500;
    font-size: var(--fs-sm);
    user-select: none;
    list-style: none;
    color: var(--text-primary);
    transition: background-color var(--duration-fast) var(--ease-out);
    line-height: var(--lh-sm);
  }

  .faq-question:hover {
    background-color: var(--surface-hover);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question .chevron {
    color: var(--text-tertiary);
    transition: transform var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .faq-answer p {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
    margin-top: var(--space-3);
  }

  .tool-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tool-favorite-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background-color: var(--surface);
    color: var(--text-tertiary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .tool-favorite-btn:hover {
    color: #FBBF24;
    border-color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.1);
    transform: scale(1.05);
  }

  .tool-favorite-btn.active {
    color: #FBBF24;
    border-color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.15);
  }

  .tool-favorite-btn.active :global(polygon) {
    fill: currentColor !important;
  }

  /* Interlinking related tools footer */
  .tool-interlinks-footer {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px dashed var(--border);
  }

  .interlinks-title {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .interlinks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .interlink-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .interlink-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .interlink-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(147, 51, 234, 0.1); /* Custom brand fallback color */
    color: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .interlink-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .interlink-name {
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--text-primary);
    line-height: var(--lh-sm);
  }

  .interlink-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

