---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/base/Icon.astro';
import SponsorCard from '../components/SponsorCard.astro';
import type { ToolRegistryEntry } from '../tools/registry';
import { registry, getCategoryDetail } from '../tools/registry';
import { useTranslations, type Language, getLocalizedPath } from '../utils/i18n';
import { getCollection } from 'astro:content';

interface Props {
  tool: ToolRegistryEntry;
  localizedMeta: {
    title: string;
    description: string;
    keywords: string[];
    faqs: { question: string; answer: string; }[];
    educationalContent: {
      whatIsIt: string;
      howToUse: string;
      proTips?: string[];
    };
  };
  lang: Language;
}

const { tool, localizedMeta, lang } = Astro.props;
const t = useTranslations(lang);

const categoryDetail = getCategoryDetail(tool.category);

// Load all tool translations from collections to render translated related tools
const allToolsEntries = await getCollection('tools');
const toolMap = new Map(allToolsEntries.map(entry => [entry.id, entry.data]));

// Find related tools (same category first, then fallback to any other tool from registry)
const relatedTools = registry
  .filter(t => t.slug !== tool.slug)
  .sort((a, b) => {
    if (a.category === tool.category && b.category !== tool.category) return -1;
    if (b.category === tool.category && a.category !== tool.category) return 1;
    return 0;
  })
  .slice(0, 3)
  .map(t => {
    const localizedData = toolMap.get(`${lang}/${t.slug}`) || toolMap.get(`en/${t.slug}`);
    return {
      ...t,
      title: localizedData?.title || t.slug,
      description: localizedData?.description || ''
    };
  });

// Generate SoftwareApplication JSON-LD schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": localizedMeta.title,
  "operatingSystem": "All",
  "applicationCategory": tool.category === 'security' ? 'SecurityApplication' : 'DeveloperApplication',
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": localizedMeta.description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Generate FAQPage JSON-LD schema
const faqSchema = localizedMeta.faqs && localizedMeta.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": localizedMeta.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout
  title={`${localizedMeta.title} - LowKeyDevs`}
  description={localizedMeta.description}
  lang={lang}
>
  <Header lang={lang} />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href={getLocalizedPath('/', lang)} class="breadcrumb-link">{t('nav.home')}</a>
      <span class="breadcrumb-sep" aria-hidden="true">
        <Icon name="ChevronRight" size={14} />
      </span>
      {categoryDetail && (
        <>
          <a href={getLocalizedPath(`/tools/category/${tool.category}`, lang)} class="breadcrumb-link">
            {t(categoryDetail.titleKey)}
          </a>
          <span class="breadcrumb-sep" aria-hidden="true">
            <Icon name="ChevronRight" size={14} />
          </span>
        </>
      )}
      <span class="breadcrumb-current" aria-current="page">{localizedMeta.title}</span>
    </div>
  </nav>

  <main id="main-content" class="tool-main container">
    <div class="tool-grid">
      <!-- Main tool workspace -->
      <section class="tool-section" aria-labelledby="tool-title-heading">
        <header class="tool-header">
          <span class="category-badge">
            <Icon name={categoryDetail?.icon || 'Info'} size={12} />
            <span>{categoryDetail ? t(categoryDetail.titleKey) : ''}</span>
          </span>
          <h1 id="tool-title-heading" class="tool-title">{localizedMeta.title}</h1>
          <p class="tool-description">{localizedMeta.description}</p>
        </header>

        <div class="tool-workspace-wrapper">
          <slot />
        </div>
      </section>

      <!-- Sidebar -->
      <aside class="tool-sidebar">
        <SponsorCard />

        <div class="sidebar-widget">
          <h2 class="widget-title">{t('tools.relatedTitle')}</h2>
          <div class="related-list">
            {relatedTools.map(t => (
              <a href={getLocalizedPath(`/tools/${t.slug}`, lang)} class="related-item">
                <div class="related-icon">
                  <Icon name={t.icon} size={14} />
                </div>
                <div class="related-info">
                  <span class="related-title">{t.title}</span>
                  <span class="related-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-widget privacy-widget">
          <div class="privacy-header">
            <Icon name="Lock" size={16} />
            <h2 class="widget-title privacy-widget-title">{t('tools.privacyTitle')}</h2>
          </div>
          <p class="privacy-text">
            {t('tools.privacyText')}
          </p>
        </div>
      </aside>
    </div>

    <!-- Educational & FAQ Section -->
    <section class="content-section" aria-label="How to use the tool">
      <div class="edu-grid">
        <!-- Educational Guide -->
        <article class="edu-guide">
          <h2 class="edu-title">{t('tools.whatIsIt')}</h2>
          <p class="edu-para">{localizedMeta.educationalContent.whatIsIt}</p>

          <h2 class="edu-title">{t('tools.howToUse')}</h2>
          <div class="steps-list">
            {localizedMeta.educationalContent.howToUse.split('\n').map(step => (
              <p class="step-item">{step}</p>
            ))}
          </div>

          {localizedMeta.educationalContent.proTips && localizedMeta.educationalContent.proTips.length > 0 && (
            <>
              <h2 class="edu-title pro-tips-title">
                <Icon name="Info" size={14} />
                {t('tools.proTips')}
              </h2>
              <ul class="pro-tips-list">
                {localizedMeta.educationalContent.proTips.map(tip => (
                  <li>{tip}</li>
                ))}
              </ul>
            </>
          )}
        </article>

        <!-- FAQs Accordion -->
        {localizedMeta.faqs && localizedMeta.faqs.length > 0 && (
          <div class="faq-accordion">
            <h2 class="edu-title">{t('tools.faqs')}</h2>
            <div class="accordion-wrapper">
              {localizedMeta.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <Icon name="ChevronDown" size={16} class="chevron" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <!-- Structured Schema-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) 0;
    font-size: 14px;
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .breadcrumbs-container::-webkit-scrollbar {
    display: none;
  }

  .breadcrumb-link, .breadcrumb-current {
    white-space: nowrap;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: var(--text-tertiary);
    font-weight: 400;
  }

  /* Layout */
  .tool-main {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(16px, 4vw, 32px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Tool header */
  .tool-header {
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .category-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tool-title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .tool-description {
    color: var(--text-secondary);
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 400;
    max-width: 600px;
    line-height: 1.7;
  }

  /* Tool workspace */
  .tool-workspace-wrapper {
    margin-top: var(--space-2);
  }

  /* Sidebar */
  .tool-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidebar-widget {
    padding: var(--space-5);
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .related-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .related-item:hover {
    background-color: var(--surface-hover);
    text-decoration: none;
  }

  .related-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .related-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    gap: var(--space-0-5);
  }

  .related-title {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-primary);
  }

  .related-desc {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Privacy widget */
  .privacy-widget {
    border-color: var(--border);
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--success);
    margin-bottom: var(--space-3);
  }

  .privacy-header .privacy-widget-title {
    margin-bottom: 0;
    color: var(--success);
    font-weight: 700;
    font-size: 14px;
  }

  .privacy-text {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Educational content */
  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(16px, 4vw, 32px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }

  .edu-guide, .faq-accordion {
    padding: clamp(16px, 4vw, 24px);
  }

  .edu-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .edu-title:not(:first-child) {
    margin-top: var(--space-8);
  }

  .edu-para {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: var(--space-2);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .step-item {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .pro-tips-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
  }

  .pro-tips-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pro-tips-list li {
    font-size: 15px;
    color: var(--text-secondary);
    position: relative;
    padding-left: var(--space-5);
    line-height: 1.7;
  }

  .pro-tips-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* FAQ Accordion */
  .accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--bg);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    user-select: none;
    list-style: none;
    color: var(--text-primary);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .faq-question:hover {
    background-color: var(--surface-hover);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question .chevron {
    color: var(--text-tertiary);
    transition: transform var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .faq-answer p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: var(--space-3);
  }
</style>
