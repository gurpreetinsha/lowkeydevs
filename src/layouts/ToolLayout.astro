---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/base/Icon.astro';
import SponsorCard from '../components/SponsorCard.astro';
import type { ToolMeta } from '../tools/definitions';
import { registry, getCategoryDetail } from '../tools/registry';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const categoryDetail = getCategoryDetail(tool.category);

// Find related tools (same category first, then fallback to any other tool from registry)
const relatedTools = registry
  .filter(t => t.slug !== tool.slug)
  .sort((a, b) => {
    if (a.category === tool.category && b.category !== tool.category) return -1;
    if (b.category === tool.category && a.category !== tool.category) return 1;
    return 0;
  })
  .slice(0, 3);

// Generate SoftwareApplication JSON-LD schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.title,
  "operatingSystem": "All",
  "applicationCategory": tool.category === 'security' ? 'SecurityApplication' : 'DeveloperApplication',
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": tool.description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Generate FAQPage JSON-LD schema
const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout 
  title={`${tool.title} - LowKeyDevs`} 
  description={tool.description}
>
  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href="/" class="breadcrumb-item">Home</a>
      <span class="separator">/</span>
      {categoryDetail && (
        <>
          <a href={`/tools/category/${tool.category}`} class="breadcrumb-item">
            {categoryDetail.title}
          </a>
          <span class="separator">/</span>
        </>
      )}
      <span class="breadcrumb-item active" aria-current="page">{tool.title}</span>
    </div>
  </nav>

  <main class="tool-main-layout container">
    <div class="tool-grid-container">
      <!-- Active Tool Workspace -->
      <section class="tool-section" aria-labelledby="tool-title-heading">
        <header class="tool-header-block">
          <span class="category-badge">
            <Icon name={categoryDetail?.icon || 'Info'} size={14} />
            {categoryDetail?.title}
          </span>
          <h1 id="tool-title-heading" class="tool-title">{tool.title}</h1>
          <p class="tool-description">{tool.description}</p>
        </header>

        <div class="tool-workspace-wrapper">
          <slot />
        </div>
      </section>

      <!-- Sidebar / Related Tools -->
      <aside class="tool-sidebar">
        <SponsorCard />

        <div class="sidebar-widget glass-panel">
          <h2 class="widget-title">Related Tools</h2>
          <div class="related-list">
            {relatedTools.map(t => (
              <a href={`/tools/${t.slug}`} class="related-item">
                <div class="related-icon">
                  <Icon name={t.icon} size={16} />
                </div>
                <div class="related-info">
                  <span class="related-title">{t.title}</span>
                  <span class="related-desc">{t.description}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-widget privacy-widget glass-panel">
          <div class="privacy-header">
            <Icon name="Lock" size={18} class="privacy-icon" />
            <h2 class="widget-title">100% Client-Side</h2>
          </div>
          <p class="privacy-text">
            All conversions and formatting happen strictly in your browser. We never save, upload, or transmit any of your text, JSON, or input data to servers.
          </p>
        </div>
      </aside>
    </div>

    <!-- Educational & FAQ Accordion Section -->
    <section class="content-section" aria-label="How to use the tool">
      <div class="edu-grid">
        <!-- Educational Guide -->
        <article class="edu-guide glass-panel">
          <h2 class="edu-title">What is this tool?</h2>
          <p class="edu-para">{tool.educationalContent.whatIsIt}</p>

          <h2 class="edu-title">How to use it</h2>
          <div class="steps-list">
            {tool.educationalContent.howToUse.split('\n').map(step => (
              <p class="step-item">{step}</p>
            ))}
          </div>

          {tool.educationalContent.proTips && (
            <>
              <h2 class="edu-title pro-tips-title">
                <Icon name="Info" size={16} />
                Pro Tips
              </h2>
              <ul class="pro-tips-list">
                {tool.educationalContent.proTips.map(tip => (
                  <li>{tip}</li>
                ))}
              </ul>
            </>
          )}
        </article>

        <!-- FAQs Accordion -->
        {tool.faqs && tool.faqs.length > 0 && (
          <div class="faq-accordion glass-panel">
            <h2 class="edu-title">Frequently Asked Questions</h2>
            <div class="accordion-wrapper">
              {tool.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <Icon name="ChevronDown" size={18} class="chevron" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Inject Structured Schema-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
    font-size: 0.85rem;
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .breadcrumb-item:hover {
    color: var(--primary-orange);
  }

  .breadcrumb-item.active {
    color: var(--text-muted);
    pointer-events: none;
  }

  .separator {
    color: var(--border-color);
    user-select: none;
  }

  /* Layout Structure */
  .tool-main-layout {
    padding-top: 2rem;
    padding-bottom: 4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .tool-grid-container {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tool-grid-container {
      grid-template-columns: 1fr;
    }
  }

  /* Header details */
  .tool-header-block {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: rgba(255, 100, 45, 0.08);
    color: var(--primary-orange);
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-sans);
  }

  .tool-title {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .tool-description {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 800px;
  }

  /* Tool Workspace Frame */
  .tool-workspace-wrapper {
    margin-top: 1rem;
  }

  /* Sidebar */
  .tool-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-widget {
    padding: 1.25rem;
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }

  .related-item:hover {
    background-color: var(--bg-color);
  }

  .related-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background-color: var(--bg-color);
    color: var(--text-secondary);
    border-radius: 6px;
    flex-shrink: 0;
  }

  .related-item:hover .related-icon {
    color: var(--primary-orange);
  }

  .related-info {
    display: flex;
    flex-direction: column;
  }

  .related-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .related-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .privacy-widget {
    border-color: hsla(142, 70%, 45%, 0.2);
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success-color);
    margin-bottom: 0.5rem;
  }

  .privacy-header .widget-title {
    margin-bottom: 0;
    color: var(--success-color);
  }

  .privacy-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Educational Content & FAQs */
  .edu-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }

  .edu-guide, .faq-accordion {
    padding: 1.75rem;
  }

  .edu-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .edu-title:not(:first-child) {
    margin-top: 1.5rem;
  }

  .edu-para {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .step-item {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .pro-tips-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary-orange);
  }

  .pro-tips-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pro-tips-list li {
    font-size: 0.95rem;
    color: var(--text-secondary);
    position: relative;
    padding-left: 1.25rem;
  }

  .pro-tips-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--primary-orange);
  }

  /* Accordion styling */
  .accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .faq-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-input);
    background-color: var(--secondary-bg);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--primary-orange);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    user-select: none;
    list-style: none; /* Hide default triangle */
  }

  .faq-question::-webkit-details-marker {
    display: none; /* Hide default triangle in Safari */
  }

  .faq-question .chevron {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-question .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1rem 1rem 1rem;
    border-top: 1px solid var(--border-color);
    background-color: #FFFFFF;
  }

  .faq-answer p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-top: 0.75rem;
  }
</style>
