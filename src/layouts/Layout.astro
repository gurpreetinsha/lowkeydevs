---
import '../styles/index.css';
import { getAlternateUrl, SUPPORTED_LANGUAGES, localeDictionaries, type Language } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  lang?: Language;
}

const {
  title = 'LowKeyDevs - Fast, Private Online Tools',
  description = 'The internet\'s default toolbox. Free, client-side, privacy-respecting online developer tools and utilities with zero registration required.',
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
  lang = 'en' as Language
} = Astro.props;

const dict = localeDictionaries[lang] || localeDictionaries['en'];
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multilingual SEO Alternate links -->
    <link rel="alternate" hreflang="x-default" href={getAlternateUrl(canonicalUrl, 'en', lang)} />
    {SUPPORTED_LANGUAGES.map(targetLang => (
      <link rel="alternate" hreflang={targetLang} href={getAlternateUrl(canonicalUrl, targetLang, lang)} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url).href} />

    <!-- Google Fonts Preconnect and Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;1,14..32,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme detection (runs before paint to prevent flash) -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('lowkeydevs-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        } else {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        }
      })();
    </script>

    <!-- Language persistence and initialization -->
    <script is:inline define:vars={{ lang }}>
      localStorage.setItem('lowkeydevs-lang', lang);
      document.documentElement.setAttribute('lang', lang);
      if (lang === 'ar') {
        document.documentElement.setAttribute('dir', 'rtl');
      } else {
        document.documentElement.setAttribute('dir', 'ltr');
      }
    </script>

    <!-- Client-Side Translation Helper -->
    <script is:inline define:vars={{ lang, dict }}>
      window.__i18n = {
        currentLang: lang,
        translations: dict,
        t(key, params) {
          let value = dict[key] || key;
          if (params) {
            Object.entries(params).forEach(([k, v]) => {
              value = value.replace(new RegExp(`{${k}}`, 'g'), v);
            });
          }
          return value;
        }
      };
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
