---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { registry } from '../../../tools/registry';
import { SUPPORTED_LANGUAGES, type Language } from '../../../utils/i18n';
import { getEntry, getCollection } from 'astro:content';

// Import all tool UI components dynamically for maximum scalability
const uiModules = import.meta.glob('../../../tools/list/*/ui.astro');

export async function getStaticPaths() {
  const paths = [];
  for (const lang of SUPPORTED_LANGUAGES) {
    for (const tool of registry) {
      paths.push({
        params: { lang, slug: tool.slug },
        props: { tool }
      });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const { tool } = Astro.props;

// Get all entries to safely check if the localized translation file exists, preventing console warnings on fallback
const allToolsEntries = await getCollection('tools');
const entryId = `${lang}/${tool.slug}`;
const hasLocalizedEntry = allToolsEntries.some(e => e.id === entryId);

let entry = null;
if (hasLocalizedEntry) {
  entry = await getEntry('tools', entryId as any);
} else {
  entry = await getEntry('tools', `en/${tool.slug}`);
}

const localizedMeta = entry ? entry.data : {
  title: tool.slug,
  description: '',
  keywords: [],
  faqs: [],
  educationalContent: { whatIsIt: '', howToUse: '' }
};

// Find the corresponding UI component dynamically
const matchKey = Object.keys(uiModules).find(key => key.endsWith(`/list/${tool.slug}/ui.astro`));
const ActiveToolUI = matchKey ? (await uiModules[matchKey]() as any).default : null;
---

{ActiveToolUI ? (
  <ToolLayout tool={tool} localizedMeta={localizedMeta} lang={lang}>
    <ActiveToolUI lang={lang} />
  </ToolLayout>
) : (
  <div style="padding: 2rem; text-align: center;">Tool workspace not found.</div>
)}
