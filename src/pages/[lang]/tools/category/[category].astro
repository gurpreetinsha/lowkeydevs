---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import ToolCard from '../../../../components/ToolCard.astro';
import Icon from '../../../../components/base/Icon.astro';
import { categories, getToolsByCategory } from '../../../../tools/registry';
import { useTranslations, SUPPORTED_LANGUAGES, type Language, getLocalizedPath } from '../../../../utils/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of SUPPORTED_LANGUAGES) {
    for (const cat of categories) {
      paths.push({
        params: { lang, category: cat.slug },
        props: { category: cat }
      });
    }
  }
  return paths;
}

const { lang, category: catParam } = Astro.params as { lang: Language; category: string };
const { category } = Astro.props;
const t = useTranslations(lang);

// Get localized metadata for tools in this category from content collections
const allToolsEntries = await getCollection('tools');
const toolMap = new Map(allToolsEntries.map(entry => [entry.id, entry.data]));

const tools = getToolsByCategory(category.slug).map(tool => {
  const localizedData = toolMap.get(`${lang}/${tool.slug}`) || toolMap.get(`en/${tool.slug}`);
  return {
    ...tool,
    title: localizedData?.title || tool.slug,
    description: localizedData?.description || ''
  };
});
---

<Layout
  title={`${t('categories.all')} - ${t(category.titleKey)}`}
  description={t(category.descriptionKey)}
  lang={lang}
>
  <Header lang={lang} />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
    <div class="container breadcrumbs-container">
      <a href={getLocalizedPath('/', lang)} class="breadcrumb-link">{t('nav.home')}</a>
      <span class="breadcrumb-sep" aria-hidden="true">
        <Icon name="ChevronRight" size={14} />
      </span>
      <span class="breadcrumb-current" aria-current="page">{t(category.titleKey)}</span>
    </div>
  </nav>

  <main id="main-content" class="category-main container">
    <header class="category-header max-w-narrow">
      <div class="category-icon-title">
        <div class="category-icon-wrapper">
          <Icon name={category.icon} size={24} />
        </div>
        <h1 class="category-title">{t(category.titleKey)}</h1>
      </div>
      <p class="category-description">{t(category.descriptionKey)}</p>
    </header>

    <section class="category-tools" aria-label={`Tools in ${t(category.titleKey)}`}>
      {tools.length > 0 ? (
        <div class="tools-grid">
          {tools.map(tool => (
            <ToolCard tool={tool} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon-wrapper">
            <Icon name="Info" size={24} />
          </div>
          <h3>{t('home.emptyState')}</h3>
          <a href={getLocalizedPath('/', lang)} class="btn btn-primary">{t('privacy.returnBtn')}</a>
        </div>
      )}
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumbs-nav {
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) 0;
    font-size: 14px;
  }

  .breadcrumbs-container {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: var(--text-tertiary);
    font-weight: 400;
  }

  /* Main layout */
  .category-main {
    padding-top: var(--space-10);
    padding-bottom: var(--space-20);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .category-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .category-icon-title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .category-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .category-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .category-description {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.7;
  }

  /* Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--space-5);
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-16) var(--space-8);
    gap: var(--space-5);
    max-width: 460px;
    margin: 0 auto;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .empty-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-md);
  }

  .empty-state h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
