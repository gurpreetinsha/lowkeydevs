---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { registry } from '../../tools/registry';

// Import all tool UI components statically
import JSONFormatterUI from '../../tools/list/json-formatter/ui.astro';
import PasswordGeneratorUI from '../../tools/list/password-generator/ui.astro';
import Base64ConverterUI from '../../tools/list/base64-converter/ui.astro';
import CharacterRemoverUI from '../../tools/list/character-remover/ui.astro';
import DuplicateWordFinderUI from '../../tools/list/duplicate-word-finder/ui.astro';
import BinaryCodeTranslatorUI from '../../tools/list/binary-code-translator/ui.astro';
import HexToTextConverterUI from '../../tools/list/hex-to-text-converter/ui.astro';
import HTMLToMarkdownConverterUI from '../../tools/list/html-to-markdown-converter/ui.astro';
import GraphQLFormatterUI from '../../tools/list/graphql-formatter/ui.astro';
import CSSFormatterUI from '../../tools/list/css-formatter/ui.astro';
import JSONStringifyTextUI from '../../tools/list/json-stringify-text/ui.astro';
import JSONUnstringifierUI from '../../tools/list/json-unstringifier/ui.astro';
import UnicodeToTextConverterUI from '../../tools/list/unicode-to-text-converter/ui.astro';
import PlainTextConverterUI from '../../tools/list/plain-text-converter/ui.astro';
import OnlineNotepadUI from '../../tools/list/online-notepad/ui.astro';
import UUIDGeneratorUI from '../../tools/list/uuid-generator/ui.astro';
import CaseConverterUI from '../../tools/list/case-converter/ui.astro';
import URLEncoderDecoderUI from '../../tools/list/url-encoder-decoder/ui.astro';
import EpochConverterUI from '../../tools/list/epoch-converter/ui.astro';
import HashGeneratorUI from '../../tools/list/hash-generator/ui.astro';

// Map slugs to UI components
const uiComponents: Record<string, any> = {
  'json-formatter': JSONFormatterUI,
  'password-generator': PasswordGeneratorUI,
  'base64-converter': Base64ConverterUI,
  'character-remover': CharacterRemoverUI,
  'duplicate-word-finder': DuplicateWordFinderUI,
  'binary-code-translator': BinaryCodeTranslatorUI,
  'hex-to-text-converter': HexToTextConverterUI,
  'html-to-markdown-converter': HTMLToMarkdownConverterUI,
  'graphql-formatter': GraphQLFormatterUI,
  'css-formatter': CSSFormatterUI,
  'json-stringify-text': JSONStringifyTextUI,
  'json-unstringifier': JSONUnstringifierUI,
  'unicode-to-text-converter': UnicodeToTextConverterUI,
  'plain-text-converter': PlainTextConverterUI,
  'online-notepad': OnlineNotepadUI,
  'uuid-generator': UUIDGeneratorUI,
  'case-converter': CaseConverterUI,
  'url-encoder-decoder': URLEncoderDecoderUI,
  'epoch-converter': EpochConverterUI,
  'hash-generator': HashGeneratorUI
};

export async function getStaticPaths() {
  return registry.map(tool => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

const { tool } = Astro.props;
const ActiveToolUI = uiComponents[tool.slug];
---

{ActiveToolUI ? (
  <ToolLayout tool={tool}>
    <ActiveToolUI />
  </ToolLayout>
) : (
  <div>Tool workspace not found.</div>
)}
