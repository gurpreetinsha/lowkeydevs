export async function getStaticPaths() {
  return registry.map(tool => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

const { slug } = Astro.params;
const { tool: propsTool } = Astro.props;
const tool = propsTool || registry.find(t => t.slug === slug);
const ActiveToolUI = tool ? uiComponents[tool.slug] : null;
---

{ActiveToolUI && tool ? (
  <ToolLayout tool={tool}>
    <ActiveToolUI />
  </ToolLayout>
) : (
  <div>Tool workspace not found.</div>
)}
