---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import Icon from '../components/base/Icon.astro';
import { registry, categories } from '../tools/registry';

// Slice registry to show a maximum of 20 tools on the landing page
const featuredTools = registry.slice(0, 20);

// Filter active categories based on the 20 featured tools
const activeCategories = categories.filter(cat => 
  featuredTools.some(tool => tool.category === cat.slug)
);
---

<Layout 
  title="LowKeyDevs - Fast, Ad-Free & Private Developer Tools"
  description="The cleanest and fastest utility toolbox. Over a dozen web tools for formatting JSON, generating passwords, converting Base64. 100% private, runs entirely client-side."
>
  <Header />

  <main class="home-main">
    <!-- Hero Banner Section -->
    <section class="hero-section container" aria-labelledby="hero-title">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="Lock" size={12} />
          100% Client-Side Privacy
        </div>
        <h1 id="hero-title" class="hero-title">
          The Internet's Default <span class="coral-text">Toolbox</span>
        </h1>
        <p class="hero-subtitle">
          Instant, beautiful developer tools that run entirely in your browser. No forced logins, no intrusive popups, and no tracking.
        </p>

        <!-- Search trigger -->
        <button class="hero-search-trigger" id="hero-search-trigger">
          <Icon name="Search" size={16} />
          <span>Search tools (type '/' anywhere)...</span>
          <kbd class="kbd-helper">/</kbd>
        </button>
      </div>
    </section>

    <!-- Categories Filter & Tools List Section -->
    <section class="tools-directory container" aria-label="Tools Directory">
      <div class="directory-header">
        <h2 class="section-title">All Utilities</h2>
        
        <!-- Category Filter Tabs (Coral Chips) -->
        <div class="category-tabs" role="tablist" aria-label="Tool Categories">
          <button 
            class="tab-btn active" 
            role="tab" 
            aria-selected="true" 
            data-category="all"
            id="tab-all"
          >
            All Tools
          </button>
          {activeCategories.map(cat => (
            <button 
              class="tab-btn" 
              role="tab" 
              aria-selected="false" 
              data-category={cat.slug}
              id={`tab-${cat.slug}`}
            >
              <Icon name={cat.icon} size={14} />
              {cat.title}
            </button>
          ))}
        </div>
      </div>

      <!-- Tools Grid -->
      <div class="tools-grid" id="tools-grid">
        {featuredTools.map(tool => (
          <div class="tool-card-container" data-tool-category={tool.category}>
            <ToolCard tool={tool} />
          </div>
        ))}
        <!-- Premium Sponsor Showcase (Ad) directly in grid -->
        <div class="tool-card-container" data-tool-category="all">
          <SponsorCard />
        </div>
      </div>
      
      <!-- Empty state -->
      <div class="filtered-empty" id="filtered-empty" hidden>
        No tools found in this category.
      </div>
    </section>

    <!-- Why Us (Key Highlights - Styled as Quiet Editorial strip) -->
    <section class="features-section container" aria-labelledby="features-title">
      <h2 id="features-title" class="features-title-header text-center">Built for Speed and Security</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="Lock" size={24} />
          </div>
          <h3>Zero Server Logs</h3>
          <p>
            Your data never touches our servers. All calculations, parsing, and formatting happen locally in your browser.
          </p>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="RefreshCw" size={24} />
          </div>
          <h3>Lightning Fast</h3>
          <p>
            Statically pre-rendered pages load in milliseconds. Standard actions parse and update instantly as you type.
          </p>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="Braces" size={24} />
          </div>
          <h3>Minimal & Clean</h3>
          <p>
            No annoying popups, cookie walls, or bloated advertisements. Just the tools you need, ready when you are.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main {
    padding-top: 60px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 24px;
    position: relative;
    overflow: hidden;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--color-neutral-surface);
    color: var(--color-primary-dark);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 24px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1.0;
    margin-bottom: 16px;
    letter-spacing: -0.04em;
    color: var(--color-primary-dark);
  }

  .coral-text {
    color: var(--color-highlight-coral);
  }

  .hero-subtitle {
    color: var(--color-body-muted);
    font-size: 18px;
    max-width: 650px;
    line-height: 1.5;
    margin-bottom: 32px;
  }

  /* Trigger input styled button */
  .hero-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 440px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-muted);
    border-radius: var(--radius-xs);
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .hero-search-trigger:hover {
    border-color: var(--color-form-focus);
    color: var(--color-slate);
    box-shadow: var(--form-focus-ring);
  }

  .kbd-helper {
    background-color: var(--color-neutral-surface);
    border: 1px solid var(--color-hairline);
    color: var(--color-muted);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
  }

  /* Tools Directory list */
  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: 16px;
  }

  .section-title {
    font-size: 24px;
    font-weight: 500;
    color: var(--color-primary-dark);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .text-center {
    text-align: center;
  }

  .category-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
  }

  /* Category Coral Chips Styling */
  .tab-btn {
    border: 1px solid var(--color-highlight-coral-soft);
    background-color: var(--color-canvas);
    color: var(--color-highlight-coral);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    transition: all 200ms ease;
  }

  .tab-btn:hover {
    border-color: var(--color-highlight-coral);
    background-color: var(--color-neutral-surface);
    color: var(--color-primary-dark);
  }

  .tab-btn.active {
    background: var(--color-highlight-coral);
    color: var(--color-primary-dark);
    border-color: var(--color-highlight-coral);
  }

  /* Cards Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .filtered-empty {
    padding: 48px;
    text-align: center;
    color: var(--color-muted);
    font-size: 14px;
    border: 1px dashed var(--color-hairline);
    border-radius: var(--radius-sm);
  }

  /* Highlights Section - Styled Cleanly & Quietly */
  .features-title-header {
    font-size: 28px;
    font-weight: 500;
    font-family: var(--font-display);
    margin-bottom: 48px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0;
    gap: 16px;
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-primary-dark);
    margin-bottom: 8px;
  }

  .feature-item h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    color: var(--color-primary-dark);
  }

  .feature-item p {
    font-size: 14px;
    color: var(--color-body-muted);
    line-height: 1.5;
    max-width: 280px;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-content {
      padding: 48px 12px;
    }
  }
</style>

<script>
  // Hero search trigger focuses the header search input
  const heroSearchTrigger = document.getElementById('hero-search-trigger');
  const headerSearchInput = document.getElementById('search-input');

  if (heroSearchTrigger && headerSearchInput) {
    heroSearchTrigger.addEventListener('click', () => {
      headerSearchInput.focus();
    });
  }

  // Client-side category filtering
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.tool-card-container');
  const emptyState = document.getElementById('filtered-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });

      // Set active
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      cards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const toolCategory = htmlCard.getAttribute('data-tool-category');

        if (selectedCategory === 'all' || toolCategory === selectedCategory) {
          htmlCard.style.display = 'block';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', 'true');
        }
      }
    });
  });
</script>
