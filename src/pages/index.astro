---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import Icon from '../components/base/Icon.astro';
import { registry, categories } from '../tools/registry';

// Slice registry to show a maximum of 20 tools on the landing page
const featuredTools = registry.slice(0, 20);

// Filter active categories based on the 20 featured tools
const activeCategories = categories.filter(cat => 
  featuredTools.some(tool => tool.category === cat.slug)
);
---

<Layout 
  title="LowKeyDevs - Fast, ad-free & private developer tools"
  description="The cleanest and fastest utility toolbox. Over a dozen web tools for formatting JSON, generating passwords, converting Base64. 100% private, runs entirely client-side."
>
  <Header />

  <main class="home-main">
    <!-- Hero Banner Section -->
    <section class="hero-section container" aria-labelledby="hero-title">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="Lock" size={12} />
          100% client-side privacy
        </div>
        <h1 id="hero-title" class="hero-title">
          The internet's default <span class="coral-text">toolbox</span>
        </h1>
        <p class="hero-subtitle">
          Instant, beautiful developer tools that run entirely in your browser. No forced logins, no intrusive popups, and no tracking.
        </p>

        <!-- Search trigger -->
        <button class="hero-search-trigger" id="hero-search-trigger">
          <Icon name="Search" size={16} />
          <span>Search tools (type '/' anywhere)...</span>
          <kbd class="kbd-helper">/</kbd>
        </button>
      </div>
    </section>

    <!-- Categories Filter & Tools List Section -->
    <section class="tools-directory container" aria-label="Tools Directory">
      <div class="directory-header">
        <h2 class="section-title">All utilities</h2>
        
        <!-- Category Filter Tabs -->
        <div class="category-tabs" role="tablist" aria-label="Tool Categories">
          <button 
            class="tab-btn active" 
            role="tab" 
            aria-selected="true" 
            data-category="all"
            id="tab-all"
          >
            All tools
          </button>
          {activeCategories.map(cat => (
            <button 
              class="tab-btn" 
              role="tab" 
              aria-selected="false" 
              data-category={cat.slug}
              id={`tab-${cat.slug}`}
            >
              <Icon name={cat.icon} size={14} />
              {cat.title}
            </button>
          ))}
        </div>
      </div>

      <!-- Tools Grid -->
      <div class="tools-grid" id="tools-grid">
        {featuredTools.map(tool => (
          <div class="tool-card-container" data-tool-category={tool.category}>
            <ToolCard tool={tool} />
          </div>
        ))}
        <!-- Premium Sponsor Showcase (Ad) directly in grid -->
        <div class="tool-card-container" data-tool-category="all">
          <SponsorCard />
        </div>
      </div>
      
      <!-- Empty state -->
      <div class="filtered-empty" id="filtered-empty" hidden>
        No tools found in this category.
      </div>
    </section>

    <!-- Why Us (Key Highlights - Styled as Quiet Editorial strip) -->
    <section class="features-section container" aria-labelledby="features-title">
      <h2 id="features-title" class="features-title-header text-center">Built for speed and security</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="Lock" size={24} />
          </div>
          <h3>Zero server logs</h3>
          <p>
            Your data never touches our servers. All calculations, parsing, and formatting happen locally in your browser.
          </p>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="RefreshCw" size={24} />
          </div>
          <h3>Lightning fast</h3>
          <p>
            Statically pre-rendered pages load in milliseconds. Standard actions parse and update instantly as you type.
          </p>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon-wrapper">
            <Icon name="Braces" size={24} />
          </div>
          <h3>Minimal & clean</h3>
          <p>
            No annoying popups, cookie walls, or bloated advertisements. Just the tools you need, ready when you are.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main {
    padding-top: var(--ds-space-600);
    padding-bottom: var(--ds-space-1000);
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-1000);
  }

  /* Hero Section */
  .hero-section {
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--ds-space-800) var(--ds-space-300);
    position: relative;
    overflow: hidden;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-075);
    background-color: rgba(0, 113, 227, 0.08);
    color: var(--ds-text-selected);
    border: 1px solid rgba(0, 113, 227, 0.15);
    padding: var(--ds-space-075) var(--ds-space-150);
    border-radius: var(--ds-radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: var(--ds-space-300);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  html[data-theme="dark"] .hero-badge {
    background-color: rgba(41, 151, 255, 0.12);
    border-color: rgba(41, 151, 255, 0.25);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--ds-space-200);
    letter-spacing: -0.04em;
    color: var(--ds-text);
  }

  .coral-text {
    color: var(--ds-text-selected);
  }

  .hero-subtitle {
    color: var(--ds-text-subtle);
    font-size: 1.125rem;
    max-width: 650px;
    line-height: 1.6;
    margin-bottom: var(--ds-space-400);
  }

  /* Trigger input styled button */
  .hero-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 440px;
    background-color: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--ds-text-subtlest);
    border-radius: var(--ds-radius-medium);
    padding: var(--ds-space-150) var(--ds-space-200);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.2s ease;
  }

  .hero-search-trigger:hover {
    border-color: var(--glass-border-hover);
    background-color: var(--glass-bg-hover);
    color: var(--ds-text-subtle);
    box-shadow: var(--glass-shadow-hover);
    transform: translateY(-1px);
  }

  .kbd-helper {
    background-color: var(--ds-background-neutral);
    border: 1px solid var(--ds-border);
    color: var(--ds-text-subtlest);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
  }

  /* Tools Directory list */
  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-300);
    margin-bottom: var(--ds-space-400);
    border-bottom: 1px solid var(--ds-border);
    padding-bottom: var(--ds-space-200);
  }

  .section-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--ds-text);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .text-center {
    text-align: center;
  }

  .category-tabs {
    display: flex;
    gap: var(--ds-space-100);
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
  }

  /* Category Tabs Styling */
  .tab-btn {
    border: none;
    background: transparent;
    color: var(--ds-text-subtle);
    padding: var(--ds-space-100) var(--ds-space-150);
    border-bottom: 2px solid transparent;
    border-radius: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-100);
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--ds-text);
    border-bottom-color: var(--ds-border-bold);
  }

  .tab-btn.active {
    color: var(--ds-text-selected);
    border-bottom-color: var(--ds-border-selected);
  }

  /* Cards Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--ds-space-300);
  }

  .filtered-empty {
    padding: var(--ds-space-600);
    text-align: center;
    color: var(--ds-text-subtlest);
    font-size: 0.875rem;
    border: var(--ds-border-width-default) dashed var(--ds-border-bold);
    border-radius: var(--ds-radius-large);
  }

  /* Highlights Section */
  .features-title-header {
    font-size: 1.85rem;
    font-weight: 800;
    font-family: var(--font-display);
    margin-bottom: var(--ds-space-600);
    color: var(--ds-text);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ds-space-600);
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: var(--ds-space-400);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--ds-space-300);
    gap: var(--ds-space-200);
    background-color: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--ds-radius-large);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--ds-text-selected);
    margin-bottom: var(--ds-space-100);
  }

  .feature-item h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ds-text);
  }

  .feature-item p {
    font-size: 0.875rem;
    color: var(--ds-text-subtle);
    line-height: 1.6;
    max-width: 280px;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.25rem;
    }
    
    .hero-content {
      padding: var(--ds-space-600) var(--ds-space-150);
    }
  }
</style>

<script>
  // Hero search trigger focuses the header search input
  const heroSearchTrigger = document.getElementById('hero-search-trigger');
  const headerSearchInput = document.getElementById('search-input');

  if (heroSearchTrigger && headerSearchInput) {
    heroSearchTrigger.addEventListener('click', () => {
      headerSearchInput.focus();
    });
  }

  // Client-side category filtering
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.tool-card-container');
  const emptyState = document.getElementById('filtered-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });

      // Set active
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      cards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const toolCategory = htmlCard.getAttribute('data-tool-category');

        if (selectedCategory === 'all' || toolCategory === selectedCategory) {
          htmlCard.style.display = 'block';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', 'true');
        }
      }
    });
  });
</script>
