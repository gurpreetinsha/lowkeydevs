---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/base/Icon.astro';
import { registry, categories } from '../tools/registry';

// Filter categories that actually have tools registered to keep lists clean
const activeCategories = categories.filter(cat => 
  registry.some(tool => tool.category === cat.slug)
);
---

<Layout 
  title="LowKeyDevs - Fast, Ad-Free & Private Developer Tools"
  description="The cleanest and fastest utility toolbox. Over a dozen web tools for formatting JSON, generating passwords, converting Base64. 100% private, runs entirely client-side."
>
  <Header />

  <main class="home-main">
    <!-- Hero Banner Section -->
    <section class="hero-section container" aria-labelledby="hero-title">
      <div class="hero-content glass-panel">
        <div class="hero-badge">
          <Icon name="Lock" size={14} />
          100% Private & Client-Side
        </div>
        <h1 id="hero-title" class="hero-title">
          The Internet's Default <span class="gradient-text">Toolbox</span>
        </h1>
        <p class="hero-subtitle">
          Instant, beautiful developer tools that run entirely in your browser. No forced logins, no intrusive popups, and no tracking. Save your time.
        </p>

        <!-- natural language search bar (focuses header search on click) -->
        <button class="hero-search-trigger" id="hero-search-trigger">
          <Icon name="Search" size={18} />
          <span>Search tools (type '/' anywhere)...</span>
          <kbd class="kbd-helper">/</kbd>
        </button>
      </div>
    </section>

    <!-- Categories Filter & Tools List Section -->
    <section class="tools-directory container" aria-label="Tools Directory">
      <div class="directory-header">
        <h2 class="section-title">All Utilities</h2>
        
        <!-- Category Filter Tabs -->
        <div class="category-tabs" role="tablist" aria-label="Tool Categories">
          <button 
            class="tab-btn active" 
            role="tab" 
            aria-selected="true" 
            data-category="all"
            id="tab-all"
          >
            All Tools
          </button>
          {activeCategories.map(cat => (
            <button 
              class="tab-btn" 
              role="tab" 
              aria-selected="false" 
              data-category={cat.slug}
              id={`tab-${cat.slug}`}
            >
              <Icon name={cat.icon} size={14} />
              {cat.title}
            </button>
          ))}
        </div>
      </div>

      <!-- Tools Grid -->
      <div class="tools-grid" id="tools-grid">
        {registry.map(tool => (
          <div class="tool-card-container" data-tool-category={tool.category}>
            <ToolCard tool={tool} />
          </div>
        ))}
      </div>
      
      <!-- Empty state when filtered and none matches (just in case) -->
      <div class="filtered-empty" id="filtered-empty" hidden>
        No tools found in this category.
      </div>
    </section>

    <!-- Why Us (Key Highlights) -->
    <section class="features-section container" aria-labelledby="features-title">
      <h2 id="features-title" class="section-title text-center">Built for Speed and Security</h2>
      <div class="features-grid">
        <div class="feature-item glass-panel">
          <div class="feature-icon-wrapper secondary">
            <Icon name="Lock" size={20} />
          </div>
          <h3>Zero Server Logs</h3>
          <p>
            Your data never touches our servers. All calculations, parsing, and formatting happen locally in your browser.
          </p>
        </div>
        
        <div class="feature-item glass-panel">
          <div class="feature-icon-wrapper primary">
            <Icon name="RefreshCw" size={20} />
          </div>
          <h3>Lightning Fast</h3>
          <p>
            Statically pre-rendered pages load in milliseconds. Standard actions parse and update instantly as you type.
          </p>
        </div>
        
        <div class="feature-item glass-panel">
          <div class="feature-icon-wrapper accent">
            <Icon name="Braces" size={20} />
          </div>
          <h3>Minimal & Clean</h3>
          <p>
            No annoying popups, cookie walls, or bloated advertisements. Just the tools you need, ready when you are.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main {
    padding-top: 3rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    position: relative;
    overflow: hidden;
  }

  /* Soft background accent glows for visual wow factor */
  .hero-content::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -20%;
    width: 60%;
    height: 140%;
    background: radial-gradient(circle, var(--primary-glow) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
  }

  .hero-content::after {
    content: "";
    position: absolute;
    bottom: -50%;
    right: -20%;
    width: 60%;
    height: 140%;
    background: radial-gradient(circle, var(--secondary-glow) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: var(--border-color);
    border: 1px solid var(--border-hover);
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.035em;
  }

  .gradient-text {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    max-width: 650px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Trigger input styled button */
  .hero-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 460px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    border-radius: var(--radius-md);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .hero-search-trigger:hover {
    border-color: var(--primary-accent);
    color: var(--text-secondary);
    box-shadow: var(--shadow-glow);
  }

  .kbd-helper {
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  /* Tools Directory list */
  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 600;
  }

  .text-center {
    text-align: center;
  }

  .category-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
  }

  .tab-btn {
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tab-btn.active {
    background: var(--primary-gradient);
    color: white;
    border-color: transparent;
    box-shadow: var(--shadow-sm);
  }

  /* Cards Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .filtered-empty {
    padding: 3rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 1rem;
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-lg);
  }

  /* Highlights Section */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.25rem 1.5rem;
    gap: 1rem;
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
  }

  .feature-icon-wrapper.primary {
    background-color: var(--primary-glow);
    color: var(--primary-accent);
  }

  .feature-icon-wrapper.secondary {
    background-color: hsla(142, 70%, 45%, 0.1);
    color: var(--success-color);
  }

  .feature-icon-wrapper.accent {
    background-color: var(--secondary-glow);
    color: var(--secondary-accent);
  }

  .feature-item h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .feature-item p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-content {
      padding: 3rem 1.25rem;
    }
  }
</style>

<script>
  // Hero search trigger focuses the header search input
  const heroSearchTrigger = document.getElementById('hero-search-trigger');
  const headerSearchInput = document.getElementById('search-input');

  if (heroSearchTrigger && headerSearchInput) {
    heroSearchTrigger.addEventListener('click', () => {
      headerSearchInput.focus();
    });
  }

  // Client-side category filtering
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.tool-card-container');
  const emptyState = document.getElementById('filtered-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });

      // Set active
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      cards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const toolCategory = htmlCard.getAttribute('data-tool-category');

        if (selectedCategory === 'all' || toolCategory === selectedCategory) {
          htmlCard.style.display = 'block';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', 'true');
        }
      }
    });
  });
</script>
