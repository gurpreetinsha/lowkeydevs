---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import Icon from '../components/base/Icon.astro';
import { registry, categories } from '../tools/registry';

// Show all tools in the registry on the landing page
const featuredTools = registry;

// Filter active categories based on the featured tools
const activeCategories = categories.filter(cat =>
  featuredTools.some(tool => tool.category === cat.slug)
);
---

<Layout
  title="LowKeyDevs - Fast, ad-free & private developer tools"
  description="The cleanest and fastest utility toolbox. Over a dozen web tools for formatting JSON, generating passwords, converting Base64. 100% private, runs entirely client-side."
>
  <Header />

  <main id="main-content" class="home-main">
    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <Icon name="Lock" size={12} />
            100% client-side privacy
          </div>
          <h1 id="hero-title" class="hero-title">
            The internet's default <span class="accent-text">toolbox</span>
          </h1>
          <p class="hero-subtitle">
            Instant, beautiful developer tools that run entirely in your browser. No forced logins, no intrusive popups, and no tracking.
          </p>

          <!-- Search trigger -->
          <button class="hero-search-trigger" id="hero-search-trigger" aria-label="Search tools">
            <Icon name="Search" size={16} />
            <span>Search tools...</span>
            <kbd class="kbd-helper">/</kbd>
          </button>
        </div>
      </div>
    </section>

    <!-- Tools Directory -->
    <section class="tools-directory" aria-label="Tools Directory">
      <div class="container">
        <div class="directory-header">
          <h2 class="section-title">All utilities</h2>

          <!-- Category Filter Tabs -->
          <div class="category-tabs" role="tablist" aria-label="Tool Categories">
            <button
              class="tab-btn active"
              role="tab"
              aria-selected="true"
              data-category="all"
              id="tab-all"
            >
              All tools
            </button>
            {activeCategories.map(cat => (
              <button
                class="tab-btn"
                role="tab"
                aria-selected="false"
                data-category={cat.slug}
                id={`tab-${cat.slug}`}
              >
                <Icon name={cat.icon} size={14} />
                <span>{cat.title}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Tools Grid -->
        <div class="tools-grid" id="tools-grid">
          {featuredTools.map(tool => (
            <div class="tool-card-container" data-tool-category={tool.category}>
              <ToolCard tool={tool} />
            </div>
          ))}
          <!-- Sponsor Card -->
          <div class="tool-card-container" data-tool-category="all">
            <SponsorCard />
          </div>
        </div>

        <!-- Empty state -->
        <div class="filtered-empty" id="filtered-empty" hidden>
          No tools found in this category.
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" aria-labelledby="features-title">
      <div class="container">
        <h2 id="features-title" class="features-heading">Built for speed and security</h2>
        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="Lock" size={24} />
            </div>
            <h3>Zero server logs</h3>
            <p>
              Your data never touches our servers. All calculations, parsing, and formatting happen locally in your browser.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="RefreshCw" size={24} />
            </div>
            <h3>Lightning fast</h3>
            <p>
              Statically pre-rendered pages load in milliseconds. Standard actions parse and update instantly as you type.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="Braces" size={24} />
            </div>
            <h3>Minimal & clean</h3>
            <p>
              No annoying popups, cookie walls, or bloated advertisements. Just the tools you need, ready when you are.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* === Hero Section === */
  .hero-section {
    padding: var(--space-24) 0 var(--space-16) 0;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: var(--space-12) 0 var(--space-10) 0;
    }
  }

  .hero-container {
    display: flex;
    justify-content: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    gap: var(--space-5);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .accent-text {
    color: var(--accent);
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 400;
    max-width: 560px;
    line-height: 1.7;
  }

  /* Search trigger */
  .hero-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 420px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    margin-top: var(--space-3);
    transition: all var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-xs);
  }

  .hero-search-trigger:hover {
    border-color: var(--border-hover);
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
  }

  .hero-search-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .kbd-helper {
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  /* === Tools Directory === */
  .tools-directory {
    padding: var(--space-10) 0 var(--space-16) 0;
  }

  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-5);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .category-tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 36px;
  }

  .tab-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tab-btn.active {
    background-color: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }

  .tab-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Cards Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-5);
  }

  .tool-card-container {
    display: flex;
  }

  .filtered-empty {
    padding: var(--space-12);
    text-align: center;
    color: var(--text-tertiary);
    font-size: 14px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-8);
  }

  /* === Features Section === */
  .features-section {
    padding: var(--space-16) 0 var(--space-20) 0;
    background-color: var(--surface);
    border-top: 1px solid var(--border);
  }

  .features-heading {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    text-align: center;
    color: var(--text-primary);
    margin-bottom: var(--space-12);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-8);
    gap: var(--space-4);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--accent);
    background-color: var(--accent-subtle);
    border-radius: var(--radius-md);
  }

  .feature-item h3 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .feature-item p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 280px;
  }

  /* Responsive adjustments */
  @media (max-width: 480px) {
    .directory-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-search-trigger {
      max-width: 100%;
    }
  }
</style>

<script>
  // Hero search trigger opens the search overlay modal
  const heroSearchTrigger = document.getElementById('hero-search-trigger');
  const searchToggleBtn = document.getElementById('search-toggle-btn');

  if (heroSearchTrigger && searchToggleBtn) {
    heroSearchTrigger.addEventListener('click', () => {
      searchToggleBtn.click();
    });
  }

  // Client-side category filtering
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.tool-card-container');
  const emptyState = document.getElementById('filtered-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });

      // Set active
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      cards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const toolCategory = htmlCard.getAttribute('data-tool-category');

        if (selectedCategory === 'all' || toolCategory === selectedCategory) {
          htmlCard.style.display = 'flex';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', 'true');
        }
      }
    });
  });
</script>
