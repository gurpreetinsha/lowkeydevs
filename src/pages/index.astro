---
// Root level page: Redirect to the user's preferred language static path
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Redirecting...</title>
  <script is:inline>
    (function() {
      const supportedLangs = ['en', 'hi', 'es', 'fr', 'de', 'ar', 'zh', 'ja', 'ru', 'pt'];
      
      // 1. Check localStorage
      let lang = localStorage.getItem('lowkeydevs-lang');
      
      // 2. Check browser language
      if (!lang || !supportedLangs.includes(lang)) {
        const browserLang = (navigator.language || navigator.userLanguage || '').split('-')[0];
        if (supportedLangs.includes(browserLang)) {
          lang = browserLang;
        }
      }
      
      // 3. Fallback to English
      if (!lang || !supportedLangs.includes(lang)) {
        lang = 'en';
      }
      
      // Save it back to ensure persistence
      localStorage.setItem('lowkeydevs-lang', lang);
      
      // Redirect
      window.location.replace('/' + lang + '/');
    })();
  </script>
</head>
<body>
  <p>Redirecting to <a href="/en/">English version</a>...</p>
</body>
</html>
