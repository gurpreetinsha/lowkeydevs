---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import Icon from '../components/base/Icon.astro';
import { registry, categories } from '../tools/registry';

// Show all tools in the registry on the landing page
const featuredTools = registry;

// Filter active categories based on the featured tools
const activeCategories = categories.filter(cat =>
  featuredTools.some(tool => tool.category === cat.slug)
);

const homeKeywords = "Lowkeydevs, lowkeydevs, lowkey devs, lowkeydevs.com, lowkeydevs tools, free ad free developer tools, private client side web utilities, browser based dev tools no tracking, zero server logs developer tools, minimalist developer toolbox, fast browser utilities for developers, secure online tools client side, open source web utilities hub, ad free text generators, private code formatters, secure hash generator browser, no login developer tools, low key developer tools website, fancy text generator, cool fonts copy and paste, font changer online, instagram font generator, discord font changer, bold text generator, gothic text generator, old english font generator, strikethrough text copy and paste, underlined text generator, upside down text generator, backwards text generator, tiny text generator, small caps converter, json formatter, beautify json online, json validator client side, minify json tool, strip html tags online, convert html to markdown, remove markdown formatting, clean plain text converter, binary code translator, text to binary converter, hex decoder online, binary to text ascii, secure password generator online, online hash generator, sha256 generator client side, md5 generator, duplicate word finder, character remover online, find and replace text online, repeat text generator, sql formatter online, beautify sql query, minify sql script, xml formatter, prettify xml online, html formatter and beautifier, minify html code, css minifier online, beautify javascript code, unminify js, css parser tool, yaml to json converter, json to yaml online, validate yaml file, base64 encode online, base64 decode text, url encoder decoder, percent encoding tool, jwt decoder online, decode json web token, parse jwt token client side, bcrypt generator, generate sha512 hash, hmac generator online, aes encryption decryption tool, html entity encoder, escape html characters, unescape html code, csv to json converter, json to csv online, excel to json tool, xml to json converter, hex to decimal converter, binary to hex calculator, decimal to binary converter, octal to decimal, rgb to hex converter, hex to rgb online, hsl to hex chart, cmyk to rgb converter, title case generator, snake_case to camelCase converter, convert text to slug, uppercase to lowercase tool, lorem ipsum generator, generate mock json data, uuid v4 generator online, guid generator, css gradient generator, css box shadow generator, qr code generator free online, data uri generator for images, generate htaccess file, cron expression generator, robots txt generator online, percentage calculator, calculate percent increase, find percentage of two numbers, word counter online, character count with spaces, line counter tool, diff checker online, subnet calculator ipv4, ip address to binary converter, mac address lookup tool, private json formatter, secure sha256 generator online, unit converter online, metric conversion calculator, unit conversion tool, measurement converter, free unit converter, convert inches to cm, mm to inches converter, meters to feet calculation, feet to meters online, cm to inches converter, lbs to kg converter, kg to lbs calculator, ounces to grams converter, weight conversion tool, celsius to fahrenheit converter, fahrenheit to celsius calculator, temperature converter online, kelvin to celsius, miles to km converter, km to miles calculator, square feet to square meters, area converter online, liquid volume converter, gallons to liters converter, liters to gallons online, ml to oz converter, currency converter real time, usd to eur conversion, byte converter online, mb to gb calculator, speed unit converter, kmh to mph converter, cooking unit converter, cups to grams online, tablespoons to ml calculator, digital data converter, length converter tool, mass converter online";
---

<Layout
  title="Lowkeydevs - Fast, ad-free & private developer tools"
  description="The cleanest and fastest utility toolbox. Over a dozen web tools for formatting JSON, generating passwords, converting Base64. 100% private, runs entirely client-side."
  keywords={homeKeywords}
>
  <Header />

  <main id="main-content" class="home-main">
    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="container container-narrow hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <Icon name="Lock" size={12} />
            100% client-side privacy
          </div>
          <h1 id="hero-title" class="hero-title">
            The internet's default <span class="accent-text">toolbox</span>
          </h1>
          <p class="hero-subtitle">
            Instant, beautiful developer tools that run entirely in your browser. No forced logins, no intrusive popups, and no tracking.
          </p>

          <!-- Search trigger -->
          <button class="hero-search-trigger" id="hero-search-trigger" aria-label="Search tools">
            <Icon name="Search" size={16} />
            <span>Search tools...</span>
            <kbd class="kbd-helper">/</kbd>
          </button>
        </div>
      </div>
    </section>

    <!-- Quick Access Section -->
    <section class="quick-access-section" id="quick-access-section" hidden>
      <div class="container">
        <div class="quick-access-header">
          <h2 class="section-title">My Toolbox</h2>
          <div class="quick-access-tabs" role="tablist" aria-label="Quick Access Tabs">
            <button class="quick-tab active" role="tab" aria-selected="true" data-tab="favorites">
              <Icon name="Star" size={14} />
              Favorites
            </button>
            <button class="quick-tab" role="tab" aria-selected="false" data-tab="recent">
              <Icon name="Clock" size={14} />
              Recent
            </button>
            <button class="quick-tab" role="tab" aria-selected="false" data-tab="frequent">
              <Icon name="RefreshCw" size={14} />
              Frequently Used
            </button>
          </div>
        </div>

        <div class="quick-access-grid" id="quick-access-grid">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </section>

    <!-- Tools Directory -->
    <section class="tools-directory" aria-label="Tools Directory">
      <div class="container">
        <div class="directory-header">
          <h2 class="section-title">All utilities</h2>

          <!-- Category Filter Tabs -->
          <div class="category-tabs-wrapper">
            <div class="category-tabs" role="tablist" aria-label="Tool Categories">
              <button
                class="tab-btn active"
                role="tab"
                aria-selected="true"
                data-category="all"
                id="tab-all"
              >
                All tools
              </button>
              {activeCategories.map(cat => (
                <button
                  class="tab-btn"
                  role="tab"
                  aria-selected="false"
                  data-category={cat.slug}
                  id={`tab-${cat.slug}`}
                >
                  <Icon name={cat.icon} size={14} />
                  <span>{cat.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Tools Grid -->
        <div class="tools-grid" id="tools-grid">
          {featuredTools.map(tool => (
            <div class="tool-card-container" data-tool-category={tool.category}>
              <ToolCard tool={tool} />
            </div>
          ))}
          <!-- Grid ad placeholder replacing Sponsor Card -->
          <div class="tool-card-container" data-tool-category="all">
            <AdPlaceholder format="in-feed" adSlot="home-grid" className="grid-ad" />
          </div>
        </div>

        <!-- Empty state -->
        <div class="filtered-empty" id="filtered-empty" hidden>
          No tools found in this category.
        </div>
      </div>
    </section>

    <!-- Natural ad layout between content sections -->
    <div class="container">
      <AdPlaceholder format="horizontal" adSlot="home-horizontal" />
    </div>

    <!-- Features Section -->
    <section class="features-section" aria-labelledby="features-title">
      <div class="container">
        <h2 id="features-title" class="features-heading">Built for speed and security</h2>
        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="Lock" size={24} />
            </div>
            <h3>Zero server logs</h3>
            <p>
              Your data never touches our servers. All calculations, parsing, and formatting happen locally in your browser.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="RefreshCw" size={24} />
            </div>
            <h3>Lightning fast</h3>
            <p>
              Statically pre-rendered pages load in milliseconds. Standard actions parse and update instantly as you type.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <Icon name="Braces" size={24} />
            </div>
            <h3>Minimal & clean</h3>
            <p>
              No annoying popups, cookie walls, or bloated advertisements. Just the tools you need, ready when you are.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Request Tool Section -->
    <section class="request-section" aria-labelledby="request-title">
      <div class="container">
        <div class="request-cta max-w-narrow mx-auto w-full">
          <h2 id="request-title" class="request-heading">Can't find the tool you're looking for?</h2>
          <p class="request-description">
            Describe the tool you need and we'll build it for you. Once it's ready and approved, it'll become part of LowKeyDevs.
          </p>
          <a href="/request-tool" class="btn btn-primary">Request a Tool</a>
        </div>
      </div>
    </section>

    <!-- SEO Content Section -->
    <section class="seo-content-section" aria-labelledby="seo-heading">
      <div class="container container-narrow seo-container-inner">
        <h2 id="seo-heading" class="seo-section-title">The Ultimate Privacy-First Developer Toolbox</h2>
        
        <p class="seo-text-p">
          Welcome to <strong>Lowkeydevs</strong> (also known as <strong>lowkeydevs</strong>, <strong>lowkey devs</strong>, or <strong>lowkeydevs.com</strong>), your premier <strong>open source web utilities hub</strong> and a complete <strong>minimalist developer toolbox</strong>. Our mission is to provide <strong>free ad free developer tools</strong> and <strong>private client side web utilities</strong> that compile, format, and convert your data securely. As a <strong>low key developer tools website</strong> built for speed, we operate under a strict <strong>browser based dev tools no tracking</strong> policy. This means we host <strong>zero server logs developer tools</strong>: all processing happens locally in your browser. We offer <strong>no login developer tools</strong>, which makes us a highly secure, <strong>secure online tools client side</strong> destination with no signup or tracking. If you are looking for <strong>fast browser utilities for developers</strong>, you are in the right place.
        </p>

        <h3 class="seo-subheading">Private Code Formatters & Code Beautifiers</h3>
        <p class="seo-text-p">
          Managing code structure can be tedious, but our suite of <strong>private code formatters</strong> makes it seamless. Use our signature <strong>json formatter</strong> to <strong>beautify json online</strong>, validate payloads with a <strong>json validator client side</strong>, or compress files using a <strong>minify json tool</strong>. For local-only parsing, our <strong>private json formatter</strong> guarantees your code remains completely secure. Beyond JSON, we host a robust <strong>sql formatter online</strong> designed to <strong>beautify sql query</strong> formats or <strong>minify sql script</strong> files. You can also utilize our <strong>xml formatter</strong> to <strong>prettify xml online</strong>, the <strong>html formatter and beautifier</strong> to format structures or <strong>minify html code</strong>, a fast <strong>css minifier online</strong>, and utilities to <strong>beautify javascript code</strong> or <strong>unminify js</strong> files. Additionally, our <strong>css parser tool</strong> simplifies analyzing stylesheets.
        </p>

        <h3 class="seo-subheading">Data Converters & Cryptography Utilities</h3>
        <p class="seo-text-p">
          Seamlessly transform data formats with our specialized converters. Convert spreadsheets and tables using our <strong>csv to json converter</strong>, <strong>json to csv online</strong> tool, and <strong>excel to json tool</strong>. We also provide a fast <strong>xml to json converter</strong>, a <strong>yaml to json converter</strong>, and a <strong>json to yaml online</strong> conversion page that lets you <strong>validate yaml file</strong> structures dynamically. If you work with raw encoding, try our <strong>base64 encode online</strong> and <strong>base64 decode text</strong> tools, or our <strong>url encoder decoder</strong> which functions as a standard <strong>percent encoding tool</strong>.
        </p>
        <p class="seo-text-p">
          For web token verification, use the <strong>jwt decoder online</strong> to <strong>decode json web token</strong> payloads and <strong>parse jwt token client side</strong>. When you need a <strong>secure password generator online</strong>, our client-side tool is there. Security professionals can generate secure hashes using our <strong>bcrypt generator</strong>, <strong>generate sha512 hash</strong> signatures, use the <strong>hmac generator online</strong>, or run the <strong>aes encryption decryption tool</strong>. To safeguard browser rendering, use our <strong>html entity encoder</strong> to <strong>escape html characters</strong> or <strong>unescape html code</strong>. If you need secure text hashing, try our <strong>secure hash generator browser</strong>, the <strong>online hash generator</strong>, our <strong>sha256 generator client side</strong>, <strong>md5 generator</strong>, or <strong>secure sha256 generator online</strong>.
        </p>

        <h3 class="seo-subheading">Fancy Text Generators & Font Changers</h3>
        <p class="seo-text-p">
          Customize your online presence with our advanced styling utilities. The <strong>fancy text generator</strong> offers <strong>cool fonts copy and paste</strong> options and acts as an interactive <strong>font changer online</strong>. Whether you need an <strong>instagram font generator</strong> or a <strong>discord font changer</strong>, we support multiple styles of <strong>ad free text generators</strong>. Instantly style words using our <strong>bold text generator</strong>, <strong>gothic text generator</strong>, and <strong>old english font generator</strong>. We also provide a <strong>strikethrough text copy and paste</strong> tool, an <strong>underlined text generator</strong>, an <strong>upside down text generator</strong>, a <strong>backwards text generator</strong>, and a <strong>tiny text generator</strong> with a built-in <strong>small caps converter</strong>.
        </p>

        <h3 class="seo-subheading">Text Utilities & Character Removers</h3>
        <p class="seo-text-p">
          Clean and format plain text with ease. Use the <strong>strip html tags online</strong> tool, <strong>convert html to markdown</strong>, or <strong>remove markdown formatting</strong> to get a <strong>clean plain text converter</strong> output. If you are analyzing text, find duplicates with our <strong>duplicate word finder</strong>, clean strings with the <strong>character remover online</strong>, perform bulk edits using <strong>find and replace text online</strong>, or duplicate lines with a <strong>repeat text generator</strong>. You can also run the <strong>word counter online</strong> to get a <strong>character count with spaces</strong>, track lines with a <strong>line counter tool</strong>, or compare files using our <strong>diff checker online</strong>.
        </p>

        <h3 class="seo-subheading">Developer Configs, Math & Networking</h3>
        <p class="seo-text-p">
          Need quick calculators or configuration generators? Use our <strong>percentage calculator</strong> to <strong>calculate percent increase</strong> or <strong>find percentage of two numbers</strong>. Network engineers can use the <strong>subnet calculator ipv4</strong>, <strong>ip address to binary converter</strong>, and the <strong>mac address lookup tool</strong>.
        </p>
        <p class="seo-text-p">
          For developers, we offer a <strong>binary code translator</strong>, <strong>text to binary converter</strong>, <strong>hex decoder online</strong>, and <strong>binary to text ascii</strong> converter. We also have number systems utilities like a <strong>hex to decimal converter</strong>, <strong>binary to hex calculator</strong>, <strong>decimal to binary converter</strong>, and <strong>octal to decimal</strong> converter. Convert colors with our <strong>rgb to hex converter</strong>, <strong>hex to rgb online</strong> lookup, <strong>hsl to hex chart</strong>, and <strong>cmyk to rgb converter</strong>. Use the <strong>title case generator</strong>, <strong>snake_case to camelCase converter</strong>, <strong>convert text to slug</strong>, or <strong>uppercase to lowercase tool</strong>. Generate placeholder text and data with our <strong>lorem ipsum generator</strong>, <strong>generate mock json data</strong>, <strong>uuid v4 generator online</strong>, and <strong>guid generator</strong>. Design frontends using our <strong>css gradient generator</strong> and <strong>css box shadow generator</strong>. We also provide a <strong>qr code generator free online</strong>, a <strong>data uri generator for images</strong>, and tools to <strong>generate htaccess file</strong>, use a <strong>cron expression generator</strong>, or generate search directives with a <strong>robots txt generator online</strong>.
        </p>

        <h3 class="seo-subheading">Universal Unit & Metric Conversion Calculator</h3>
        <p class="seo-text-p">
          Perform accurate conversions using our robust <strong>unit converter online</strong>. This <strong>metric conversion calculator</strong> serves as a comprehensive <strong>unit conversion tool</strong>, <strong>measurement converter</strong>, and <strong>free unit converter</strong>.
        </p>
        <p class="seo-text-p">
          Convert length with our <strong>length converter tool</strong>, including options to <strong>convert inches to cm</strong>, use a <strong>mm to inches converter</strong>, calculate <strong>meters to feet calculation</strong>, convert <strong>feet to meters online</strong>, and utilize a <strong>cm to inches converter</strong>. For mass and weight, our <strong>mass converter online</strong> and <strong>weight conversion tool</strong> features a <strong>lbs to kg converter</strong>, <strong>kg to lbs calculator</strong>, and <strong>ounces to grams converter</strong>.
        </p>
        <p class="seo-text-p">
          Convert temperatures with our <strong>temperature converter online</strong>, including a <strong>celsius to fahrenheit converter</strong>, <strong>fahrenheit to celsius calculator</strong>, and <strong>kelvin to celsius</strong> conversion. For area, our <strong>area converter online</strong> makes converting <strong>square feet to square meters</strong> simple. We also provide distance utilities like a <strong>miles to km converter</strong> and a <strong>km to miles calculator</strong>. For liquid volume, our <strong>liquid volume converter</strong> enables <strong>gallons to liters converter</strong>, <strong>liters to gallons online</strong>, and <strong>ml to oz converter</strong> operations.
        </p>
        <p class="seo-text-p">
          Finally, convert financial values using a <strong>currency converter real time</strong> (such as <strong>usd to eur conversion</strong>), parse storage units with a <strong>byte converter online</strong> and <strong>mb to gb calculator</strong>, convert velocity with our <strong>speed unit converter</strong> or <strong>kmh to mph converter</strong>, translate kitchen units with our <strong>cooking unit converter</strong> (e.g. <strong>cups to grams online</strong> or <strong>tablespoons to ml calculator</strong>), or utilize our <strong>digital data converter</strong>.
        </p>

        <p class="seo-footer-note">
          Lowkeydevs tools are built to protect your data privacy. By ensuring that no user input leaves your local machine, we provide a safe, fast, and completely free developer toolbox for professionals around the globe.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* === Hero Section === */
  .hero-section {
    position: relative;
    overflow: hidden;
    padding: var(--space-24) 0 var(--space-16) 0;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: var(--space-12) 0 var(--space-10) 0;
    }
  }

  .hero-container {
    display: flex;
    justify-content: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    gap: var(--space-5);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    color: var(--text-primary);
  }

  .accent-text {
    color: var(--accent);
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: var(--fs-body-lg);
    font-weight: 400;
    max-width: 560px;
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  /* Search trigger */
  .hero-search-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 420px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    margin-top: var(--space-3);
    transition: all var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-xs);
  }

  .hero-search-trigger:hover {
    border-color: var(--accent);
    color: var(--text-secondary);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .hero-search-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .kbd-helper {
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  /* === Tools Directory === */
  .tools-directory {
    padding: var(--space-10) 0 var(--space-16) 0;
  }

  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-5);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
  }

  .category-tabs-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }


  .category-tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: 4px;
    padding-right: 48px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 44px;
  }

  .tab-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tab-btn.active {
    background-color: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }

  .tab-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Cards Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-5);
  }

  .tool-card-container {
    display: flex;
  }

  .filtered-empty {
    padding: var(--space-12);
    text-align: center;
    color: var(--text-tertiary);
    font-size: 14px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-8);
  }

  /* === Quick Access Section === */
  .quick-access-section {
    padding: var(--space-10) 0 var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .quick-access-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .quick-access-tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .quick-access-tabs::-webkit-scrollbar {
    display: none;
  }

  .quick-tab {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 40px;
  }

  .quick-tab:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .quick-tab.active {
    background-color: var(--accent-subtle);
    color: var(--accent);
    border-color: var(--accent);
  }

  .quick-access-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-5);
  }

  .quick-empty-state-card {
    grid-column: 1 / -1;
    padding: var(--space-8);
    text-align: center;
    color: var(--text-tertiary);
    font-size: 14px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    width: 100%;
  }

  @media (max-width: 768px) {
    .quick-access-header {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }
  }

  /* === Features Section === */
  .features-section {
    padding: var(--space-16) 0 var(--space-20) 0;
    background-color: var(--surface);
    border-top: 1px solid var(--border);
  }

  .features-heading {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    text-align: center;
    color: var(--text-primary);
    margin-bottom: var(--space-12);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(16px, 3vw, 32px);
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-8);
    gap: var(--space-4);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .feature-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--accent);
    background-color: var(--accent-subtle);
    border-radius: var(--radius-md);
  }

  .feature-item h3 {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    color: var(--text-primary);
  }

  .feature-item p {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-sm);
    max-width: 280px;
  }

  /* Responsive adjustments */
  @media (max-width: 960px) {
    .directory-header {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }

    .category-tabs {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-search-trigger {
      max-width: 100%;
    }
  }

  /* === Request Tool Section === */
  .request-section {
    padding: var(--space-16) 0 var(--space-20) 0;
    border-top: 1px solid var(--border);
    background-color: var(--bg);
  }

  .request-cta {
    padding: clamp(24px, 6vw, 40px) clamp(16px, 5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .request-cta h2 {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
  }

  .request-cta p {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    max-width: 480px;
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  @media (max-width: 480px) {
    .request-cta {
      padding: var(--space-8) var(--space-4);
    }
  }

  /* === SEO Content Section === */
  .seo-content-section {
    padding: var(--space-16) 0 var(--space-20) 0;
    border-top: 1px solid var(--border);
    background-color: var(--bg);
  }

  .seo-container-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    text-align: left;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .seo-section-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .seo-subheading {
    font-family: var(--font-heading);
    font-size: var(--fs-h4);
    font-weight: 500;
    line-height: var(--lh-h4);
    letter-spacing: var(--ls-h4);
    color: var(--text-primary);
    margin-top: var(--space-4);
  }

  .seo-text-p {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin: 0;
  }

  .seo-text-p strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .seo-footer-note {
    font-size: var(--fs-sm);
    color: var(--text-tertiary);
    line-height: var(--lh-sm);
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
    margin-top: var(--space-4);
    font-style: italic;
  }
</style>

<script>
  // Hero search trigger opens the search overlay modal
  const heroSearchTrigger = document.getElementById('hero-search-trigger');
  const searchToggleBtn = document.getElementById('search-toggle-btn');

  if (heroSearchTrigger && searchToggleBtn) {
    heroSearchTrigger.addEventListener('click', () => {
      searchToggleBtn.click();
    });
  }

  // Client-side category filtering
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.tool-card-container');
  const emptyState = document.getElementById('filtered-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });

      // Set active
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      cards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const toolCategory = htmlCard.getAttribute('data-tool-category');

        if (selectedCategory === 'all' || toolCategory === selectedCategory) {
          htmlCard.style.display = 'flex';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', 'true');
        }
      }
    });
  });

  // --- Quick Access (My Toolbox) Dashboard Logic ---
  let favorites: string[] = [];
  let recentSlugs: string[] = [];
  let frequentMap: Record<string, number> = {};

  function loadData() {
    try {
      favorites = JSON.parse(localStorage.getItem('favorite_tools') || '[]');
      recentSlugs = JSON.parse(localStorage.getItem('recent_tools') || '[]');
      frequentMap = JSON.parse(localStorage.getItem('frequent_tools') || '{}');
    } catch (e) {
      console.error('Error loading toolbox data', e);
    }
  }

  const quickAccessSection = document.getElementById('quick-access-section');
  const quickAccessGrid = document.getElementById('quick-access-grid');
  const quickTabs = document.querySelectorAll('.quick-tab');

  function syncAllFavoriteButtons() {
    loadData();
    const starBtns = document.querySelectorAll('.favorite-btn');
    starBtns.forEach(btn => {
      const slug = btn.getAttribute('data-slug');
      if (slug) {
        if (favorites.includes(slug)) {
          btn.classList.add('active');
          btn.setAttribute('aria-label', 'Remove from favorites');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-label', 'Add to favorites');
        }
      }
    });
  }

  function setupFavoriteClickListeners() {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      
      const btn = target.closest('.favorite-btn');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      const slug = btn.getAttribute('data-slug');
      if (!slug) return;

      loadData();
      if (favorites.includes(slug)) {
        favorites = favorites.filter(s => s !== slug);
      } else {
        favorites.push(slug);
      }
      localStorage.setItem('favorite_tools', JSON.stringify(favorites));

      syncAllFavoriteButtons();
      renderQuickAccess();
    });
  }

  let activeTab = 'favorites';

  function renderQuickAccess() {
    loadData();

    const hasFavorites = favorites.length > 0;
    const hasRecent = recentSlugs.length > 0;
    const hasFrequent = Object.keys(frequentMap).length > 0;

    if (!hasFavorites && !hasRecent && !hasFrequent) {
      if (quickAccessSection) quickAccessSection.hidden = true;
      return;
    }

    if (quickAccessSection) {
      quickAccessSection.hidden = false;
      quickAccessSection.removeAttribute('hidden');
    }

    let toolsToRender: string[] = [];

    if (activeTab === 'favorites') {
      toolsToRender = favorites;
    } else if (activeTab === 'recent') {
      toolsToRender = recentSlugs;
    } else if (activeTab === 'frequent') {
      toolsToRender = Object.keys(frequentMap)
        .sort((a, b) => (frequentMap[b] || 0) - (frequentMap[a] || 0));
    }

    if (quickAccessGrid) {
      quickAccessGrid.innerHTML = '';

      if (toolsToRender.length === 0) {
        let emptyMessage = '';
        if (activeTab === 'favorites') {
          emptyMessage = "You haven't favorited any tools yet. Click the star on any card to add it here!";
        } else if (activeTab === 'recent') {
          emptyMessage = "Your recently visited tools will appear here.";
        } else if (activeTab === 'frequent') {
          emptyMessage = "Your frequently used tools will appear here.";
        }

        quickAccessGrid.innerHTML = `
          <div class="quick-empty-state-card">
            <p>${emptyMessage}</p>
          </div>
        `;
      } else {
        toolsToRender.forEach(slug => {
          const originalCard = document.querySelector(`.tools-grid a[href="/tools/${slug}"]`);
          if (originalCard) {
            const wrapper = originalCard.closest('.tool-card-wrapper');
            if (wrapper) {
              const clone = wrapper.cloneNode(true) as HTMLElement;
              quickAccessGrid.appendChild(clone);
            }
          }
        });
      }
    }

    syncAllFavoriteButtons();
  }

  if (quickTabs) {
    quickTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        quickTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        activeTab = tab.getAttribute('data-tab') || 'favorites';
        renderQuickAccess();
      });
    });
  }

  // Choose the default active tab on initial page load based on data availability
  loadData();
  if (favorites.length > 0) {
    activeTab = 'favorites';
  } else if (recentSlugs.length > 0) {
    activeTab = 'recent';
  } else if (Object.keys(frequentMap).length > 0) {
    activeTab = 'frequent';
  }

  if (quickTabs) {
    quickTabs.forEach(tab => {
      const tabName = tab.getAttribute('data-tab');
      if (tabName === activeTab) {
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
      } else {
        tab.classList.remove('active');
        tab.setAttribute('aria-selected', 'false');
      }
    });
  }

  syncAllFavoriteButtons();
  setupFavoriteClickListeners();
  renderQuickAccess();
</script>

