---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About us - LowKeyDevs"
  description="Learn about the philosophy behind LowKeyDevs: why we build fast, privacy-first, 100% client-side developer utility tools."
>
  <Header />

  <main id="main-content" class="about-main container">
    <header class="about-header max-w-narrow mx-auto w-full">
      <h1 class="about-title">Why we built <span class="accent-text">LowKeyDevs</span></h1>
      <p class="about-subtitle">The story and core principles behind the fastest toolbox on the web.</p>
    </header>

    <section class="about-content">
      <div class="about-grid">
        <article class="about-card">
          <h2>Our mission</h2>
          <p>
            Developer utility tools are everywhere. But almost all of them suffer from the same issues: intrusive ads, cookie popups, slow loading speeds, and forced account registrations.
          </p>
          <p>
            We built <strong>LowKeyDevs</strong> to solve these pain points. We want it to be the first place you visit whenever you need to format JSON, generate a password, or decode base64. A clean, fast utility that simply works.
          </p>
        </article>

        <article class="about-card">
          <h2>The core principles</h2>
          <ul class="principles-list">
            <li>
              <strong>Instant:</strong> No unnecessary loading. Paste your content, and results render immediately.
            </li>
            <li>
              <strong>100% client-side:</strong> Your privacy is absolute. All computations run in your own browser; no sensitive data touches a server.
            </li>
            <li>
              <strong>Clean UX:</strong> No dark patterns, fake countdowns, popups, or aggressive tracking pixels. Trust is our biggest feature.
            </li>
          </ul>
        </article>
      </div>

      <div class="about-cta max-w-narrow mx-auto w-full">
        <h2>Open source & community driven</h2>
        <p>
          LowKeyDevs is designed to scale to hundreds of utilities. We are continuously adding new tools. Have an idea or need a specific converter? Let us know!
        </p>
        <a href="/" class="btn btn-primary">Browse all tools</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-main {
    padding-top: var(--spacing-xl); /* 24px */
    padding-bottom: var(--spacing-section); /* 80px */
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxl); /* 32px */
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    text-align: center;
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: 72px; /* product-display scale */
    font-weight: 400;
    letter-spacing: -1.44px;
    color: var(--color-ink);
    line-height: 1.0;
  }

  .accent-text {
    color: var(--color-primary);
  }

  .about-subtitle {
    color: var(--color-body-muted);
    font-size: 18px; /* body-large */
    font-weight: 400;
    line-height: 1.4;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxl);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm); /* 8px */
    padding: var(--spacing-xl); /* 24px */
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    box-shadow: none;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .about-card:hover {
    border-color: var(--color-primary);
  }

  .about-card h2 {
    font-family: var(--font-sans);
    font-size: 24px; /* feature-heading */
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .about-card p {
    color: var(--color-body-muted);
    font-size: 16px; /* body */
    line-height: 1.5;
  }

  .principles-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .principles-list li {
    font-size: 16px; /* body */
    color: var(--color-body-muted);
    line-height: 1.5;
    position: relative;
    padding-left: var(--spacing-xl);
  }

  .principles-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-deep-green);
    font-weight: bold;
    font-size: 16px;
  }

  .about-cta {
    padding: 48px var(--spacing-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-md);
    background-color: var(--color-soft-stone); /* #eeece7 */
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 22px */
  }

  .about-cta h2 {
    font-family: var(--font-sans);
    font-size: 32px; /* card-heading */
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.32px;
    line-height: 1.2;
  }

  .about-cta p {
    color: var(--color-body-muted);
    font-size: 16px; /* body */
    max-width: 480px;
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .about-cta {
      padding: var(--spacing-xl) var(--spacing-md);
    }
  }
</style>
