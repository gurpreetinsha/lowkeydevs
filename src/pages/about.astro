---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About us - Lowkeydevs"
  description="Learn about the philosophy behind Lowkeydevs: why we build fast, privacy-first, 100% client-side developer utility tools."
>
  <Header />

  <main id="main-content" class="about-main container">
    <header class="about-header max-w-narrow mx-auto w-full">
      <h1 class="about-title">Why we built <span class="accent-text">Lowkeydevs</span></h1>
      <p class="about-subtitle">The story and core principles behind the fastest toolbox on the web.</p>
    </header>

    <section class="about-content">
      <div class="about-grid">
        <article class="about-card">
          <h2>Our mission</h2>
          <p>
            Developer utility tools are everywhere. But almost all of them suffer from the same issues: intrusive ads, cookie popups, slow loading speeds, and forced account registrations.
          </p>
          <p>
            We built <strong>Lowkeydevs</strong> to solve these pain points. We want it to be the first place you visit whenever you need to format JSON, generate a password, or decode base64. A clean, fast utility that simply works.
          </p>
        </article>

        <article class="about-card">
          <h2>The core principles</h2>
          <ul class="principles-list">
            <li>
              <strong>Instant:</strong> No unnecessary loading. Paste your content, and results render immediately.
            </li>
            <li>
              <strong>100% client-side:</strong> Your privacy is absolute. All computations run in your own browser; no sensitive data touches a server.
            </li>
            <li>
              <strong>Clean UX:</strong> No dark patterns, fake countdowns, popups, or aggressive tracking pixels. Trust is our biggest feature.
            </li>
          </ul>
        </article>
      </div>

      <div class="about-team max-w-narrow mx-auto w-full">
        <h2>Meet the team</h2>
        <p class="team-subtitle">The developers behind Lowkeydevs.</p>
        
        <div class="team-grid">
          <div class="team-member-card">
            <div class="member-avatar">GI</div>
            <div class="member-info">
              <h3>Gurpreet Insha</h3>
              <span class="member-role">Developer</span>
              <p class="member-education">Shri Ram Group of Colleges, Muzaffarnagar</p>
              <p class="member-location">Lives in Khatauli, Uttar Pradesh</p>
            </div>
          </div>
          <div class="team-member-card">
            <div class="member-avatar">PT</div>
            <div class="member-info">
              <h3>Priyank Tyagi</h3>
              <span class="member-role">Developer</span>
              <p class="member-education">Shri Ram Group of Colleges, Muzaffarnagar</p>
              <p class="member-location">Lives in Muzaffarnagar, Uttar Pradesh</p>
            </div>
          </div>
          <div class="team-member-card">
            <div class="member-avatar">AG</div>
            <div class="member-info">
              <h3>Abhi Garg</h3>
              <span class="member-role">Developer</span>
              <p class="member-education">Shri Ram Group of Colleges, Muzaffarnagar</p>
              <p class="member-location">Lives in Muzaffarnagar, Uttar Pradesh</p>
            </div>
          </div>
        </div>

        <div class="team-contact">
          <p>To contact us, email at <a href="mailto:info@lowkeydevs.com" class="contact-link">info@lowkeydevs.com</a></p>
        </div>
      </div>

      <div class="about-cta max-w-narrow mx-auto w-full">
        <h2>Open source & community driven</h2>
        <p>
          Lowkeydevs is designed to scale to hundreds of utilities. We are continuously adding new tools. Have an idea or need a specific converter? Let us know!
        </p>
        <a href="/" class="btn btn-primary">Browse all tools</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-main {
    padding-top: clamp(32px, 8vw, 64px);
    padding-bottom: clamp(40px, 10vw, 80px);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 6vw, 48px);
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: center;
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    color: var(--text-primary);
  }

  .accent-text {
    color: var(--accent);
  }

  .about-subtitle {
    color: var(--text-secondary);
    font-size: var(--fs-body-lg);
    font-weight: 400;
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 6vw, 48px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(16px, 4vw, 24px);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-card {
    padding: clamp(16px, 5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .about-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .about-card h2 {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
  }

  .about-card p {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  .principles-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .principles-list li {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
    position: relative;
    padding-left: var(--space-6);
  }

  .principles-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: 500;
    font-size: 16px;
  }

  .about-cta {
    padding: clamp(24px, 6vw, 40px) clamp(16px, 5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .about-cta h2 {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
  }

  .about-cta p {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    max-width: 460px;
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
  }

  @media (max-width: 480px) {
    .about-cta {
      padding: var(--space-8) var(--space-4);
    }
  }

  /* Team Section Styles */
  .about-team {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: clamp(24px, 6vw, 48px);
    margin-bottom: clamp(24px, 6vw, 48px);
    border-top: 1px solid var(--border);
    padding-top: clamp(32px, 8vw, 64px);
  }

  .about-team h2 {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    color: var(--text-primary);
    text-align: center;
  }

  .team-subtitle {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    text-align: center;
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-2);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 24px);
    margin-top: var(--space-4);
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .team-member-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 4vw, 32px) clamp(16px, 3vw, 24px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .team-member-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .member-avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: var(--accent-subtle);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: var(--fs-h4);
    border: 2px solid var(--border);
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }

  .member-info h3 {
    font-family: var(--font-heading);
    font-size: var(--fs-h4);
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
  }

  .member-role {
    color: var(--accent);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .member-education {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-sm);
    margin: var(--space-1) 0 0 0;
  }

  .member-location {
    font-size: var(--fs-caption);
    color: var(--text-tertiary);
    margin: 0;
  }

  .team-contact {
    margin-top: var(--space-4);
    font-size: var(--fs-body);
    color: var(--text-secondary);
    text-align: center;
  }

  .contact-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contact-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
</style>

