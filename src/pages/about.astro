---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About us - LowKeyDevs"
  description="Learn about the philosophy behind LowKeyDevs: why we build fast, privacy-first, 100% client-side developer utility tools."
>
  <Header />

  <main id="main-content" class="about-main container">
    <header class="about-header max-w-narrow mx-auto w-full">
      <h1 class="about-title">Why we built <span class="accent-text">LowKeyDevs</span></h1>
      <p class="about-subtitle">The story and core principles behind the fastest toolbox on the web.</p>
    </header>

    <section class="about-content">
      <div class="about-grid">
        <article class="about-card">
          <h2>Our mission</h2>
          <p>
            Developer utility tools are everywhere. But almost all of them suffer from the same issues: intrusive ads, cookie popups, slow loading speeds, and forced account registrations.
          </p>
          <p>
            We built <strong>LowKeyDevs</strong> to solve these pain points. We want it to be the first place you visit whenever you need to format JSON, generate a password, or decode base64. A clean, fast utility that simply works.
          </p>
        </article>

        <article class="about-card">
          <h2>The core principles</h2>
          <ul class="principles-list">
            <li>
              <strong>Instant:</strong> No unnecessary loading. Paste your content, and results render immediately.
            </li>
            <li>
              <strong>100% client-side:</strong> Your privacy is absolute. All computations run in your own browser; no sensitive data touches a server.
            </li>
            <li>
              <strong>Clean UX:</strong> No dark patterns, fake countdowns, popups, or aggressive tracking pixels. Trust is our biggest feature.
            </li>
          </ul>
        </article>
      </div>

      <div class="about-cta max-w-narrow mx-auto w-full">
        <h2>Open source & community driven</h2>
        <p>
          LowKeyDevs is designed to scale to hundreds of utilities. We are continuously adding new tools. Have an idea or need a specific converter? Let us know!
        </p>
        <a href="/" class="btn btn-primary">Browse all tools</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-main {
    padding-top: var(--spacing-xl); /* 32px */
    padding-bottom: var(--spacing-section); /* 96px */
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxl); /* 48px */
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: center;
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: 56px; /* display-lg */
    font-weight: 500;
    letter-spacing: -2px;
    color: var(--color-ink);
    line-height: 1.05;
  }

  .accent-text {
    color: var(--color-primary);
  }

  .about-subtitle {
    color: var(--color-body);
    font-size: 16px; /* body-md */
    font-weight: 400;
    line-height: 1.55;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxl);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg); /* 16px */
    padding: var(--spacing-lg); /* 24px */
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: none;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  .about-card:hover {
    transform: translateY(-1px);
    border-color: var(--color-ink);
  }

  .about-card h2 {
    font-family: var(--font-sans);
    font-size: 18px; /* title-md */
    font-weight: 600;
    color: var(--color-ink);
  }

  .about-card p {
    color: var(--color-body);
    font-size: 16px; /* body-md */
    line-height: 1.55;
  }

  .principles-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .principles-list li {
    font-size: 16px; /* body-md */
    color: var(--color-body);
    line-height: 1.55;
    position: relative;
    padding-left: var(--space-6);
  }

  .principles-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: bold;
    font-size: 16px;
  }

  .about-cta {
    padding: 48px var(--spacing-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    background-color: var(--color-surface-soft); /* #faf5e8 */
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl); /* 24px */
  }

  .about-cta h2 {
    font-family: var(--font-heading);
    font-size: 32px; /* display-sm */
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.5px;
  }

  .about-cta p {
    color: var(--color-body);
    font-size: 16px; /* body-md */
    max-width: 480px;
    line-height: 1.55;
  }

  @media (max-width: 480px) {
    .about-cta {
      padding: var(--space-8) var(--space-4);
    }
  }
</style>
