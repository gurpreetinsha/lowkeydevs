---
import Icon from '../../../components/base/Icon.astro';
---

<rand-letter-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="form-group">
          <label for="letter-qty" class="label">Quantity</label>
          <input type="number" id="letter-qty" value="10" min="1" max="1000" class="input" />
        </div>
        <div class="form-group">
          <label for="letter-sep" class="label">Separator</label>
          <select id="letter-sep" class="select">
            <option value=" ">Space ( )</option>
            <option value=", ">Comma (, )</option>
            <option value="\n">New Line</option>
            <option value="">None</option>
          </select>
        </div>
      </div>

      <div class="options-grid">
        <label class="checkbox-container">
          <input type="checkbox" id="opt-lower" checked />
          <span class="checkmark"></span>
          Lowercase (a-z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-upper" checked />
          <span class="checkmark"></span>
          Uppercase (A-Z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-unique" />
          <span class="checkmark"></span>
          Unique Letters (no duplicates)
        </label>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Type" size={18} />
          Generate Letters
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated Letters</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy All</span>
        </button>
      </div>
      <textarea
        id="letter-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated letters will appear here..."
        aria-label="Generated letters output"
      ></textarea>
    </div>
  </div>
</rand-letter-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  @media (max-width: 600px) {
    .inputs-grid, .options-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 150px;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 18px;
    width: 18px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--accent);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--accent);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateRandomLetters, type LetterGenOptions } from './logic';

  class RandLetterTool extends HTMLElement {
    private qtyInput!: HTMLInputElement;
    private sepSelect!: HTMLSelectElement;
    private optLower!: HTMLInputElement;
    private optUpper!: HTMLInputElement;
    private optUnique!: HTMLInputElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.qtyInput = this.querySelector('#letter-qty') as HTMLInputElement;
      this.sepSelect = this.querySelector('#letter-sep') as HTMLSelectElement;
      this.optLower = this.querySelector('#opt-lower') as HTMLInputElement;
      this.optUpper = this.querySelector('#opt-upper') as HTMLInputElement;
      this.optUnique = this.querySelector('#opt-unique') as HTMLInputElement;
      this.outputEl = this.querySelector('#letter-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      this.handleGenerate();
    }

    private handleGenerate() {
      const quantity = parseInt(this.qtyInput.value, 10);
      const separatorStr = this.sepSelect.value;
      const separator = separatorStr === '\\n' ? '\n' : separatorStr;
      const upper = this.optUpper.checked;
      const lower = this.optLower.checked;
      const unique = this.optUnique.checked;

      if (isNaN(quantity)) {
        this.outputEl.value = 'Please enter a valid quantity.';
        return;
      }

      if (!upper && !lower) {
        this.outputEl.value = 'Please select at least Lowercase or Uppercase.';
        return;
      }

      const list = generateRandomLetters({ quantity, upper, lower, unique, separator });
      this.outputEl.value = list.join(separator);
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = 'Copy All';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy letters', err);
      }
    }
  }

  if (!customElements.get('rand-letter-tool')) {
    customElements.define('rand-letter-tool', RandLetterTool);
  }
</script>
