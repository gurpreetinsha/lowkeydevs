---
import Icon from '../../../components/base/Icon.astro';
---

<case-converter-tool class="tool-workspace">
  <!-- Controls Panel -->
  <div class="tool-controls glass-panel">
    <div class="control-actions">
      <button data-action="upper" class="btn btn-secondary btn-sm">UPPERCASE</button>
      <button data-action="lower" class="btn btn-secondary btn-sm">lowercase</button>
      <button data-action="title" class="btn btn-secondary btn-sm">Title Case</button>
      <button data-action="sentence" class="btn btn-secondary btn-sm">Sentence Case</button>
      <button data-action="camel" class="btn btn-secondary btn-sm">camelCase</button>
      <button data-action="pascal" class="btn btn-secondary btn-sm">PascalCase</button>
      <button data-action="snake" class="btn btn-secondary btn-sm">snake_case</button>
      <button data-action="kebab" class="btn btn-secondary btn-sm">kebab-case</button>
    </div>
    <div class="control-danger">
      <button data-action="clear" class="btn btn-danger btn-sm">
        <Icon name="Trash2" size={14} />
        Clear
      </button>
    </div>
  </div>

  <!-- Dual Pane Grid -->
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea
        id="text-input"
        placeholder="Type or paste your text here..."
        aria-label="Text Input"
      ></textarea>
      
      <!-- Live Stats Inside Input Pane Footer -->
      <div class="stats-row">
        <div class="stat-item"><span class="stat-label">Chars:</span> <strong id="stat-chars">0</strong></div>
        <div class="stat-item"><span class="stat-label">Words:</span> <strong id="stat-words">0</strong></div>
        <div class="stat-item"><span class="stat-label">Lines:</span> <strong id="stat-lines">0</strong></div>
        <div class="stat-item"><span class="stat-label">Paragraphs:</span> <strong id="stat-paragraphs">0</strong></div>
      </div>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      <textarea
        id="text-output"
        readonly
        placeholder="Converted text will appear here..."
        aria-label="Converted Output"
      ></textarea>
    </div>
  </div>
</case-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #text-input, #text-output {
    flex: 1;
    width: 100%;
    min-height: 280px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    resize: none;
    outline: none;
  }

  #text-output {
    color: var(--text-secondary);
  }

  /* Stats Row in footer */
  .stats-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .stat-item {
    font-family: var(--font-sans);
  }

  .stat-item strong {
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import {
    toCamelCase,
    toPascalCase,
    toSnakeCase,
    toKebabCase,
    toTitleCase,
    toSentenceCase,
    getTextStats
  } from './logic';

  class CaseConverterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private statChars!: HTMLStrongElement;
    private statWords!: HTMLStrongElement;
    private statLines!: HTMLStrongElement;
    private statParagraphs!: HTMLStrongElement;
    private btnCopy!: HTMLButtonElement;
    private currentCase: string = 'none';

    connectedCallback() {
      this.inputEl = this.querySelector('#text-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#text-output') as HTMLTextAreaElement;
      this.statChars = this.querySelector('#stat-chars') as HTMLStrongElement;
      this.statWords = this.querySelector('#stat-words') as HTMLStrongElement;
      this.statLines = this.querySelector('#stat-lines') as HTMLStrongElement;
      this.statParagraphs = this.querySelector('#stat-paragraphs') as HTMLStrongElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Listen for text input to update stats and auto-apply current conversion
      this.inputEl.addEventListener('input', () => {
        this.updateStats();
        this.applyCase();
      });

      // Actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (!action) return;

        if (action === 'clear') {
          this.handleClear();
        } else if (action === 'copy') {
          this.handleCopy();
        } else if (action === 'load-sample') {
          this.handleLoadSample();
        } else {
          this.currentCase = action;
          this.applyCase();
        }
      });
    }

    private updateStats() {
      const val = this.inputEl.value;
      const stats = getTextStats(val);
      this.statChars.textContent = stats.characters.toString();
      this.statWords.textContent = stats.words.toString();
      this.statLines.textContent = stats.lines.toString();
      this.statParagraphs.textContent = stats.paragraphs.toString();
    }

    private applyCase() {
      const val = this.inputEl.value;
      if (!val) {
        this.outputEl.value = '';
        return;
      }

      let result = '';
      switch (this.currentCase) {
        case 'upper':
          result = val.toUpperCase();
          break;
        case 'lower':
          result = val.toLowerCase();
          break;
        case 'title':
          result = toTitleCase(val);
          break;
        case 'sentence':
          result = toSentenceCase(val);
          break;
        case 'camel':
          result = toCamelCase(val);
          break;
        case 'pascal':
          result = toPascalCase(val);
          break;
        case 'snake':
          result = toSnakeCase(val);
          break;
        case 'kebab':
          result = toKebabCase(val);
          break;
        default:
          result = val; // Default preview
      }

      this.outputEl.value = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.currentCase = 'none';
      this.updateStats();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "The Quick Brown Fox Jumps Over The Lazy Dog.\n\nThis is a sample sentence showing case conversion.";
      this.updateStats();
      this.applyCase();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text', err);
      }
    }
  }

  if (!customElements.get('case-converter-tool')) {
    customElements.define('case-converter-tool', CaseConverterTool);
  }
</script>
