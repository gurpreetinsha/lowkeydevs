---
import Icon from '../../../components/base/Icon.astro';
---

<italic-text-tool class="tool-workspace">
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="italic-input" 
        placeholder="Type or paste your text here..." 
        aria-label="Input Text to Italicize"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          Clear
        </button>
      </div>
    </div>

    <div class="editor-pane glass-panel results-pane">
      <div class="pane-header">
        <span class="pane-title">Italic Styles</span>
      </div>
      
      <div class="results-list" id="italic-results">
        <div class="empty-state">
          Type some text on the left to see italic styles here...
        </div>
      </div>
    </div>
  </div>
</italic-text-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #italic-input {
    flex: 1;
    width: 100%;
    min-height: 220px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .results-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.1rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
    padding: 2rem;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateItalicText } from './logic';

  class ItalicTextTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private resultsEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#italic-input') as HTMLTextAreaElement;
      this.resultsEl = this.querySelector('#italic-results') as HTMLDivElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });
    }

    private handleUpdate() {
      const text = this.inputEl.value;
      if (!text) {
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text on the left to see italic styles here...
          </div>
        `;
        return;
      }

      const results = generateItalicText(text);
      
      this.resultsEl.innerHTML = results.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = 'Italic Text Generator';
      this.handleUpdate();
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      
      try {
        await navigator.clipboard.writeText(text);
        
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied-btn');

        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('italic-text-tool')) {
    customElements.define('italic-text-tool', ItalicTextTool);
  }
</script>
