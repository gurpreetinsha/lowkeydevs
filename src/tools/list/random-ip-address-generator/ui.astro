---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<rand-ip-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="form-group">
          <label for="ip-qty" class="label">{t('common.Quantity')}</label>
          <input type="number" id="ip-qty" value="10" min="1" max="500" class="input" />
        </div>
        <div class="form-group">
          <label class="label">IP Address Type</label>
          <div class="toggle-group">
            <button class="toggle-btn active" data-type="ipv4">IPv4</button>
            <button class="toggle-btn" data-type="ipv6">IPv6</button>
          </div>
        </div>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Globe" size={18} />
          Generate IP Addresses
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated IP Addresses</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy All')}</span>
        </button>
      </div>
      <textarea
        id="ip-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated IP addresses will appear here..."
        aria-label="Generated IP addresses output"
      ></textarea>
    </div>
  </div>
</rand-ip-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (max-width: 600px) {
    .inputs-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 180px;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  /* Toggle Group */
  .toggle-group {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    width: 100%;
  }

  .toggle-btn {
    flex: 1;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface);
    border: none;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
    text-align: center;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
    background: var(--surface-hover);
  }

  .toggle-btn.active {
    background: var(--accent);
    color: var(--accent-on);
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateRandomIps, type IpGenOptions } from './logic';

  class RandIpTool extends HTMLElement {
    private qtyInput!: HTMLInputElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;
    private ipType: IpGenOptions['type'] = 'ipv4';

    connectedCallback() {
      this.qtyInput = this.querySelector('#ip-qty') as HTMLInputElement;
      this.outputEl = this.querySelector('#ip-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      // Toggle buttons
      const toggleBtns = this.querySelectorAll('.toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          toggleBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.ipType = btn.getAttribute('data-type') as IpGenOptions['type'];
          this.handleGenerate();
        });
      });

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      this.handleGenerate();
    }

    private handleGenerate() {
      const quantity = parseInt(this.qtyInput.value, 10);
      const type = this.ipType;

      if (isNaN(quantity)) {
        this.outputEl.value = 'Please enter a valid quantity.';
        return;
      }

      const list = generateRandomIps({ type, quantity });
      this.outputEl.value = list.join('\n');
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy All') || 'Copy All');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy IPs', err);
      }
    }
  }

  if (!customElements.get('rand-ip-tool')) {
    customElements.define('rand-ip-tool', RandIpTool);
  }
</script>
