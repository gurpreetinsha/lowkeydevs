---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load html2pdf bundle from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" is:inline></script>

<html-to-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">HTML to PDF Converter</h3>
      <p class="converter-subtitle">Write, edit, and convert raw HTML templates to PDF documents locally in your browser.</p>
    </div>

    <div class="editor-workspace">
      <!-- Left Side: Editor & Settings -->
      <div class="workspace-pane pane-editor">
        <div class="settings-grid">
          <div class="settings-group">
            <label for="pdf-page-size" class="field-label">Page Size</label>
            <select id="pdf-page-size" class="field-input">
              <option value="a4" selected>A4</option>
              <option value="letter">Letter</option>
              <option value="legal">Legal</option>
            </select>
          </div>

          <div class="settings-group">
            <label for="pdf-orientation" class="field-label">Orientation</label>
            <select id="pdf-orientation" class="field-input">
              <option value="portrait" selected>Portrait</option>
              <option value="landscape">Landscape</option>
            </select>
          </div>

          <div class="settings-group">
            <label for="pdf-margin" class="field-label">Margins</label>
            <select id="pdf-margin" class="field-input">
              <option value="10" selected>Standard (10mm)</option>
              <option value="5">Small (5mm)</option>
              <option value="0">None (Full Page)</option>
            </select>
          </div>
        </div>

        <div class="html-editor-container">
          <label for="html-code-input" class="field-label">HTML Code</label>
          <textarea id="html-code-input" class="field-input code-editor" placeholder="Write or paste HTML/CSS code here..."></textarea>
        </div>

        <div class="pane-actions">
          <button id="btn-update-preview" class="btn btn-secondary">
            Update Preview
          </button>
          <button id="btn-download-pdf" class="btn btn-primary btn-lg">
            Download PDF
          </button>
        </div>
      </div>

      <!-- Right Side: Live Sandbox Preview -->
      <div class="workspace-pane pane-preview">
        <span class="field-label">Live Preview</span>
        <div class="iframe-container">
          <iframe id="preview-sandbox" title="HTML Sandbox Preview"></iframe>
        </div>
      </div>
    </div>
  </div>
</html-to-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .editor-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    min-height: 500px;
  }

  .workspace-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  .settings-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .html-editor-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .code-editor {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
    flex-grow: 1;
    min-height: 350px;
    resize: vertical;
    white-space: pre;
  }

  .pane-actions {
    display: flex;
    gap: 1rem;
  }

  .pane-preview {
    border-left: 1px solid var(--border);
    padding-left: 2rem;
  }

  .iframe-container {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #FFFFFF; /* Standard print background is white */
    flex-grow: 1;
    overflow: hidden;
    height: 100%;
    min-height: 450px;
  }

  #preview-sandbox {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
  }

  @media (max-width: 968px) {
    .editor-workspace {
      grid-template-columns: 1fr;
    }
    .pane-preview {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 2rem;
    }
  }
</style>

<script>
  const DEFAULT_HTML_TEMPLATE = `<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: #333;
      padding: 10px;
    }
    .invoice-card {
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 24px;
      background: #fdfdfd;
      max-width: 600px;
      margin: 0 auto;
    }
    .header {
      display: flex;
      justify-content: space-between;
      border-bottom: 2px solid #c4a9f3;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }
    .title {
      font-size: 24px;
      font-weight: 700;
      color: #111;
    }
    .details {
      margin-bottom: 20px;
      line-height: 1.6;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    .table th, .table td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    .table th {
      background-color: #f2f2f2;
    }
    .total {
      text-align: right;
      font-size: 18px;
      font-weight: bold;
      margin-top: 15px;
    }
  </style>
</head>
<body>
  <div class="invoice-card">
    <div class="header">
      <div>
        <div class="title">INVOICE</div>
        <div>#INV-2026-001</div>
      </div>
      <div style="text-align: right;">
        <strong>Lowkeydevs</strong><br>
        info@Lowkeydevs.com
      </div>
    </div>
    <div class="details">
      <strong>Billed To:</strong> John Doe (john@example.com)<br>
      <strong>Date:</strong> July 5, 2026
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Qty</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Developer API Design Package</td>
          <td>1</td>
          <td>$49.00</td>
        </tr>
        <tr>
          <td>Premium PDF Tools Setup</td>
          <td>1</td>
          <td>$25.00</td>
        </tr>
      </tbody>
    </table>
    <div class="total">Total: $74.00</div>
  </div>
</body>
</html>`;

  class HtmlToPdfTool extends HTMLElement {
    private inputCodeEl!: HTMLTextAreaElement;
    private sizeSelectEl!: HTMLSelectElement;
    private orientationSelectEl!: HTMLSelectElement;
    private marginSelectEl!: HTMLSelectElement;
    private btnUpdatePreviewEl!: HTMLButtonElement;
    private btnDownloadPdfEl!: HTMLButtonElement;
    private previewSandboxEl!: HTMLIFrameElement;

    connectedCallback() {
      this.inputCodeEl = this.querySelector('#html-code-input')!;
      this.sizeSelectEl = this.querySelector('#pdf-page-size')!;
      this.orientationSelectEl = this.querySelector('#pdf-orientation')!;
      this.marginSelectEl = this.querySelector('#pdf-margin')!;
      this.btnUpdatePreviewEl = this.querySelector('#btn-update-preview')!;
      this.btnDownloadPdfEl = this.querySelector('#btn-download-pdf')!;
      this.previewSandboxEl = this.querySelector('#preview-sandbox')!;

      // Set default template
      this.inputCodeEl.value = DEFAULT_HTML_TEMPLATE;

      // Bind events
      this.btnUpdatePreviewEl.addEventListener('click', () => this.updatePreview());
      this.btnDownloadPdfEl.addEventListener('click', () => this.downloadPdf());
      
      // Auto initial preview
      setTimeout(() => this.updatePreview(), 200);
    }

    private updatePreview() {
      const code = this.inputCodeEl.value;
      const doc = this.previewSandboxEl.contentDocument || this.previewSandboxEl.contentWindow?.document;
      if (doc) {
        doc.open();
        doc.write(code);
        doc.close();
      }
    }

    private async downloadPdf() {
      if (typeof window.html2pdf === 'undefined') {
        alert('Converter library is loading. Please try again.');
        return;
      }

      this.updatePreview();
      const doc = this.previewSandboxEl.contentDocument || this.previewSandboxEl.contentWindow?.document;
      if (!doc || !doc.body) {
        alert('Preview content is empty.');
        return;
      }

      const size = this.sizeSelectEl.value;
      const orientation = this.orientationSelectEl.value;
      const margin = parseInt(this.marginSelectEl.value, 10);

      const opt = {
        margin: margin,
        filename: 'web_layout.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2.0, useCORS: true },
        jsPDF: { unit: 'mm', format: size, orientation: orientation }
      };

      try {
        // Run conversion using html2pdf
        window.html2pdf().set(opt).from(doc.body).save();
      } catch (err) {
        console.error(err);
        alert('Failed to generate PDF from HTML.');
      }
    }
  }

  if (!customElements.get('html-to-pdf-tool')) {
    customElements.define('html-to-pdf-tool', HtmlToPdfTool);
  }
</script>

