---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<unicode-converter-tool class="tool-workspace">
  <!-- Inputs and Format Selector -->
  <div class="tool-controls glass-panel">
    <div class="control-actions">
      <!-- Output format selector -->
      <div class="control-group">
        <label for="format-select" class="label">Bulk Format:</label>
        <select id="format-select" class="select select-compact">
          <option value="codePoint">Code Point (U+XXXX)</option>
          <option value="hex">Hexadecimal</option>
          <option value="decimal">Decimal</option>
          <option value="htmlDec">HTML Decimal Entity</option>
          <option value="htmlHex">HTML Hex Entity</option>
          <option value="binary">Binary</option>
        </select>
      </div>
    </div>
    <div class="control-danger">
      <button data-action="clear" class="btn btn-danger btn-sm">
        <Icon name="Trash2" size={14} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <!-- Input pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea
        id="text-input"
        placeholder="Type or paste text to analyze (e.g. Hello ⚡ 😊)..."
        aria-label="Text Input"
      ></textarea>
    </div>

    <!-- Output pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Bulk Output</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      <textarea
        id="text-output"
        readonly
        placeholder="Bulk Unicode conversion will appear here..."
        aria-label="Bulk Output"
      ></textarea>
    </div>
  </div>

  <!-- Character Analysis Table -->
  <div class="glass-panel table-panel">
    <div class="pane-header">
      <span class="pane-title">Character Analysis</span>
    </div>
    <div class="table-wrapper">
      <table class="analysis-table">
        <thead>
          <tr>
            <th>Char</th>
            <th>Code Point</th>
            <th>Decimal</th>
            <th>Hex</th>
            <th>HTML Entity</th>
            <th>Binary</th>
          </tr>
        </thead>
        <tbody id="analysis-tbody">
          <tr>
            <td colspan="6" class="empty-cell">No characters to analyze</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</unicode-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 250px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #text-input, #text-output {
    flex: 1;
    width: 100%;
    min-height: 150px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: vertical;
    outline: none;
  }

  /* Table styling */
  .table-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }

  .table-wrapper {
    overflow-x: auto;
    width: 100%;
  }

  .analysis-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  .analysis-table th, .analysis-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .analysis-table th {
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .analysis-table td {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .analysis-table tbody tr:hover {
    background-color: var(--surface-hover);
  }

  .empty-cell {
    text-align: center;
    color: var(--text-tertiary);
    font-family: var(--font-sans);
    padding: 2rem !important;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { analyzeUnicode, convertTextToFormat, type UnicodeCharInfo } from './logic';

  class UnicodeConverterTool extends HTMLElement {
    private textInput!: HTMLTextAreaElement;
    private textOutput!: HTMLTextAreaElement;
    private formatSelect!: HTMLSelectElement;
    private tbody!: HTMLTableSectionElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.textInput = this.querySelector('#text-input') as HTMLTextAreaElement;
      this.textOutput = this.querySelector('#text-output') as HTMLTextAreaElement;
      this.formatSelect = this.querySelector('#format-select') as HTMLSelectElement;
      this.tbody = this.querySelector('#analysis-tbody') as HTMLTableSectionElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.textInput.addEventListener('input', () => this.handleUpdate());
      this.formatSelect.addEventListener('change', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (action === 'copy') this.handleCopy();
      });
    }

    private handleUpdate() {
      const text = this.textInput.value;
      const format = this.formatSelect.value as any;

      // 1. Bulk Output
      this.textOutput.value = convertTextToFormat(text, format);

      // 2. Character Table Breakdown
      const analysis = analyzeUnicode(text);
      if (analysis.length === 0) {
        this.tbody.innerHTML = `
          <tr>
            <td colspan="6" class="empty-cell">No characters to analyze</td>
          </tr>
        `;
        return;
      }

      this.tbody.innerHTML = analysis.map(info => `
        <tr>
          <td><strong>${info.char}</strong></td>
          <td>${info.codePoint}</td>
          <td>${info.decimal}</td>
          <td>${info.hex}</td>
          <td><code>${this.escapeHtml(info.htmlDec)}</code></td>
          <td>${info.binary}</td>
        </tr>
      `).join('');
    }

    private escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    private handleClear() {
      this.textInput.value = '';
      this.handleUpdate();
      this.textInput.focus();
    }

    private handleLoadSample() {
      this.textInput.value = 'Hello 😊 ⚡';
      this.handleUpdate();
    }

    private async handleCopy() {
      const text = this.textOutput.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text', err);
      }
    }
  }

  if (!customElements.get('unicode-converter-tool')) {
    customElements.define('unicode-converter-tool', UnicodeConverterTool);
  }
</script>
