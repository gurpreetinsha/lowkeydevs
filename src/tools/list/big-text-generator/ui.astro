---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<big-text-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="settings-grid">
      <div class="form-group">
        <label for="big-font" class="label">ASCII Font Style</label>
        <select id="big-font" class="select-input">
          <option value="block">Retro Block Font</option>
          <option value="slant">Slanted Banner Font</option>
        </select>
      </div>
    </div>

    <div class="control-actions">
      <button data-action="generate" class="btn btn-primary">
        <Icon name="Terminal" size={16} />
        Generate Big Text
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text (Keep it short!)</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="big-input" 
        placeholder="Type a word or short phrase here..." 
        aria-label="Input Text to Magnify"
        maxlength="25"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">ASCII Art Output</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      <div class="output-container">
        <pre id="big-output" class="ascii-output-pre" aria-label="ASCII Art Output Text">ASCII Art will appear here...</pre>
      </div>
    </div>
  </div>
</big-text-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .select-input {
    width: 100%;
    padding: 0.625rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .select-input:focus {
    border-color: var(--primary-accent);
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 350px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #big-input {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .ascii-output-pre {
    margin: 0;
    color: var(--primary-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.2;
    white-space: pre;
    overflow-x: auto;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { generateBigText } from './logic';

  class BigTextTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLPreElement;
    private fontEl!: HTMLSelectElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#big-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#big-output') as HTMLPreElement;
      this.fontEl = this.querySelector('#big-font') as HTMLSelectElement;

      this.inputEl.addEventListener('input', () => this.handleGenerate());
      this.fontEl.addEventListener('change', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'generate') this.handleGenerate();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });
    }

    private handleGenerate() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.textContent = 'ASCII Art will appear here...';
        return;
      }

      const font = this.fontEl.value as any;
      const result = generateBigText(text, font);
      this.outputEl.textContent = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.textContent = 'ASCII Art will appear here...';
      this.fontEl.value = 'block';
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "BIG ART";
      this.fontEl.value = 'block';
      this.handleGenerate();
    }

    private async handleCopy() {
      const text = this.outputEl.textContent;
      if (!text || text === 'ASCII Art will appear here...') return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }
  }

  if (!customElements.get('big-text-tool')) {
    customElements.define('big-text-tool', BigTextTool);
  }
</script>
