---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load SheetJS, jsPDF, and html2canvas from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" is:inline></script>

<excel-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Convert Excel to PDF</h3>
      <p class="converter-subtitle">Convert Excel spreadsheets (.xlsx, .xls, .csv) into PDF documents locally in your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="excel-dropzone">
      <input type="file" id="excel-file-input" accept=".xlsx,.xls,.csv" class="hidden-input" aria-label="Upload spreadsheet" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your Excel file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports .xlsx, .xls, .csv files (Max 25MB)</p>
      </div>
    </div>

    <!-- Preview & Configuration Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.xlsx</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Sheet Tabs Navigation -->
      <div class="sheet-tabs-container">
        <span class="field-label" style="margin-right: 0.5rem;">Sheet:</span>
        <div class="sheet-tabs" id="sheet-tabs-list"></div>
      </div>

      <!-- Preview Box -->
      <div class="preview-box">
        <h4 class="section-subtitle">Spreadsheet Preview</h4>
        <div class="preview-scroll">
          <!-- Rendered Table Wrapper -->
          <div class="excel-preview-content" id="excel-preview"></div>
        </div>
      </div>

      <!-- Page Settings -->
      <div class="settings-group">
        <h4 class="section-subtitle">PDF Page Setup</h4>
        <div class="settings-card">
          <div class="setting-item">
            <label for="pdf-orientation" class="field-label">Orientation</label>
            <select id="pdf-orientation" class="field-input">
              <option value="portrait" selected>Portrait (Vertical)</option>
              <option value="landscape">Landscape (Horizontal - For Wide Tables)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-convert" class="btn btn-primary btn-lg">
          Convert to PDF
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Parsing spreadsheet pages, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Conversion Complete!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download PDF Document
        </a>
      </div>
    </div>
  </div>
</excel-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  /* Sheet navigation */
  .sheet-tabs-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    background: var(--surface-elevated);
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .sheet-tabs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
  }

  .sheet-tab {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast);
  }

  .sheet-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .sheet-tab.active {
    background: var(--accent-subtle);
    color: var(--accent);
    border-color: var(--accent);
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  /* Preview Scroll */
  .preview-box {
    display: flex;
    flex-direction: column;
  }

  .preview-scroll {
    width: 100%;
    max-height: 380px;
    overflow-y: auto;
    overflow-x: auto;
    border: 1px solid var(--border);
    background: #ffffff; /* paper background */
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .excel-preview-content {
    color: #111111;
    font-family: Arial, sans-serif;
    font-size: 12px;
  }

  .excel-preview-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .excel-preview-content td, 
  .excel-preview-content th {
    border: 1px solid #ddd;
    padding: 6px 8px;
    text-align: left;
    white-space: nowrap;
  }

  .excel-preview-content th {
    background: #f5f5f5;
    font-weight: bold;
  }

  /* Page setup options */
  .settings-group {
    display: flex;
    flex-direction: column;
  }

  .settings-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class ExcelToPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private sheetTabsListEl!: HTMLDivElement;
    private excelPreviewEl!: HTMLDivElement;
    private pdfOrientationEl!: HTMLSelectElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnConvertEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    private workbook: any = null;
    private sheetNames: string[] = [];
    private activeSheetName: string = '';

    connectedCallback() {
      this.fileInputEl = this.querySelector('#excel-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#excel-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.sheetTabsListEl = this.querySelector('#sheet-tabs-list') as HTMLDivElement;
      this.excelPreviewEl = this.querySelector('#excel-preview') as HTMLDivElement;
      this.pdfOrientationEl = this.querySelector('#pdf-orientation') as HTMLSelectElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnConvertEl = this.querySelector('#btn-convert') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnConvertEl.addEventListener('click', () => this.runConversion());
    }

    private async handleFile(file: File) {
      const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
      if (ext !== '.xlsx' && ext !== '.xls' && ext !== '.csv') {
        alert('Please upload a valid Excel or CSV file.');
        return;
      }

      if (typeof window.XLSX === 'undefined') {
        alert('Spreadsheet parsing library is loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingTextEl.textContent = 'Parsing spreadsheet...';

      try {
        const arrayBuffer = await file.arrayBuffer();
        
        // Parse workbook structure
        this.workbook = window.XLSX.read(arrayBuffer, { type: 'array' });
        this.sheetNames = this.workbook.SheetNames;
        this.activeSheetName = this.sheetNames[0];

        // Draw tab buttons
        this.renderSheetTabs();

        // Draw preview for default active sheet
        this.renderActiveSheetPreview();

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.add('hidden');
      } catch (err) {
        console.error(err);
        alert('Error parsing spreadsheet document.');
        this.reset();
      }
    }

    private renderSheetTabs() {
      this.sheetTabsListEl.innerHTML = '';
      this.sheetNames.forEach(name => {
        const tab = document.createElement('button');
        tab.className = `sheet-tab ${name === this.activeSheetName ? 'active' : ''}`;
        tab.textContent = name;
        tab.addEventListener('click', () => {
          this.querySelectorAll('.sheet-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          this.activeSheetName = name;
          this.renderActiveSheetPreview();
        });
        this.sheetTabsListEl.appendChild(tab);
      });
    }

    private renderActiveSheetPreview() {
      if (!this.workbook || !this.activeSheetName) return;
      const sheet = this.workbook.Sheets[this.activeSheetName];
      
      // Convert to HTML
      const htmlTable = window.XLSX.utils.sheet_to_html(sheet);
      this.excelPreviewEl.innerHTML = htmlTable || '<p style="color: grey; text-align: center;">Sheet is empty.</p>';
    }

    private reset() {
      this.selectedFile = null;
      this.workbook = null;
      this.sheetNames = [];
      this.activeSheetName = '';
      this.fileInputEl.value = '';
      this.excelPreviewEl.innerHTML = '';
      this.sheetTabsListEl.innerHTML = '';
      
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    private async runConversion() {
      if (!this.selectedFile || !this.workbook) return;

      if (typeof window.jspdf === 'undefined' || typeof window.html2canvas === 'undefined') {
        alert('PDF rendering libraries are still loading. Please wait.');
        return;
      }

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingTextEl.textContent = 'Generating PDF pages...';

      try {
        const { jsPDF } = window.jspdf;
        const orientation = this.pdfOrientationEl.value as 'portrait' | 'landscape';

        // standard A4 bounds
        const standardWidth = 595.28;
        const standardHeight = 841.89;
        
        const pageWidth = orientation === 'portrait' ? standardWidth : standardHeight;
        const pageHeight = orientation === 'portrait' ? standardHeight : standardWidth;

        const doc = new jsPDF({
          orientation: orientation,
          unit: 'pt',
          format: 'a4'
        });

        // Loop over each sheet page in the workbook and snapshot them sequentially
        for (let i = 0; i < this.sheetNames.length; i++) {
          const sheetName = this.sheetNames[i];
          this.loadingTextEl.textContent = `Rendering sheet ${i + 1} of ${this.sheetNames.length}: ${sheetName}...`;

          // Temporarily draw this sheet contents into the preview DOM element
          const sheet = this.workbook.Sheets[sheetName];
          const htmlTable = window.XLSX.utils.sheet_to_html(sheet);
          this.excelPreviewEl.innerHTML = htmlTable;

          // Render html to canvas
          const canvas = await window.html2canvas(this.excelPreviewEl, {
            scale: 2,
            useCORS: true,
            backgroundColor: '#ffffff',
            logging: false
          });

          const imgWidth = pageWidth;
          const imgHeight = (canvas.height * imgWidth) / canvas.width;
          let heightLeft = imgHeight;
          
          let position = 0;
          const imgData = canvas.toDataURL('image/jpeg', 0.95);

          if (i > 0) {
            doc.addPage();
          }

          // Add sheet pages
          doc.addImage(imgData, 'JPEG', 0, position, imgWidth, imgHeight);
          heightLeft -= pageHeight;

          while (heightLeft >= 0) {
            position = heightLeft - imgHeight;
            doc.addPage();
            doc.addImage(imgData, 'JPEG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
          }
        }

        // Restore original active sheet preview
        this.renderActiveSheetPreview();

        const pdfBlob = doc.output('blob');
        const url = URL.createObjectURL(pdfBlob);

        this.downloadBtnEl.href = url;
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        this.downloadBtnEl.download = `${baseName}.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error rendering PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('excel-pdf-tool')) {
    customElements.define('excel-pdf-tool', ExcelToPdfTool);
  }
</script>
