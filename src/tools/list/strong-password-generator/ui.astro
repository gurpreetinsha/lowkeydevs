---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<strong-pwd-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Big Premium Output Banner -->
    <div class="output-banner">
      <div id="password-display" class="password-text-container">Generating...</div>
      <div class="banner-actions">
        <button data-action="regenerate" class="btn btn-secondary btn-circle" aria-label="Regenerate Password">
          <Icon name="RefreshCw" size={16} />
        </button>
        <button data-action="copy" class="btn btn-primary" id="btn-copy">
          <Icon name="Clipboard" size={16} class="copy-icon" />
          <Icon name="Check" size={16} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
    </div>

    <!-- Live Strength Meter -->
    <div class="strength-meter-section">
      <div class="strength-labels">
        <span class="strength-title">Strength: <strong id="strength-label">Strong</strong></span>
        <span class="entropy-title"><span id="entropy-val">0</span> bits entropy</span>
      </div>
      <div class="meter-bar-container">
        <div id="meter-bar-fill" class="meter-bar-fill"></div>
      </div>
      <div class="crack-time-text">Estimated crack time: <strong id="crack-time-val">centuries</strong></div>
    </div>

    <!-- Controls Form -->
    <div class="generator-controls">
      <!-- Mode Selection -->
      <div class="form-group">
        <label class="label">Generator Mode</label>
        <div class="toggle-group">
          <button class="toggle-btn active" data-mode="random">Random Characters</button>
          <button class="toggle-btn" data-mode="passphrase">Memorable Passphrase</button>
        </div>
      </div>

      <!-- Settings based on Mode -->
      <div class="controls-grid">
        <!-- Length Slider (Adjustable dynamically) -->
        <div class="control-row">
          <div class="control-header">
            <label for="pwd-len-input" class="label" id="len-slider-label">{t('common.Length')}</label>
            <span id="len-val" class="qty-display">20</span>
          </div>
          <input type="range" id="pwd-len-input" min="8" max="64" value="20" class="slider" />
        </div>

        <!-- Passphrase settings (hidden initially) -->
        <div class="passphrase-settings hidden" id="passphrase-configs">
          <div class="form-group">
            <label for="pass-sep" class="label">Word Separator</label>
            <select id="pass-sep" class="select">
              <option value="-">Hyphen (-)</option>
              <option value=" ">Space ( )</option>
              <option value=".">Dot (.)</option>
              <option value="_">Underscore (_)</option>
            </select>
          </div>
          <div class="checkboxes-row">
            <label class="checkbox-container">
              <input type="checkbox" id="pass-cap" checked />
              <span class="checkmark"></span>
              Capitalize Words
            </label>
            <label class="checkbox-container">
              <input type="checkbox" id="pass-num" checked />
              <span class="checkmark"></span>
              Append Number
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>
</strong-pwd-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
  }

  /* Output Banner */
  .output-banner {
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .password-text-container {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
    line-height: 1.4;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Strength Meter */
  .strength-meter-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background-color: var(--surface-hover);
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .strength-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .strength-title {
    color: var(--text-secondary);
  }

  .entropy-title {
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .meter-bar-container {
    height: 8px;
    width: 100%;
    background-color: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .meter-bar-fill {
    height: 100%;
    width: 0;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .crack-time-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Controls */
  .generator-controls {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .controls-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-display {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .slider {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    outline: none;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  .slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  /* Passphrase setting row */
  .passphrase-settings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .checkboxes-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  @media (max-width: 500px) {
    .passphrase-settings {
      grid-template-columns: 1fr;
    }
    .checkboxes-row {
      padding-top: 0;
    }
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 18px;
    width: 18px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--accent);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--accent);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Toggle Group */
  .toggle-group {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    width: 100%;
  }

  .toggle-btn {
    flex: 1;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface);
    border: none;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
    text-align: center;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
    background: var(--surface-hover);
  }

  .toggle-btn.active {
    background: var(--accent);
    color: var(--accent-on);
  }

  .hidden {
    display: none !important;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateStrongPassword, calculateStrength, type StrongPwdOptions } from './logic';

  class StrongPwdTool extends HTMLElement {
    private displayEl!: HTMLElement;
    private lenSlider!: HTMLInputElement;
    private lenLabel!: HTMLElement;
    private lenVal!: HTMLElement;
    private passphraseConfigs!: HTMLElement;
    private passSep!: HTMLSelectElement;
    private passCap!: HTMLInputElement;
    private passNum!: HTMLInputElement;

    private strengthLabel!: HTMLElement;
    private entropyVal!: HTMLElement;
    private meterFill!: HTMLElement;
    private crackTimeVal!: HTMLElement;

    private btnCopy!: HTMLButtonElement;

    private mode: StrongPwdOptions['mode'] = 'random';

    connectedCallback() {
      this.displayEl = this.querySelector('#password-display') as HTMLElement;
      this.lenSlider = this.querySelector('#pwd-len-input') as HTMLInputElement;
      this.lenLabel = this.querySelector('#len-slider-label') as HTMLElement;
      this.lenVal = this.querySelector('#len-val') as HTMLElement;
      this.passphraseConfigs = this.querySelector('#passphrase-configs') as HTMLElement;
      this.passSep = this.querySelector('#pass-sep') as HTMLSelectElement;
      this.passCap = this.querySelector('#pass-cap') as HTMLInputElement;
      this.passNum = this.querySelector('#pass-num') as HTMLInputElement;

      this.strengthLabel = this.querySelector('#strength-label') as HTMLElement;
      this.entropyVal = this.querySelector('#entropy-val') as HTMLElement;
      this.meterFill = this.querySelector('#meter-bar-fill') as HTMLElement;
      this.crackTimeVal = this.querySelector('#crack-time-val') as HTMLElement;

      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Toggle modes
      const toggleBtns = this.querySelectorAll('.toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          toggleBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.mode = btn.getAttribute('data-mode') as StrongPwdOptions['mode'];
          this.handleModeChange();
        });
      });

      // Inputs change
      this.lenSlider.addEventListener('input', () => {
        this.lenVal.textContent = this.lenSlider.value;
        this.handleGenerate();
      });
      this.passSep.addEventListener('change', () => this.handleGenerate());
      this.passCap.addEventListener('change', () => this.handleGenerate());
      this.passNum.addEventListener('change', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'regenerate') this.handleGenerate();
        if (action === 'copy') this.handleCopy();
      });

      this.handleGenerate();
    }

    private handleModeChange() {
      if (this.mode === 'random') {
        this.lenLabel.textContent = 'Password Length';
        this.lenSlider.min = '8';
        this.lenSlider.max = '64';
        this.lenSlider.value = '20';
        this.lenVal.textContent = '20';
        this.passphraseConfigs.classList.add('hidden');
      } else {
        this.lenLabel.textContent = 'Number of Words';
        this.lenSlider.min = '3';
        this.lenSlider.max = '12';
        this.lenSlider.value = '4';
        this.lenVal.textContent = '4';
        this.passphraseConfigs.classList.remove('hidden');
      }
      this.handleGenerate();
    }

    private handleGenerate() {
      const length = parseInt(this.lenSlider.value, 10);
      const separator = this.passSep.value;
      const capitalize = this.passCap.checked;
      const includeNumber = this.passNum.checked;

      const pwd = generateStrongPassword({
        mode: this.mode,
        length,
        separator,
        capitalize,
        includeNumber
      });

      this.displayEl.textContent = pwd;

      // Strength Meter Updates
      const strength = calculateStrength(pwd);
      this.strengthLabel.textContent = strength.label;
      this.strengthLabel.style.color = strength.color;
      this.entropyVal.textContent = strength.entropy.toString();
      this.meterFill.style.width = `${strength.percent}%`;
      this.meterFill.style.backgroundColor = strength.color;
      this.crackTimeVal.textContent = strength.crackTime;
    }

    private async handleCopy() {
      const text = this.displayEl.textContent;
      if (!text || text === 'Generating...') return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy password', err);
      }
    }
  }

  if (!customElements.get('strong-pwd-tool')) {
    customElements.define('strong-pwd-tool', StrongPwdTool);
  }
</script>
