---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<wide-text-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="wide-input" 
        placeholder="Type here to widen your text..." 
        aria-label="Wide Text Input"
      ></textarea>
      
      <div class="control-actions-col">
        <div class="control-row">
          <label for="wide-spacer-select">Spacer Character:</label>
          <select id="wide-spacer-select" aria-label="Spacer Selector">
            <option value=" ">Space (Standard)</option>
            <option value="・">Bullet (・)</option>
            <option value="*">Star (*)</option>
            <option value="-">Dash (-)</option>
            <option value="/">Slash (/)</option>
            <option value="custom">Custom Character...</option>
          </select>
          <input 
            type="text" 
            id="wide-custom-spacer" 
            placeholder="Type spacer..." 
            class="hidden" 
            maxlength="3" 
            value=" "
            aria-label="Custom Spacer character"
          />
        </div>
        <div class="control-row">
          <label for="wide-spacer-count">Spacing Count:</label>
          <input 
            type="range" 
            id="wide-spacer-count" 
            min="1" 
            max="5" 
            value="1" 
            aria-label="Spacing Count Slider"
          />
          <span id="spacer-count-val">1</span>
        </div>
      </div>

      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          {t('common.Clear')}
        </button>
      </div>
    </div>

    <!-- Wide Preview Card -->
    <div class="editor-pane glass-panel preview-pane">
      <div class="pane-header">
        <span class="pane-title">Aesthetic Fullwidth Preview</span>
        <button id="wide-main-copy" class="btn btn-primary btn-sm">
          <Icon name="Copy" size={14} />
          Copy Main Output
        </button>
      </div>
      <div class="wide-big-display" id="wide-primary-display">
        ａｅｓｔｈｅｔｉｃ
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="results-section glass-panel">
    <h3 class="section-title">Wide Text Variations</h3>
    
    <div class="results-list" id="wide-results">
      <div class="empty-state">
        Type some text above to see wide text variations...
      </div>
    </div>
  </div>
</wide-text-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 380px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #wide-input {
    flex: 1;
    width: 100%;
    min-height: 120px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    border: 1px solid var(--border-color);
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .control-row label {
    min-width: 120px;
  }

  .control-row select, .control-row input[type="text"] {
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0.25rem 0.5rem;
    outline: none;
  }

  .hidden {
    display: none !important;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Wide Preview Display */
  .preview-pane {
    background: var(--card-bg);
  }

  .wide-big-display {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    text-align: center;
    color: var(--primary-accent);
    word-break: break-all;
    padding: 1.5rem;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    white-space: pre-wrap;
  }

  /* Results List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.2rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
    white-space: pre-wrap;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateWideStyles, toFullWidth } from './logic';

  class WideTextTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private spacerSelectEl!: HTMLSelectElement;
    private customSpacerEl!: HTMLInputElement;
    private spacerCountEl!: HTMLInputElement;
    private countValEl!: HTMLSpanElement;
    private primaryDisplayEl!: HTMLDivElement;
    private resultsEl!: HTMLDivElement;
    private copyMainBtn!: HTMLButtonElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#wide-input') as HTMLTextAreaElement;
      this.spacerSelectEl = this.querySelector('#wide-spacer-select') as HTMLSelectElement;
      this.customSpacerEl = this.querySelector('#wide-custom-spacer') as HTMLInputElement;
      this.spacerCountEl = this.querySelector('#wide-spacer-count') as HTMLInputElement;
      this.countValEl = this.querySelector('#spacer-count-val') as HTMLSpanElement;
      this.primaryDisplayEl = this.querySelector('#wide-primary-display') as HTMLDivElement;
      this.resultsEl = this.querySelector('#wide-results') as HTMLDivElement;
      this.copyMainBtn = this.querySelector('#wide-main-copy') as HTMLButtonElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());
      this.spacerCountEl.addEventListener('input', () => {
        this.countValEl.textContent = this.spacerCountEl.value;
        this.handleUpdate();
      });

      this.spacerSelectEl.addEventListener('change', () => {
        if (this.spacerSelectEl.value === 'custom') {
          this.customSpacerEl.classList.remove('hidden');
          this.customSpacerEl.focus();
        } else {
          this.customSpacerEl.classList.add('hidden');
        }
        this.handleUpdate();
      });

      this.customSpacerEl.addEventListener('input', () => this.handleUpdate());

      this.copyMainBtn.addEventListener('click', () => {
        const text = this.primaryDisplayEl.textContent || '';
        this.copyToClipboard(this.copyMainBtn, text);
      });

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private getSpacer(): string {
      const val = this.spacerSelectEl.value;
      if (val === 'custom') {
        return this.customSpacerEl.value || ' ';
      }
      return val;
    }

    private handleUpdate() {
      const text = this.inputEl.value;
      const spacer = this.getSpacer();
      const count = parseInt(this.spacerCountEl.value || '1');

      if (!text) {
        this.primaryDisplayEl.textContent = 'ａｅｓｔｈｅｔｉｃ';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see wide text variations...
          </div>
        `;
        return;
      }

      const primary = toFullWidth(text);
      this.primaryDisplayEl.textContent = primary;

      const fonts = generateWideStyles(text, spacer, count);

      this.resultsEl.innerHTML = fonts.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="wide-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = 'aesthetic';
      this.handleUpdate();
    }

    private async copyToClipboard(btn: HTMLButtonElement, text: string) {
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalText = btn.innerHTML;
        btn.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');
        btn.classList.add('copied-btn');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Copy failed', err);
      }
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#wide-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      this.copyToClipboard(button, text);
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('wide-text-tool')) {
    customElements.define('wide-text-tool', WideTextTool);
  }
</script>
