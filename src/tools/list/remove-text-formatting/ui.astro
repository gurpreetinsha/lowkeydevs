---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<remove-formatting-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="checkbox-options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-html" checked />
        <span class="checkmark"></span>
        Strip HTML Tags
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-markdown" checked />
        <span class="checkmark"></span>
        Strip Markdown Shorthand
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-bbcode" checked />
        <span class="checkmark"></span>
        Strip BBCode Tags
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-unicode" checked />
        <span class="checkmark"></span>
        Normalize Unicode Styled Fonts
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-space" checked />
        <span class="checkmark"></span>
        Collapse Excess Whitespace
      </label>
    </div>

    <div class="control-actions">
      <button data-action="clean" class="btn btn-primary">
        <Icon name="Brush" size={16} />
        Clear Formatting
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Rich / Styled Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="format-remover-input" 
        placeholder="Paste styled text, markdown, HTML, or social media fonts here..." 
        aria-label="Input Text with Formatting"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Plain Text Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      <div class="output-container">
        <textarea 
          id="format-remover-output" 
          placeholder="Unformatted text will appear here..." 
          readonly
          aria-label="Cleaned Plain Text Output"
        ></textarea>
      </div>
    </div>
  </div>
</remove-formatting-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .checkbox-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #format-remover-input,
  #format-remover-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #format-remover-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { clearFormatting } from './logic';

  class RemoveFormattingTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private htmlEl!: HTMLInputElement;
    private markdownEl!: HTMLInputElement;
    private bbcodeEl!: HTMLInputElement;
    private unicodeEl!: HTMLInputElement;
    private spaceEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#format-remover-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#format-remover-output') as HTMLTextAreaElement;
      this.htmlEl = this.querySelector('#opt-html') as HTMLInputElement;
      this.markdownEl = this.querySelector('#opt-markdown') as HTMLInputElement;
      this.bbcodeEl = this.querySelector('#opt-bbcode') as HTMLInputElement;
      this.unicodeEl = this.querySelector('#opt-unicode') as HTMLInputElement;
      this.spaceEl = this.querySelector('#opt-space') as HTMLInputElement;

      // Realtime cleaning
      this.inputEl.addEventListener('input', () => this.handleClean());

      const configCheckboxes = [
        this.htmlEl,
        this.markdownEl,
        this.bbcodeEl,
        this.unicodeEl,
        this.spaceEl
      ];
      configCheckboxes.forEach(el => el.addEventListener('change', () => this.handleClean()));

      // Button clicks
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clean') this.handleClean();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });
    }

    private handleClean() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        stripHtml: this.htmlEl.checked,
        stripMarkdown: this.markdownEl.checked,
        stripBbcode: this.bbcodeEl.checked,
        normalizeUnicode: this.unicodeEl.checked,
        collapseWhitespace: this.spaceEl.checked
      };

      const result = clearFormatting(text, options);
      this.outputEl.value = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.htmlEl.checked = true;
      this.markdownEl.checked = true;
      this.bbcodeEl.checked = true;
      this.unicodeEl.checked = true;
      this.spaceEl.checked = true;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "<h1>Sample Rich Text</h1>\n" +
        "This is **bold markdown** and [i]italic BBCode[/i].\n\n" +
        "Here are some math Unicode letters: 𝕿𝖍𝖎𝖘 𝖎𝖘 𝖕𝖑𝖆𝖎𝖓 𝖙𝖊𝖝𝖙.\n\n" +
        "Double   spaces    can be collapsed   too! <script>console.log(1)</" + "script>";
      this.handleClean();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }
  }

  if (!customElements.get('remove-formatting-tool')) {
    customElements.define('remove-formatting-tool', RemoveFormattingTool);
  }
</script>
