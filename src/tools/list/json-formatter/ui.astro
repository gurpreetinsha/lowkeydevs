---
import Icon from '../../../components/base/Icon.astro';
---

<json-formatter-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="control-group">
      <label for="json-indent-select" class="label">Indentation</label>
      <select id="json-indent-select" class="select select-compact">
        <option value="2">2 Spaces</option>
        <option value="4">4 Spaces</option>
        <option value="tab">Tab</option>
      </select>
    </div>
    
    <div class="control-actions">
      <button data-action="format" class="btn btn-primary">
        <Icon name="Braces" size={16} />
        Beautify
      </button>
      <button data-action="minify" class="btn btn-secondary">
        Minify
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input JSON</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="json-input" 
        placeholder='Paste raw JSON here...\n\nExample:\n{"name":"Lowkeydevs","active":true,"tags":["speed","seo","privacy"]}' 
        aria-label="Raw JSON Input"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      
      <!-- Output Container -->
      <div class="output-container">
        <div id="json-error-banner" class="error-banner" hidden>
          <Icon name="Info" size={16} />
          <span id="error-message"></span>
        </div>
        <pre id="json-output" class="output-pre" tabindex="0" aria-label="JSON Output"></pre>
      </div>
    </div>
  </div>
</json-formatter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .select-compact {
    padding: 0.5rem 2rem 0.5rem 1rem;
    font-size: 0.9rem;
    width: auto;
    cursor: pointer;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 480px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #json-input {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 380px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    resize: none;
    outline: none;
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 380px;
    overflow: hidden;
  }

  .output-pre {
    flex: 1;
    overflow: auto;
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary);
    white-space: pre-wrap;
    word-break: break-all;
    outline: none;
  }

  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { formatJson, minifyJson } from './logic';

  class JsonFormatterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLPreElement;
    private indentSelectEl!: HTMLSelectElement;
    private errorBannerEl!: HTMLDivElement;
    private errorMessageEl!: HTMLSpanElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#json-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#json-output') as HTMLPreElement;
      this.indentSelectEl = this.querySelector('#json-indent-select') as HTMLSelectElement;
      this.errorBannerEl = this.querySelector('#json-error-banner') as HTMLDivElement;
      this.errorMessageEl = this.querySelector('#error-message') as HTMLSpanElement;

      // Event listener delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'format') this.handleFormat();
        if (action === 'minify') this.handleMinify();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Auto-validate and format on input (silently)
      this.inputEl.addEventListener('input', () => this.handleFormat(true));
      
      // Update format when indentation changes
      this.indentSelectEl.addEventListener('change', () => this.handleFormat());
    }

    private handleFormat(silent = false) {
      const val = this.inputEl.value;
      if (!val.trim()) {
        this.clearOutput();
        return;
      }

      try {
        const spacing = this.indentSelectEl.value;
        const result = formatJson(val, spacing);
        this.outputEl.textContent = result;
        this.hideError();
      } catch (err: any) {
        if (!silent) {
          this.showError(`Invalid JSON: ${err.message}`);
        }
      }
    }

    private handleMinify() {
      const val = this.inputEl.value;
      if (!val.trim()) return;

      try {
        const result = minifyJson(val);
        this.outputEl.textContent = result;
        this.hideError();
      } catch (err: any) {
        this.showError(`Invalid JSON: ${err.message}`);
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.clearOutput();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      const sample = {
        projectName: "Lowkeydevs",
        version: "1.0.0",
        description: "The ultimate tools collection",
        active: true,
        stats: {
          lighthouse: 100,
          speed: "sub-100ms"
        },
        tools: [
          "JSON Formatter",
          "Password Generator",
          "Base64 Converter"
        ]
      };
      this.inputEl.value = JSON.stringify(sample, null, 2);
      this.handleFormat();
    }

    private async handleCopy() {
      const text = this.outputEl.textContent;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }

    private clearOutput() {
      this.outputEl.textContent = '';
      this.hideError();
    }

    private showError(msg: string) {
      this.errorMessageEl.textContent = msg;
      this.errorBannerEl.removeAttribute('hidden');
      this.outputEl.textContent = '';
    }

    private hideError() {
      this.errorBannerEl.setAttribute('hidden', 'true');
      this.errorMessageEl.textContent = '';
    }
  }

  if (!customElements.get('json-formatter-tool')) {
    customElements.define('json-formatter-tool', JsonFormatterTool);
  }
</script>

