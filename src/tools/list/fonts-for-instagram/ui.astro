---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<instagram-font-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="ig-input" 
        placeholder="Type or paste your bio or caption here..." 
        aria-label="Instagram Text Input"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          {t('common.Clear')}
        </button>
      </div>
    </div>

    <!-- Instagram Simulator Pane -->
    <div class="editor-pane glass-panel simulator-pane">
      <div class="pane-header">
        <span class="pane-title">Instagram Bio Live Simulator</span>
      </div>
      
      <div class="ig-mock-phone">
        <div class="ig-mock-header">
          <Icon name="ArrowRight" class="back-icon" size={18} style="transform: rotate(180deg);" />
          <span class="ig-username">your_aesthetic_profile</span>
          <div class="header-dots">•••</div>
        </div>
        
        <div class="ig-profile-info">
          <div class="ig-avatar-container">
            <div class="ig-avatar-ring">
              <div class="ig-avatar"></div>
            </div>
          </div>
          <div class="ig-stats">
            <div class="stat-item"><span class="stat-num">42</span><span class="stat-label">Posts</span></div>
            <div class="stat-item"><span class="stat-num">12.5k</span><span class="stat-label">Followers</span></div>
            <div class="stat-item"><span class="stat-num">480</span><span class="stat-label">Following</span></div>
          </div>
        </div>

        <div class="ig-profile-bio">
          <div class="ig-display-name" id="ig-preview-name">Your Name</div>
          <div class="ig-bio-text" id="ig-preview-bio">✨ Creator & Designer<br>🌴 Dreamer<br>👇 Check out my tools!</div>
          <div class="ig-bio-link">🔗 <span class="link-text">lowkeydevs.com/tools</span></div>
        </div>

        <div class="ig-action-buttons">
          <button class="ig-btn font-sans-bold">Following</button>
          <button class="ig-btn font-sans-bold">Message</button>
          <button class="ig-btn ig-btn-icon"><Icon name="Sliders" size={14} /></button>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Results Section -->
  <div class="results-section glass-panel">
    <div class="results-header">
      <h3 class="section-title">Copy & Paste Fonts</h3>
      <div class="search-box">
        <Icon name="Search" size={16} class="search-icon" />
        <input type="text" id="font-search" placeholder="Search fonts..." aria-label="Search fonts" />
      </div>
    </div>
    
    <div class="results-list" id="ig-results">
      <div class="empty-state">
        Type some text above to see beautiful Instagram fonts...
      </div>
    </div>
  </div>
</instagram-font-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 400px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #ig-input {
    flex: 1;
    width: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Instagram Mock Simulator */
  .simulator-pane {
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ig-mock-phone {
    width: 100%;
    max-width: 320px;
    background: #000000; /* Instagram Dark Mode */
    border: 6px solid #262626;
    border-radius: 24px;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ig-mock-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 0.5px solid #262626;
    padding-bottom: 0.5rem;
  }

  .back-icon {
    color: #ffffff;
  }

  .ig-username {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .header-dots {
    color: #a8a8a8;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .ig-profile-info {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .ig-avatar-container {
    flex-shrink: 0;
  }

  .ig-avatar-ring {
    padding: 2.5px;
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    border-radius: 50%;
  }

  .ig-avatar {
    width: 65px;
    height: 65px;
    background: #363636;
    border: 2px solid #000;
    border-radius: 50%;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%238e8e8e"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>');
    background-position: center;
    background-size: 60%;
    background-repeat: no-repeat;
  }

  .ig-stats {
    display: flex;
    justify-content: space-around;
    flex: 1;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .stat-label {
    font-size: 0.7rem;
    color: #a8a8a8;
  }

  .ig-profile-bio {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .ig-display-name {
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .ig-bio-text {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ig-bio-link {
    color: #e0f1ff;
    font-weight: 500;
    margin-top: 0.15rem;
  }

  .ig-action-buttons {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .ig-btn {
    flex: 1;
    background: #363636;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    padding: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .ig-btn:hover {
    background: #454545;
  }

  .ig-btn-icon {
    flex: 0 0 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Copy & Paste List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-primary);
    font-size: 1.1rem;
    margin: 0;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface-hover);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.35rem 0.75rem;
    max-width: 250px;
    width: 100%;
  }

  .search-icon {
    color: var(--text-secondary);
  }

  #font-search {
    background: transparent;
    border: none;
    color: var(--text-primary);
    outline: none;
    font-size: 0.85rem;
    width: 100%;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateInstagramFonts } from './logic';

  class InstagramFontTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private searchEl!: HTMLInputElement;
    private resultsEl!: HTMLDivElement;
    private bioPreviewEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#ig-input') as HTMLTextAreaElement;
      this.searchEl = this.querySelector('#font-search') as HTMLInputElement;
      this.resultsEl = this.querySelector('#ig-results') as HTMLDivElement;
      this.bioPreviewEl = this.querySelector('#ig-preview-bio') as HTMLDivElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());
      this.searchEl.addEventListener('input', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private handleUpdate() {
      const text = this.inputEl.value;
      const query = this.searchEl.value.toLowerCase();

      if (!text) {
        this.bioPreviewEl.innerHTML = '✨ Creator & Designer<br>🌴 Dreamer<br>👇 Check out my tools!';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see beautiful Instagram fonts...
          </div>
        `;
        return;
      }

      // Sync Bio Preview (use first cursive / decorated font for demo or direct input)
      const fonts = generateInstagramFonts(text);
      this.bioPreviewEl.textContent = text;

      // Filter and render list
      const filtered = fonts.filter(f => f.name.toLowerCase().includes(query));

      if (filtered.length === 0) {
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            No matching fonts found for "${query}"
          </div>
        `;
        return;
      }

      this.resultsEl.innerHTML = filtered.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="ig-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = 'Aesthetic Bio!';
      this.handleUpdate();
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#ig-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      
      try {
        await navigator.clipboard.writeText(text);
        
        const originalText = button.textContent;
        button.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');
        button.classList.add('copied-btn');

        // Let the simulator show this font style
        this.bioPreviewEl.textContent = text;

        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('instagram-font-tool')) {
    customElements.define('instagram-font-tool', InstagramFontTool);
  }
</script>
