---
import Icon from '../../../components/base/Icon.astro';
---

<apa-citation-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Form Fields Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Source Details</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>

      <div class="form-group">
        <label for="citation-type" class="label">Source Type</label>
        <select id="citation-type" class="select">
          <option value="book">Book</option>
          <option value="website">Website / Web Page</option>
          <option value="journal">Journal Article</option>
        </select>
      </div>

      <div class="form-group">
        <label for="input-authors" class="label">Author(s)</label>
        <input type="text" id="input-authors" class="input" placeholder="e.g. John Smith, Jane Doe" />
      </div>

      <div class="form-group">
        <label for="input-year" class="label">Publication Year</label>
        <input type="text" id="input-year" class="input" placeholder="e.g. 2026 (or n.d.)" />
      </div>

      <div class="form-group">
        <label for="input-title" class="label">Title of Work</label>
        <input type="text" id="input-title" class="input" placeholder="e.g. Writing Clean Code" />
      </div>

      <div class="form-group">
        <label for="input-pub" class="label" id="label-pub">Publisher</label>
        <input type="text" id="input-pub" class="input" placeholder="e.g. Tech Press" />
      </div>

      <div class="form-group">
        <label for="input-url" class="label" id="label-url">URL (optional)</label>
        <input type="text" id="input-url" class="input" placeholder="e.g. https://..." />
      </div>

      <!-- Journal specific fields -->
      <div class="journal-fields hidden" id="journal-fields">
        <div class="inputs-grid">
          <div class="form-group">
            <label for="input-volume" class="label">Volume</label>
            <input type="text" id="input-volume" class="input" placeholder="e.g. 14" />
          </div>
          <div class="form-group">
            <label for="input-issue" class="label">Issue</label>
            <input type="text" id="input-issue" class="input" placeholder="e.g. 2" />
          </div>
          <div class="form-group">
            <label for="input-pages" class="label">Pages</label>
            <input type="text" id="input-pages" class="input" placeholder="e.g. 105-120" />
          </div>
        </div>
      </div>
    </div>

    <!-- Live Preview Pane -->
    <div class="editor-pane glass-panel results-pane">
      <div class="pane-header">
        <span class="pane-title">APA 7th Reference Preview</span>
      </div>

      <div class="preview-box">
        <div id="citation-preview-html" class="citation-preview-text">Preview will appear here...</div>
      </div>

      <div class="actions-row">
        <button data-action="copy-text" class="btn btn-secondary btn-sm" id="btn-copy-text">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy Plain Text</span>
        </button>
        <button data-action="copy-html" class="btn btn-primary btn-sm" id="btn-copy-html">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy HTML Reference</span>
        </button>
      </div>
    </div>
  </div>
</apa-citation-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .results-pane {
    justify-content: space-between;
    min-height: 300px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .hidden {
    display: none !important;
  }

  /* Preview Container */
  .preview-box {
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem 0;
  }

  .citation-preview-text {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-primary);
    width: 100%;
    /* Indent second line for proper APA hanging indent */
    padding-left: 2rem;
    text-indent: -2rem;
  }

  .citation-preview-text a {
    color: var(--accent);
    text-decoration: none;
  }

  .citation-preview-text a:hover {
    text-decoration: underline;
  }

  .actions-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .actions-row button {
    flex: 1;
    min-width: 150px;
  }

  /* Copy Button States */
  .btn .check-icon {
    display: none;
  }

  .btn.copied .copy-icon {
    display: none;
  }

  .btn.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  .btn.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateApa7Citation, type CitationInputs } from './logic';

  class ApaCitationTool extends HTMLElement {
    private typeSelect!: HTMLSelectElement;
    private authorsInput!: HTMLInputElement;
    private yearInput!: HTMLInputElement;
    private titleInput!: HTMLInputElement;
    private pubInput!: HTMLInputElement;
    private urlInput!: HTMLInputElement;
    private volInput!: HTMLInputElement;
    private issueInput!: HTMLInputElement;
    private pagesInput!: HTMLInputElement;

    private labelPub!: HTMLElement;
    private labelUrl!: HTMLElement;
    private journalFields!: HTMLElement;
    private previewHtml!: HTMLElement;

    private btnCopyText!: HTMLButtonElement;
    private btnCopyHtml!: HTMLButtonElement;

    private plainTextOutput = '';
    private htmlOutput = '';

    connectedCallback() {
      this.typeSelect = this.querySelector('#citation-type') as HTMLSelectElement;
      this.authorsInput = this.querySelector('#input-authors') as HTMLInputElement;
      this.yearInput = this.querySelector('#input-year') as HTMLInputElement;
      this.titleInput = this.querySelector('#input-title') as HTMLInputElement;
      this.pubInput = this.querySelector('#input-pub') as HTMLInputElement;
      this.urlInput = this.querySelector('#input-url') as HTMLInputElement;
      this.volInput = this.querySelector('#input-volume') as HTMLInputElement;
      this.issueInput = this.querySelector('#input-issue') as HTMLInputElement;
      this.pagesInput = this.querySelector('#input-pages') as HTMLInputElement;

      this.labelPub = this.querySelector('#label-pub') as HTMLElement;
      this.labelUrl = this.querySelector('#label-url') as HTMLElement;
      this.journalFields = this.querySelector('#journal-fields') as HTMLElement;
      this.previewHtml = this.querySelector('#citation-preview-html') as HTMLElement;

      this.btnCopyText = this.querySelector('#btn-copy-text') as HTMLButtonElement;
      this.btnCopyHtml = this.querySelector('#btn-copy-html') as HTMLButtonElement;

      // Event listeners
      this.typeSelect.addEventListener('change', () => this.handleTypeChange());
      
      const textInputs = [
        this.authorsInput, this.yearInput, this.titleInput,
        this.pubInput, this.urlInput, this.volInput, this.issueInput, this.pagesInput
      ];
      textInputs.forEach(input => input.addEventListener('input', () => this.handleGenerate()));

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'load-sample') this.handleLoadSample();
        if (action === 'copy-text') this.handleCopy(this.plainTextOutput, this.btnCopyText, 'Copy Plain Text');
        if (action === 'copy-html') this.handleCopy(this.htmlOutput, this.btnCopyHtml, 'Copy HTML Reference');
      });

      this.handleGenerate();
    }

    private handleTypeChange() {
      const type = this.typeSelect.value;
      
      if (type === 'book') {
        this.labelPub.textContent = 'Publisher';
        this.pubInput.placeholder = 'e.g. Tech Press';
        this.labelUrl.textContent = 'URL / DOI (optional)';
        this.journalFields.classList.add('hidden');
      } else if (type === 'website') {
        this.labelPub.textContent = 'Website Name';
        this.pubInput.placeholder = 'e.g. Wikipedia';
        this.labelUrl.textContent = 'URL';
        this.journalFields.classList.add('hidden');
      } else {
        this.labelPub.textContent = 'Journal Title';
        this.pubInput.placeholder = 'e.g. Nature';
        this.labelUrl.textContent = 'URL / DOI (optional)';
        this.journalFields.classList.remove('hidden');
      }
      this.handleGenerate();
    }

    private handleGenerate() {
      const type = this.typeSelect.value as CitationInputs['type'];
      const authors = this.authorsInput.value;
      const year = this.yearInput.value;
      const title = this.titleInput.value;
      const publisherOrSite = this.pubInput.value;
      const url = this.urlInput.value;
      const volume = this.volInput.value;
      const issue = this.issueInput.value;
      const pages = this.pagesInput.value;

      if (!title) {
        this.previewHtml.innerHTML = 'Preview will appear here once you type a Title...';
        this.plainTextOutput = '';
        this.htmlOutput = '';
        return;
      }

      const res = generateApa7Citation({
        type, authors, year, title, publisherOrSite, url, volume, issue, pages
      });

      this.plainTextOutput = res.plainText;
      this.htmlOutput = res.html;
      this.previewHtml.innerHTML = res.html;
    }

    private handleLoadSample() {
      const type = this.typeSelect.value;
      if (type === 'book') {
        this.authorsInput.value = 'Joshua Bloch';
        this.yearInput.value = '2018';
        this.titleInput.value = 'Effective Java (3rd Edition)';
        this.pubInput.value = 'Addison-Wesley';
        this.urlInput.value = '';
      } else if (type === 'website') {
        this.authorsInput.value = 'John Doe';
        this.yearInput.value = '2026';
        this.titleInput.value = 'Web Accessibility Best Practices';
        this.pubInput.value = 'A11Y Project';
        this.urlInput.value = 'https://example.com/accessibility';
      } else {
        this.authorsInput.value = 'Albert Einstein';
        this.yearInput.value = '1905';
        this.titleInput.value = 'On the Electrodynamics of Moving Bodies';
        this.pubInput.value = 'Annalen der Physik';
        this.urlInput.value = 'https://example.com/relativity';
        this.volInput.value = '17';
        this.issueInput.value = '10';
        this.pagesInput.value = '891-921';
      }
      this.handleGenerate();
    }

    private async handleCopy(text: string, button: HTMLButtonElement, originalText: string) {
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const btnTextSpan = button.querySelector('.copy-text') as HTMLSpanElement;

        button.classList.add('copied');
        btnTextSpan.textContent = 'Copied!';

        setTimeout(() => {
          button.classList.remove('copied');
          btnTextSpan.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy citation', err);
      }
    }
  }

  if (!customElements.get('apa-citation-tool')) {
    customElements.define('apa-citation-tool', ApaCitationTool);
  }
</script>
