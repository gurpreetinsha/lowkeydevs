---
import Icon from '../../../components/base/Icon.astro';
---

<remove-duplicate-lines-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="settings-grid">
      <div class="form-group">
        <label for="dedupe-behavior" class="label">Deduplication Behavior</label>
        <select id="dedupe-behavior" class="select-input">
          <option value="keep-first">Keep First Occurrence (Standard)</option>
          <option value="keep-last">Keep Last Occurrence</option>
          <option value="remove-all">Remove All Duplicates Completely</option>
        </select>
      </div>
    </div>

    <div class="checkbox-options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-case" />
        <span class="checkmark"></span>
        Case Sensitive
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-empty" checked />
        <span class="checkmark"></span>
        Ignore Empty Lines
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-sort" />
        <span class="checkmark"></span>
        Sort Output Alphabetically
      </label>
    </div>

    <div class="control-actions">
      <button data-action="dedupe" class="btn btn-primary">
        <Icon name="ListFilter" size={16} />
        Remove Duplicate Lines
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input List / Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="dedupe-input" 
        placeholder="Paste your lines of text here..." 
        aria-label="Input Lines to Deduplicate"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Deduplicated Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      <div class="output-container">
        <textarea 
          id="dedupe-output" 
          placeholder="Cleaned lines will appear here..." 
          readonly
          aria-label="Deduplicated Output Text"
        ></textarea>
      </div>
    </div>
  </div>
</remove-duplicate-lines-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .select-input {
    width: 100%;
    padding: 0.625rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .select-input:focus {
    border-color: var(--primary-accent);
  }

  .checkbox-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #dedupe-input,
  #dedupe-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #dedupe-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { removeDuplicateLines } from './logic';

  class RemoveDuplicateLinesTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private behaviorEl!: HTMLSelectElement;
    private caseEl!: HTMLInputElement;
    private emptyEl!: HTMLInputElement;
    private sortEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#dedupe-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#dedupe-output') as HTMLTextAreaElement;
      this.behaviorEl = this.querySelector('#dedupe-behavior') as HTMLSelectElement;
      this.caseEl = this.querySelector('#opt-case') as HTMLInputElement;
      this.emptyEl = this.querySelector('#opt-empty') as HTMLInputElement;
      this.sortEl = this.querySelector('#opt-sort') as HTMLInputElement;

      // Realtime dedupe
      this.inputEl.addEventListener('input', () => this.handleDedupe());

      const configInputs = [
        this.behaviorEl,
        this.caseEl,
        this.emptyEl,
        this.sortEl
      ];
      configInputs.forEach(el => el.addEventListener('change', () => this.handleDedupe()));

      // Action clicks
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'dedupe') this.handleDedupe();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });
    }

    private handleDedupe() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        caseSensitive: this.caseEl.checked,
        behavior: this.behaviorEl.value as any,
        ignoreEmptyLines: this.emptyEl.checked,
        sortOutput: this.sortEl.checked
      };

      const result = removeDuplicateLines(text, options);
      this.outputEl.value = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.behaviorEl.value = 'keep-first';
      this.caseEl.checked = false;
      this.emptyEl.checked = true;
      this.sortEl.checked = false;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "Apple\nBanana\nOrange\nApple\n\nBanana\nGrape\nOrange\nPear";
      this.handleDedupe();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }
  }

  if (!customElements.get('remove-duplicate-lines-tool')) {
    customElements.define('remove-duplicate-lines-tool', RemoveDuplicateLinesTool);
  }
</script>
