---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<password-generator-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Password Display Output -->
    <div class="password-display-wrapper">
      <div id="password-output" class="password-text" tabindex="0" aria-label="Generated Password">Select options and generate</div>
      <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy" aria-label="Copy password">
        <Icon name="Clipboard" size={16} class="copy-icon" />
        <Icon name="Check" size={16} class="check-icon" />
        <span class="copy-text">{t('common.Copy')}</span>
      </button>
    </div>

    <!-- Password Strength Meter -->
    <div class="strength-meter">
      <span class="strength-label">Strength: <strong id="strength-text">Medium</strong></span>
      <div class="strength-bars" id="strength-bars">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
      </div>
    </div>

    <!-- Controls Form -->
    <div class="generator-controls">
      <!-- Length Slider -->
      <div class="control-row">
        <div class="control-header">
          <label for="password-length" class="label">Password Length</label>
          <span id="length-val" class="length-display">16</span>
        </div>
        <input 
          type="range" 
          id="password-length" 
          min="6" 
          max="64" 
          value="16" 
          class="slider"
          aria-label="Password length slider"
        />
      </div>

      <!-- Checklist Toggles -->
      <div class="options-grid">
        <label class="checkbox-container">
          <input type="checkbox" id="opt-upper" checked />
          <span class="checkmark"></span>
          Uppercase Letters (A-Z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-lower" checked />
          <span class="checkmark"></span>
          Lowercase Letters (a-z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-numbers" checked />
          <span class="checkmark"></span>
          Numbers (0-9)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-symbols" checked />
          <span class="checkmark"></span>
          Symbols (!@#$...)
        </label>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Shuffle" size={18} />
          Generate Secure Password
        </button>
      </div>
    </div>
  </div>
</password-generator-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
  }

  /* Password Display */
  .password-display-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    gap: 1rem;
  }

  .password-text {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
    outline: none;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Strength Meter */
  .strength-meter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .strength-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
  }

  .strength-bars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
    height: 6px;
    width: 100%;
    border-radius: 3px;
    overflow: hidden;
  }

  .strength-bars .bar {
    background-color: var(--border-color);
    height: 100%;
    border-radius: 3px;
    transition: background-color 0.3s ease;
  }

  /* Controls */
  .generator-controls {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .length-display {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary-accent);
  }

  .slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--border-color);
    outline: none;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary-accent);
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  /* Options Checkbox Grid */
  .options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .options-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Custom Checkbox Design */
  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    user-select: none;
    color: var(--text-secondary);
    font-family: var(--font-display);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 20px;
    width: 20px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--primary-gradient);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 7px;
    top: 3px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .action-row {
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
    padding: 0.875rem;
    font-size: 1rem;
  }

  /* Copy button checkmark state */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }
</style>

<script>
  import { generatePassword, ratePasswordStrength } from './logic';

  class PasswordGeneratorTool extends HTMLElement {
    private outputEl!: HTMLDivElement;
    private lengthSliderEl!: HTMLInputElement;
    private lengthValEl!: HTMLSpanElement;
    private optUpperEl!: HTMLInputElement;
    private optLowerEl!: HTMLInputElement;
    private optNumbersEl!: HTMLInputElement;
    private optSymbolsEl!: HTMLInputElement;
    private strengthTextEl!: HTMLElement;
    private strengthBarsEl!: HTMLDivElement;

    connectedCallback() {
      this.outputEl = this.querySelector('#password-output') as HTMLDivElement;
      this.lengthSliderEl = this.querySelector('#password-length') as HTMLInputElement;
      this.lengthValEl = this.querySelector('#length-val') as HTMLSpanElement;
      
      this.optUpperEl = this.querySelector('#opt-upper') as HTMLInputElement;
      this.optLowerEl = this.querySelector('#opt-lower') as HTMLInputElement;
      this.optNumbersEl = this.querySelector('#opt-numbers') as HTMLInputElement;
      this.optSymbolsEl = this.querySelector('#opt-symbols') as HTMLInputElement;
      
      this.strengthTextEl = this.querySelector('#strength-text') as HTMLElement;
      this.strengthBarsEl = this.querySelector('#strength-bars') as HTMLDivElement;

      // Event listener delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'generate') this.handleGenerate();
        if (action === 'copy') this.handleCopy();
      });

      // Live updates when slider changes
      this.lengthSliderEl.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        this.lengthValEl.textContent = val;
        this.handleGenerate(true);
      });

      // Live updates on options toggle
      const options = [this.optUpperEl, this.optLowerEl, this.optNumbersEl, this.optSymbolsEl];
      options.forEach(opt => {
        opt.addEventListener('change', () => this.handleGenerate(true));
      });

      // Initial generation
      this.handleGenerate();
    }

    private handleGenerate(silent = false) {
      const length = parseInt(this.lengthSliderEl.value);
      const uppercase = this.optUpperEl.checked;
      const lowercase = this.optLowerEl.checked;
      const numbers = this.optNumbersEl.checked;
      const symbols = this.optSymbolsEl.checked;

      try {
        const password = generatePassword({ length, uppercase, lowercase, numbers, symbols });
        this.outputEl.textContent = password;
        this.updateStrength(password);
      } catch (err: any) {
        if (!silent) {
          this.outputEl.textContent = err.message;
          this.resetStrength();
        }
      }
    }

    private updateStrength(password: string) {
      const strength = ratePasswordStrength(password);
      this.strengthTextEl.textContent = strength.label;
      this.strengthTextEl.style.color = strength.color;

      const bars = this.strengthBarsEl.querySelectorAll('.bar');
      bars.forEach((bar, idx) => {
        const htmlBar = bar as HTMLElement;
        if (idx <= strength.score) {
          htmlBar.style.backgroundColor = strength.color;
        } else {
          htmlBar.style.backgroundColor = 'var(--border-color)';
        }
      });
    }

    private resetStrength() {
      this.strengthTextEl.textContent = 'None';
      this.strengthTextEl.style.color = 'var(--text-muted)';
      const bars = this.strengthBarsEl.querySelectorAll('.bar');
      bars.forEach(bar => {
        (bar as HTMLElement).style.backgroundColor = 'var(--border-color)';
      });
    }

    private async handleCopy() {
      const text = this.outputEl.textContent;
      if (!text || text.startsWith('Select options') || text.startsWith('At least one')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy password', e);
      }
    }
  }

  if (!customElements.get('password-generator-tool')) {
    customElements.define('password-generator-tool', PasswordGeneratorTool);
  }
</script>
