---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<!-- Load external libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>

<compress-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Compress PDF File</h3>
      <p class="converter-subtitle">Reduce PDF document file size locally in your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="compress-dropzone">
      <input type="file" id="compress-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 100MB)</p>
      </div>
    </div>

    <!-- Config Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Original Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Compression Settings -->
      <div class="options-group">
        <h4 class="section-subtitle">Choose Compression Mode</h4>
        
        <label class="option-label">
          <input type="radio" name="compress-mode" value="standard" checked />
          <div class="option-content">
            <span class="option-title">Standard Compression</span>
            <span class="option-desc">Cleans PDF structures and removes unused fonts. Retains pixel-perfect vector and text sharpness.</span>
          </div>
        </label>

        <label class="option-label">
          <input type="radio" name="compress-mode" value="max" />
          <div class="option-content">
            <span class="option-title">Maximum Compression (For Scanned / Image PDFs)</span>
            <span class="option-desc">Rasterizes and compresses pages as JPEG images. Ideal for large scanned documents. (Text won't be selectable).</span>
          </div>
        </label>
      </div>

      <!-- Maximum Options (hidden by default) -->
      <div class="inputs-group hidden" id="max-options-block">
        <div class="input-block">
          <label for="compress-dpi" class="field-label">Target Page Resolution (DPI)</label>
          <select id="compress-dpi" class="field-input" aria-label="Page resolution">
            <option value="96">96 DPI (Screen - Compact Size)</option>
            <option value="120">120 DPI (Normal - Balanced)</option>
            <option value="150" selected>150 DPI (Print - High Quality)</option>
          </select>
        </div>

        <div class="input-block" style="margin-top: 1rem;">
          <label for="compress-quality" class="field-label">JPEG Quality (10% to 100%)</label>
          <input type="range" id="compress-quality" class="slider-input" min="10" max="100" value="70" aria-label="JPEG Quality" />
          <div class="slider-values">
            <span>High Compression</span>
            <span id="quality-display">70%</span>
            <span>Best Quality</span>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-compress" class="btn btn-primary btn-lg">
          Compress PDF
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Compressing PDF document, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        PDF Compressed Successfully!
      </div>

      <div class="conversion-stats">
        <div class="stat-card">
          <span class="stat-label">Original Size</span>
          <span class="stat-value" id="stats-orig-size">0 KB</span>
        </div>
        <div class="stat-arrow">➔</div>
        <div class="stat-card">
          <span class="stat-label">Compressed Size</span>
          <span class="stat-value" id="stats-comp-size">0 KB</span>
        </div>
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Compressed PDF
        </a>
      </div>
    </div>
  </div>
</compress-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .options-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .option-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .option-label:hover {
    border-color: var(--border-hover);
    background: var(--surface-hover);
  }

  .option-label input[type="radio"] {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  .option-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .option-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .option-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Input fields */
  .inputs-group {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .input-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .slider-input {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
    margin: 0.5rem 0;
  }

  .slider-values {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  #quality-display {
    color: var(--accent);
    font-weight: bold;
    font-size: 0.85rem;
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .conversion-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    justify-content: center;
  }

  .stat-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 140px;
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-arrow {
    color: var(--text-secondary);
    font-size: 1.2rem;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class CompressPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnCompressEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;
    private maxOptionsEl!: HTMLDivElement;
    private dpiSelectEl!: HTMLSelectElement;
    private qualityInputEl!: HTMLInputElement;
    private qualityDisplayEl!: HTMLSpanElement;
    private statsOrigSizeEl!: HTMLSpanElement;
    private statsCompSizeEl!: HTMLSpanElement;

    private selectedFile: File | null = null;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#compress-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#compress-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnCompressEl = this.querySelector('#btn-compress') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;
      this.maxOptionsEl = this.querySelector('#max-options-block') as HTMLDivElement;
      this.dpiSelectEl = this.querySelector('#compress-dpi') as HTMLSelectElement;
      this.qualityInputEl = this.querySelector('#compress-quality') as HTMLInputElement;
      this.qualityDisplayEl = this.querySelector('#quality-display') as HTMLSpanElement;
      this.statsOrigSizeEl = this.querySelector('#stats-orig-size') as HTMLSpanElement;
      this.statsCompSizeEl = this.querySelector('#stats-comp-size') as HTMLSpanElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      this.querySelectorAll('input[name="compress-mode"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          const val = (e.target as HTMLInputElement).value;
          if (val === 'max') {
            this.maxOptionsEl.classList.remove('hidden');
          } else {
            this.maxOptionsEl.classList.add('hidden');
          }
        });
      });

      this.qualityInputEl.addEventListener('input', () => {
        this.qualityDisplayEl.textContent = `${this.qualityInputEl.value}%`;
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnCompressEl.addEventListener('click', () => this.runCompression());
    }

    private handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
      this.resultsPanelEl.classList.add('hidden');
    }

    private reset() {
      this.selectedFile = null;
      this.fileInputEl.value = '';
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.maxOptionsEl.classList.add('hidden');
      (this.querySelector('input[name="compress-mode"][value="standard"]') as HTMLInputElement).checked = true;
    }

    private async runCompression() {
      if (!this.selectedFile) return;

      if (typeof window.PDFLib === 'undefined') {
        alert('PDF Library is still loading. Please wait.');
        return;
      }

      const mode = (this.querySelector('input[name="compress-mode"]:checked') as HTMLInputElement).value;
      const { PDFDocument } = window.PDFLib;
      const arrayBuffer = await this.selectedFile.arrayBuffer();

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        if (mode === 'standard') {
          // Standard structural compression
          this.loadingTextEl.textContent = 'Optimizing PDF structures...';
          const srcDoc = await PDFDocument.load(arrayBuffer);
          const compDoc = await PDFDocument.create();
          const copiedPages = await compDoc.copyPages(srcDoc, srcDoc.getPageIndices());
          copiedPages.forEach(p => compDoc.addPage(p));

          const compBytes = await compDoc.save();
          this.finishCompression(compBytes);
        } else {
          // Maximum rasterized compression using PDF.js
          if (typeof window.pdfjsLib === 'undefined') {
            throw new Error('PDF.js renderer failed to load. Please refresh.');
          }

          this.loadingTextEl.textContent = 'Initializing PDF renderer...';
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

          const dpi = parseInt(this.dpiSelectEl.value, 10);
          const scale = dpi / 72.0; // standard PDF point density is 72 per inch
          const quality = parseInt(this.qualityInputEl.value, 10) / 100.0;

          const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
          const pdfjsDoc = await loadingTask.promise;
          const numPages = pdfjsDoc.numPages;

          const compDoc = await PDFDocument.create();

          for (let i = 1; i <= numPages; i++) {
            this.loadingTextEl.textContent = `Compressing Page ${i} of ${numPages}...`;
            const page = await pdfjsDoc.getPage(i);
            const viewport = page.getViewport({ scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;

            const ctx = canvas.getContext('2d');
            if (!ctx) throw new Error('Could not get Canvas 2D context.');

            await page.render({ canvasContext: ctx, viewport }).promise;

            const jpegUrl = canvas.toDataURL('image/jpeg', quality);
            const imageBytes = await fetch(jpegUrl).then(res => res.arrayBuffer());
            const embeddedJpg = await compDoc.embedJpg(imageBytes);

            const newPage = compDoc.addPage([viewport.width / scale, viewport.height / scale]);
            newPage.drawImage(embeddedJpg, {
              x: 0,
              y: 0,
              width: viewport.width / scale,
              height: viewport.height / scale
            });
          }

          const compBytes = await compDoc.save();
          this.finishCompression(compBytes);
        }
      } catch (err) {
        console.error(err);
        alert(`Error compressing PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }

    private finishCompression(compBytes: Uint8Array) {
      const blob = new Blob([compBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);

      this.statsOrigSizeEl.textContent = formatBytes(this.selectedFile!.size);
      
      // If standard compression didn't shrink it because it is already optimized,
      // display the actual size.
      this.statsCompSizeEl.textContent = formatBytes(blob.size);

      this.downloadBtnEl.href = url;
      const baseName = this.selectedFile!.name.replace(/\.[^/.]+$/, "");
      this.downloadBtnEl.download = `${baseName}_compressed.pdf`;

      this.loadingPanelEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
      this.resultsPanelEl.classList.remove('hidden');
      this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
    }
  }

  if (!customElements.get('compress-pdf-tool')) {
    customElements.define('compress-pdf-tool', CompressPdfTool);
  }
</script>
