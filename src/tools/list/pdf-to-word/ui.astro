---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load pdf.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>

<pdf-word-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Convert PDF to Word</h3>
      <p class="converter-subtitle">Extract text and layout from PDF and convert it to an editable Word document (.doc) locally.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="word-dropzone">
      <input type="file" id="word-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 50MB)</p>
      </div>
    </div>

    <!-- Config Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Settings -->
      <div class="options-group">
        <h4 class="section-subtitle">Conversion Settings</h4>
        
        <label class="checkbox-label">
          <input type="checkbox" id="chk-headings" checked />
          <div class="option-content">
            <span class="option-title">Auto-detect Headings</span>
            <span class="option-desc">Converts short capitalized lines into Word heading styles.</span>
          </div>
        </label>

        <label class="checkbox-label" style="margin-top: 0.75rem;">
          <input type="checkbox" id="chk-pagebreaks" checked />
          <div class="option-content">
            <span class="option-title">Preserve Page Breaks</span>
            <span class="option-desc">Maintains original document page layout transitions in Word.</span>
          </div>
        </label>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-convert" class="btn btn-primary btn-lg">
          Convert to Word
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Extracting document contents, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Conversion Complete!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Word Document (.doc)
        </a>
      </div>
    </div>
  </div>
</pdf-word-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .options-group {
    display: flex;
    flex-direction: column;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .checkbox-label:hover {
    border-color: var(--border-hover);
    background: var(--surface-hover);
  }

  .checkbox-label input[type="checkbox"] {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  .option-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .option-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .option-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class PdfToWordTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private chkHeadingsEl!: HTMLInputElement;
    private chkPageBreaksEl!: HTMLInputElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnConvertEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#word-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#word-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.chkHeadingsEl = this.querySelector('#chk-headings') as HTMLInputElement;
      this.chkPageBreaksEl = this.querySelector('#chk-pagebreaks') as HTMLInputElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnConvertEl = this.querySelector('#btn-convert') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnConvertEl.addEventListener('click', () => this.runConversion());
    }

    private handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
      this.resultsPanelEl.classList.add('hidden');
    }

    private reset() {
      this.selectedFile = null;
      this.fileInputEl.value = '';
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
    }

    private async runConversion() {
      if (!this.selectedFile) return;

      if (typeof window.pdfjsLib === 'undefined') {
        alert('PDF renderer library is loading. Please wait a moment.');
        return;
      }

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        const pdf = await loadingTask.promise;
        const numPages = pdf.numPages;

        const detectHeadings = this.chkHeadingsEl.checked;
        const pageBreaks = this.chkPageBreaksEl.checked;

        // Build HTML template structure compatible with Word (msword mimetype)
        let htmlContent = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head>
          <meta charset="utf-8">
          <title>Exported PDF to Word</title>
          <style>
            body { font-family: 'Calibri', 'Arial', sans-serif; line-height: 1.4; padding: 40px; }
            p { margin-bottom: 8px; margin-top: 0; }
            h1, h2, h3 { color: #2E74B5; font-family: 'Calibri Light', sans-serif; margin-top: 18px; margin-bottom: 6px; }
            h1 { font-size: 20pt; font-weight: bold; border-bottom: 1.5px solid #2E74B5; padding-bottom: 4px; }
            h2 { font-size: 16pt; font-weight: bold; }
            h3 { font-size: 13pt; font-weight: bold; }
            .page-break { page-break-after: always; }
          </style>
        </head>
        <body>
        `;

        for (let i = 1; i <= numPages; i++) {
          this.loadingTextEl.textContent = `Extracting text: Page ${i} of ${numPages}...`;
          
          const page = await pdf.getPage(i);
          const textContent = await page.getTextContent();
          
          // Group items by vertical lines (y coordinate)
          const items = textContent.items;
          const lines: Record<number, any[]> = {};
          
          for (const item of items) {
            // Each item has item.transform: [scaleX, skewX, skewY, scaleY, x, y]
            // We round y coordinates to group items aligned on the same horizontal line.
            const matrix = (item as any).transform;
            if (!matrix) continue;
            const x = matrix[4];
            const y = Math.round(matrix[5] / 3) * 3; // 3pt vertical tolerance

            if (!lines[y]) {
              lines[y] = [];
            }
            lines[y].push({ x, text: (item as any).str });
          }

          // Sort lines descending (top of page is highest y value in PDF space)
          const sortedY = Object.keys(lines).map(Number).sort((a, b) => b - a);
          
          let pageText = '';
          for (const y of sortedY) {
            // Sort items on this line from left to right
            const lineItems = lines[y].sort((a, b) => a.x - b.x);
            const lineText = lineItems.map(item => item.text).join(' ').trim();
            
            if (lineText) {
              // Heuristic for heading: short length, uppercase
              if (detectHeadings && lineText.length < 50 && lineText === lineText.toUpperCase() && lineText.length > 3) {
                pageText += `<h2>${lineText}</h2>\n`;
              } else {
                pageText += `<p>${lineText}</p>\n`;
              }
            }
          }

          htmlContent += `<!-- Start Page ${i} -->\n` + pageText;
          if (pageBreaks && i < numPages) {
            htmlContent += '<div class="page-break"></div>\n';
          }
        }

        htmlContent += `
        </body>
        </html>
        `;

        // Create Blob for Word
        const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/msword' });
        const url = URL.createObjectURL(blob);

        this.downloadBtnEl.href = url;
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        this.downloadBtnEl.download = `${baseName}_converted.doc`;

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error converting PDF to Word: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('pdf-word-tool')) {
    customElements.define('pdf-word-tool', PdfToWordTool);
  }
</script>
