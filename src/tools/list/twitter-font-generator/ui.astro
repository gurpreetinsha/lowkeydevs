---
import Icon from '../../../components/base/Icon.astro';
---

<twitter-font-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="tw-input" 
        placeholder="Type or paste your tweet text here..." 
        aria-label="Twitter Text Input"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          Clear
        </button>
      </div>
    </div>

    <!-- Twitter Post Simulator -->
    <div class="editor-pane glass-panel simulator-pane">
      <div class="pane-header">
        <span class="pane-title">Twitter/X Post Preview</span>
      </div>
      
      <div class="tw-mock-tweet">
        <div class="tw-tweet-top">
          <div class="tw-avatar"></div>
          <div class="tw-user-info">
            <div class="tw-names-verified">
              <span class="tw-display-name">Aesthetic Tweeter</span>
              <span class="tw-verified-badge">✓</span>
            </div>
            <span class="tw-handle">@lowkey_tweeter</span>
          </div>
          <span class="tw-brand-logo">𝕏</span>
        </div>

        <div class="tw-tweet-body" id="tw-preview-body">
          Type on the left to preview your tweet styling here...
        </div>

        <div class="tw-tweet-timestamp">
          <span>12:02 PM • Jul 5, 2026</span>
          <span>•</span>
          <span class="tw-view-count"><strong style="color: #ffffff;">482.4K</strong> Views</span>
        </div>

        <div class="tw-tweet-metrics">
          <span><strong>12.4K</strong> Likes</span>
          <span><strong>2.8K</strong> Reposts</span>
          <span><strong>842</strong> Bookmarks</span>
        </div>

        <div class="tw-tweet-actions">
          <button class="tw-action-btn">💬</button>
          <button class="tw-action-btn">🔁</button>
          <button class="tw-action-btn">❤️</button>
          <button class="tw-action-btn">🔖</button>
          <button class="tw-action-btn">📤</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="results-section glass-panel">
    <h3 class="section-title">Copy Twitter Fonts</h3>
    
    <div class="results-list" id="tw-results">
      <div class="empty-state">
        Type some text above to see stylish Twitter fonts...
      </div>
    </div>
  </div>
</twitter-font-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 400px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #tw-input {
    flex: 1;
    width: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Twitter Mock */
  .simulator-pane {
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tw-mock-tweet {
    width: 100%;
    max-width: 340px;
    background: #000000; /* X/Twitter Black Theme */
    border: 1px solid #2f3336;
    border-radius: 16px;
    color: #e7e9ea;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .tw-tweet-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
  }

  .tw-avatar {
    width: 40px;
    height: 40px;
    background: #2f3336;
    border-radius: 50%;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%2371767b"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4.42 0-8 2-8 5v1h16v-1c0-3-3.58-5-8-5z"/></svg>');
    background-size: 60%;
    background-position: center;
    background-repeat: no-repeat;
  }

  .tw-user-info {
    display: flex;
    flex-direction: column;
  }

  .tw-names-verified {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .tw-display-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: #e7e9ea;
  }

  .tw-verified-badge {
    color: #1d9bf0; /* Twitter Blue */
    font-size: 0.75rem;
    font-weight: bold;
    background: transparent;
  }

  .tw-handle {
    font-size: 0.8rem;
    color: #71767b;
  }

  .tw-brand-logo {
    position: absolute;
    right: 0;
    top: 0;
    color: #e7e9ea;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .tw-tweet-body {
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    color: #e7e9ea;
  }

  .tw-tweet-timestamp {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #71767b;
    border-bottom: 1px solid #2f3336;
    padding-bottom: 0.75rem;
  }

  .tw-tweet-metrics {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: #71767b;
    border-bottom: 1px solid #2f3336;
    padding-bottom: 0.75rem;
  }

  .tw-tweet-metrics strong {
    color: #e7e9ea;
  }

  .tw-tweet-actions {
    display: flex;
    justify-content: space-between;
    padding: 0 0.5rem;
    color: #71767b;
    font-size: 0.9rem;
  }

  .tw-action-btn {
    background: none;
    border: none;
    color: #71767b;
    cursor: pointer;
    transition: color 0.2s;
  }

  .tw-action-btn:hover {
    color: #1d9bf0;
  }

  /* Results List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateTwitterFonts } from './logic';

  class TwitterFontTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private resultsEl!: HTMLDivElement;
    private previewBodyEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#tw-input') as HTMLTextAreaElement;
      this.resultsEl = this.querySelector('#tw-results') as HTMLDivElement;
      this.previewBodyEl = this.querySelector('#tw-preview-body') as HTMLDivElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private handleUpdate() {
      const text = this.inputEl.value;

      if (!text) {
        this.previewBodyEl.textContent = 'Type on the left to preview your tweet styling here...';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see stylish Twitter fonts...
          </div>
        `;
        return;
      }

      const fonts = generateTwitterFonts(text);
      this.previewBodyEl.textContent = text;

      this.resultsEl.innerHTML = fonts.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="tw-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = '🧵 Here is a short thread on building clean web interfaces...';
      this.handleUpdate();
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#tw-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      
      try {
        await navigator.clipboard.writeText(text);
        
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied-btn');

        this.previewBodyEl.textContent = text;

        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('twitter-font-tool')) {
    customElements.define('twitter-font-tool', TwitterFontTool);
  }
</script>
