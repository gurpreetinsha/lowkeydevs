---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<rand-pwd-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="control-row">
          <div class="control-header">
            <label for="pwd-length" class="label">Password Length</label>
            <span id="length-val" class="qty-display">16</span>
          </div>
          <input type="range" id="pwd-length" min="6" max="64" value="16" class="slider" />
        </div>
        <div class="control-row">
          <div class="control-header">
            <label for="pwd-qty" class="label">{t('common.Quantity')}</label>
            <span id="qty-val" class="qty-display">5</span>
          </div>
          <input type="range" id="pwd-qty" min="1" max="50" value="5" class="slider" />
        </div>
      </div>

      <div class="options-grid">
        <label class="checkbox-container">
          <input type="checkbox" id="opt-lower" checked />
          <span class="checkmark"></span>
          Lowercase (a-z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-upper" checked />
          <span class="checkmark"></span>
          Uppercase (A-Z)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-numbers" checked />
          <span class="checkmark"></span>
          Numbers (0-9)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-symbols" checked />
          <span class="checkmark"></span>
          Symbols (!@#$...)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-similar" />
          <span class="checkmark"></span>
          Exclude Similar (e.g. 1, l, 0, O)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-ambiguous" />
          <span class="checkmark"></span>
          Exclude Ambiguous (e.g. { } [ ])
        </label>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Key" size={18} />
          Generate Passwords
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated Passwords</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy All')}</span>
        </button>
      </div>
      <textarea
        id="pwd-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated passwords will appear here..."
        aria-label="Generated passwords output"
      ></textarea>
    </div>
  </div>
</rand-pwd-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-display {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .slider {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    outline: none;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  .slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 18px;
    width: 18px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--accent);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--accent);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
  }

  .btn-generate {
    width: 100%;
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .output-textarea {
    min-height: 180px;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generatePasswords } from './logic';

  class RandPwdTool extends HTMLElement {
    private lenSlider!: HTMLInputElement;
    private qtySlider!: HTMLInputElement;
    private lenVal!: HTMLElement;
    private qtyVal!: HTMLElement;
    private optLower!: HTMLInputElement;
    private optUpper!: HTMLInputElement;
    private optNumbers!: HTMLInputElement;
    private optSymbols!: HTMLInputElement;
    private optSimilar!: HTMLInputElement;
    private optAmbiguous!: HTMLInputElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.lenSlider = this.querySelector('#pwd-length') as HTMLInputElement;
      this.qtySlider = this.querySelector('#pwd-qty') as HTMLInputElement;
      this.lenVal = this.querySelector('#length-val') as HTMLElement;
      this.qtyVal = this.querySelector('#qty-val') as HTMLElement;
      this.optLower = this.querySelector('#opt-lower') as HTMLInputElement;
      this.optUpper = this.querySelector('#opt-upper') as HTMLInputElement;
      this.optNumbers = this.querySelector('#opt-numbers') as HTMLInputElement;
      this.optSymbols = this.querySelector('#opt-symbols') as HTMLInputElement;
      this.optSimilar = this.querySelector('#opt-similar') as HTMLInputElement;
      this.optAmbiguous = this.querySelector('#opt-ambiguous') as HTMLInputElement;
      this.outputEl = this.querySelector('#pwd-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Update slider values
      this.lenSlider.addEventListener('input', () => {
        this.lenVal.textContent = this.lenSlider.value;
      });
      this.qtySlider.addEventListener('input', () => {
        this.qtyVal.textContent = this.qtySlider.value;
      });

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      this.handleGenerate();
    }

    private handleGenerate() {
      const length = parseInt(this.lenSlider.value, 10);
      const quantity = parseInt(this.qtySlider.value, 10);
      const uppercase = this.optUpper.checked;
      const lowercase = this.optLower.checked;
      const numbers = this.optNumbers.checked;
      const symbols = this.optSymbols.checked;
      const excludeSimilar = this.optSimilar.checked;
      const excludeAmbiguous = this.optAmbiguous.checked;

      if (!uppercase && !lowercase && !numbers && !symbols) {
        this.outputEl.value = 'Please select at least one character set.';
        return;
      }

      const list = generatePasswords({
        length, quantity, uppercase, lowercase, numbers, symbols, excludeSimilar, excludeAmbiguous
      });
      this.outputEl.value = list.join('\n');
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy All') || 'Copy All');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy passwords', err);
      }
    }
  }

  if (!customElements.get('rand-pwd-tool')) {
    customElements.define('rand-pwd-tool', RandPwdTool);
  }
</script>
