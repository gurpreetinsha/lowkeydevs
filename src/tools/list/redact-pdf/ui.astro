---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF.js and PDFLib from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<redact-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Redact PDF</h3>
      <p class="converter-subtitle">Visually cover and sanitize sensitive information in PDF files completely in your browser.</p>
    </div>

    <!-- Dropzone -->
    <div class="dropzone" id="redact-dropzone">
      <input type="file" id="redact-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF to redact" />
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files</p>
      </div>
    </div>

    <!-- Interface -->
    <div class="config-panel hidden" id="redact-interface">
      <div class="redact-toolbar">
        <div class="toolbar-left">
          <span class="toolbar-label">Color:</span>
          <div class="color-picker">
            <button class="color-btn active" data-color="#000000" style="background-color: #000000;" title="Black"></button>
            <button class="color-btn" data-color="#ffffff" style="background-color: #ffffff; border: 1px solid var(--border);" title="White"></button>
            <button class="color-btn" data-color="#7f7f7f" style="background-color: #7f7f7f;" title="Gray"></button>
            <button class="color-btn" data-color="#ff0000" style="background-color: #ff0000;" title="Red"></button>
          </div>
        </div>

        <div class="toolbar-right">
          <button id="btn-clear-page" class="btn btn-secondary btn-sm">Clear Page</button>
        </div>
      </div>

      <!-- Canvas viewport -->
      <div class="canvas-viewport">
        <div class="canvas-container" id="canvas-container">
          <canvas id="pdf-canvas"></canvas>
          <canvas id="overlay-canvas"></canvas>
        </div>
      </div>

      <!-- Navigation & Actions -->
      <div class="editor-nav-bar">
        <button id="btn-prev" class="btn btn-secondary btn-sm" disabled>Prev Page</button>
        <span class="page-indicator"><span id="page-num">1</span> / <span id="page-total">1</span></span>
        <button id="btn-next" class="btn btn-secondary btn-sm" disabled>Next Page</button>
      </div>

      <div class="converter-actions">
        <button id="btn-apply-redact" class="btn btn-danger btn-lg">
          Apply & Download Redacted PDF
        </button>
        <button id="btn-cancel" class="btn btn-secondary">
          Cancel
        </button>
      </div>
    </div>

    <!-- Loading / Status -->
    <div class="converter-loading hidden" id="redact-loading-panel">
      <div class="spinner"></div>
      <p id="loading-status">Applying redaction overlays...</p>
    </div>

    <!-- Results Panel -->
    <div class="converter-results hidden" id="redact-results-panel">
      <div class="divider"></div>
      
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Redactions Applied Safely!
      </div>

      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Sanitized PDF
        </a>
      </div>
    </div>
  </div>
</redact-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .config-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .redact-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .toolbar-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .color-picker {
    display: flex;
    gap: 0.5rem;
  }

  .color-btn {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .color-btn:hover {
    transform: scale(1.1);
  }

  .color-btn.active {
    border-color: var(--accent);
    transform: scale(1.15);
  }

  .canvas-viewport {
    display: flex;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow: auto;
    max-height: 500px;
    border: 1px solid var(--border);
  }

  .canvas-container {
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  #overlay-canvas {
    position: absolute;
    top: 0;
    left: 0;
    cursor: crosshair;
    z-index: 10;
  }

  .editor-nav-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .page-indicator {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .converter-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--success-subtle);
    color: var(--success);
  }

  .download-box {
    display: flex;
    justify-content: center;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  interface RedactBox {
    x: number; // percentage width
    y: number; // percentage height
    w: number; // percentage width
    h: number; // percentage height
    color: string; // hex color
  }

  class RedactPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private interfaceEl!: HTMLDivElement;
    private canvasContainerEl!: HTMLDivElement;
    private pdfCanvasEl!: HTMLCanvasElement;
    private overlayCanvasEl!: HTMLCanvasElement;

    private btnPrevEl!: HTMLButtonElement;
    private btnNextEl!: HTMLButtonElement;
    private pageNumEl!: HTMLSpanElement;
    private pageTotalEl!: HTMLSpanElement;
    private btnClearPageEl!: HTMLButtonElement;
    private btnApplyRedactEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnDownloadEl!: HTMLAnchorElement;

    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;

    private selectedFile: File | null = null;
    private pdfjsDoc: any = null;
    private currentPage = 1;
    private totalPages = 0;
    private activeColor = '#000000';

    // Store redactions per page (1-based index keys)
    private redactions: Record<number, RedactBox[]> = {};

    // Mouse drag state
    private isDrawing = false;
    private startX = 0;
    private startY = 0;
    private currentX = 0;
    private currentY = 0;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#redact-file-input')!;
      this.dropzoneEl = this.querySelector('#redact-dropzone')!;
      this.interfaceEl = this.querySelector('#redact-interface')!;
      this.canvasContainerEl = this.querySelector('#canvas-container')!;
      this.pdfCanvasEl = this.querySelector('#pdf-canvas')!;
      this.overlayCanvasEl = this.querySelector('#overlay-canvas')!;

      this.btnPrevEl = this.querySelector('#btn-prev')!;
      this.btnNextEl = this.querySelector('#btn-next')!;
      this.pageNumEl = this.querySelector('#page-num')!;
      this.pageTotalEl = this.querySelector('#page-total')!;
      this.btnClearPageEl = this.querySelector('#btn-clear-page')!;
      this.btnApplyRedactEl = this.querySelector('#btn-apply-redact')!;
      this.btnCancelEl = this.querySelector('#btn-cancel')!;
      this.btnDownloadEl = this.querySelector('#btn-download')!;

      this.loadingPanelEl = this.querySelector('#redact-loading-panel')!;
      this.resultsPanelEl = this.querySelector('#redact-results-panel')!;

      // Bind events
      this.fileInputEl.addEventListener('change', (e) => this.handleFileSelect(e));
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });
      this.dropzoneEl.addEventListener('dragleave', () => this.dropzoneEl.classList.remove('dragover'));
      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });

      this.btnPrevEl.addEventListener('click', () => this.changePage(-1));
      this.btnNextEl.addEventListener('click', () => this.changePage(1));
      this.btnClearPageEl.addEventListener('click', () => this.clearCurrentPageRedactions());
      this.btnApplyRedactEl.addEventListener('click', () => this.applyRedactions());
      this.btnCancelEl.addEventListener('click', () => this.reset());

      // Color picker mapping
      this.querySelectorAll('.color-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          this.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
          const target = e.target as HTMLButtonElement;
          target.classList.add('active');
          this.activeColor = target.dataset.color || '#000000';
        });
      });

      // Canvas Mouse Drag events
      this.overlayCanvasEl.addEventListener('mousedown', (e) => this.startDrawing(e));
      this.overlayCanvasEl.addEventListener('mousemove', (e) => this.draw(e));
      window.addEventListener('mouseup', () => this.stopDrawing());
    }

    private handleFileSelect(e: Event) {
      const target = e.target as HTMLInputElement;
      if (target.files?.length) {
        this.processFile(target.files[0]);
      }
    }

    private async processFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;

      if (typeof window.pdfjsLib === 'undefined' || typeof window.PDFLib === 'undefined') {
        alert('Libraries are loading. Please try again.');
        return;
      }

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        const arrayBuffer = await file.arrayBuffer();
        const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        this.pdfjsDoc = await loadingTask.promise;
        this.totalPages = this.pdfjsDoc.numPages;
        this.currentPage = 1;
        this.redactions = {};

        this.pageTotalEl.textContent = this.totalPages.toString();

        await this.renderCurrentPage();

        this.loadingPanelEl.classList.add('hidden');
        this.interfaceEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to load PDF in editor viewport.');
        this.reset();
      }
    }

    private async renderCurrentPage() {
      if (!this.pdfjsDoc) return;

      this.pageNumEl.textContent = this.currentPage.toString();
      this.btnPrevEl.disabled = this.currentPage === 1;
      this.btnNextEl.disabled = this.currentPage === this.totalPages;

      const page = await this.pdfjsDoc.getPage(this.currentPage);
      const viewport = page.getViewport({ scale: 1.25 }); // scale for screen size

      this.pdfCanvasEl.width = viewport.width;
      this.pdfCanvasEl.height = viewport.height;
      this.overlayCanvasEl.width = viewport.width;
      this.overlayCanvasEl.height = viewport.height;

      const ctx = this.pdfCanvasEl.getContext('2d')!;
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, viewport.width, viewport.height);

      await page.render({ canvasContext: ctx, viewport }).promise;

      this.drawExistingRedactions();
    }

    private drawExistingRedactions() {
      const ctx = this.overlayCanvasEl.getContext('2d')!;
      ctx.clearRect(0, 0, this.overlayCanvasEl.width, this.overlayCanvasEl.height);

      const list = this.redactions[this.currentPage] || [];
      list.forEach(box => {
        ctx.fillStyle = box.color;
        ctx.fillRect(
          box.x * this.overlayCanvasEl.width,
          box.y * this.overlayCanvasEl.height,
          box.w * this.overlayCanvasEl.width,
          box.h * this.overlayCanvasEl.height
        );
      });
    }

    private startDrawing(e: MouseEvent) {
      this.isDrawing = true;
      const rect = this.overlayCanvasEl.getBoundingClientRect();
      this.startX = e.clientX - rect.left;
      this.startY = e.clientY - rect.top;
      this.currentX = this.startX;
      this.currentY = this.startY;
    }

    private draw(e: MouseEvent) {
      if (!this.isDrawing) return;
      const rect = this.overlayCanvasEl.getBoundingClientRect();
      this.currentX = e.clientX - rect.left;
      this.currentY = e.clientY - rect.top;

      this.drawExistingRedactions();

      // Render drag box preview
      const ctx = this.overlayCanvasEl.getContext('2d')!;
      ctx.fillStyle = this.activeColor;
      ctx.globalAlpha = 0.6; // Transparent preview
      ctx.fillRect(
        Math.min(this.startX, this.currentX),
        Math.min(this.startY, this.currentY),
        Math.abs(this.startX - this.currentX),
        Math.abs(this.startY - this.currentY)
      );
      ctx.globalAlpha = 1.0;
    }

    private stopDrawing() {
      if (!this.isDrawing) return;
      this.isDrawing = false;

      const boxW = Math.abs(this.startX - this.currentX);
      const boxH = Math.abs(this.startY - this.currentY);

      // Only save if box has size
      if (boxW > 4 && boxH > 4) {
        if (!this.redactions[this.currentPage]) {
          this.redactions[this.currentPage] = [];
        }

        const xMin = Math.min(this.startX, this.currentX);
        const yMin = Math.min(this.startY, this.currentY);

        this.redactions[this.currentPage].push({
          x: xMin / this.overlayCanvasEl.width,
          y: yMin / this.overlayCanvasEl.height,
          w: boxW / this.overlayCanvasEl.width,
          h: boxH / this.overlayCanvasEl.height,
          color: this.activeColor
        });
      }

      this.drawExistingRedactions();
    }

    private clearCurrentPageRedactions() {
      this.redactions[this.currentPage] = [];
      this.drawExistingRedactions();
    }

    private async changePage(dir: number) {
      const target = this.currentPage + dir;
      if (target >= 1 && target <= this.totalPages) {
        this.currentPage = target;
        await this.renderCurrentPage();
      }
    }

    private async applyRedactions() {
      if (!this.selectedFile) return;

      this.interfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        const { PDFDocument, rgb } = window.PDFLib;
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);
        const pages = pdfDoc.getPages();

        const hexToRgb = (hex: string) => {
          const r = parseInt(hex.substring(1, 3), 16) / 255;
          const g = parseInt(hex.substring(3, 5), 16) / 255;
          const b = parseInt(hex.substring(5, 7), 16) / 255;
          return rgb(r, g, b);
        };

        // Draw solid rectangles on the PDF pages
        Object.keys(this.redactions).forEach(pageNumStr => {
          const pageNum = parseInt(pageNumStr, 10);
          const page = pages[pageNum - 1];
          if (!page) return;

          const boxes = this.redactions[pageNum] || [];
          const { width: pageW, height: pageH } = page.getSize();

          boxes.forEach(box => {
            // PDF coordinates have origin at bottom-left
            // pdfX = box.x * pageW
            // pdfY = pageH - (box.y * pageH) - (box.h * pageH)
            const pdfX = box.x * pageW;
            const pdfY = pageH - (box.y * pageH) - (box.h * pageH);
            const pdfW = box.w * pageW;
            const pdfH = box.h * pageH;

            page.drawRectangle({
              x: pdfX,
              y: pdfY,
              width: pdfW,
              height: pdfH,
              color: hexToRgb(box.color)
            });
          });
        });

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        this.btnDownloadEl.href = url;
        this.btnDownloadEl.download = `${this.selectedFile.name.replace('.pdf', '')}_redacted.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.resultsPanelEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to apply redactions to PDF file stream.');
        this.loadingPanelEl.classList.add('hidden');
        this.interfaceEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.pdfjsDoc = null;
      this.currentPage = 1;
      this.totalPages = 0;
      this.redactions = {};
      this.fileInputEl.value = '';

      this.interfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.dropzoneEl.classList.remove('hidden');
    }
  }

  if (!customElements.get('redact-pdf-tool')) {
    customElements.define('redact-pdf-tool', RedactPdfTool);
  }
</script>
