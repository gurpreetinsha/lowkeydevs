---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<roman-dates-tool class="tool-workspace">
  <!-- Controls Panel -->
  <div class="tool-controls glass-panel">
    <div class="control-actions">
      <!-- Mode Toggle -->
      <div class="toggle-group">
        <button class="toggle-btn active" data-mode="to-roman">Date ➜ Roman</button>
        <button class="toggle-btn" data-mode="from-roman">Roman ➜ Date</button>
      </div>

      <!-- Format selector -->
      <div class="control-group">
        <label for="format-select" class="label">Format:</label>
        <select id="format-select" class="select select-compact">
          <option value="MDY">Month/Day/Year</option>
          <option value="DMY">Day/Month/Year</option>
          <option value="YMD">Year/Month/Day</option>
        </select>
      </div>

      <!-- Separator selector -->
      <div class="control-group">
        <label for="separator-select" class="label">Separator:</label>
        <select id="separator-select" class="select select-compact">
          <option value=".">Dot (.)</option>
          <option value="/">Slash (/)</option>
          <option value="-">Hyphen (-)</option>
          <option value=" ">Space ( )</option>
        </select>
      </div>
    </div>
    <div class="control-danger">
      <button data-action="clear" class="btn btn-danger btn-sm">
        <Icon name="Trash2" size={14} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <!-- Main Work area -->
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="input-label">Input Date</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      
      <!-- Container for dynamic input types -->
      <div class="input-container">
        <input 
          type="date" 
          id="date-picker" 
          class="input"
          aria-label="Date Picker Input"
        />
        <input 
          type="text" 
          id="text-input" 
          class="input hidden" 
          placeholder="e.g. VII.V.MMXXVI"
          aria-label="Manual Date Input"
        />
      </div>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">{t('common.Result')}</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      <textarea
        id="text-output"
        readonly
        placeholder="Converted date will appear here..."
        aria-label="Result Output"
      ></textarea>
    </div>
  </div>
</roman-dates-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 250px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .input-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .hidden {
    display: none !important;
  }

  #text-output {
    flex: 1;
    width: 100%;
    min-height: 120px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    resize: none;
    outline: none;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
  }

  /* Toggle Group */
  .toggle-group {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .toggle-btn {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface);
    border: none;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
    background: var(--surface-hover);
  }

  .toggle-btn.active {
    background: var(--accent);
    color: var(--accent-on);
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { convertDateToRoman, convertRomanToDate, type RomanDateOptions } from './logic';

  class RomanDatesTool extends HTMLElement {
    private datePicker!: HTMLInputElement;
    private textInput!: HTMLInputElement;
    private textOutput!: HTMLTextAreaElement;
    private formatSelect!: HTMLSelectElement;
    private sepSelect!: HTMLSelectElement;
    private inputLabel!: HTMLElement;
    private btnCopy!: HTMLButtonElement;
    private mode = 'to-roman';

    connectedCallback() {
      this.datePicker = this.querySelector('#date-picker') as HTMLInputElement;
      this.textInput = this.querySelector('#text-input') as HTMLInputElement;
      this.textOutput = this.querySelector('#text-output') as HTMLTextAreaElement;
      this.formatSelect = this.querySelector('#format-select') as HTMLSelectElement;
      this.sepSelect = this.querySelector('#separator-select') as HTMLSelectElement;
      this.inputLabel = this.querySelector('#input-label') as HTMLElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Event Listeners
      this.datePicker.addEventListener('change', () => this.handleConvert());
      this.textInput.addEventListener('input', () => this.handleConvert());
      this.formatSelect.addEventListener('change', () => this.handleConvert());
      this.sepSelect.addEventListener('change', () => this.handleConvert());

      // Toggle mode
      const toggleBtns = this.querySelectorAll('.toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          toggleBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.mode = btn.getAttribute('data-mode') || 'to-roman';
          
          if (this.mode === 'to-roman') {
            this.datePicker.classList.remove('hidden');
            this.textInput.classList.add('hidden');
            this.inputLabel.textContent = 'Input Date';
            this.textOutput.placeholder = 'Roman numerals date will appear here...';
          } else {
            this.datePicker.classList.add('hidden');
            this.textInput.classList.remove('hidden');
            this.inputLabel.textContent = 'Input Roman Numeral Date';
            this.textOutput.placeholder = 'Standard date will appear here...';
          }
          this.handleConvert();
        });
      });

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (action === 'copy') this.handleCopy();
      });

      // Default date
      const today = new Date().toISOString().split('T')[0];
      this.datePicker.value = today;
      this.handleConvert();
    }

    private handleConvert() {
      const format = this.formatSelect.value as RomanDateOptions['format'];
      const separator = this.sepSelect.value;
      const options = { format, separator };

      if (this.mode === 'to-roman') {
        const dateVal = this.datePicker.value;
        this.textOutput.value = convertDateToRoman(dateVal, options);
      } else {
        const romanVal = this.textInput.value;
        this.textOutput.value = convertRomanToDate(romanVal, options);
      }
    }

    private handleClear() {
      if (this.mode === 'to-roman') {
        this.datePicker.value = '';
      } else {
        this.textInput.value = '';
      }
      this.textOutput.value = '';
    }

    private handleLoadSample() {
      if (this.mode === 'to-roman') {
        this.datePicker.value = '1999-12-25';
      } else {
        const sep = this.sepSelect.value;
        if (this.formatSelect.value === 'DMY') {
          this.textInput.value = ['XXV', 'XII', 'MCMXCIX'].join(sep);
        } else if (this.formatSelect.value === 'YMD') {
          this.textInput.value = ['MCMXCIX', 'XII', 'XXV'].join(sep);
        } else {
          this.textInput.value = ['XII', 'XXV', 'MCMXCIX'].join(sep);
        }
      }
      this.handleConvert();
    }

    private async handleCopy() {
      const text = this.textOutput.value;
      if (!text || text.startsWith('Invalid')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text', err);
      }
    }
  }

  if (!customElements.get('roman-dates-tool')) {
    customElements.define('roman-dates-tool', RomanDatesTool);
  }
</script>
