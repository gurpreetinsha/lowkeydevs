---
import Icon from '../../../components/base/Icon.astro';
---

<facebook-font-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="fb-input" 
        placeholder="Type or paste your Facebook post text here..." 
        aria-label="Facebook Text Input"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          Clear
        </button>
      </div>
    </div>

    <!-- Facebook Post Simulator -->
    <div class="editor-pane glass-panel simulator-pane">
      <div class="pane-header">
        <span class="pane-title">Facebook Post Preview</span>
      </div>
      
      <div class="fb-mock-post">
        <div class="fb-post-header">
          <div class="fb-avatar"></div>
          <div class="fb-user-details">
            <span class="fb-author-name">Lowkey Devs User</span>
            <div class="fb-time-privacy">
              <span class="fb-time">Just now</span>
              <span class="fb-privacy-globe">🌐</span>
            </div>
          </div>
          <span class="fb-dots">•••</span>
        </div>

        <div class="fb-post-body" id="fb-preview-body">
          Type on the left to preview your post styling here...
        </div>

        <div class="fb-post-stats">
          <span class="fb-likes-badge">👍❤️ 1.4k</span>
          <span class="fb-comments-shares">124 Comments • 45 Shares</span>
        </div>

        <div class="fb-post-actions">
          <button class="fb-action-btn"><span class="fb-action-icon">👍</span> Like</button>
          <button class="fb-action-btn"><span class="fb-action-icon">💬</span> Comment</button>
          <button class="fb-action-btn"><span class="fb-action-icon">↩️</span> Share</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="results-section glass-panel">
    <h3 class="section-title">Copy Facebook Fonts</h3>
    
    <div class="results-list" id="fb-results">
      <div class="empty-state">
        Type some text above to see stylish Facebook fonts...
      </div>
    </div>
  </div>
</facebook-font-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 400px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #fb-input {
    flex: 1;
    width: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Facebook Post Mock */
  .simulator-pane {
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fb-mock-post {
    width: 100%;
    max-width: 340px;
    background: #242526; /* Facebook Dark Mode */
    border: 1px solid #3e4042;
    border-radius: 12px;
    color: #e4e6eb;
    font-family: Segoe UI, Helvetica, Arial, sans-serif;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .fb-post-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
  }

  .fb-avatar {
    width: 38px;
    height: 38px;
    background: #3e4042;
    border-radius: 50%;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%238e8e8e"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-3-3.58-5-8-5z"/></svg>');
    background-size: 60%;
    background-position: center;
    background-repeat: no-repeat;
  }

  .fb-user-details {
    display: flex;
    flex-direction: column;
  }

  .fb-author-name {
    font-weight: 600;
    font-size: 0.85rem;
    color: #e4e6eb;
  }

  .fb-time-privacy {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    color: #b0b3b8;
  }

  .fb-dots {
    position: absolute;
    right: 0;
    top: 2px;
    color: #b0b3b8;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .fb-post-body {
    font-size: 0.9rem;
    line-height: 1.4;
    white-space: pre-wrap;
    word-break: break-word;
    color: #e4e6eb;
    margin: 0.25rem 0;
  }

  .fb-post-stats {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #b0b3b8;
    border-bottom: 1px solid #3e4042;
    padding-bottom: 0.5rem;
  }

  .fb-post-actions {
    display: flex;
    justify-content: space-around;
    padding-top: 0.15rem;
  }

  .fb-action-btn {
    flex: 1;
    background: none;
    border: none;
    color: #b0b3b8;
    font-weight: 600;
    font-size: 0.8rem;
    padding: 0.45rem;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: background 0.2s;
  }

  .fb-action-btn:hover {
    background: #3a3b3c;
    color: #ffffff;
  }

  .fb-action-icon {
    font-size: 0.95rem;
  }

  /* Results List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateFacebookFonts } from './logic';

  class FacebookFontTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private resultsEl!: HTMLDivElement;
    private previewBodyEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#fb-input') as HTMLTextAreaElement;
      this.resultsEl = this.querySelector('#fb-results') as HTMLDivElement;
      this.previewBodyEl = this.querySelector('#fb-preview-body') as HTMLDivElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private handleUpdate() {
      const text = this.inputEl.value;

      if (!text) {
        this.previewBodyEl.textContent = 'Type on the left to preview your post styling here...';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see stylish Facebook fonts...
          </div>
        `;
        return;
      }

      const fonts = generateFacebookFonts(text);
      this.previewBodyEl.textContent = text;

      this.resultsEl.innerHTML = fonts.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="fb-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = '🔥 Special Announcement: Check out our launch!';
      this.handleUpdate();
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#fb-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      
      try {
        await navigator.clipboard.writeText(text);
        
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied-btn');

        this.previewBodyEl.textContent = text;

        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('facebook-font-tool')) {
    customElements.define('facebook-font-tool', FacebookFontTool);
  }
</script>
