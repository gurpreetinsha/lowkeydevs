---
import { DENSITY_RAMPS } from './logic';
import Icon from '../../../components/base/Icon.astro';
---

<image-ascii-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input & Controls Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Upload Image & Settings</span>
      </div>

      <!-- Dropzone -->
      <div class="dropzone" id="ascii-dropzone">
        <input type="file" id="ascii-file-input" accept="image/*" class="hidden-input" aria-label="Upload source image" />
        
        <div class="dropzone-content" id="ascii-idle-state">
          <Icon name="Image" size={40} />
          <p class="dropzone-text">Drop image or <span>browse</span></p>
        </div>

        <div class="preview-state hidden" id="ascii-preview-state">
          <img id="ascii-preview-img" src="" alt="Source preview" />
          <button class="btn-remove-preview" id="btn-remove-ascii" aria-label="Clear selection">✕</button>
        </div>
      </div>

      <!-- Settings Panel -->
      <div class="settings-panel">
        <div class="setting-row">
          <label for="ascii-width">ASCII Width (chars):</label>
          <input type="range" id="ascii-width" min="40" max="150" value="80" aria-label="ASCII Output Width" />
          <span class="val-display" id="width-val">80</span>
        </div>

        <div class="setting-row">
          <label for="ascii-ramp">Character Set:</label>
          <select id="ascii-ramp" aria-label="ASCII Character Set Selector">
            <option value="standard">Standard Detailed</option>
            <option value="short">Short Simple</option>
            <option value="blocks">Blocks (Solid Shading)</option>
            <option value="minimal">Minimal (#+-.)</option>
          </select>
        </div>

        <div class="setting-row">
          <label for="ascii-color">Color Mode:</label>
          <select id="ascii-color" aria-label="Color Mode Selector">
            <option value="bw">Black & White (Plain Text)</option>
            <option value="color">Full Color (HTML Render)</option>
          </select>
        </div>

        <div class="setting-row">
          <label for="ascii-brightness">Brightness:</label>
          <input type="range" id="ascii-brightness" min="-100" max="100" value="0" aria-label="Luminance adjustment" />
          <span class="val-display" id="brightness-val">0</span>
        </div>

        <div class="setting-row">
          <label for="ascii-contrast">Contrast:</label>
          <input type="range" id="ascii-contrast" min="-100" max="100" value="0" aria-label="Contrast adjustment" />
          <span class="val-display" id="contrast-val">0</span>
        </div>

        <div class="checkbox-row">
          <input type="checkbox" id="ascii-invert" aria-label="Invert Character Brightness Mapping" />
          <label for="ascii-invert">Invert Characters (for dark backgrounds)</label>
        </div>
      </div>

      <button id="btn-generate-ascii" class="btn btn-primary w-full" disabled>
        <Icon name="Sparkles" size={16} />
        Generate ASCII Art
      </button>
    </div>

    <!-- Output Pane -->
    <div class="editor-pane glass-panel output-pane">
      <div class="pane-header">
        <span class="pane-title">ASCII Art Preview</span>
        <div class="pane-actions">
          <button id="btn-copy-ascii" class="btn btn-secondary btn-sm" disabled>
            <Icon name="Copy" size={14} />
            Copy Art
          </button>
          <button id="btn-download-ascii" class="btn btn-secondary btn-sm" disabled>
            <Icon name="Download" size={14} />
            Download
          </button>
        </div>
      </div>

      <div class="ascii-output-container">
        <!-- Render block for ASCII -->
        <pre id="ascii-art-pre">Upload an image and hit generate to render ASCII art here...</pre>
      </div>
    </div>
  </div>
</image-ascii-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    min-height: 520px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .pane-actions {
    display: flex;
    gap: 0.5rem;
  }

  /* Dropzone */
  .dropzone {
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-lg);
    min-height: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    text-align: center;
  }

  .dropzone-text {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--primary-accent);
    text-decoration: underline;
  }

  .preview-state {
    position: absolute;
    width: 100%;
    height: 100%;
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
  }

  #ascii-preview-img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .btn-remove-preview {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.6);
    border: none;
    color: #fff;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.75rem;
  }

  /* Settings */
  .settings-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    padding: 1rem;
    border: 1px solid var(--border-color);
  }

  .setting-row {
    display: grid;
    grid-template-columns: 130px 1fr 40px;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .setting-row select {
    grid-column: 2 / 4;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    outline: none;
  }

  .val-display {
    text-align: right;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .checkbox-row input {
    cursor: pointer;
  }

  .w-full {
    width: 100%;
  }

  .hidden {
    display: none !important;
  }

  /* Output Screen */
  .output-pane {
    background: #000000;
    border-color: #222;
  }

  .output-pane .pane-title {
    color: #888;
  }

  .ascii-output-container {
    flex: 1;
    overflow: auto;
    background: #000000;
    border-radius: var(--radius-md);
    border: 1px solid #111;
    padding: 1rem;
  }

  #ascii-art-pre {
    margin: 0;
    font-family: 'Courier New', Courier, monospace;
    line-height: 1.1;
    letter-spacing: 0.35em; /* Adjust character scaling horizontally */
    font-size: 8px;
    color: #00ff00; /* Default green glow */
    white-space: pre;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { DENSITY_RAMPS } from './logic';

  class ImageASCIITool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private previewStateEl!: HTMLDivElement;
    private previewImgEl!: HTMLImageElement;
    private removeBtn!: HTMLButtonElement;
    private widthInputEl!: HTMLInputElement;
    private widthValEl!: HTMLSpanElement;
    private rampSelectEl!: HTMLSelectElement;
    private colorSelectEl!: HTMLSelectElement;
    private brightnessInputEl!: HTMLInputElement;
    private brightnessValEl!: HTMLSpanElement;
    private contrastInputEl!: HTMLInputElement;
    private contrastValEl!: HTMLSpanElement;
    private invertCheckboxEl!: HTMLInputElement;
    private generateBtn!: HTMLButtonElement;
    private copyBtn!: HTMLButtonElement;
    private downloadBtn!: HTMLButtonElement;
    private artPreEl!: HTMLPreElement;

    private selectedFile: File | null = null;
    private rawPlainTextArt: string = '';

    connectedCallback() {
      this.fileInputEl = this.querySelector('#ascii-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#ascii-dropzone') as HTMLDivElement;
      this.previewStateEl = this.querySelector('#ascii-preview-state') as HTMLDivElement;
      this.previewImgEl = this.querySelector('#ascii-preview-img') as HTMLImageElement;
      this.removeBtn = this.querySelector('#btn-remove-ascii') as HTMLButtonElement;
      
      this.widthInputEl = this.querySelector('#ascii-width') as HTMLInputElement;
      this.widthValEl = this.querySelector('#width-val') as HTMLSpanElement;
      this.rampSelectEl = this.querySelector('#ascii-ramp') as HTMLSelectElement;
      this.colorSelectEl = this.querySelector('#ascii-color') as HTMLSelectElement;
      
      this.brightnessInputEl = this.querySelector('#ascii-brightness') as HTMLInputElement;
      this.brightnessValEl = this.querySelector('#brightness-val') as HTMLSpanElement;
      this.contrastInputEl = this.querySelector('#ascii-contrast') as HTMLInputElement;
      this.contrastValEl = this.querySelector('#contrast-val') as HTMLSpanElement;
      this.invertCheckboxEl = this.querySelector('#ascii-invert') as HTMLInputElement;
      
      this.generateBtn = this.querySelector('#btn-generate-ascii') as HTMLButtonElement;
      this.copyBtn = this.querySelector('#btn-copy-ascii') as HTMLButtonElement;
      this.downloadBtn = this.querySelector('#btn-download-ascii') as HTMLButtonElement;
      this.artPreEl = this.querySelector('#ascii-art-pre') as HTMLPreElement;

      // Event Listeners
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFileSelect(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFileSelect(this.fileInputEl.files[0]);
        }
      });

      this.removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.resetGenerator();
      });

      this.widthInputEl.addEventListener('input', () => {
        this.widthValEl.textContent = this.widthInputEl.value;
      });

      this.brightnessInputEl.addEventListener('input', () => {
        this.brightnessValEl.textContent = this.brightnessInputEl.value;
      });

      this.contrastInputEl.addEventListener('input', () => {
        this.contrastValEl.textContent = this.contrastInputEl.value;
      });

      this.generateBtn.addEventListener('click', () => this.generateASCII());

      this.copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(this.rawPlainTextArt);
        const originalText = this.copyBtn.innerHTML;
        this.copyBtn.textContent = 'Copied!';
        this.copyBtn.classList.add('copied-btn');
        setTimeout(() => {
          this.copyBtn.innerHTML = originalText;
          this.copyBtn.classList.remove('copied-btn');
        }, 1500);
      });

      this.downloadBtn.addEventListener('click', () => {
        const blob = new Blob([this.rawPlainTextArt], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ascii-art-${Date.now()}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    private handleFileSelect(file: File) {
      if (!file.type.startsWith('image/')) {
        alert('Invalid image format.');
        return;
      }
      this.selectedFile = file;
      const reader = new FileReader();
      reader.onload = (e) => {
        this.previewImgEl.src = e.target?.result as string;
        this.previewStateEl.classList.remove('hidden');
        this.generateBtn.disabled = false;
      };
      reader.readAsDataURL(file);
    }

    private resetGenerator() {
      this.selectedFile = null;
      this.fileInputEl.value = '';
      this.previewImgEl.src = '';
      this.previewStateEl.classList.add('hidden');
      this.generateBtn.disabled = true;
      this.copyBtn.disabled = true;
      this.downloadBtn.disabled = true;
      this.artPreEl.innerHTML = 'Upload an image and hit generate to render ASCII art here...';
      this.artPreEl.style.color = '#00ff00';
    }

    private generateASCII() {
      if (!this.selectedFile) return;

      const img = new Image();
      img.onload = () => {
        const asciiWidth = parseInt(this.widthInputEl.value);
        const rampKey = this.rampSelectEl.value as keyof typeof DENSITY_RAMPS;
        const ramp = DENSITY_RAMPS[rampKey];
        const colorMode = this.colorSelectEl.value;
        const brightness = parseInt(this.brightnessInputEl.value);
        const contrast = parseInt(this.contrastInputEl.value);
        const invert = this.invertCheckboxEl.checked;

        // Aspect ratio correction (monospace characters are taller than wide, roughly 1:1.8)
        const charAspectRatio = 0.55;
        const aspect = img.naturalWidth / img.naturalHeight;
        const asciiHeight = Math.round((asciiWidth / aspect) * charAspectRatio);

        // Render to canvas
        const canvas = document.createElement('canvas');
        canvas.width = asciiWidth;
        canvas.height = asciiHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        ctx.drawImage(img, 0, 0, asciiWidth, asciiHeight);
        const imgData = ctx.getImageData(0, 0, asciiWidth, asciiHeight);
        const pixels = imgData.data;

        // Precompute contrast factor
        const factor = (259 * (contrast + 255)) / (255 * (259 - contrast));

        let asciiHtml = '';
        let asciiPlain = '';

        for (let y = 0; y < asciiHeight; y++) {
          for (let x = 0; x < asciiWidth; x++) {
            const index = (y * asciiWidth + x) * 4;
            let r = pixels[index];
            let g = pixels[index + 1];
            let b = pixels[index + 2];

            // Apply contrast
            r = factor * (r - 128) + 128;
            g = factor * (g - 128) + 128;
            b = factor * (b - 128) + 128;

            // Apply brightness
            r += brightness;
            g += brightness;
            b += brightness;

            // Clamp values
            r = Math.max(0, Math.min(255, r));
            g = Math.max(0, Math.min(255, g));
            b = Math.max(0, Math.min(255, b));

            // Calculate luminance
            let luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;

            if (invert) {
              luminance = 255 - luminance;
            }

            // Map luminance to character index
            const charIndex = Math.floor((luminance / 255) * (ramp.length - 1));
            const char = ramp[charIndex] === ' ' ? '&nbsp;' : ramp[charIndex];
            const plainChar = ramp[charIndex];

            if (colorMode === 'color') {
              asciiHtml += `<span style="color: rgb(${Math.round(r)},${Math.round(g)},${Math.round(b)})">${char}</span>`;
            } else {
              asciiHtml += char;
            }

            asciiPlain += plainChar;
          }
          asciiHtml += '\n';
          asciiPlain += '\n';
        }

        this.rawPlainTextArt = asciiPlain;
        this.artPreEl.innerHTML = asciiHtml;

        if (colorMode === 'color') {
          this.artPreEl.style.color = 'inherit';
        } else {
          this.artPreEl.style.color = '#ffffff';
        }

        // Dynamically adjust font-size based on character width to fit container
        if (asciiWidth > 100) {
          this.artPreEl.style.fontSize = '5px';
        } else if (asciiWidth > 70) {
          this.artPreEl.style.fontSize = '7px';
        } else {
          this.artPreEl.style.fontSize = '9px';
        }

        this.copyBtn.disabled = false;
        this.downloadBtn.disabled = false;
      };

      img.src = this.previewImgEl.src;
    }
  }

  if (!customElements.get('image-ascii-tool')) {
    customElements.define('image-ascii-tool', ImageASCIITool);
  }
</script>
