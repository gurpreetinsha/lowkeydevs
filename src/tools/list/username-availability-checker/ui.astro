    'dev-domain': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.53c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>',
    'ai-domain': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.53c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>',
    'app-domain': '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.53c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>',
  };

  class UsernameCheckerTool extends HTMLElement {
    private inputEl!: HTMLInputElement;
    private btnCheckEl!: HTMLButtonElement;
    private btnClearEl!: HTMLButtonElement;
    private statusPanelEl!: HTMLDivElement;
    private statusTextEl!: HTMLSpanElement;
    private scanTimeEl!: HTMLSpanElement;
    private progressBarEl!: HTMLDivElement;
    
    private countAvailableEl!: HTMLSpanElement;
    private countTakenEl!: HTMLSpanElement;
    private countUnknownEl!: HTMLSpanElement;
    
    private resultsGridEl!: HTMLDivElement;
    private favoritesBoxEl!: HTMLDivElement;
    private favoritesListEl!: HTMLDivElement;
    private historyBoxEl!: HTMLDivElement;
    private historyListEl!: HTMLDivElement;

    // Actions
    private btnCopyUsernameEl!: HTMLButtonElement;
    private btnShareEl!: HTMLButtonElement;
    private btnDownloadEl!: HTMLButtonElement;
    private btnFavoriteEl!: HTMLButtonElement;

    // State
    private isScanning = false;
    private results: Array<{ platformId: string; platformName: string; category: string; status: string; profileUrl: string }> = [];
    private favorites: string[] = [];
    private history: string[] = [];
    private searchCache: Record<string, typeof this.results> = {};

    connectedCallback() {
      // Elements lookup
      this.inputEl = this.querySelector('#username-input') as HTMLInputElement;
      this.btnCheckEl = this.querySelector('#btn-check') as HTMLButtonElement;
      this.btnClearEl = this.querySelector('#btn-clear') as HTMLButtonElement;
      this.statusPanelEl = this.querySelector('#status-panel') as HTMLDivElement;
      this.statusTextEl = this.querySelector('#status-text') as HTMLSpanElement;
      this.scanTimeEl = this.querySelector('#scan-time') as HTMLSpanElement;
      this.progressBarEl = this.querySelector('#progress-bar') as HTMLDivElement;
      
      this.countAvailableEl = this.querySelector('#count-available') as HTMLSpanElement;
      this.countTakenEl = this.querySelector('#count-taken') as HTMLSpanElement;
      this.countUnknownEl = this.querySelector('#count-unknown') as HTMLSpanElement;
      
      this.resultsGridEl = this.querySelector('#results-grid') as HTMLDivElement;
      this.favoritesBoxEl = this.querySelector('#favorites-box') as HTMLDivElement;
      this.favoritesListEl = this.querySelector('#favorites-list') as HTMLDivElement;
      this.historyBoxEl = this.querySelector('#history-box') as HTMLDivElement;
      this.historyListEl = this.querySelector('#history-list') as HTMLDivElement;

      this.btnCopyUsernameEl = this.querySelector('#btn-copy-username') as HTMLButtonElement;
      this.btnShareEl = this.querySelector('#btn-share') as HTMLButtonElement;
      this.btnDownloadEl = this.querySelector('#btn-download') as HTMLButtonElement;
      this.btnFavoriteEl = this.querySelector('#btn-favorite') as HTMLButtonElement;

      // Load Favorites & History from LocalStorage
      this.loadStorage();

      // Setup Listeners
      this.btnCheckEl.addEventListener('click', () => this.startSearch());
      this.inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') this.startSearch();
      });
      this.inputEl.addEventListener('input', () => this.handleInputUpdate());
      this.btnClearEl.addEventListener('click', () => {
        this.inputEl.value = '';
        this.handleInputUpdate();
        this.inputEl.focus();
      });

      // Example Pills Click
      this.querySelectorAll('.example-pill').forEach(pill => {
        pill.addEventListener('click', (e) => {
          const username = (e.currentTarget as HTMLButtonElement).getAttribute('data-username') || '';
          this.inputEl.value = username;
          this.handleInputUpdate();
          this.startSearch();
        });
      });

      // Filters Click
      this.querySelectorAll('.filter-pill').forEach(pill => {
        pill.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          this.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          this.applyFilter(btn.getAttribute('data-filter') || 'all');
        });
      });

      // Actions Click
      this.btnCopyUsernameEl.addEventListener('click', () => this.copyUsername());
      this.btnShareEl.addEventListener('click', () => this.shareResults());
      this.btnDownloadEl.addEventListener('click', () => this.downloadJson());
      this.btnFavoriteEl.addEventListener('click', () => this.toggleFavorite());

      // Auto-search if query parameter exists
      const params = new URLSearchParams(window.location.search);
      const queryUsername = params.get('q');
      if (queryUsername) {
        this.inputEl.value = queryUsername;
        this.handleInputUpdate();
        this.startSearch();
      }
    }

    private loadStorage() {
      try {
        this.favorites = JSON.parse(localStorage.getItem('username_checker_favorites') || '[]');
        this.history = JSON.parse(localStorage.getItem('username_checker_history') || '[]');
        this.renderPills();
      } catch (err) {
        console.error('Failed to load storage', err);
      }
    }

    private saveStorage() {
      try {
        localStorage.setItem('username_checker_favorites', JSON.stringify(this.favorites));
        localStorage.setItem('username_checker_history', JSON.stringify(this.history));
      } catch (err) {
        console.error('Failed to save storage', err);
      }
    }

    private handleInputUpdate() {
      const val = this.inputEl.value.trim();
      this.btnClearEl.style.display = val.length > 0 ? 'block' : 'none';
    }

    private renderPills() {
      // Render Favorites
      if (this.favorites.length > 0) {
        this.favoritesBoxEl.style.display = 'block';
        this.favoritesListEl.innerHTML = '';
        this.favorites.forEach(fav => {
          const pill = document.createElement('button');
          pill.className = 'history-pill';
          pill.innerHTML = `⭐ <span>${fav}</span>`;
          pill.addEventListener('click', () => {
            this.inputEl.value = fav;
            this.handleInputUpdate();
            this.startSearch();
          });
          this.favoritesListEl.appendChild(pill);
        });
      } else {
        this.favoritesBoxEl.style.display = 'none';
      }

      // Render History
      if (this.history.length > 0) {
        this.historyBoxEl.style.display = 'block';
        this.historyListEl.innerHTML = '';
        this.history.forEach(hist => {
          const container = document.createElement('div');
          container.className = 'history-pill';
          
          const textSpan = document.createElement('span');
          textSpan.textContent = hist;
          textSpan.addEventListener('click', () => {
            this.inputEl.value = hist;
            this.handleInputUpdate();
            this.startSearch();
          });

          const removeBtn = document.createElement('button');
          removeBtn.className = 'btn-remove-pill';
          removeBtn.innerHTML = '✕';
          removeBtn.setAttribute('aria-label', `Remove ${hist} from history`);
          removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            this.history = this.history.filter(h => h !== hist);
            this.saveStorage();
            this.renderPills();
          });

          container.appendChild(textSpan);
          container.appendChild(removeBtn);
          this.historyListEl.appendChild(container);
        });
      } else {
        this.historyBoxEl.style.display = 'none';
      }
    }

    private async startSearch() {
      const username = this.inputEl.value.trim().toLowerCase();
      if (!username || this.isScanning) return;

      // Basic regex validation check
      if (username.length < 1 || username.length > 50 || /[^a-zA-Z0-9_\-\.]/.test(username)) {
        alert('Please enter a valid username (only letters, numbers, underscores, hyphens, and dots allowed).');
        return;
      }

      this.isScanning = true;
      this.btnCheckEl.disabled = true;
      this.btnCheckEl.querySelector('.btn-spinner')!.style.display = 'inline-block';
      this.results = [];

      // Update URL query parameter
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('q', username);
      window.history.replaceState({}, '', newUrl.toString());

      // Update document title for SEO
      document.title = `Check Username Availability - ${username}`;

      // Reset counters & panel
      this.statusPanelEl.style.display = 'block';
      this.resultsGridEl.style.display = 'grid';
      this.statusTextEl.textContent = `Scanning "${username}"...`;
      this.scanTimeEl.textContent = '';
      this.progressBarEl.style.width = '0%';
      this.updateCounters(0, 0, 0);

      // Add to history
      this.history = [username, ...this.history.filter(h => h !== username)].slice(0, 10);
      this.saveStorage();
      this.renderPills();

      // Check Favorite status
      this.updateFavoriteButtonState(username);

      // Check Cache
      if (this.searchCache[username]) {
        // Instant simulated check from cache
        this.results = this.searchCache[username];
        this.renderAllCards(this.results);
        this.isScanning = false;
        this.btnCheckEl.disabled = false;
        this.btnCheckEl.querySelector('.btn-spinner')!.style.display = 'none';
        this.statusTextEl.textContent = `Scan completed for "${username}" (cached)`;
        this.progressBarEl.style.width = '100%';
        const available = this.results.filter(r => r.status === 'Available').length;
        const taken = this.results.filter(r => r.status === 'Taken').length;
        const unknown = this.results.filter(r => r.status === 'Unknown').length;
        this.updateCounters(available, taken, unknown);
        this.applyFilter(this.querySelector('.filter-pill.active')?.getAttribute('data-filter') || 'all');
        return;
      }

      // Initial loading state skeletons
      this.renderSkeletons();

      const startTime = performance.now();
      const concurrencyLimit = 10;
      let completedCount = 0;
      const totalPlatforms = platforms.length;

      let availableCount = 0;
      let takenCount = 0;
      let unknownCount = 0;

      // Concurrency Pool
      const pool = [...platforms];
      const workers = Array(concurrencyLimit).fill(null).map(async () => {
        while (pool.length > 0) {
          const platform = pool.shift();
          if (!platform) break;

          try {
            const response = await fetch(`/api/check-username?username=${encodeURIComponent(username)}&platform=${platform.id}`);
            const data = await response.json();
            
            const result = {
              platformId: platform.id,
              platformName: platform.name,
              category: platform.category,
              status: data.status,
              profileUrl: data.profileUrl
            };

            this.results.push(result);

            // Update stats
            if (result.status === 'Available') availableCount++;
            else if (result.status === 'Taken') takenCount++;
            else unknownCount++;

            this.updateCardState(result);
          } catch (err) {
            const errorResult = {
              platformId: platform.id,
              platformName: platform.name,
              category: platform.category,
              status: 'Unknown',
              profileUrl: platform.url.replace('{username}', encodeURIComponent(username))
            };
            this.results.push(errorResult);
            unknownCount++;
            this.updateCardState(errorResult);
          } finally {
            completedCount++;
            const pct = Math.round((completedCount / totalPlatforms) * 100);
            this.progressBarEl.style.width = `${pct}%`;
            this.statusTextEl.textContent = `Scanning "${username}" (${pct}%)...`;
            this.updateCounters(availableCount, takenCount, unknownCount);
          }
        }
      });

      await Promise.all(workers);

      const endTime = performance.now();
      const durationSeconds = ((endTime - startTime) / 1000).toFixed(2);

      this.isScanning = false;
      this.btnCheckEl.disabled = false;
      this.btnCheckEl.querySelector('.btn-spinner')!.style.display = 'none';
      this.statusTextEl.textContent = `Scan completed for "${username}"`;
      this.scanTimeEl.textContent = `Scan completed in ${durationSeconds}s`;

      // Cache Results
      this.searchCache[username] = [...this.results];

      // Sort and re-render final list
      this.sortResults();
      this.applyFilter(this.querySelector('.filter-pill.active')?.getAttribute('data-filter') || 'all');
    }

    private updateCounters(available: number, taken: number, unknown: number) {
      this.countAvailableEl.textContent = String(available);
      this.countTakenEl.textContent = String(taken);
      this.countUnknownEl.textContent = String(unknown);
    }

    private renderSkeletons() {
      this.resultsGridEl.innerHTML = '';
      platforms.forEach(platform => {
        const card = document.createElement('div');
        card.className = `platform-card skeleton-card`;
        card.setAttribute('data-id', platform.id);
        card.setAttribute('data-category', platform.category);
        
        card.innerHTML = `
          <div class="card-top">
            <div class="platform-identity">
              <div class="skeleton-logo"></div>
              <div class="skeleton-text"></div>
            </div>
            <div class="skeleton-badge"></div>
          </div>
        `;
        this.resultsGridEl.appendChild(card);
      });
    }

    private getPlatformLogoSvg(id: string): string {
      const path = BRAND_LOGOS[id];
      if (path) {
        return `<svg class="platform-logo-svg" viewBox="0 0 24 24">${path}</svg>`;
      }
      // Return letter avatar
      const platform = platforms.find(p => p.id === id);
      const letter = platform ? platform.name.charAt(0) : '?';
      return `<span class="platform-logo-letter">${letter}</span>`;
    }

    private updateCardState(result: typeof this.results[0]) {
      const card = this.resultsGridEl.querySelector(`[data-id="${result.platformId}"]`) as HTMLDivElement;
      if (!card) return;

      const badgeClass = result.status.toLowerCase();
      const badgeIcon = result.status === 'Available' ? '✅' : result.status === 'Taken' ? '❌' : '⚠️';
      const logoMarkup = this.getPlatformLogoSvg(result.platformId);

      card.className = `platform-card ${badgeClass}-card`;
      card.innerHTML = `
        <div class="card-top">
          <div class="platform-identity">
            <div class="platform-logo-container">
              ${logoMarkup}
            </div>
            <span class="platform-name">${result.platformName}</span>
          </div>
          <span class="status-badge ${badgeClass}">${badgeIcon} ${result.status}</span>
        </div>
        <div class="profile-link-container">
          <a href="${result.profileUrl}" target="_blank" rel="noopener noreferrer" class="btn-profile">
            <span>${result.status === 'Taken' ? 'Open Profile' : 'Visit Site'}</span>
            <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
        </div>
      `;
    }

    private renderAllCards(resultsList: typeof this.results) {
      this.resultsGridEl.innerHTML = '';
      resultsList.forEach(result => {
        const card = document.createElement('div');
        card.className = `platform-card ${result.status.toLowerCase()}-card`;
        card.setAttribute('data-id', result.platformId);
        card.setAttribute('data-category', result.category);
        
        const badgeClass = result.status.toLowerCase();
        const badgeIcon = result.status === 'Available' ? '✅' : result.status === 'Taken' ? '❌' : '⚠️';
        const logoMarkup = this.getPlatformLogoSvg(result.platformId);

        card.innerHTML = `
          <div class="card-top">
            <div class="platform-identity">
              <div class="platform-logo-container">
                ${logoMarkup}
              </div>
              <span class="platform-name">${result.platformName}</span>
            </div>
            <span class="status-badge ${badgeClass}">${badgeIcon} ${result.status}</span>
          </div>
          <div class="profile-link-container">
            <a href="${result.profileUrl}" target="_blank" rel="noopener noreferrer" class="btn-profile">
              <span>${result.status === 'Taken' ? 'Open Profile' : 'Visit Site'}</span>
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </a>
          </div>
        `;
        this.resultsGridEl.appendChild(card);
      });
    }

    private sortResults() {
      // Sort: Available first, Taken second, Unknown last
      this.results.sort((a, b) => {
        const statusWeight: Record<string, number> = {
          'Available': 1,
          'Taken': 2,
          'Unknown': 3
        };
        const wA = statusWeight[a.status] || 3;
        const wB = statusWeight[b.status] || 3;
        return wA - wB;
      });

      this.renderAllCards(this.results);
    }

    private applyFilter(category: string) {
      const cards = this.resultsGridEl.querySelectorAll('.platform-card');
      cards.forEach(card => {
        const htmlCard = card as HTMLDivElement;
        const cardCat = htmlCard.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          htmlCard.style.display = 'flex';
        } else {
          htmlCard.style.display = 'none';
        }
      });
    }

    // Actions implementation
    private copyUsername() {
      const username = this.inputEl.value.trim();
      if (!username) return;

      navigator.clipboard.writeText(username).then(() => {
        const span = this.btnCopyUsernameEl.querySelector('span') as HTMLSpanElement;
        const copyIcon = this.btnCopyUsernameEl.querySelector('.copy-icon') as HTMLElement;
        const checkIcon = this.btnCopyUsernameEl.querySelector('.check-icon') as HTMLElement;

        span.textContent = 'Copied!';
        copyIcon.style.display = 'none';
        checkIcon.style.display = 'inline-block';

        setTimeout(() => {
          span.textContent = 'Copy Username';
          copyIcon.style.display = 'inline-block';
          checkIcon.style.display = 'none';
        }, 2000);
      });
    }

    private shareResults() {
      const username = this.inputEl.value.trim();
      if (!username) return;

      const shareUrl = `${window.location.origin}${window.location.pathname}?q=${encodeURIComponent(username)}`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        const span = this.btnShareEl.querySelector('span') as HTMLSpanElement;
        const shareIcon = this.btnShareEl.querySelector('.share-icon') as HTMLElement;
        const checkIcon = this.btnShareEl.querySelector('.share-check-icon') as HTMLElement;

        span.textContent = 'Link Copied!';
        shareIcon.style.display = 'none';
        checkIcon.style.display = 'inline-block';

        setTimeout(() => {
          span.textContent = 'Share';
          shareIcon.style.display = 'inline-block';
          checkIcon.style.display = 'none';
        }, 2000);
      });
    }

    private downloadJson() {
      const username = this.inputEl.value.trim();
      if (!username || this.results.length === 0) return;

      const report = {
        username,
        scannedAt: new Date().toISOString(),
        totalChecked: this.results.length,
        summary: {
          available: this.results.filter(r => r.status === 'Available').length,
          taken: this.results.filter(r => r.status === 'Taken').length,
          unknown: this.results.filter(r => r.status === 'Unknown').length
        },
        results: this.results
      };

      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `username-report-${username}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    private updateFavoriteButtonState(username: string) {
      const isFav = this.favorites.includes(username);
      const span = this.btnFavoriteEl.querySelector('span') as HTMLSpanElement;
      
      if (isFav) {
        span.textContent = 'Favorited ⭐';
        this.btnFavoriteEl.classList.add('btn-primary');
        this.btnFavoriteEl.classList.remove('btn-secondary');
      } else {
        span.textContent = 'Favorite';
        this.btnFavoriteEl.classList.add('btn-secondary');
        this.btnFavoriteEl.classList.remove('btn-primary');
      }
    }

    private toggleFavorite() {
      const username = this.inputEl.value.trim().toLowerCase();
      if (!username) return;

      const index = this.favorites.indexOf(username);
      if (index === -1) {
        this.favorites.push(username);
      } else {
        this.favorites.splice(index, 1);
      }

      this.saveStorage();
      this.renderPills();
      this.updateFavoriteButtonState(username);
    }
  }

  if (!customElements.get('username-checker-tool')) {
    customElements.define('username-checker-tool', UsernameCheckerTool);
  }
</script>
