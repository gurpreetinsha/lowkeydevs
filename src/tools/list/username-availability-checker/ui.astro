---
import Icon from '../../../components/base/Icon.astro';
---

<username-checker-tool class="tool-workspace">
  <!-- Search & Input Card -->
  <div class="checker-card glass-panel">
    <div class="search-section">
      <div class="input-wrapper">
        <Icon name="Search" class="search-input-icon" size={20} />
        <input 
          type="text" 
          id="username-input" 
          placeholder="Enter a username..." 
          autocomplete="off"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          aria-label="Username to check"
        />
        <button id="btn-clear" class="btn-clear-input" aria-label="Clear input" style="display: none;">
          ✕
        </button>
      </div>
      <button id="btn-check" class="btn btn-primary btn-check">
        <Icon name="RefreshCw" size={18} class="btn-spinner" />
        <span>Check Availability</span>
      </button>
    </div>

    <!-- Example Usernames -->
    <div class="examples-row">
      <span class="example-label">Try:</span>
      <button class="example-pill" data-username="john">john</button>
      <button class="example-pill" data-username="alex">alex</button>
      <button class="example-pill" data-username="guri">guri</button>
      <button class="example-pill" data-username="devcoder">devcoder</button>
    </div>
  </div>

  <!-- Scan Status & Controls Panel (Shown only when scanning or scanned) -->
  <div id="status-panel" class="status-panel glass-panel" style="display: none;">
    <div class="status-header">
      <div class="progress-info">
        <span class="status-text" id="status-text">Ready to scan</span>
        <span class="scan-time" id="scan-time"></span>
      </div>
      <div class="utility-actions">
        <button id="btn-copy-username" class="btn btn-secondary btn-sm" title="Copy Username">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" style="display: none; color: var(--success);" />
          <span>Copy Username</span>
        </button>
        <button id="btn-share" class="btn btn-secondary btn-sm" title="Share Results">
          <Icon name="ExternalLink" size={14} class="share-icon" />
          <Icon name="Check" size={14} class="share-check-icon" style="display: none; color: var(--success);" />
          <span>Share</span>
        </button>
        <button id="btn-download" class="btn btn-secondary btn-sm" title="Download JSON">
          <Icon name="Download" size={14} />
          <span>JSON</span>
        </button>
        <button id="btn-favorite" class="btn btn-secondary btn-sm" title="Add to Favorites">
          <Icon name="Star" size={14} class="fav-star-icon" />
          <span>Favorite</span>
        </button>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-bar-container">
      <div id="progress-bar" class="progress-bar"></div>
    </div>

    <!-- Counters -->
    <div class="counters-grid">
      <div class="counter-card available">
        <span class="counter-badge">✅</span>
        <div class="counter-info">
          <span class="counter-count" id="count-available">0</span>
          <span class="counter-label">Available</span>
        </div>
      </div>
      <div class="counter-card taken">
        <span class="counter-badge">❌</span>
        <div class="counter-info">
          <span class="counter-count" id="count-taken">0</span>
          <span class="counter-label">Taken</span>
        </div>
      </div>
      <div class="counter-card unknown">
        <span class="counter-badge">⚠️</span>
        <div class="counter-info">
          <span class="counter-count" id="count-unknown">0</span>
          <span class="counter-label">Unknown</span>
        </div>
      </div>
    </div>

    <!-- Category Filters -->
    <div class="filters-row">
      <span class="filter-label">Filter:</span>
      <button class="filter-pill active" data-filter="all">All Platforms</button>
      <button class="filter-pill" data-filter="social">Social</button>
      <button class="filter-pill" data-filter="developer">Developer</button>
      <button class="filter-pill" data-filter="gaming">Gaming</button>
      <button class="filter-pill" data-filter="streaming">Streaming</button>
      <button class="filter-pill" data-filter="community">Community</button>
      <button class="filter-pill" data-filter="design">Design</button>
      <button class="filter-pill" data-filter="business">Business</button>
      <button class="filter-pill" data-filter="domain">Domains</button>
    </div>
  </div>

  <!-- Results Grid -->
  <div id="results-grid" class="results-grid" style="display: none;">
    <!-- Cards will be populated dynamically -->
  </div>

  <!-- History & Favorites Section -->
  <div class="history-favorites-section">
    <!-- Favorites -->
    <div id="favorites-box" class="favorites-box glass-panel" style="display: none;">
      <h3 class="panel-subtitle">
        <Icon name="Star" size={16} style="color: var(--accent);" />
        Favorite Usernames
      </h3>
      <div id="favorites-list" class="pill-list">
        <!-- populated dynamically -->
      </div>
    </div>

    <!-- Recently Checked -->
    <div id="history-box" class="history-box glass-panel" style="display: none;">
      <h3 class="panel-subtitle">
        <Icon name="Terminal" size={16} />
        Recently Checked
      </h3>
      <div id="history-list" class="pill-list">
        <!-- populated dynamically -->
      </div>
    </div>
  </div>
</username-checker-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .glass-panel {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .glass-panel:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }

  /* Search Panel */
  .search-section {
    display: flex;
    gap: 1rem;
    width: 100%;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0 1rem;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .input-wrapper:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
  }

  .search-input-icon {
    color: var(--text-secondary);
    margin-right: 0.75rem;
  }

  #username-input {
    flex: 1;
    height: 48px;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .btn-clear-input {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.25rem;
  }

  .btn-clear-input:hover {
    color: var(--text-primary);
  }

  .btn-check {
    height: 50px;
    padding: 0 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-spinner {
    display: none;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Examples Row */
  .examples-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .example-label {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .example-pill {
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .example-pill:hover {
    background-color: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Status Panel */
  .status-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .progress-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .status-text {
    font-size: var(--fs-body-lg);
    font-weight: 600;
    color: var(--text-primary);
  }

  .scan-time {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .utility-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Progress Bar */
  .progress-bar-container {
    height: 6px;
    background-color: var(--border);
    border-radius: var(--radius-full);
    overflow: hidden;
    width: 100%;
  }

  .progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-hover));
    border-radius: var(--radius-full);
    transition: width 0.2s ease;
  }

  /* Counters */
  .counters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .counter-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
  }

  .counter-badge {
    font-size: 1.25rem;
  }

  .counter-info {
    display: flex;
    flex-direction: column;
  }

  .counter-count {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .counter-label {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
  }

  /* Category Filters */
  .filters-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .filter-label {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    margin-right: 0.5rem;
  }

  .filter-pill {
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .filter-pill:hover, .filter-pill.active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  /* Results Grid */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  /* Platform Card */
  .platform-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .platform-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .platform-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .platform-logo-container {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--surface-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    overflow: hidden;
    color: var(--text-primary);
    font-weight: bold;
    font-size: 0.9rem;
  }

  .platform-logo-svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .platform-name {
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }

  /* Status Badge */
  .status-badge {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  .status-badge.available {
    background-color: var(--success-subtle);
    color: var(--success);
    border: 1px solid rgba(34, 197, 94, 0.2);
  }

  .status-badge.taken {
    background-color: var(--error-subtle);
    color: var(--error);
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .status-badge.unknown {
    background-color: rgba(234, 179, 8, 0.15);
    color: #EAB308;
    border: 1px solid rgba(234, 179, 8, 0.2);
  }

  .status-badge.scanning {
    background-color: var(--surface-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .profile-link-container {
    margin-top: auto;
    width: 100%;
  }

  .btn-profile {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    font-weight: 500;
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-profile:hover {
    background-color: var(--border);
    border-color: var(--border-hover);
  }

  /* Skeletons */
  .skeleton-logo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-hover);
    position: relative;
    overflow: hidden;
  }

  .skeleton-text {
    width: 80px;
    height: 14px;
    background: var(--surface-hover);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  .skeleton-badge {
    width: 70px;
    height: 20px;
    background: var(--surface-hover);
    border-radius: var(--radius-full);
    position: relative;
    overflow: hidden;
  }

  .skeleton-logo::after, .skeleton-text::after, .skeleton-badge::after {
    content: "";
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* History & Favorites */
  .history-favorites-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .favorites-box, .history-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .panel-subtitle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .history-pill {
    background-color: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .history-pill:hover {
    border-color: var(--accent);
    background-color: var(--accent-subtle);
  }

  .btn-remove-pill {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 2px;
  }

  .btn-remove-pill:hover {
    color: var(--error);
  }

  /* Mobile Tweaks */
  @media (max-width: 768px) {
    .search-section {
      flex-direction: column;
    }
    .btn-check {
      width: 100%;
      justify-content: center;
    }
    .counters-grid {
      grid-template-columns: 1fr;
    }
    .history-favorites-section {
      grid-template-columns: 1fr;
    }
  }
</style>

