---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<character-remover-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-letters" />
        <span class="checkmark"></span>
        Remove Letters (a-z, A-Z)
      </label>
      
      <label class="checkbox-container">
        <input type="checkbox" id="opt-numbers" />
        <span class="checkmark"></span>
        Remove Numbers (0-9)
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-punctuation" />
        <span class="checkmark"></span>
        Remove Punctuation
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-whitespace" />
        <span class="checkmark"></span>
        Remove Spaces & Tabs
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-newlines" />
        <span class="checkmark"></span>
        Remove Newlines
      </label>
    </div>

    <div class="custom-chars-input-group form-group">
      <label for="opt-custom-chars" class="label">Custom Characters to Remove</label>
      <div class="custom-input-wrapper">
        <input type="text" id="opt-custom-chars" placeholder="e.g. @#$%" class="input" />
        <label class="checkbox-container inline-checkbox">
          <input type="checkbox" id="opt-case-sensitive" checked />
          <span class="checkmark"></span>
          Case Sensitive
        </label>
      </div>
    </div>

    <div class="control-actions">
      <button data-action="remove" class="btn btn-primary">
        <Icon name="Eraser" size={16} />
        Clean Text
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="char-remover-input" 
        placeholder="Paste your raw text here..." 
        aria-label="Raw Input Text"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">{t('common.Result')}</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      
      <div class="output-container">
        <textarea 
          id="char-remover-output" 
          placeholder="Cleaned text will appear here..." 
          readonly
          aria-label="Cleaned Output Text"
        ></textarea>
      </div>
    </div>
  </div>
</character-remover-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .custom-chars-input-group {
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .custom-input-wrapper {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .custom-input-wrapper .input {
    flex: 1;
    min-width: 250px;
  }

  .inline-checkbox {
    white-space: nowrap;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #char-remover-input,
  #char-remover-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #char-remover-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { removeCharacters } from './logic';

  class CharacterRemoverTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private optLettersEl!: HTMLInputElement;
    private optNumbersEl!: HTMLInputElement;
    private optPunctuationEl!: HTMLInputElement;
    private optWhitespaceEl!: HTMLInputElement;
    private optNewlinesEl!: HTMLInputElement;
    private optCustomCharsEl!: HTMLInputElement;
    private optCaseSensitiveEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#char-remover-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#char-remover-output') as HTMLTextAreaElement;
      this.optLettersEl = this.querySelector('#opt-letters') as HTMLInputElement;
      this.optNumbersEl = this.querySelector('#opt-numbers') as HTMLInputElement;
      this.optPunctuationEl = this.querySelector('#opt-punctuation') as HTMLInputElement;
      this.optWhitespaceEl = this.querySelector('#opt-whitespace') as HTMLInputElement;
      this.optNewlinesEl = this.querySelector('#opt-newlines') as HTMLInputElement;
      this.optCustomCharsEl = this.querySelector('#opt-custom-chars') as HTMLInputElement;
      this.optCaseSensitiveEl = this.querySelector('#opt-case-sensitive') as HTMLInputElement;

      // Event listeners for actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'remove') this.handleClean();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Realtime clean on input
      const inputs = [
        this.inputEl,
        this.optCustomCharsEl
      ];
      inputs.forEach(el => el.addEventListener('input', () => this.handleClean()));

      const checkboxes = [
        this.optLettersEl,
        this.optNumbersEl,
        this.optPunctuationEl,
        this.optWhitespaceEl,
        this.optNewlinesEl,
        this.optCaseSensitiveEl
      ];
      checkboxes.forEach(el => el.addEventListener('change', () => this.handleClean()));
    }

    private handleClean() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        removeLetters: this.optLettersEl.checked,
        removeNumbers: this.optNumbersEl.checked,
        removePunctuation: this.optPunctuationEl.checked,
        removeWhitespace: this.optWhitespaceEl.checked,
        removeNewlines: this.optNewlinesEl.checked,
        customChars: this.optCustomCharsEl.value,
        caseSensitive: this.optCaseSensitiveEl.checked
      };

      const cleaned = removeCharacters(text, options);
      this.outputEl.value = cleaned;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.optLettersEl.checked = false;
      this.optNumbersEl.checked = false;
      this.optPunctuationEl.checked = false;
      this.optWhitespaceEl.checked = false;
      this.optNewlinesEl.checked = false;
      this.optCustomCharsEl.value = '';
      this.optCaseSensitiveEl.checked = true;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "Hey there! My email address is contact_123@lowkeydevs.com. The telephone number is +1-555-0199.";
      this.optLettersEl.checked = false;
      this.optNumbersEl.checked = true; // remove numbers
      this.optPunctuationEl.checked = true; // remove punctuation
      this.handleClean();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }
  }

  if (!customElements.get('character-remover-tool')) {
    customElements.define('character-remover-tool', CharacterRemoverTool);
  }
</script>
