---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load external libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" is:inline></script>

<split-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Split PDF File</h3>
      <p class="converter-subtitle">Extract page ranges or separate all pages from a PDF locally inside your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="split-dropzone">
      <input type="file" id="split-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files up to 100MB</p>
      </div>
    </div>

    <!-- Configuration Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Total Pages:</span>
          <span class="detail-value" id="doc-pages">0</span>
        </div>
      </div>

      <!-- Action Choice -->
      <div class="options-group">
        <h4 class="section-subtitle">Choose Split Method</h4>
        
        <label class="option-label">
          <input type="radio" name="split-method" value="all" checked />
          <div class="option-content">
            <span class="option-title">Extract all pages</span>
            <span class="option-desc">Create a separate PDF for every single page (downloaded as a ZIP).</span>
          </div>
        </label>

        <label class="option-label">
          <input type="radio" name="split-method" value="range" />
          <div class="option-content">
            <span class="option-title">Extract specific range</span>
            <span class="option-desc">Create a single PDF with selected pages. (e.g. 1-3, 5, 7-10)</span>
          </div>
        </label>

        <label class="option-label">
          <input type="radio" name="split-method" value="interval" />
          <div class="option-content">
            <span class="option-title">Split every N pages</span>
            <span class="option-desc">Divide the document into files of equal page count.</span>
          </div>
        </label>
      </div>

      <!-- Option Inputs -->
      <div class="inputs-group">
        <!-- Range input -->
        <div class="input-block hidden" id="range-input-block">
          <label for="range-string" class="field-label">Pages to Extract</label>
          <input type="text" id="range-string" class="field-input" placeholder="e.g. 1-3, 5, 8-12" aria-label="Pages to extract" />
          <p class="field-help">Use commas to separate pages or dash for page ranges.</p>
        </div>

        <!-- Interval input -->
        <div class="input-block hidden" id="interval-input-block">
          <label for="interval-number" class="field-label">Split interval (pages)</label>
          <input type="number" id="interval-number" class="field-input" min="1" value="1" aria-label="Split interval" />
          <p class="field-help">E.g., choosing "2" splits a 6-page PDF into three 2-page documents.</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-split" class="btn btn-primary btn-lg">
          Split PDF
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Splitting PDF file, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        PDF Split Successfully!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Split Result
        </a>
      </div>
    </div>
  </div>
</split-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .options-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .option-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .option-label:hover {
    border-color: var(--border-hover);
    background: var(--surface-hover);
  }

  .option-label input[type="radio"] {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  .option-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .option-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .option-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Input fields */
  .inputs-group {
    display: flex;
    flex-direction: column;
  }

  .input-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .field-help {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class SplitPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private docPagesEl!: HTMLSpanElement;
    private rangeInputBlockEl!: HTMLDivElement;
    private intervalInputBlockEl!: HTMLDivElement;
    private rangeStringEl!: HTMLInputElement;
    private intervalNumberEl!: HTMLInputElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnSplitEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    private pageCount: number = 0;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#split-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#split-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.docPagesEl = this.querySelector('#doc-pages') as HTMLSpanElement;
      this.rangeInputBlockEl = this.querySelector('#range-input-block') as HTMLDivElement;
      this.intervalInputBlockEl = this.querySelector('#interval-input-block') as HTMLDivElement;
      this.rangeStringEl = this.querySelector('#range-string') as HTMLInputElement;
      this.intervalNumberEl = this.querySelector('#interval-number') as HTMLInputElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnSplitEl = this.querySelector('#btn-split') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Handle split method selection change
      this.querySelectorAll('input[name="split-method"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          const val = (e.target as HTMLInputElement).value;
          this.toggleInputBlocks(val);
        });
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnSplitEl.addEventListener('click', () => this.runSplit());
    }

    private toggleInputBlocks(method: string) {
      this.rangeInputBlockEl.classList.add('hidden');
      this.intervalInputBlockEl.classList.add('hidden');
      if (method === 'range') {
        this.rangeInputBlockEl.classList.remove('hidden');
      } else if (method === 'interval') {
        this.intervalInputBlockEl.classList.remove('hidden');
      }
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.PDFLib === 'undefined') {
        alert('PDF Library is still loading. Please wait a moment.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      try {
        const { PDFDocument } = window.PDFLib;
        const arrayBuffer = await file.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer, { ignoreEncryption: true });
        this.pageCount = pdfDoc.getPageCount();
        this.docPagesEl.textContent = this.pageCount.toString();

        // Default constraints
        this.rangeStringEl.placeholder = `e.g. 1-2, 4, 5-${this.pageCount}`;
        this.intervalNumberEl.max = this.pageCount.toString();

        this.dropzoneEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.add('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to read PDF pages. If the document is password-protected, unlock it first.');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.fileInputEl.value = '';
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.rangeStringEl.value = '';
      this.intervalNumberEl.value = '1';
      this.toggleInputBlocks('all');
      (this.querySelector('input[name="split-method"][value="all"]') as HTMLInputElement).checked = true;
    }

    // Parse standard range like "1-3, 5, 8-10" -> [0, 1, 2, 4, 7, 8, 9] (0-indexed)
    private parseRangeString(str: string, maxPages: number): number[] {
      const indices: number[] = [];
      const parts = str.split(',');

      for (let part of parts) {
        part = part.trim();
        if (!part) continue;

        if (part.includes('-')) {
          const [startStr, endStr] = part.split('-');
          const start = parseInt(startStr, 10);
          const end = parseInt(endStr, 10);

          if (!isNaN(start) && !isNaN(end) && start <= end) {
            for (let i = start; i <= end; i++) {
              if (i >= 1 && i <= maxPages) {
                indices.push(i - 1);
              }
            }
          }
        } else {
          const val = parseInt(part, 10);
          if (!isNaN(val) && val >= 1 && val <= maxPages) {
            indices.push(val - 1);
          }
        }
      }

      return Array.from(new Set(indices)).sort((a, b) => a - b);
    }

    private async runSplit() {
      if (!this.selectedFile) return;

      const method = (this.querySelector('input[name="split-method"]:checked') as HTMLInputElement).value;
      const { PDFDocument } = window.PDFLib;
      const arrayBuffer = await this.selectedFile.arrayBuffer();

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        const srcPdf = await PDFDocument.load(arrayBuffer);
        const nameWithoutExt = this.selectedFile.name.replace(/\.[^/.]+$/, "");

        if (method === 'all') {
          // Extract all pages as a ZIP of separate PDFs
          if (typeof window.JSZip === 'undefined') {
            throw new Error('ZIP Library failed to load. Please refresh and try again.');
          }

          const zip = new window.JSZip();

          for (let i = 0; i < this.pageCount; i++) {
            const newPdf = await PDFDocument.create();
            const [copiedPage] = await newPdf.copyPages(srcPdf, [i]);
            newPdf.addPage(copiedPage);
            const pdfBytes = await newPdf.save();
            zip.file(`${nameWithoutExt}_page_${i + 1}.pdf`, pdfBytes);
          }

          const zipContent = await zip.generateAsync({ type: 'blob' });
          const url = URL.createObjectURL(zipContent);
          this.downloadBtnEl.href = url;
          this.downloadBtnEl.download = `${nameWithoutExt}_split_pages.zip`;

        } else if (method === 'range') {
          // Extract specific range into a single PDF
          const rangeStr = this.rangeStringEl.value.trim();
          if (!rangeStr) {
            alert('Please enter a valid page range.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }

          const targetIndices = this.parseRangeString(rangeStr, this.pageCount);
          if (targetIndices.length === 0) {
            alert('No valid pages found in range. Double-check your page range input.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }

          const newPdf = await PDFDocument.create();
          const copiedPages = await newPdf.copyPages(srcPdf, targetIndices);
          copiedPages.forEach((page) => newPdf.addPage(page));

          const pdfBytes = await newPdf.save();
          const blob = new Blob([pdfBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);

          this.downloadBtnEl.href = url;
          this.downloadBtnEl.download = `${nameWithoutExt}_extracted.pdf`;

        } else if (method === 'interval') {
          // Split every N pages
          const n = parseInt(this.intervalNumberEl.value, 10);
          if (isNaN(n) || n < 1) {
            alert('Please enter a valid interval.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }

          if (typeof window.JSZip === 'undefined') {
            throw new Error('ZIP Library failed to load. Please refresh.');
          }

          const zip = new window.JSZip();
          let fileIndex = 1;

          for (let i = 0; i < this.pageCount; i += n) {
            const end = Math.min(i + n, this.pageCount);
            const targetIndices = [];
            for (let j = i; j < end; j++) {
              targetIndices.push(j);
            }

            const newPdf = await PDFDocument.create();
            const copiedPages = await newPdf.copyPages(srcPdf, targetIndices);
            copiedPages.forEach(p => newPdf.addPage(p));
            
            const pdfBytes = await newPdf.save();
            zip.file(`${nameWithoutExt}_part_${fileIndex}_pages_${i+1}-${end}.pdf`, pdfBytes);
            fileIndex++;
          }

          const zipContent = await zip.generateAsync({ type: 'blob' });
          const url = URL.createObjectURL(zipContent);
          this.downloadBtnEl.href = url;
          this.downloadBtnEl.download = `${nameWithoutExt}_split_parts.zip`;
        }

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error splitting PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('split-pdf-tool')) {
    customElements.define('split-pdf-tool', SplitPdfTool);
  }
</script>
