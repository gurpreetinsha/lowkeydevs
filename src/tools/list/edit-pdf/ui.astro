---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF manipulation and rendering libraries from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>

<edit-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Edit PDF</h3>
      <p class="converter-subtitle">Add text annotations and freehand drawings directly on your PDF locally in the browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="edit-dropzone">
      <input type="file" id="edit-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file to edit" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 50MB)</p>
      </div>
    </div>

    <!-- Main Editor Interface -->
    <div class="config-panel hidden" id="editor-interface">
      
      <!-- Toolbar -->
      <div class="editor-toolbar">
        <div class="tool-group">
          <button class="btn-tool active" id="tool-view" title="Browse / Navigate Mode">
            Browse
          </button>
          <button class="btn-tool" id="tool-text" title="Add Text Annotation">
            Text
          </button>
          <button class="btn-tool" id="tool-draw" title="Freehand Pen Draw">
            Draw
          </button>
        </div>

        <div class="divider-v"></div>

        <!-- Text Settings -->
        <div class="tool-settings" id="text-settings">
          <div class="setting-item-h">
            <label for="font-size" class="field-label-sm">Size:</label>
            <select id="font-size" class="field-input-sm">
              <option value="12" selected>12px</option>
              <option value="16">16px</option>
              <option value="20">20px</option>
              <option value="28">28px</option>
              <option value="36">36px</option>
            </select>
          </div>
        </div>

        <!-- Draw Settings -->
        <div class="tool-settings hidden" id="draw-settings">
          <div class="setting-item-h">
            <label for="brush-size" class="field-label-sm">Width:</label>
            <select id="brush-size" class="field-input-sm">
              <option value="2" selected>2px</option>
              <option value="4">4px</option>
              <option value="8">8px</option>
              <option value="12">12px</option>
            </select>
          </div>
        </div>

        <div class="divider-v"></div>

        <!-- Color Settings -->
        <div class="color-picker-group">
          <button class="color-btn active" data-color="#000000" style="background-color: #000000;" title="Black"></button>
          <button class="color-btn" data-color="#ff0000" style="background-color: #ff0000;" title="Red"></button>
          <button class="color-btn" data-color="#0000ff" style="background-color: #0000ff;" title="Blue"></button>
          <button class="color-btn" data-color="#008000" style="background-color: #008000;" title="Green"></button>
        </div>

        <div class="spacer"></div>

        <button class="btn btn-secondary btn-sm" id="btn-clear-annotations">
          Clear Page
        </button>
      </div>

      <!-- Canvas Viewport Wrapper -->
      <div class="canvas-viewport">
        <div class="canvas-container" id="canvas-container">
          <!-- Rendered PDF underlayer -->
          <canvas id="pdf-canvas"></canvas>
          <!-- Drawing Overlay layer -->
          <canvas id="overlay-canvas"></canvas>
        </div>
      </div>

      <!-- Nav & Actions Bar -->
      <div class="editor-bottom-bar">
        <div class="page-navigation">
          <button class="btn btn-secondary btn-sm" id="btn-prev-page" disabled>◀ Previous</button>
          <span class="page-indicator"><span id="current-page-num">1</span> of <span id="total-pages-num">1</span></span>
          <button class="btn btn-secondary btn-sm" id="btn-next-page" disabled>Next ▶</button>
        </div>

        <div class="panel-actions-right">
          <button id="btn-cancel" class="btn btn-secondary">
            Exit Editor
          </button>
          <button id="btn-save" class="btn btn-primary">
            Apply Changes & Download
          </button>
        </div>
      </div>

    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Rendering pages, please wait...</p>
    </div>

    <!-- Text Input Popover Modal (added when user clicks to type) -->
    <div class="text-modal hidden" id="text-input-popover">
      <div class="text-modal-content glass-panel">
        <label for="annotation-text" class="field-label">Type your note:</label>
        <textarea id="annotation-text" class="field-input" rows="3" placeholder="Enter text annotation here..."></textarea>
        <div class="text-modal-actions">
          <button class="btn btn-secondary btn-sm" id="btn-cancel-text">Cancel</button>
          <button class="btn btn-primary btn-sm" id="btn-apply-text">Add text</button>
        </div>
      </div>
    </div>
  </div>
</edit-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Editor Toolbar */
  .editor-toolbar {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tool-group {
    display: flex;
    gap: 0.25rem;
  }

  .btn-tool {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .btn-tool:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }

  .btn-tool.active {
    background: var(--accent-subtle);
    color: var(--accent);
    border-color: var(--border-hover);
  }

  .divider-v {
    width: 1px;
    height: 24px;
    background-color: var(--border);
  }

  .tool-settings {
    display: flex;
    align-items: center;
  }

  .setting-item-h {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .field-label-sm {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .field-input-sm {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    outline: none;
  }

  .color-picker-group {
    display: flex;
    gap: 0.35rem;
  }

  .color-btn {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
    transition: border-color 0.15s;
  }

  .color-btn.active {
    border-color: var(--accent);
    transform: scale(1.1);
  }

  .spacer {
    flex-grow: 1;
  }

  /* Viewport Wrapper */
  .canvas-viewport {
    background: #2b2b2b; /* dark container for contrasting white PDF page */
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    justify-content: center;
    overflow-x: auto;
  }

  .canvas-container {
    position: relative;
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    background: white;
  }

  #pdf-canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  #overlay-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    cursor: default;
    z-index: 10;
  }

  /* Navigation & Actions bottom bar */
  .editor-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .page-navigation {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-indicator {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .panel-actions-right {
    display: flex;
    gap: 0.75rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    cursor: pointer;
    border-radius: var(--radius-md);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Text popover modal styling */
  .text-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.5);
    z-index: 500;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .text-modal-content {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
    width: 100%;
    resize: none;
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .text-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
</style>

<script>
  // Definition of a text annotation
  interface TextAnnotation {
    type: 'text';
    x: number; // percentage width (0-1)
    y: number; // percentage height (0-1)
    text: string;
    fontSize: number;
    color: string;
  }

  // Definition of a freehand line point
  interface Point {
    x: number;
    y: number;
  }

  // Definition of a freehand drawing
  interface DrawingAnnotation {
    type: 'draw';
    points: Point[];
    lineWidth: number;
    color: string;
  }

  type PDFAnnotation = TextAnnotation | DrawingAnnotation;

  class EditPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private editorInterfaceEl!: HTMLDivElement;
    private pdfCanvasEl!: HTMLCanvasElement;
    private overlayCanvasEl!: HTMLCanvasElement;
    private btnPrevPageEl!: HTMLButtonElement;
    private btnNextPageEl!: HTMLButtonElement;
    private currentPageNumEl!: HTMLSpanElement;
    private totalPagesNumEl!: HTMLSpanElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnSaveEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    
    // Tools
    private toolViewBtn!: HTMLButtonElement;
    private toolTextBtn!: HTMLButtonElement;
    private toolDrawBtn!: HTMLButtonElement;
    
    // Tool settings panels
    private textSettingsEl!: HTMLDivElement;
    private drawSettingsEl!: HTMLDivElement;
    
    // Input Fields
    private fontSizeSelectEl!: HTMLSelectElement;
    private brushSizeSelectEl!: HTMLSelectElement;
    private btnClearAnnotationsEl!: HTMLButtonElement;
    
    // Text Modal Input
    private textPopoverEl!: HTMLDivElement;
    private annotationTextEl!: HTMLTextAreaElement;
    private btnCancelTextEl!: HTMLButtonElement;
    private btnApplyTextEl!: HTMLButtonElement;

    // State Variables
    private selectedFile: File | null = null;
    private pdfjsDoc: any = null;
    private numPages: number = 0;
    private currentPage: number = 1;
    
    private currentTool: 'view' | 'text' | 'draw' = 'view';
    private currentColor: string = '#000000';
    
    // Record of annotations per page (page number is 1-indexed)
    private annotations: Record<number, PDFAnnotation[]> = {};
    
    // Drawing states
    private isDrawing: boolean = false;
    private activeDrawingPoints: Point[] = [];
    
    // Text placement state
    private pendingTextCoords: { x: number; y: number } | null = null;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#edit-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#edit-dropzone') as HTMLDivElement;
      this.editorInterfaceEl = this.querySelector('#editor-interface') as HTMLDivElement;
      this.pdfCanvasEl = this.querySelector('#pdf-canvas') as HTMLCanvasElement;
      this.overlayCanvasEl = this.querySelector('#overlay-canvas') as HTMLCanvasElement;
      this.btnPrevPageEl = this.querySelector('#btn-prev-page') as HTMLButtonElement;
      this.btnNextPageEl = this.querySelector('#btn-next-page') as HTMLButtonElement;
      this.currentPageNumEl = this.querySelector('#current-page-num') as HTMLSpanElement;
      this.totalPagesNumEl = this.querySelector('#total-pages-num') as HTMLSpanElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnSaveEl = this.querySelector('#btn-save') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      
      this.toolViewBtn = this.querySelector('#tool-view') as HTMLButtonElement;
      this.toolTextBtn = this.querySelector('#tool-text') as HTMLButtonElement;
      this.toolDrawBtn = this.querySelector('#tool-draw') as HTMLButtonElement;
      
      this.textSettingsEl = this.querySelector('#text-settings') as HTMLDivElement;
      this.drawSettingsEl = this.querySelector('#draw-settings') as HTMLDivElement;
      
      this.fontSizeSelectEl = this.querySelector('#font-size') as HTMLSelectElement;
      this.brushSizeSelectEl = this.querySelector('#brush-size') as HTMLSelectElement;
      this.btnClearAnnotationsEl = this.querySelector('#btn-clear-annotations') as HTMLButtonElement;
      
      this.textPopoverEl = this.querySelector('#text-input-popover') as HTMLDivElement;
      this.annotationTextEl = this.querySelector('#annotation-text') as HTMLTextAreaElement;
      this.btnCancelTextEl = this.querySelector('#btn-cancel-text') as HTMLButtonElement;
      this.btnApplyTextEl = this.querySelector('#btn-apply-text') as HTMLButtonElement;

      // File Events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Toolbar Tool Buttons Selection
      this.toolViewBtn.addEventListener('click', () => this.selectTool('view'));
      this.toolTextBtn.addEventListener('click', () => this.selectTool('text'));
      this.toolDrawBtn.addEventListener('click', () => this.selectTool('draw'));

      // Color pickers click
      this.querySelectorAll('.color-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          this.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
          const target = e.target as HTMLButtonElement;
          target.classList.add('active');
          this.currentColor = target.dataset.color || '#000000';
        });
      });

      // Clear annotations
      this.btnClearAnnotationsEl.addEventListener('click', () => {
        this.annotations[this.currentPage] = [];
        this.redrawOverlay();
      });

      // Navigations page
      this.btnPrevPageEl.addEventListener('click', () => this.changePage(-1));
      this.btnNextPageEl.addEventListener('click', () => this.changePage(1));

      // Exit / Save
      this.btnCancelEl.addEventListener('click', () => this.reset());
      this.btnSaveEl.addEventListener('click', () => this.saveDocument());

      // Overlay canvas events for Annotations (drawing and clicks)
      this.setupOverlayEvents();

      // Text Input Popover Dialog events
      this.btnCancelTextEl.addEventListener('click', () => {
        this.textPopoverEl.classList.add('hidden');
        this.pendingTextCoords = null;
        this.annotationTextEl.value = '';
      });

      this.btnApplyTextEl.addEventListener('click', () => {
        this.applyTextAnnotation();
      });
    }

    private selectTool(tool: 'view' | 'text' | 'draw') {
      this.currentTool = tool;
      this.toolViewBtn.classList.remove('active');
      this.toolTextBtn.classList.remove('active');
      this.toolDrawBtn.classList.remove('active');

      this.textSettingsEl.classList.add('hidden');
      this.drawSettingsEl.classList.add('hidden');

      if (tool === 'view') {
        this.toolViewBtn.classList.add('active');
        this.overlayCanvasEl.style.cursor = 'default';
      } else if (tool === 'text') {
        this.toolTextBtn.classList.add('active');
        this.textSettingsEl.classList.remove('hidden');
        this.overlayCanvasEl.style.cursor = 'text';
      } else if (tool === 'draw') {
        this.toolDrawBtn.classList.add('active');
        this.drawSettingsEl.classList.remove('hidden');
        this.overlayCanvasEl.style.cursor = 'crosshair';
      }
    }

    private setupOverlayEvents() {
      // Mouse events
      this.overlayCanvasEl.addEventListener('mousedown', (e) => this.onStart(e.offsetX, e.offsetY));
      this.overlayCanvasEl.addEventListener('mousemove', (e) => this.onMove(e.offsetX, e.offsetY));
      this.overlayCanvasEl.addEventListener('mouseup', () => this.onEnd());
      this.overlayCanvasEl.addEventListener('mouseleave', () => this.onEnd());

      // Touch events
      this.overlayCanvasEl.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        const rect = this.overlayCanvasEl.getBoundingClientRect();
        this.onStart(touch.clientX - rect.left, touch.clientY - rect.top);
      });
      this.overlayCanvasEl.addEventListener('touchmove', (e) => {
        const touch = e.touches[0];
        const rect = this.overlayCanvasEl.getBoundingClientRect();
        this.onMove(touch.clientX - rect.left, touch.clientY - rect.top);
      });
      this.overlayCanvasEl.addEventListener('touchend', () => this.onEnd());
    }

    private onStart(x: number, y: number) {
      if (this.currentTool === 'draw') {
        this.isDrawing = true;
        const pt = {
          x: x / this.overlayCanvasEl.width,
          y: y / this.overlayCanvasEl.height
        };
        this.activeDrawingPoints = [pt];
      }
    }

    private onMove(x: number, y: number) {
      if (this.currentTool === 'draw' && this.isDrawing) {
        const pt = {
          x: x / this.overlayCanvasEl.width,
          y: y / this.overlayCanvasEl.height
        };
        this.activeDrawingPoints.push(pt);
        this.drawTempLine();
      }
    }

    private onEnd() {
      if (this.currentTool === 'draw' && this.isDrawing) {
        this.isDrawing = false;
        if (this.activeDrawingPoints.length > 1) {
          const drawing: DrawingAnnotation = {
            type: 'draw',
            points: [...this.activeDrawingPoints],
            lineWidth: parseInt(this.brushSizeSelectEl.value, 10),
            color: this.currentColor
          };
          if (!this.annotations[this.currentPage]) {
            this.annotations[this.currentPage] = [];
          }
          this.annotations[this.currentPage].push(drawing);
        }
        this.activeDrawingPoints = [];
        this.redrawOverlay();
      }
    }

    // Capture text click coordinates
    private clickOverlay(e: MouseEvent) {
      if (this.currentTool === 'text') {
        const x = e.offsetX / this.overlayCanvasEl.width;
        const y = e.offsetY / this.overlayCanvasEl.height;
        this.pendingTextCoords = { x, y };

        this.textPopoverEl.classList.remove('hidden');
        this.annotationTextEl.focus();
      }
    }

    private applyTextAnnotation() {
      const text = this.annotationTextEl.value.trim();
      if (text && this.pendingTextCoords) {
        const textAnn: TextAnnotation = {
          type: 'text',
          x: this.pendingTextCoords.x,
          y: this.pendingTextCoords.y,
          text,
          fontSize: parseInt(this.fontSizeSelectEl.value, 10),
          color: this.currentColor
        };

        if (!this.annotations[this.currentPage]) {
          this.annotations[this.currentPage] = [];
        }
        this.annotations[this.currentPage].push(textAnn);
        this.redrawOverlay();
      }

      this.textPopoverEl.classList.add('hidden');
      this.pendingTextCoords = null;
      this.annotationTextEl.value = '';
    }

    private drawTempLine() {
      const ctx = this.overlayCanvasEl.getContext('2d');
      if (!ctx || this.activeDrawingPoints.length < 2) return;

      const w = this.overlayCanvasEl.width;
      const h = this.overlayCanvasEl.height;

      ctx.strokeStyle = this.currentColor;
      ctx.lineWidth = parseInt(this.brushSizeSelectEl.value, 10);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      ctx.beginPath();
      const first = this.activeDrawingPoints[0];
      ctx.moveTo(first.x * w, first.y * h);

      for (let i = 1; i < this.activeDrawingPoints.length; i++) {
        const pt = this.activeDrawingPoints[i];
        ctx.lineTo(pt.x * w, pt.y * h);
      }
      ctx.stroke();
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.pdfjsLib === 'undefined' || typeof window.PDFLib === 'undefined') {
        alert('Libraries are still loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingTextEl.textContent = 'Loading editor...';

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        
        const arrayBuffer = await file.arrayBuffer();
        const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        this.pdfjsDoc = await loadingTask.promise;
        this.numPages = this.pdfjsDoc.numPages;
        this.currentPage = 1;
        this.annotations = {};

        this.totalPagesNumEl.textContent = this.numPages.toString();
        
        // Connect overlay clicks specifically for adding textpopover, draw handles drag/drop
        this.overlayCanvasEl.addEventListener('click', (e) => this.clickOverlay(e));

        await this.renderCurrentPage();

        this.loadingPanelEl.classList.add('hidden');
        this.editorInterfaceEl.classList.remove('hidden');
        this.selectTool('view');
      } catch (err) {
        console.error(err);
        alert('Error loading PDF in editor.');
        this.reset();
      }
    }

    private async renderCurrentPage() {
      if (!this.pdfjsDoc) return;

      this.currentPageNumEl.textContent = this.currentPage.toString();
      this.btnPrevPageEl.disabled = this.currentPage === 1;
      this.btnNextPageEl.disabled = this.currentPage === this.numPages;

      const page = await this.pdfjsDoc.getPage(this.currentPage);
      const viewport = page.getViewport({ scale: 1.25 }); // Standard editor viewport scale

      this.pdfCanvasEl.width = viewport.width;
      this.pdfCanvasEl.height = viewport.height;

      this.overlayCanvasEl.width = viewport.width;
      this.overlayCanvasEl.height = viewport.height;

      const ctx = this.pdfCanvasEl.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, viewport.width, viewport.height);
        await page.render({ canvasContext: ctx, viewport }).promise;
      }

      this.redrawOverlay();
    }

    private redrawOverlay() {
      const ctx = this.overlayCanvasEl.getContext('2d');
      if (!ctx) return;

      const w = this.overlayCanvasEl.width;
      const h = this.overlayCanvasEl.height;

      ctx.clearRect(0, 0, w, h);

      const pageAnns = this.annotations[this.currentPage] || [];
      pageAnns.forEach(ann => {
        if (ann.type === 'draw') {
          ctx.strokeStyle = ann.color;
          ctx.lineWidth = ann.lineWidth;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';

          ctx.beginPath();
          const first = ann.points[0];
          ctx.moveTo(first.x * w, first.y * h);

          for (let i = 1; i < ann.points.length; i++) {
            const pt = ann.points[i];
            ctx.lineTo(pt.x * w, pt.y * h);
          }
          ctx.stroke();
        } else if (ann.type === 'text') {
          ctx.fillStyle = ann.color;
          ctx.font = `${ann.fontSize}px Arial, sans-serif`;
          ctx.textBaseline = 'top';
          ctx.fillText(ann.text, ann.x * w, ann.y * h);
        }
      });
    }

    private async changePage(dir: number) {
      const target = this.currentPage + dir;
      if (target >= 1 && target <= this.numPages) {
        this.currentPage = target;
        this.loadingPanelEl.classList.remove('hidden');
        this.editorInterfaceEl.classList.add('hidden');
        await this.renderCurrentPage();
        this.loadingPanelEl.classList.add('hidden');
        this.editorInterfaceEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.pdfjsDoc = null;
      this.annotations = {};
      this.fileInputEl.value = '';
      this.dropzoneEl.classList.remove('hidden');
      this.editorInterfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    // Hex to rgb conversion helper for pdf-lib drawing colors
    private hexToRgbPercent(hex: string): { r: number; g: number; b: number } {
      const r = parseInt(hex.substring(1, 3), 16) / 255.0;
      const g = parseInt(hex.substring(3, 5), 16) / 255.0;
      const b = parseInt(hex.substring(5, 7), 16) / 255.0;
      return { r, g, b };
    }

    private async saveDocument() {
      if (!this.selectedFile) return;

      this.loadingPanelEl.classList.remove('hidden');
      this.editorInterfaceEl.classList.add('hidden');
      this.loadingTextEl.textContent = 'Saving annotations into PDF...';

      try {
        const { PDFDocument, rgb } = window.PDFLib;
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);

        const pages = pdfDoc.getPages();

        // Write annotations page by page
        for (const pageNumKey in this.annotations) {
          const pageIndex = parseInt(pageNumKey, 10) - 1;
          if (pageIndex < 0 || pageIndex >= pages.length) continue;

          const page = pages[pageIndex];
          const { width, height } = page.getSize();

          const pageAnns = this.annotations[parseInt(pageNumKey, 10)];
          
          for (const ann of pageAnns) {
            const { r, g, b } = this.hexToRgbPercent(ann.color);
            const colorRgb = rgb(r, g, b);

            if (ann.type === 'text') {
              // Convert coordinates. Note: PDF coordinate space y starts from bottom-left corner!
              const pdfX = ann.x * width;
              const pdfY = (1.0 - ann.y) * height - ann.fontSize; // Subtract size to match baseline top offset

              page.drawText(ann.text, {
                x: pdfX,
                y: pdfY,
                size: ann.fontSize,
                color: colorRgb
              });
            } else if (ann.type === 'draw') {
              // Convert points list and draw segments
              for (let j = 0; j < ann.points.length - 1; j++) {
                const pt1 = ann.points[j];
                const pt2 = ann.points[j + 1];

                const x1 = pt1.x * width;
                const y1 = (1.0 - pt1.y) * height;
                const x2 = pt2.x * width;
                const y2 = (1.0 - pt2.y) * height;

                page.drawLine({
                  start: { x: x1, y: y1 },
                  end: { x: x2, y: y2 },
                  thickness: ann.lineWidth,
                  color: colorRgb,
                  opacity: 0.95
                });
              }
            }
          }
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        const link = document.createElement('a');
        link.href = url;
        link.download = `${baseName}_edited.pdf`;
        link.click();

        this.reset();
      } catch (err) {
        console.error(err);
        alert(`Error saving document: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.editorInterfaceEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('edit-pdf-tool')) {
    customElements.define('edit-pdf-tool', EditPdfTool);
  }
</script>
