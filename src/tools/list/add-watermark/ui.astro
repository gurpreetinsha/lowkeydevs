---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load pdf-lib from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<add-watermark-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Add Watermark to PDF</h3>
      <p class="converter-subtitle">Overlay custom text or image watermarks on your PDF pages locally in your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="watermark-dropzone">
      <input type="file" id="watermark-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file to watermark" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 75MB)</p>
      </div>
    </div>

    <!-- Config Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Watermark Configurations -->
      <div class="settings-group">
        <h4 class="section-subtitle">Watermark Settings</h4>
        
        <div class="watermark-type-tabs">
          <button class="tab-btn active" id="tab-text-mode">Text Watermark</button>
          <button class="tab-btn" id="tab-image-mode">Image Watermark</button>
        </div>

        <!-- Text Watermark Section -->
        <div class="settings-grid" id="text-watermark-settings">
          <div class="setting-item full-width">
            <label for="watermark-text" class="field-label">Watermark Text</label>
            <input type="text" id="watermark-text" class="field-input" value="CONFIDENTIAL" placeholder="e.g. DRAFT, COPY, CONFIDENTIAL" />
          </div>

          <div class="setting-item">
            <label for="text-font-size" class="field-label">Font Size</label>
            <input type="number" id="text-font-size" class="field-input" value="50" min="12" max="150" />
          </div>

          <div class="setting-item">
            <label for="text-rotation" class="field-label">Rotation Angle (Degrees)</label>
            <input type="number" id="text-rotation" class="field-input" value="-45" min="-360" max="360" />
          </div>

          <div class="setting-item">
            <label for="text-color" class="field-label">Color</label>
            <input type="color" id="text-color" class="field-input" value="#cccccc" />
          </div>

          <div class="setting-item">
            <label for="text-opacity" class="field-label">Opacity (<span id="text-opacity-val">0.3</span>)</label>
            <input type="range" id="text-opacity" class="field-input range-slider" min="0.05" max="1" step="0.05" value="0.3" aria-label="Text opacity" />
          </div>
        </div>

        <!-- Image Watermark Section -->
        <div class="settings-grid hidden" id="image-watermark-settings">
          <div class="setting-item full-width">
            <label for="watermark-image-file" class="field-label">Upload Watermark Image (PNG or JPG)</label>
            <input type="file" id="watermark-image-file" class="field-input" accept="image/png, image/jpeg, image/jpg" aria-label="Watermark image file" />
          </div>

          <div class="setting-item">
            <label for="image-scale" class="field-label">Image Scale (<span id="image-scale-val">0.5</span>)</label>
            <input type="range" id="image-scale" class="field-input range-slider" min="0.1" max="3" step="0.05" value="0.5" aria-label="Image scale" />
          </div>

          <div class="setting-item">
            <label for="image-opacity" class="field-label">Opacity (<span id="image-opacity-val">0.3</span>)</label>
            <input type="range" id="image-opacity" class="field-input range-slider" min="0.05" max="1" step="0.05" value="0.3" aria-label="Image opacity" />
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-apply" class="btn btn-primary btn-lg">
          Add Watermark
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Embedding watermark, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Watermark Added Successfully!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Watermarked PDF
        </a>
      </div>
    </div>
  </div>
</add-watermark-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  /* Watermark Setup */
  .settings-group {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .watermark-type-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }

  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .setting-item.full-width {
    grid-column: 1 / -1;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .range-slider {
    padding: 0.25rem 0;
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function hexToRgb(hex: string) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? {
      r: parseInt(result[1], 16) / 255,
      g: parseInt(result[2], 16) / 255,
      b: parseInt(result[3], 16) / 255
    } : { r: 0.8, g: 0.8, b: 0.8 };
  }

  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class AddWatermarkTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private btnTextModeEl!: HTMLButtonElement;
    private btnImageModeEl!: HTMLButtonElement;
    private textSettingsEl!: HTMLDivElement;
    private imageSettingsEl!: HTMLDivElement;
    private watermarkTextEl!: HTMLInputElement;
    private textFontSizeEl!: HTMLInputElement;
    private textRotationEl!: HTMLInputElement;
    private textColorEl!: HTMLInputElement;
    private textOpacityEl!: HTMLInputElement;
    private textOpacityValEl!: HTMLSpanElement;
    private imageFileInputEl!: HTMLInputElement;
    private imageScaleEl!: HTMLInputElement;
    private imageScaleValEl!: HTMLSpanElement;
    private imageOpacityEl!: HTMLInputElement;
    private imageOpacityValEl!: HTMLSpanElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnApplyEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    private arrayBuffer: ArrayBuffer | null = null;
    private activeMode: 'text' | 'image' = 'text';

    connectedCallback() {
      this.fileInputEl = this.querySelector('#watermark-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#watermark-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.btnTextModeEl = this.querySelector('#tab-text-mode') as HTMLButtonElement;
      this.btnImageModeEl = this.querySelector('#tab-image-mode') as HTMLButtonElement;
      this.textSettingsEl = this.querySelector('#text-watermark-settings') as HTMLDivElement;
      this.imageSettingsEl = this.querySelector('#image-watermark-settings') as HTMLDivElement;
      this.watermarkTextEl = this.querySelector('#watermark-text') as HTMLInputElement;
      this.textFontSizeEl = this.querySelector('#text-font-size') as HTMLInputElement;
      this.textRotationEl = this.querySelector('#text-rotation') as HTMLInputElement;
      this.textColorEl = this.querySelector('#text-color') as HTMLInputElement;
      this.textOpacityEl = this.querySelector('#text-opacity') as HTMLInputElement;
      this.textOpacityValEl = this.querySelector('#text-opacity-val') as HTMLSpanElement;
      this.imageFileInputEl = this.querySelector('#watermark-image-file') as HTMLInputElement;
      this.imageScaleEl = this.querySelector('#image-scale') as HTMLInputElement;
      this.imageScaleValEl = this.querySelector('#image-scale-val') as HTMLSpanElement;
      this.imageOpacityEl = this.querySelector('#image-opacity') as HTMLInputElement;
      this.imageOpacityValEl = this.querySelector('#image-opacity-val') as HTMLSpanElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnApplyEl = this.querySelector('#btn-apply') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Tabs switching
      this.btnTextModeEl.addEventListener('click', () => this.switchMode('text'));
      this.btnImageModeEl.addEventListener('click', () => this.switchMode('image'));

      // Range sliders updates
      this.textOpacityEl.addEventListener('input', () => {
        this.textOpacityValEl.textContent = this.textOpacityEl.value;
      });

      this.imageScaleEl.addEventListener('input', () => {
        this.imageScaleValEl.textContent = this.imageScaleEl.value;
      });

      this.imageOpacityEl.addEventListener('input', () => {
        this.imageOpacityValEl.textContent = this.imageOpacityEl.value;
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnApplyEl.addEventListener('click', () => this.runWatermark());
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.PDFLib === 'undefined') {
        alert('Libraries are still loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        this.arrayBuffer = await file.arrayBuffer();
      } catch (err) {
        console.error(err);
        alert('Error reading PDF file.');
        this.reset();
      }
    }

    private switchMode(mode: 'text' | 'image') {
      this.activeMode = mode;
      if (mode === 'text') {
        this.btnTextModeEl.classList.add('active');
        this.btnImageModeEl.classList.remove('active');
        this.textSettingsEl.classList.remove('hidden');
        this.imageSettingsEl.classList.add('hidden');
      } else {
        this.btnTextModeEl.classList.remove('active');
        this.btnImageModeEl.classList.add('active');
        this.textSettingsEl.classList.add('hidden');
        this.imageSettingsEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.arrayBuffer = null;
      this.fileInputEl.value = '';
      this.imageFileInputEl.value = '';
      
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    private async runWatermark() {
      if (!this.selectedFile || !this.arrayBuffer) return;

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        const { PDFDocument, StandardFonts, rgb, degrees } = window.PDFLib;
        const pdfDoc = await PDFDocument.load(this.arrayBuffer);
        const pages = pdfDoc.getPages();
        const totalPages = pages.length;

        if (this.activeMode === 'text') {
          const text = this.watermarkTextEl.value || 'CONFIDENTIAL';
          const fontSize = parseInt(this.textFontSizeEl.value, 10) || 50;
          const rotationAngle = parseInt(this.textRotationEl.value, 10) || -45;
          const opacity = parseFloat(this.textOpacityEl.value) || 0.3;
          const { r, g, b } = hexToRgb(this.textColorEl.value);

          const font = await pdfDoc.embedFont(StandardFonts.HelveticaBold);
          const textColor = rgb(r, g, b);

          for (const page of pages) {
            const { width, height } = page.getSize();
            
            const textWidth = font.widthOfTextAtSize(text, fontSize);
            const textHeight = font.heightAtSize(fontSize);

            // Center of the page
            const x = (width - textWidth) / 2;
            const y = (height - textHeight) / 2;

            page.drawText(text, {
              x: x + (textWidth / 4), // visual center adjustment offset
              y: y,
              size: fontSize,
              font: font,
              color: textColor,
              opacity: opacity,
              rotate: degrees(rotationAngle)
            });
          }
        } else {
          // Image Watermark
          if (!this.imageFileInputEl.files || this.imageFileInputEl.files.length === 0) {
            alert('Please select an image file first.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }

          const imgFile = this.imageFileInputEl.files[0];
          const imgBuffer = await imgFile.arrayBuffer();

          let embedImage;
          if (imgFile.type === 'image/png') {
            embedImage = await pdfDoc.embedPng(imgBuffer);
          } else if (imgFile.type === 'image/jpeg' || imgFile.type === 'image/jpg') {
            embedImage = await pdfDoc.embedJpg(imgBuffer);
          } else {
            alert('Please upload a valid PNG or JPEG image.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }

          const scale = parseFloat(this.imageScaleEl.value) || 0.5;
          const opacity = parseFloat(this.imageOpacityEl.value) || 0.3;

          const imgWidth = embedImage.width * scale;
          const imgHeight = embedImage.height * scale;

          for (const page of pages) {
            const { width, height } = page.getSize();
            const x = (width - imgWidth) / 2;
            const y = (height - imgHeight) / 2;

            page.drawImage(embedImage, {
              x,
              y,
              width: imgWidth,
              height: imgHeight,
              opacity: opacity
            });
          }
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        this.downloadBtnEl.href = url;
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        this.downloadBtnEl.download = `${baseName}_watermarked.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error overlaying watermark: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('add-watermark-tool')) {
    customElements.define('add-watermark-tool', AddWatermarkTool);
  }
</script>
