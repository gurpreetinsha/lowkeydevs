---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<!-- Load pdf-lib from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<scan-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Scan to PDF</h3>
      <p class="converter-subtitle">Capture document scans using your webcam or device camera and compile them into a PDF locally.</p>
    </div>

    <!-- Scanner Workspace Split -->
    <div class="scanner-layout">
      <!-- Camera View & Settings Pane -->
      <div class="scanner-camera-pane">
        <h4 class="section-subtitle">Camera Feed</h4>
        
        <div class="video-container">
          <video id="scanner-video" class="scanner-video" autoplay playsinline muted></video>
          <div class="camera-placeholder" id="camera-placeholder">
            <Icon name="Camera" size={48} />
            <p>Camera feed is not active.</p>
            <button id="btn-start-camera" class="btn btn-primary" style="margin-top: 1rem;">
              Start Camera
            </button>
          </div>
        </div>

        <div class="camera-actions hidden" id="camera-controls">
          <div class="setting-item" style="width: 100%; margin-bottom: 0.75rem;">
            <label for="scanner-filter" class="field-label">Document Scan Filter</label>
            <select id="scanner-filter" class="field-input">
              <option value="color" selected>Normal (Color)</option>
              <option value="grayscale">Grayscale</option>
              <option value="threshold">High Contrast (Document Scan)</option>
            </select>
          </div>
          
          <div class="btn-group-row">
            <button id="btn-capture" class="btn btn-primary btn-lg" style="flex-grow: 1;">
              Capture Page
            </button>
            <button id="btn-stop-camera" class="btn btn-secondary">
              Stop Camera
            </button>
          </div>
        </div>
      </div>

      <!-- Scanned Pages List Pane -->
      <div class="scanner-pages-pane">
        <h4 class="section-subtitle">Captured Pages</h4>
        
        <div class="scans-list" id="scans-list">
          <p class="empty-scans-message">No pages captured yet. Start your camera and align your page to scan.</p>
        </div>

        <div class="scans-actions hidden" id="scans-actions">
          <button id="btn-compile" class="btn btn-success btn-lg" style="width: 100%;">
            Compile Scan to PDF
          </button>
          <button id="btn-clear-all" class="btn btn-secondary" style="width: 100%; margin-top: 0.5rem;">
            Clear All Pages
          </button>
        </div>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Compiling document PDF, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Scanned PDF Compiled Successfully!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Scanned PDF
        </a>
      </div>
    </div>
  </div>
</scan-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  /* Split Layout */
  .scanner-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .scanner-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Left pane camera feed */
  .scanner-camera-pane {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .video-container {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #111111;
    border-radius: var(--radius-sm);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .scanner-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .camera-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-align: center;
    padding: 1rem;
  }

  .camera-actions {
    display: flex;
    flex-direction: column;
  }

  .btn-group-row {
    display: flex;
    gap: 0.5rem;
  }

  /* Right pane scans list */
  .scanner-pages-pane {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .scans-list {
    flex-grow: 1;
    min-height: 250px;
    max-height: 400px;
    overflow-y: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .empty-scans-message {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-align: center;
    margin-top: 30%;
  }

  /* Captured Items */
  .scanned-item {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .scanned-item-details {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .scanned-thumb {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: white;
  }

  .scanned-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .btn-delete-item {
    background: transparent;
    border: none;
    color: var(--error);
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
  }

  .btn-delete-item:hover {
    text-decoration: underline;
  }

  /* Settings and Fields */
  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .btn {
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
    transition: all var(--duration-fast);
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .btn-lg {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .hidden {
    display: none !important;
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  interface ScanItem {
    id: string;
    dataUrl: string;
  }

  class ScanPdfTool extends HTMLElement {
    private videoEl!: HTMLVideoElement;
    private cameraPlaceholderEl!: HTMLDivElement;
    private btnStartCameraEl!: HTMLButtonElement;
    private cameraControlsEl!: HTMLDivElement;
    private scannerFilterSelectEl!: HTMLSelectElement;
    private btnCaptureEl!: HTMLButtonElement;
    private btnStopCameraEl!: HTMLButtonElement;
    private scansListEl!: HTMLDivElement;
    private scansActionsEl!: HTMLDivElement;
    private btnCompileEl!: HTMLButtonElement;
    private btnClearAllEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private mediaStream: MediaStream | null = null;
    private captures: ScanItem[] = [];
    private captureCounter = 0;

    connectedCallback() {
      this.videoEl = this.querySelector('#scanner-video') as HTMLVideoElement;
      this.cameraPlaceholderEl = this.querySelector('#camera-placeholder') as HTMLDivElement;
      this.btnStartCameraEl = this.querySelector('#btn-start-camera') as HTMLButtonElement;
      this.cameraControlsEl = this.querySelector('#camera-controls') as HTMLDivElement;
      this.scannerFilterSelectEl = this.querySelector('#scanner-filter') as HTMLSelectElement;
      this.btnCaptureEl = this.querySelector('#btn-capture') as HTMLButtonElement;
      this.btnStopCameraEl = this.querySelector('#btn-stop-camera') as HTMLButtonElement;
      this.scansListEl = this.querySelector('#scans-list') as HTMLDivElement;
      this.scansActionsEl = this.querySelector('#scans-actions') as HTMLDivElement;
      this.btnCompileEl = this.querySelector('#btn-compile') as HTMLButtonElement;
      this.btnClearAllEl = this.querySelector('#btn-clear-all') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Event listeners
      this.btnStartCameraEl.addEventListener('click', () => this.startCamera());
      this.btnStopCameraEl.addEventListener('click', () => this.stopCamera());
      this.btnCaptureEl.addEventListener('click', () => this.captureFrame());
      this.btnCompileEl.addEventListener('click', () => this.compilePdf());
      this.btnClearAllEl.addEventListener('click', () => this.clearAll());
    }

    private async startCamera() {
      if (typeof window.PDFLib === 'undefined') {
        alert('PDF compilation library is loading. Please wait.');
        return;
      }

      try {
        this.mediaStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 960 } }
        });
        
        this.videoEl.srcObject = this.mediaStream;
        this.videoEl.style.display = 'block';
        this.cameraPlaceholderEl.style.display = 'none';
        this.cameraControlsEl.classList.remove('hidden');
        this.resultsPanelEl.classList.add('hidden');
      } catch (err) {
        console.error(err);
        alert('Could not access device camera. Please check browser permissions.');
      }
    }

    private stopCamera() {
      if (this.mediaStream) {
        this.mediaStream.getTracks().forEach(track => track.stop());
        this.mediaStream = null;
      }
      this.videoEl.style.display = 'none';
      this.videoEl.srcObject = null;
      this.cameraPlaceholderEl.style.display = 'flex';
      this.cameraControlsEl.classList.add('hidden');
    }

    private captureFrame() {
      if (!this.mediaStream || this.videoEl.paused) return;

      const canvas = document.createElement('canvas');
      canvas.width = this.videoEl.videoWidth;
      canvas.height = this.videoEl.videoHeight;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      // Draw active video frame
      ctx.drawImage(this.videoEl, 0, 0, canvas.width, canvas.height);

      // Apply Filter
      const filter = this.scannerFilterSelectEl.value;
      if (filter === 'grayscale' || filter === 'threshold') {
        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imgData.data;

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          // Grayscale formula
          const gray = 0.299 * r + 0.587 * g + 0.114 * b;

          if (filter === 'threshold') {
            // Apply high contrast threshold (128)
            const binary = (gray > 120) ? 255 : 0;
            data[i] = binary;
            data[i + 1] = binary;
            data[i + 2] = binary;
          } else {
            data[i] = gray;
            data[i + 1] = gray;
            data[i + 2] = gray;
          }
        }
        ctx.putImageData(imgData, 0, 0);
      }

      // Convert canvas to jpeg data url
      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      this.captures.push({
        id: `scan-${++this.captureCounter}`,
        dataUrl
      });

      this.renderScansList();
    }

    private renderScansList() {
      this.scansListEl.innerHTML = '';
      
      if (this.captures.length === 0) {
        this.scansListEl.innerHTML = '<p class="empty-scans-message">No pages captured yet. Start your camera and align your page to scan.</p>';
        this.scansActionsEl.classList.add('hidden');
        return;
      }

      this.scansActionsEl.classList.remove('hidden');

      this.captures.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = 'scanned-item';
        row.dataset.id = item.id;

        row.innerHTML = `
          <div class="scanned-item-details">
            <img src="${item.dataUrl}" class="scanned-thumb" alt="Page ${idx + 1}" />
            <span class="scanned-title">Page ${idx + 1}</span>
          </div>
          <button class="btn-delete-item">Delete</button>
        `;

        row.querySelector('.btn-delete-item')?.addEventListener('click', () => {
          this.captures = this.captures.filter(c => c.id !== item.id);
          this.renderScansList();
        });

        this.scansListEl.appendChild(row);
      });
    }

    private clearAll() {
      this.captures = [];
      this.renderScansList();
    }

    private async compilePdf() {
      if (this.captures.length === 0) return;

      this.stopCamera();

      this.loadingPanelEl.classList.remove('hidden');
      this.scansActionsEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        const { PDFDocument } = window.PDFLib;
        const outPdf = await PDFDocument.create();

        // Target A4 margins size bounds: 595.28 x 841.89 points
        const targetWidth = 595.28;
        const targetHeight = 841.89;

        const margin = 20;
        const printWidth = targetWidth - (margin * 2);
        const printHeight = targetHeight - (margin * 2);

        for (const item of this.captures) {
          // Parse base64 URL bytes
          const response = await fetch(item.dataUrl);
          const imgBuffer = await response.arrayBuffer();

          const embedImg = await outPdf.embedJpg(imgBuffer);
          const page = outPdf.addPage([targetWidth, targetHeight]);

          // Proportionally scale captured image inside margins
          const scale = Math.min(printWidth / embedImg.width, printHeight / embedImg.height);
          const w = embedImg.width * scale;
          const h = embedImg.height * scale;

          // Center image on the page
          const x = margin + (printWidth - w) / 2;
          const y = margin + (printHeight - h) / 2;

          page.drawImage(embedImg, { x, y, width: w, height: h });
        }

        const outBytes = await outPdf.save();
        const blob = new Blob([outBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        this.downloadBtnEl.href = url;
        this.downloadBtnEl.download = 'scanned_document.pdf';

        this.loadingPanelEl.classList.add('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error compiling PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.renderScansList();
      }
    }

    // Stop tracks on element removal
    disconnectedCallback() {
      this.stopCamera();
    }
  }

  if (!customElements.get('scan-pdf-tool')) {
    customElements.define('scan-pdf-tool', ScanPdfTool);
  }
</script>
