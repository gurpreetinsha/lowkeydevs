---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<json-unstringifier-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="control-label-group">
      <span class="control-label-title">JSON Unstringifier & Unescaper</span>
    </div>
    
    <div class="control-actions">
      <button data-action="clear" class="btn btn-danger btn-compact-sm">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Stringified JSON Input</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="unstringify-input" 
        placeholder='Paste escaped stringified JSON here...\n\nExample:\n"{\\"name\\":\\"LowKeyDevs\\",\\"status\\":\\"active\\"}"' 
        aria-label="Stringified JSON Input"
      ></textarea>
    </div>

    <!-- Output Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="output-pane-title">Unescaped Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      
      <div class="output-container">
        <div id="unstringify-error-banner" class="error-banner" hidden>
          <Icon name="Info" size={16} />
          <span id="error-message"></span>
        </div>
        <textarea 
          id="unstringify-output" 
          placeholder="Unescaped formatted output will appear here..." 
          readonly 
          aria-label="Unstringified Output"
        ></textarea>
      </div>
    </div>
  </div>
</json-unstringifier-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    gap: 1rem;
  }

  .control-label-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-compact-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* Grid Panes */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 450px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #unstringify-input,
  #unstringify-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 350px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #unstringify-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { unstringifyText } from './logic';

  class JsonUnstringifierTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private outputPaneTitle!: HTMLElement;
    private errorBannerEl!: HTMLDivElement;
    private errorMessageEl!: HTMLSpanElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#unstringify-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#unstringify-output') as HTMLTextAreaElement;
      this.outputPaneTitle = this.querySelector('#output-pane-title') as HTMLElement;
      this.errorBannerEl = this.querySelector('#unstringify-error-banner') as HTMLDivElement;
      this.errorMessageEl = this.querySelector('#error-message') as HTMLSpanElement;

      // Event listener delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Live processing as user types
      this.inputEl.addEventListener('input', () => this.processConversion());
    }

    private processConversion() {
      const val = this.inputEl.value;
      if (!val) {
        this.clearOutput();
        return;
      }

      try {
        const parsedResult = unstringifyText(val);
        this.outputEl.value = parsedResult.result;

        if (parsedResult.format === 'json') {
          this.outputPaneTitle.textContent = 'Unescaped JSON (Formatted)';
        } else {
          this.outputPaneTitle.textContent = 'Unescaped Plain Text';
        }
        this.hideError();
      } catch (err: any) {
        this.showError(err.message || 'Error occurred during processing.');
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.clearOutput();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = '"{\\"projectName\\":\\"LowKeyDevs\\",\\"version\\":\\"1.0.0\\",\\"tags\\":[\\"speed\\",\\"seo\\",\\"privacy\\"],\\"active\\":true}"';
      this.processConversion();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }

    private clearOutput() {
      this.outputEl.value = '';
      this.outputPaneTitle.textContent = 'Unescaped Result';
      this.hideError();
    }

    private showError(msg: string) {
      this.errorMessageEl.textContent = msg;
      this.errorBannerEl.removeAttribute('hidden');
      this.outputEl.value = '';
    }

    private hideError() {
      this.errorBannerEl.setAttribute('hidden', 'true');
      this.errorMessageEl.textContent = '';
    }
  }

  if (!customElements.get('json-unstringifier-tool')) {
    customElements.define('json-unstringifier-tool', JsonUnstringifierTool);
  }
</script>
