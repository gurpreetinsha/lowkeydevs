---
import Icon from '../../../components/base/Icon.astro';
---

<nanoid-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="control-row">
          <div class="control-header">
            <label for="nanoid-size" class="label">ID Size (Length)</label>
            <span id="size-val" class="qty-display">21</span>
          </div>
          <input type="range" id="nanoid-size" min="1" max="64" value="21" class="slider" />
        </div>
        <div class="control-row">
          <div class="control-header">
            <label for="nanoid-qty" class="label">Quantity</label>
            <span id="qty-val" class="qty-display">5</span>
          </div>
          <input type="range" id="nanoid-qty" min="1" max="50" value="5" class="slider" />
        </div>
      </div>

      <div class="form-group">
        <label for="nanoid-alphabet" class="label">Custom Alphabet</label>
        <input 
          type="text" 
          id="nanoid-alphabet" 
          value="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" 
          class="input"
          placeholder="e.g. abcdef"
        />
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Fingerprint" size={18} />
          Generate Nano IDs
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated Nano IDs</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy All</span>
        </button>
      </div>
      <textarea
        id="nanoid-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated Nano IDs will appear here..."
        aria-label="Generated Nano IDs output"
      ></textarea>
    </div>
  </div>
</nanoid-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-display {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .slider {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    outline: none;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  .slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .inputs-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 180px;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateNanoids } from './logic';

  class NanoidTool extends HTMLElement {
    private sizeSlider!: HTMLInputElement;
    private qtySlider!: HTMLInputElement;
    private sizeVal!: HTMLElement;
    private qtyVal!: HTMLElement;
    private alphabetInput!: HTMLInputElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.sizeSlider = this.querySelector('#nanoid-size') as HTMLInputElement;
      this.qtySlider = this.querySelector('#nanoid-qty') as HTMLInputElement;
      this.sizeVal = this.querySelector('#size-val') as HTMLElement;
      this.qtyVal = this.querySelector('#qty-val') as HTMLElement;
      this.alphabetInput = this.querySelector('#nanoid-alphabet') as HTMLInputElement;
      this.outputEl = this.querySelector('#nanoid-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Slider updates
      this.sizeSlider.addEventListener('input', () => {
        this.sizeVal.textContent = this.sizeSlider.value;
      });
      this.qtySlider.addEventListener('input', () => {
        this.qtyVal.textContent = this.qtySlider.value;
      });

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      this.handleGenerate();
    }

    private handleGenerate() {
      const size = parseInt(this.sizeSlider.value, 10);
      const quantity = parseInt(this.qtySlider.value, 10);
      const alphabet = this.alphabetInput.value;

      if (!alphabet) {
        this.outputEl.value = 'Please enter alphabet characters.';
        return;
      }

      const list = generateNanoids({ size, alphabet, quantity });
      this.outputEl.value = list.join('\n');
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = 'Copy All';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy Nano IDs', err);
      }
    }
  }

  if (!customElements.get('nanoid-tool')) {
    customElements.define('nanoid-tool', NanoidTool);
  }
</script>
