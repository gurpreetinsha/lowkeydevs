---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF.js, PDF-lib, and Signature Fonts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Pacifico&family=Great+Vibes&display=swap" rel="stylesheet" />

<sign-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Sign PDF Document</h3>
      <p class="converter-subtitle">Place secure, custom handwritten signatures on PDF documents locally inside your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="sign-dropzone">
      <input type="file" id="sign-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF document to sign" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports PDF documents up to 50MB</p>
      </div>
    </div>

    <!-- Main Signer Interface -->
    <div class="config-panel hidden" id="signer-interface">
      
      <!-- Editor Columns -->
      <div class="split-layout">
        
        <!-- Left Side: Viewport Viewer -->
        <div class="viewer-column">
          <div class="canvas-viewport">
            <div class="canvas-container" id="canvas-container">
              <canvas id="pdf-canvas"></canvas>
              <!-- Signature items parent overlay container -->
              <div class="signature-overlay-layer" id="sig-overlay"></div>
            </div>
          </div>

          <!-- Navigation controls -->
          <div class="page-navigation-bar">
            <button class="btn btn-secondary btn-sm" id="btn-prev-page" disabled>◀ Previous</button>
            <span class="page-indicator"><span id="current-page-num">1</span> of <span id="total-pages-num">1</span></span>
            <button class="btn btn-secondary btn-sm" id="btn-next-page" disabled>Next ▶</button>
          </div>
        </div>

        <!-- Right Side: Signature Creator Panel -->
        <div class="sidebar-column">
          <h4 class="section-subtitle">Your Signatures</h4>
          <div class="signature-list-card">
            
            <div class="sig-preview-empty" id="sig-empty-state">
              <p>No signatures created yet.</p>
              <button class="btn btn-primary btn-sm" id="btn-trigger-modal">
                Create Signature
              </button>
            </div>

            <div class="sig-preview-active hidden" id="sig-active-state">
              <img class="sig-thumb" id="sig-thumbnail" src="" alt="Active signature" />
              <div class="sig-actions">
                <button class="btn btn-primary btn-sm" id="btn-place-sig">
                  Place on Page
                </button>
                <button class="btn btn-secondary btn-sm" id="btn-edit-sig">
                  Change Signature
                </button>
              </div>
            </div>

          </div>

          <!-- Instructions -->
          <div class="guide-card">
            <h5>How to Sign</h5>
            <ol>
              <li>Create or select your signature style.</li>
              <li>Click <strong>Place on Page</strong> to add it to the active page.</li>
              <li>Drag the signature box to reposition, or pull the corner handle to resize it.</li>
              <li>Click <strong>Apply & Download</strong> to generate your signed PDF.</li>
            </ol>
          </div>

          <!-- Bottom Actions -->
          <div class="actions-box">
            <button id="btn-cancel" class="btn btn-secondary">
              Exit Signer
            </button>
            <button id="btn-save" class="btn btn-success btn-lg" disabled>
              Apply & Download
            </button>
          </div>
        </div>

      </div>

    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Rendering PDF pages, please wait...</p>
    </div>

    <!-- Signature Creation Modal Dialog -->
    <div class="modal hidden" id="signature-modal">
      <div class="modal-content glass-panel">
        <div class="modal-header">
          <h4>Create Signature</h4>
          <button class="btn-close-modal" id="btn-close-modal">✕</button>
        </div>

        <!-- Tab headers -->
        <div class="tab-headers">
          <button class="tab-btn active" data-tab="tab-draw">Draw</button>
          <button class="tab-btn" data-tab="tab-type">Type</button>
          <button class="tab-btn" data-tab="tab-upload">Upload</button>
        </div>

        <!-- Tab contents -->
        <div class="tab-contents">
          <!-- Draw Tab -->
          <div class="tab-pane" id="tab-draw">
            <div class="signature-pad-container">
              <canvas id="sig-pad-canvas"></canvas>
            </div>
            <div class="tab-pane-actions">
              <button class="btn btn-secondary btn-sm" id="btn-clear-pad">Clear</button>
            </div>
          </div>

          <!-- Type Tab -->
          <div class="tab-pane hidden" id="tab-type">
            <div class="type-input-block">
              <label for="sig-type-text" class="field-label">Type your name:</label>
              <input type="text" id="sig-type-text" class="field-input" placeholder="e.g. John Doe" />
            </div>

            <!-- Styles list -->
            <div class="type-styles-list">
              <label class="style-item">
                <input type="radio" name="sig-font-style" value="Dancing Script" checked />
                <span class="style-preview font-dancing" id="preview-dancing">Signature</span>
              </label>
              <label class="style-item" style="margin-top: 0.5rem;">
                <input type="radio" name="sig-font-style" value="Pacifico" />
                <span class="style-preview font-pacifico" id="preview-pacifico">Signature</span>
              </label>
              <label class="style-item" style="margin-top: 0.5rem;">
                <input type="radio" name="sig-font-style" value="Great Vibes" />
                <span class="style-preview font-vibes" id="preview-vibes">Signature</span>
              </label>
            </div>
          </div>

          <!-- Upload Tab -->
          <div class="tab-pane hidden" id="tab-upload">
            <div class="upload-pane-content">
              <input type="file" id="sig-image-file" accept="image/*" class="field-input" />
              <p class="field-help">Upload a transparent PNG signature or dark ink image on white background.</p>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-secondary" id="btn-cancel-modal">Cancel</button>
          <button class="btn btn-primary" id="btn-save-modal">Create Signature</button>
        </div>
      </div>
    </div>
  </div>
</sign-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Split Layout */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .split-layout {
    display: flex;
    gap: 2rem;
  }

  @media (max-width: 992px) {
    .split-layout {
      flex-direction: column;
    }
  }

  .viewer-column {
    flex: 1.5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .sidebar-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Viewport */
  .canvas-viewport {
    background: #2b2b2b;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: auto;
  }

  .canvas-container {
    position: relative;
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    background: white;
  }

  #pdf-canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .signature-overlay-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    pointer-events: none;
  }

  /* Placed drag signature card style */
  .placed-sig-box {
    position: absolute;
    border: 1.5px dashed var(--accent);
    background: rgba(196, 169, 243, 0.08);
    cursor: move;
    z-index: 20;
    pointer-events: auto;
  }

  .placed-sig-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .placed-sig-delete {
    position: absolute;
    top: -10px;
    right: -10px;
    background: var(--error);
    color: white;
    border: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .placed-sig-resize {
    position: absolute;
    bottom: -4px;
    right: -4px;
    background: var(--accent);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    cursor: nwse-resize;
    box-shadow: var(--shadow-sm);
  }

  .page-navigation-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-indicator {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Sidebar details */
  .section-subtitle {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .signature-list-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .sig-preview-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .sig-preview-active {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .sig-thumb {
    max-width: 100%;
    max-height: 80px;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: white;
    padding: 0.25rem;
  }

  .sig-actions {
    display: flex;
    gap: 0.5rem;
  }

  .guide-card {
    background: var(--accent-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .guide-card h5 {
    font-weight: bold;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .guide-card ol {
    padding-left: 1.2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .actions-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* Modal Styles */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.6);
    z-index: 500;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .modal-content {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    width: 440px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h4 {
    font-size: 1.15rem;
    font-weight: bold;
    color: var(--text-primary);
  }

  .btn-close-modal {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1rem;
    cursor: pointer;
  }

  .btn-close-modal:hover {
    color: var(--text-primary);
  }

  .tab-headers {
    display: flex;
    border-bottom: 1px solid var(--border);
    gap: 0.5rem;
  }

  .tab-headers .tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .tab-headers .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-headers .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Tab Panes */
  .signature-pad-container {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  #sig-pad-canvas {
    display: block;
    width: 100%;
    height: 150px;
    cursor: crosshair;
  }

  .tab-pane-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .type-input-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
    width: 100%;
  }

  .type-styles-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
  }

  .style-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--border);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    background: var(--surface);
  }

  .style-item input[type="radio"] {
    accent-color: var(--accent);
  }

  .style-preview {
    font-size: 1.5rem;
    color: #111111; /* dark preview to mimic ink signature */
    background: white;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-xs);
    flex-grow: 1;
    text-align: center;
    border: 1px solid #eee;
  }

  /* Cursive families */
  .font-dancing {
    font-family: 'Dancing Script', cursive;
  }

  .font-pacifico {
    font-family: 'Pacifico', cursive;
  }

  .font-vibes {
    font-family: 'Great Vibes', cursive;
  }

  .upload-pane-content {
    padding: 1.5rem 1rem;
    text-align: center;
    border: 2px dashed var(--border);
    border-radius: var(--radius-sm);
  }

  .field-help {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover:not(:disabled) {
    opacity: 0.9;
  }

  .btn-success:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .hidden {
    display: none !important;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  interface PlacedSignature {
    id: number;
    page: number;
    x: number; // percentage (0-1)
    y: number; // percentage (0-1)
    w: number; // percentage (0-1)
    h: number; // percentage (0-1)
  }

  class SignPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private signerInterfaceEl!: HTMLDivElement;
    private pdfCanvasEl!: HTMLCanvasElement;
    private sigOverlayEl!: HTMLDivElement;
    
    // Nav
    private btnPrevPageEl!: HTMLButtonElement;
    private btnNextPageEl!: HTMLButtonElement;
    private currentPageNumEl!: HTMLSpanElement;
    private totalPagesNumEl!: HTMLSpanElement;

    // Sidebar
    private sigEmptyStateEl!: HTMLDivElement;
    private sigActiveStateEl!: HTMLDivElement;
    private sigThumbnailEl!: HTMLImageElement;
    private btnTriggerModalEl!: HTMLButtonElement;
    private btnPlaceSigEl!: HTMLButtonElement;
    private btnEditSigEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnSaveEl!: HTMLButtonElement;

    // Modal
    private sigModalEl!: HTMLDivElement;
    private btnCloseModalEl!: HTMLButtonElement;
    private btnCancelModalEl!: HTMLButtonElement;
    private btnSaveModalEl!: HTMLButtonElement;
    private sigPadCanvasEl!: HTMLCanvasElement;
    private btnClearPadEl!: HTMLButtonElement;
    private sigTypeTextEl!: HTMLInputElement;
    private sigImageFileEl!: HTMLInputElement;

    // State
    private selectedFile: File | null = null;
    private pdfjsDoc: any = null;
    private numPages: number = 0;
    private currentPage: number = 1;

    // Signature data (base64 transparent PNG)
    private signatureImgData: string | null = null;
    
    // Placed instances
    private placedSignatures: PlacedSignature[] = [];
    private nextSigId: number = 1;

    // Draw pad state
    private isDrawingPad: boolean = false;
    private lastPadX: number = 0;
    private lastPadY: number = 0;
    private currentTab: string = 'tab-draw';

    connectedCallback() {
      this.fileInputEl = this.querySelector('#sign-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#sign-dropzone') as HTMLDivElement;
      this.signerInterfaceEl = this.querySelector('#signer-interface') as HTMLDivElement;
      this.pdfCanvasEl = this.querySelector('#pdf-canvas') as HTMLCanvasElement;
      this.sigOverlayEl = this.querySelector('#sig-overlay') as HTMLDivElement;
      
      this.btnPrevPageEl = this.querySelector('#btn-prev-page') as HTMLButtonElement;
      this.btnNextPageEl = this.querySelector('#btn-next-page') as HTMLButtonElement;
      this.currentPageNumEl = this.querySelector('#current-page-num') as HTMLSpanElement;
      this.totalPagesNumEl = this.querySelector('#total-pages-num') as HTMLSpanElement;

      this.sigEmptyStateEl = this.querySelector('#sig-empty-state') as HTMLDivElement;
      this.sigActiveStateEl = this.querySelector('#sig-active-state') as HTMLDivElement;
      this.sigThumbnailEl = this.querySelector('#sig-thumbnail') as HTMLImageElement;
      this.btnTriggerModalEl = this.querySelector('#btn-trigger-modal') as HTMLButtonElement;
      this.btnPlaceSigEl = this.querySelector('#btn-place-sig') as HTMLButtonElement;
      this.btnEditSigEl = this.querySelector('#btn-edit-sig') as HTMLButtonElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnSaveEl = this.querySelector('#btn-save') as HTMLButtonElement;

      this.sigModalEl = this.querySelector('#signature-modal') as HTMLDivElement;
      this.btnCloseModalEl = this.querySelector('#btn-close-modal') as HTMLButtonElement;
      this.btnCancelModalEl = this.querySelector('#btn-cancel-modal') as HTMLButtonElement;
      this.btnSaveModalEl = this.querySelector('#btn-save-modal') as HTMLButtonElement;
      this.sigPadCanvasEl = this.querySelector('#sig-pad-canvas') as HTMLCanvasElement;
      this.btnClearPadEl = this.querySelector('#btn-clear-pad') as HTMLButtonElement;
      this.sigTypeTextEl = this.querySelector('#sig-type-text') as HTMLInputElement;
      this.sigImageFileEl = this.querySelector('#sig-image-file') as HTMLInputElement;

      // File Events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Navigation
      this.btnPrevPageEl.addEventListener('click', () => this.changePage(-1));
      this.btnNextPageEl.addEventListener('click', () => this.changePage(1));

      // Sidebar events
      this.btnTriggerModalEl.addEventListener('click', () => this.openSignatureModal());
      this.btnEditSigEl.addEventListener('click', () => this.openSignatureModal());
      this.btnPlaceSigEl.addEventListener('click', () => this.placeSignatureOnPage());
      this.btnCancelEl.addEventListener('click', () => this.reset());
      this.btnSaveEl.addEventListener('click', () => this.saveSignedPDF());

      // Modal Tab toggle
      this.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          this.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          this.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));

          const target = e.target as HTMLButtonElement;
          target.classList.add('active');
          
          const tabId = target.dataset.tab;
          if (tabId) {
            this.querySelector(`#${tabId}`)?.classList.remove('hidden');
            this.currentTab = tabId;
            if (this.currentTab === 'tab-draw') {
              this.resizePadCanvas();
            }
          }
        });
      });

      // Type tab input synchronization
      this.sigTypeTextEl.addEventListener('input', () => {
        const text = this.sigTypeTextEl.value || 'Signature';
        (this.querySelector('#preview-dancing') as HTMLElement).textContent = text;
        (this.querySelector('#preview-pacifico') as HTMLElement).textContent = text;
        (this.querySelector('#preview-vibes') as HTMLElement).textContent = text;
      });

      // Draw pad events
      this.setupPadCanvasEvents();

      // Modal Close/Submit
      this.btnCloseModalEl.addEventListener('click', () => this.sigModalEl.classList.add('hidden'));
      this.btnCancelModalEl.addEventListener('click', () => this.sigModalEl.classList.add('hidden'));
      this.btnSaveModalEl.addEventListener('click', () => this.createSignatureFromActiveTab());
    }

    private setupPadCanvasEvents() {
      const getCoords = (e: MouseEvent | TouchEvent) => {
        const rect = this.sigPadCanvasEl.getBoundingClientRect();
        if (e instanceof MouseEvent) {
          return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        } else {
          const touch = e.touches[0];
          return { x: touch.clientX - rect.left, y: touch.clientY - rect.top };
        }
      };

      const startDrawing = (e: MouseEvent | TouchEvent) => {
        this.isDrawingPad = true;
        const coords = getCoords(e);
        this.lastPadX = coords.x;
        this.lastPadY = coords.y;
        e.preventDefault();
      };

      const draw = (e: MouseEvent | TouchEvent) => {
        if (!this.isDrawingPad) return;
        const coords = getCoords(e);
        const ctx = this.sigPadCanvasEl.getContext('2d');
        if (ctx) {
          ctx.strokeStyle = '#000000'; // Standard black ink
          ctx.lineWidth = 2.5;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(this.lastPadX, this.lastPadY);
          ctx.lineTo(coords.x, coords.y);
          ctx.stroke();
        }
        this.lastPadX = coords.x;
        this.lastPadY = coords.y;
        e.preventDefault();
      };

      const stopDrawing = () => {
        this.isDrawingPad = false;
      };

      this.sigPadCanvasEl.addEventListener('mousedown', startDrawing);
      this.sigPadCanvasEl.addEventListener('mousemove', draw);
      this.sigPadCanvasEl.addEventListener('mouseup', stopDrawing);
      this.sigPadCanvasEl.addEventListener('mouseleave', stopDrawing);

      this.sigPadCanvasEl.addEventListener('touchstart', startDrawing);
      this.sigPadCanvasEl.addEventListener('touchmove', draw);
      this.sigPadCanvasEl.addEventListener('touchend', stopDrawing);

      this.btnClearPadEl.addEventListener('click', () => {
        const ctx = this.sigPadCanvasEl.getContext('2d');
        if (ctx) ctx.clearRect(0, 0, this.sigPadCanvasEl.width, this.sigPadCanvasEl.height);
      });
    }

    private resizePadCanvas() {
      // Must set canvas coordinate size explicitly to match layout CSS display size
      const rect = this.sigPadCanvasEl.getBoundingClientRect();
      this.sigPadCanvasEl.width = rect.width;
      this.sigPadCanvasEl.height = 150;
      
      const ctx = this.sigPadCanvasEl.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, this.sigPadCanvasEl.width, this.sigPadCanvasEl.height);
      }
    }

    private openSignatureModal() {
      this.sigModalEl.classList.remove('hidden');
      // Reset inputs
      this.sigTypeTextEl.value = '';
      this.sigImageFileEl.value = '';
      this.currentTab = 'tab-draw';
      
      // Default to Draw tab active
      this.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      this.querySelector('.tab-btn[data-tab="tab-draw"]')?.classList.add('active');
      this.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
      this.querySelector('#tab-draw')?.classList.remove('hidden');

      this.resizePadCanvas();
    }

    private createSignatureFromActiveTab() {
      if (this.currentTab === 'tab-draw') {
        // Capture drawn pixels
        // Let's check if user drew anything (verify non-white pixels)
        const canvas = this.sigPadCanvasEl;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imgData.data;
        let drawn = false;
        
        // Loop and check alpha/color channels to see if pad contains strokes
        for (let i = 0; i < data.length; i += 4) {
          if (data[i] < 240 || data[i+1] < 240 || data[i+2] < 240) {
            drawn = true;
            break;
          }
        }

        if (!drawn) {
          alert('Please draw your signature before saving.');
          return;
        }

        // To make the background transparent, convert all white pixels to transparent alpha
        const transparentCanvas = document.createElement('canvas');
        transparentCanvas.width = canvas.width;
        transparentCanvas.height = canvas.height;
        const tCtx = transparentCanvas.getContext('2d');
        if (tCtx) {
          tCtx.drawImage(canvas, 0, 0);
          const tImgData = tCtx.getImageData(0, 0, canvas.width, canvas.height);
          const tData = tImgData.data;
          
          for (let i = 0; i < tData.length; i += 4) {
            // If near white, make transparent alpha
            if (tData[i] > 220 && tData[i+1] > 220 && tData[i+2] > 220) {
              tData[i+3] = 0;
            }
          }
          tCtx.putImageData(tImgData, 0, 0);
        }

        this.signatureImgData = transparentCanvas.toDataURL('image/png');
        this.updateActiveSignatureThumbnail();

      } else if (this.currentTab === 'tab-type') {
        const text = this.sigTypeTextEl.value.trim();
        if (!text) {
          alert('Please type your name.');
          return;
        }

        const font = (this.querySelector('input[name="sig-font-style"]:checked') as HTMLInputElement).value;

        // Render typography text onto a canvas as PNG
        const canvas = document.createElement('canvas');
        canvas.width = 400;
        canvas.height = 100;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          // Clear transparent
          ctx.clearRect(0,0, canvas.width, canvas.height);
          ctx.fillStyle = '#000000'; // black ink
          ctx.font = `italic 36px "${font}", cursive, sans-serif`;
          ctx.textBaseline = 'middle';
          ctx.textAlign = 'center';
          ctx.fillText(text, 200, 50);
        }

        this.signatureImgData = canvas.toDataURL('image/png');
        this.updateActiveSignatureThumbnail();

      } else if (this.currentTab === 'tab-upload') {
        if (!this.sigImageFileEl.files || this.sigImageFileEl.files.length === 0) {
          alert('Please select an image file to upload.');
          return;
        }

        const file = this.sigImageFileEl.files[0];
        const reader = new FileReader();
        reader.onload = (e) => {
          this.signatureImgData = e.target?.result as string;
          this.updateActiveSignatureThumbnail();
        };
        reader.readAsDataURL(file);
      }
    }

    private updateActiveSignatureThumbnail() {
      if (this.signatureImgData) {
        this.sigThumbnailEl.src = this.signatureImgData;
        this.sigEmptyStateEl.classList.add('hidden');
        this.sigActiveStateEl.classList.remove('hidden');
        this.sigModalEl.classList.add('hidden');
      }
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.pdfjsLib === 'undefined' || typeof window.PDFLib === 'undefined') {
        alert('Libraries are still loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingTextEl.textContent = 'Loading signer...';

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        
        const arrayBuffer = await file.arrayBuffer();
        const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        this.pdfjsDoc = await loadingTask.promise;
        this.numPages = this.pdfjsDoc.numPages;
        this.currentPage = 1;
        this.placedSignatures = [];
        this.nextSigId = 1;

        this.totalPagesNumEl.textContent = this.numPages.toString();

        await this.renderCurrentPage();

        this.loadingPanelEl.classList.add('hidden');
        this.signerInterfaceEl.classList.remove('hidden');
        this.btnSaveEl.disabled = false;
      } catch (err) {
        console.error(err);
        alert('Error loading PDF document.');
        this.reset();
      }
    }

    private async renderCurrentPage() {
      if (!this.pdfjsDoc) return;

      this.currentPageNumEl.textContent = this.currentPage.toString();
      this.btnPrevPageEl.disabled = this.currentPage === 1;
      this.btnNextPageEl.disabled = this.currentPage === this.numPages;

      const page = await this.pdfjsDoc.getPage(this.currentPage);
      const viewport = page.getViewport({ scale: 1.25 }); // scale matching editor size

      this.pdfCanvasEl.width = viewport.width;
      this.pdfCanvasEl.height = viewport.height;

      const ctx = this.pdfCanvasEl.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, viewport.width, viewport.height);
        await page.render({ canvasContext: ctx, viewport }).promise;
      }

      // Redraw placed signatures overlay for active page
      this.renderPlacedSignaturesHTML();
    }

    private renderPlacedSignaturesHTML() {
      this.sigOverlayEl.innerHTML = '';
      
      const pageSigs = this.placedSignatures.filter(s => s.page === this.currentPage);
      const w = this.pdfCanvasEl.width;
      const h = this.pdfCanvasEl.height;

      pageSigs.forEach(sig => {
        const box = document.createElement('div');
        box.className = 'placed-sig-box';
        box.style.left = `${sig.x * w}px`;
        box.style.top = `${sig.y * h}px`;
        box.style.width = `${sig.w * w}px`;
        box.style.height = `${sig.h * h}px`;

        const img = document.createElement('img');
        img.className = 'placed-sig-img';
        img.src = this.signatureImgData!;

        // Delete button
        const btnDelete = document.createElement('button');
        btnDelete.className = 'placed-sig-delete';
        btnDelete.innerHTML = '✕';
        btnDelete.addEventListener('click', (e) => {
          e.stopPropagation();
          this.placedSignatures = this.placedSignatures.filter(s => s.id !== sig.id);
          this.renderPlacedSignaturesHTML();
        });

        // Resize handle (nwse style)
        const handle = document.createElement('div');
        handle.className = 'placed-sig-resize';

        box.appendChild(img);
        box.appendChild(btnDelete);
        box.appendChild(handle);
        this.sigOverlayEl.appendChild(box);

        // Bind Drag and Resize handlers
        this.bindDragAndResize(box, handle, sig);
      });
    }

    private bindDragAndResize(box: HTMLDivElement, handle: HTMLDivElement, sig: PlacedSignature) {
      let isDragging = false;
      let isResizing = false;
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;
      let startWidth = 0;
      let startHeight = 0;

      const overlayW = this.pdfCanvasEl.width;
      const overlayH = this.pdfCanvasEl.height;

      // Drag
      box.addEventListener('mousedown', (e) => {
        if (e.target === handle || e.target === box.querySelector('.placed-sig-delete')) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        startLeft = box.offsetLeft;
        startTop = box.offsetTop;
        e.preventDefault();
      });

      // Resize
      handle.addEventListener('mousedown', (e) => {
        isResizing = true;
        startX = e.clientX;
        startY = e.clientY;
        startWidth = box.offsetWidth;
        startHeight = box.offsetHeight;
        e.preventDefault();
        e.stopPropagation();
      });

      const onMouseMove = (e: MouseEvent) => {
        if (isDragging) {
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;

          let newLeft = startLeft + dx;
          let newTop = startTop + dy;

          // Boundaries clamp
          newLeft = Math.max(0, Math.min(newLeft, overlayW - box.offsetWidth));
          newTop = Math.max(0, Math.min(newTop, overlayH - box.offsetHeight));

          box.style.left = `${newLeft}px`;
          box.style.top = `${newTop}px`;

          // Update data struct
          sig.x = newLeft / overlayW;
          sig.y = newTop / overlayH;
        }

        if (isResizing) {
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;

          let newWidth = startWidth + dx;
          let newHeight = startHeight + dy;

          // Size constraints
          newWidth = Math.max(40, Math.min(newWidth, overlayW - box.offsetLeft));
          newHeight = Math.max(15, Math.min(newHeight, overlayH - box.offsetTop));

          box.style.width = `${newWidth}px`;
          box.style.height = `${newHeight}px`;

          // Update data struct
          sig.w = newWidth / overlayW;
          sig.h = newHeight / overlayH;
        }
      };

      const onMouseUp = () => {
        isDragging = false;
        isResizing = false;
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      };

      box.addEventListener('mousedown', () => {
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });

      handle.addEventListener('mousedown', () => {
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });
    }

    private placeSignatureOnPage() {
      if (!this.signatureImgData) return;

      const overlayW = this.pdfCanvasEl.width;
      const overlayH = this.pdfCanvasEl.height;

      // Default: place a signature centered on screen, width 150px, height 50px
      const w = 150 / overlayW;
      const h = 50 / overlayH;
      const x = (overlayW / 2 - 75) / overlayW;
      const y = (overlayH / 2 - 25) / overlayH;

      const sig: PlacedSignature = {
        id: this.nextSigId++,
        page: this.currentPage,
        x,
        y,
        w,
        h
      };

      this.placedSignatures.push(sig);
      this.renderPlacedSignaturesHTML();
    }

    private async changePage(dir: number) {
      const target = this.currentPage + dir;
      if (target >= 1 && target <= this.numPages) {
        this.currentPage = target;
        this.loadingPanelEl.classList.remove('hidden');
        this.signerInterfaceEl.classList.add('hidden');
        await this.renderCurrentPage();
        this.loadingPanelEl.classList.add('hidden');
        this.signerInterfaceEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.pdfjsDoc = null;
      this.placedSignatures = [];
      this.signatureImgData = null;
      this.nextSigId = 1;
      this.fileInputEl.value = '';
      this.sigOverlayEl.innerHTML = '';
      
      this.sigEmptyStateEl.classList.remove('hidden');
      this.sigActiveStateEl.classList.add('hidden');
      this.sigThumbnailEl.src = '';
      this.btnSaveEl.disabled = true;

      this.dropzoneEl.classList.remove('hidden');
      this.signerInterfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    private async saveSignedPDF() {
      if (!this.selectedFile) return;

      this.loadingPanelEl.classList.remove('hidden');
      this.signerInterfaceEl.classList.add('hidden');
      this.loadingTextEl.textContent = 'Embedding signatures and exporting PDF...';

      try {
        const { PDFDocument } = window.PDFLib;
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);

        const pages = pdfDoc.getPages();

        // Convert base64 PNG signature to PNG bytes buffer once
        const pngResponse = await fetch(this.signatureImgData!);
        const pngArrayBuffer = await pngResponse.arrayBuffer();

        const embeddedPng = await pdfDoc.embedPng(pngArrayBuffer);

        // Draw signatures onto PDF document coordinates
        for (const sig of this.placedSignatures) {
          const pageIndex = sig.page - 1;
          if (pageIndex < 0 || pageIndex >= pages.length) continue;

          const page = pages[pageIndex];
          const { width, height } = page.getSize();

          // Calculate correct coordinates. Note that PDF coordinate space starts from bottom-left!
          const drawX = sig.x * width;
          const drawY = (1.0 - sig.y - sig.h) * height; // bottom offset matches bottom-left origin
          const drawW = sig.w * width;
          const drawH = sig.h * height;

          page.drawImage(embeddedPng, {
            x: drawX,
            y: drawY,
            width: drawW,
            height: drawH
          });
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        const link = document.createElement('a');
        link.href = url;
        link.download = `${baseName}_signed.pdf`;
        link.click();

        this.reset();
      } catch (err) {
        console.error(err);
        alert(`Error saving PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.signerInterfaceEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('sign-pdf-tool')) {
    customElements.define('sign-pdf-tool', SignPdfTool);
  }
</script>
