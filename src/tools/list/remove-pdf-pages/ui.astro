---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF.js and PDFLib from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<remove-pdf-pages-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Remove PDF Pages</h3>
      <p class="converter-subtitle">Visually select and delete pages from your PDF file locally in your browser.</p>
    </div>

    <!-- Dropzone -->
    <div class="dropzone" id="remove-dropzone">
      <input type="file" id="remove-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF to remove pages" />
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files</p>
      </div>
    </div>

    <!-- Interface -->
    <div class="config-panel hidden" id="remove-interface">
      <div class="removal-actions">
        <div class="input-selection-group">
          <label for="remove-page-input" class="field-label">Pages to remove (e.g. 1, 3-5):</label>
          <input type="text" id="remove-page-input" class="field-input" placeholder="e.g. 2, 4-6" />
        </div>
        
        <div class="panel-buttons">
          <button id="btn-select-all" class="btn btn-secondary btn-sm">Select All</button>
          <button id="btn-clear-selection" class="btn btn-secondary btn-sm">Clear</button>
        </div>
      </div>

      <!-- Thumbnail grid -->
      <div class="thumbnail-section">
        <h4 class="section-subtitle">Click pages to mark for deletion</h4>
        <div class="thumbnail-grid" id="thumbnail-grid"></div>
      </div>

      <div class="converter-actions">
        <button id="btn-compile-pdf" class="btn btn-danger btn-lg">
          Delete Selected Pages
        </button>
        <button id="btn-cancel" class="btn btn-secondary">
          Cancel
        </button>
      </div>
    </div>

    <!-- Loading / Status -->
    <div class="converter-loading hidden" id="remove-loading-panel">
      <div class="spinner"></div>
      <p id="loading-status">Generating new PDF document...</p>
    </div>

    <!-- Results Panel -->
    <div class="converter-results hidden" id="remove-results-panel">
      <div class="divider"></div>
      
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Selected Pages Removed!
      </div>

      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Modified PDF
        </a>
      </div>
    </div>
  </div>
</remove-pdf-pages-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .config-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .removal-actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .input-selection-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
    max-width: 400px;
  }

  .panel-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
    width: 100%;
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .thumbnail-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1.25rem;
    max-height: 400px;
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: rgba(0,0,0,0.1);
  }

  /* Custom Scrollbar */
  .thumbnail-grid::-webkit-scrollbar {
    width: 8px;
  }
  .thumbnail-grid::-webkit-scrollbar-track {
    background: transparent;
  }
  .thumbnail-grid::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  .thumb-item {
    position: relative;
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background: #FFFFFF;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    aspect-ratio: 3/4;
  }

  .thumb-item:hover {
    border-color: var(--border-hover);
    transform: scale(1.02);
  }

  .thumb-item.selected {
    border-color: var(--error);
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.2);
  }

  .thumb-canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .thumb-badge {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0, 0, 0, 0.75);
    color: #FFFFFF;
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .thumb-delete-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(239, 68, 68, 0.35);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .thumb-item.selected .thumb-delete-overlay {
    opacity: 1;
  }

  .delete-icon {
    font-size: 2rem;
    color: #FFFFFF;
    font-weight: bold;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }

  .converter-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--success-subtle);
    color: var(--success);
  }

  .download-box {
    display: flex;
    justify-content: center;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  class RemovePdfPagesTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private interfaceEl!: HTMLDivElement;
    private thumbnailGridEl!: HTMLDivElement;
    private pageInputEl!: HTMLInputElement;
    
    private btnSelectAllEl!: HTMLButtonElement;
    private btnClearSelectionEl!: HTMLButtonElement;
    private btnCompilePdfEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnDownloadEl!: HTMLAnchorElement;

    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;

    private selectedFile: File | null = null;
    private totalPages = 0;
    private selectedPages: Set<number> = new Set(); // 1-based page numbers selected for REMOVAL

    connectedCallback() {
      this.fileInputEl = this.querySelector('#remove-file-input')!;
      this.dropzoneEl = this.querySelector('#remove-dropzone')!;
      this.interfaceEl = this.querySelector('#remove-interface')!;
      this.thumbnailGridEl = this.querySelector('#thumbnail-grid')!;
      this.pageInputEl = this.querySelector('#remove-page-input')!;

      this.btnSelectAllEl = this.querySelector('#btn-select-all')!;
      this.btnClearSelectionEl = this.querySelector('#btn-clear-selection')!;
      this.btnCompilePdfEl = this.querySelector('#btn-compile-pdf')!;
      this.btnCancelEl = this.querySelector('#btn-cancel')!;
      this.btnDownloadEl = this.querySelector('#btn-download')!;

      this.loadingPanelEl = this.querySelector('#remove-loading-panel')!;
      this.resultsPanelEl = this.querySelector('#remove-results-panel')!;

      // Bind drag and drop
      this.fileInputEl.addEventListener('change', (e) => this.handleFileSelect(e));
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });
      this.dropzoneEl.addEventListener('dragleave', () => this.dropzoneEl.classList.remove('dragover'));
      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });

      this.btnSelectAllEl.addEventListener('click', () => this.selectAll());
      this.btnClearSelectionEl.addEventListener('click', () => this.clearSelection());
      this.btnCompilePdfEl.addEventListener('click', () => this.compilePdf());
      this.btnCancelEl.addEventListener('click', () => this.reset());

      // Monitor text input updates
      this.pageInputEl.addEventListener('input', () => this.handleTextInput());
    }

    private handleFileSelect(e: Event) {
      const target = e.target as HTMLInputElement;
      if (target.files?.length) {
        this.processFile(target.files[0]);
      }
    }

    private async processFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;

      if (typeof window.pdfjsLib === 'undefined') {
        alert('PDF rendering engine is loading. Please wait.');
        return;
      }

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;
        this.totalPages = pdf.numPages;
        this.selectedPages.clear();

        // Render thumbnails
        this.thumbnailGridEl.innerHTML = '';
        for (let i = 1; i <= this.totalPages; i++) {
          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 0.25 }); // Small scale for thumbnail

          const thumbItem = document.createElement('div');
          thumbItem.className = 'thumb-item';
          thumbItem.dataset.page = i.toString();

          const canvas = document.createElement('canvas');
          canvas.className = 'thumb-canvas';
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d')!;
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          await page.render({ canvasContext: ctx, viewport }).promise;

          const badge = document.createElement('div');
          badge.className = 'thumb-badge';
          badge.textContent = i.toString();

          const overlay = document.createElement('div');
          overlay.className = 'thumb-delete-overlay';
          overlay.innerHTML = '<span class="delete-icon">✕</span>';

          thumbItem.appendChild(canvas);
          thumbItem.appendChild(badge);
          thumbItem.appendChild(overlay);

          thumbItem.addEventListener('click', () => this.togglePageSelection(i, thumbItem));

          this.thumbnailGridEl.appendChild(thumbItem);
        }

        this.loadingPanelEl.classList.add('hidden');
        this.interfaceEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Error loading PDF pages.');
        this.reset();
      }
    }

    private togglePageSelection(pageNum: number, element: HTMLDivElement) {
      if (this.selectedPages.has(pageNum)) {
        this.selectedPages.delete(pageNum);
        element.classList.remove('selected');
      } else {
        this.selectedPages.add(pageNum);
        element.classList.add('selected');
      }
      this.updateTextInputFromSelection();
    }

    private selectAll() {
      for (let i = 1; i <= this.totalPages; i++) {
        this.selectedPages.add(i);
      }
      this.querySelectorAll('.thumb-item').forEach(el => el.classList.add('selected'));
      this.updateTextInputFromSelection();
    }

    private clearSelection() {
      this.selectedPages.clear();
      this.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('selected'));
      this.pageInputEl.value = '';
    }

    private updateTextInputFromSelection() {
      if (this.selectedPages.size === 0) {
        this.pageInputEl.value = '';
        return;
      }
      // Sort pages and format
      const pages = Array.from(this.selectedPages).sort((a, b) => a - b);
      const ranges: string[] = [];
      let start = pages[0];
      let end = pages[0];

      for (let i = 1; i < pages.length; i++) {
        if (pages[i] === end + 1) {
          end = pages[i];
        } else {
          ranges.push(start === end ? `${start}` : `${start}-${end}`);
          start = pages[i];
          end = pages[i];
        }
      }
      ranges.push(start === end ? `${start}` : `${start}-${end}`);
      this.pageInputEl.value = ranges.join(', ');
    }

    private handleTextInput() {
      const val = this.pageInputEl.value;
      this.selectedPages.clear();
      this.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('selected'));

      if (!val.trim()) return;

      // Parse range strings e.g. "1, 3-5"
      const parts = val.split(',');
      parts.forEach(part => {
        const cleanPart = part.trim();
        if (cleanPart.includes('-')) {
          const [startStr, endStr] = cleanPart.split('-');
          const start = parseInt(startStr, 10);
          const end = parseInt(endStr, 10);
          if (!isNaN(start) && !isNaN(end) && start <= end) {
            for (let i = start; i <= end; i++) {
              if (i >= 1 && i <= this.totalPages) {
                this.selectedPages.add(i);
                const thumb = this.querySelector(`.thumb-item[data-page="${i}"]`);
                if (thumb) thumb.classList.add('selected');
              }
            }
          }
        } else {
          const num = parseInt(cleanPart, 10);
          if (!isNaN(num) && num >= 1 && num <= this.totalPages) {
            this.selectedPages.add(num);
            const thumb = this.querySelector(`.thumb-item[data-page="${num}"]`);
            if (thumb) thumb.classList.add('selected');
          }
        }
      });
    }

    private async compilePdf() {
      if (!this.selectedFile) return;

      if (this.selectedPages.size === 0) {
        alert('Please select at least one page to remove.');
        return;
      }

      if (this.selectedPages.size === this.totalPages) {
        alert('Cannot remove all pages from a PDF. Keep at least one page.');
        return;
      }

      if (typeof window.PDFLib === 'undefined') {
        alert('PDF writing library is loading. Please try again.');
        return;
      }

      this.interfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        const { PDFDocument } = window.PDFLib;
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);

        // Indices to remove (0-indexed)
        const indicesToRemove = Array.from(this.selectedPages).map(p => p - 1);
        
        // CRITICAL: Sort indices in descending order so they do not shift during sequential deletion
        indicesToRemove.sort((a, b) => b - a);
        indicesToRemove.forEach(idx => pdfDoc.removePage(idx));

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        this.btnDownloadEl.href = url;
        this.btnDownloadEl.download = `${this.selectedFile.name.replace('.pdf', '')}_modified.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.resultsPanelEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Error compiling final PDF.');
        this.loadingPanelEl.classList.add('hidden');
        this.interfaceEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.totalPages = 0;
      this.selectedPages.clear();
      this.fileInputEl.value = '';
      this.pageInputEl.value = '';
      this.thumbnailGridEl.innerHTML = '';

      this.interfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.dropzoneEl.classList.remove('hidden');
    }
  }

  if (!customElements.get('remove-pdf-pages-tool')) {
    customElements.define('remove-pdf-pages-tool', RemovePdfPagesTool);
  }
</script>
