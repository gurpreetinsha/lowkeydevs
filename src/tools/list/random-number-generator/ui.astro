---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<rand-num-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="form-group">
          <label for="num-min" class="label">Minimum</label>
          <input type="number" id="num-min" value="1" class="input" />
        </div>
        <div class="form-group">
          <label for="num-max" class="label">Maximum</label>
          <input type="number" id="num-max" value="100" class="input" />
        </div>
        <div class="form-group">
          <label for="num-qty" class="label">{t('common.Quantity')}</label>
          <input type="number" id="num-qty" value="10" min="1" max="1000" class="input" />
        </div>
      </div>

      <div class="options-grid">
        <div class="form-group">
          <label for="num-sort" class="label">Sort Order</label>
          <select id="num-sort" class="select">
            <option value="none">None (Random)</option>
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>
        </div>
        <div class="form-group">
          <label for="num-sep" class="label">Separator</label>
          <select id="num-sep" class="select">
            <option value="\n">New Line</option>
            <option value=", ">Comma (, )</option>
            <option value=" ">Space ( )</option>
          </select>
        </div>
        <div class="checkbox-wrapper">
          <label class="checkbox-container">
            <input type="checkbox" id="num-unique" checked />
            <span class="checkmark"></span>
            Unique Numbers (no duplicates)
          </label>
        </div>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Shuffle" size={18} />
          Generate Numbers
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated Numbers</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy All')}</span>
        </button>
      </div>
      <textarea
        id="num-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated numbers will appear here..."
        aria-label="Generated numbers output"
      ></textarea>
    </div>
  </div>
</rand-num-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .checkbox-wrapper {
    display: flex;
    align-items: center;
    padding-top: 1.5rem;
  }

  @media (max-width: 600px) {
    .inputs-grid, .options-grid {
      grid-template-columns: 1fr;
    }
    .checkbox-wrapper {
      padding-top: 0;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 150px;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 18px;
    width: 18px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--accent);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--accent);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateRandomNumbers, type RandomNumberOptions } from './logic';

  class RandNumTool extends HTMLElement {
    private minInput!: HTMLInputElement;
    private maxInput!: HTMLInputElement;
    private qtyInput!: HTMLInputElement;
    private sortSelect!: HTMLSelectElement;
    private sepSelect!: HTMLSelectElement;
    private uniqueCheckbox!: HTMLInputElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.minInput = this.querySelector('#num-min') as HTMLInputElement;
      this.maxInput = this.querySelector('#num-max') as HTMLInputElement;
      this.qtyInput = this.querySelector('#num-qty') as HTMLInputElement;
      this.sortSelect = this.querySelector('#num-sort') as HTMLSelectElement;
      this.sepSelect = this.querySelector('#num-sep') as HTMLSelectElement;
      this.uniqueCheckbox = this.querySelector('#num-unique') as HTMLInputElement;
      this.outputEl = this.querySelector('#num-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      // Generate on initial load
      this.handleGenerate();
    }

    private handleGenerate() {
      const min = parseInt(this.minInput.value, 10);
      const max = parseInt(this.maxInput.value, 10);
      const quantity = parseInt(this.qtyInput.value, 10);
      const sort = this.sortSelect.value as RandomNumberOptions['sort'];
      const separatorStr = this.sepSelect.value;
      const separator = separatorStr === '\\n' ? '\n' : separatorStr as RandomNumberOptions['separator'];
      const unique = this.uniqueCheckbox.checked;

      if (isNaN(min) || isNaN(max) || isNaN(quantity)) {
        this.outputEl.value = 'Please enter valid numbers.';
        return;
      }

      if (min > max) {
        this.outputEl.value = 'Minimum cannot be greater than Maximum.';
        return;
      }

      const nums = generateRandomNumbers({ min, max, quantity, unique, sort, separator });
      this.outputEl.value = nums.join(separator);
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please') || text.startsWith('Minimum')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy All') || 'Copy All');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy numbers', err);
      }
    }
  }

  if (!customElements.get('rand-num-tool')) {
    customElements.define('rand-num-tool', RandNumTool);
  }
</script>
