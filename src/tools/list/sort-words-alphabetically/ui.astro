---
import Icon from '../../../components/base/Icon.astro';
---

<sort-words-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="settings-grid">
      <div class="form-group">
        <label for="sort-separator" class="label">Item Separator</label>
        <select id="sort-separator" class="select-input">
          <option value="newline">Newline (Line by Line)</option>
          <option value="space">Space</option>
          <option value="comma">Comma</option>
          <option value="tab">Tab</option>
          <option value="custom">Custom Delimiter</option>
        </select>
      </div>

      <div class="form-group" id="custom-separator-group" style="display: none;">
        <label for="custom-separator" class="label">Custom Delimiter</label>
        <input type="text" id="custom-separator" placeholder="e.g. | or ;" class="input" />
      </div>

      <div class="form-group">
        <label for="sort-order" class="label">Sort Order</label>
        <select id="sort-order" class="select-input">
          <option value="asc">Ascending (A to Z, 0 to 9)</option>
          <option value="desc">Descending (Z to A, 9 to 0)</option>
        </select>
      </div>
    </div>

    <div class="checkbox-options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-case" />
        <span class="checkmark"></span>
        Case Sensitive
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-uniq" />
        <span class="checkmark"></span>
        Remove Duplicates
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-punct" checked />
        <span class="checkmark"></span>
        Ignore Punctuation (during sorting)
      </label>
    </div>

    <div class="control-actions">
      <button data-action="sort" class="btn btn-primary">
        <Icon name="SortAsc" size={16} />
        Sort Words
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text / List</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="sort-words-input" 
        placeholder="Paste your words or list items here..." 
        aria-label="Input Text to Sort"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Sorted Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      <div class="output-container">
        <textarea 
          id="sort-words-output" 
          placeholder="Sorted words will appear here..." 
          readonly
          aria-label="Sorted Output Text"
        ></textarea>
      </div>
    </div>
  </div>
</sort-words-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .select-input {
    width: 100%;
    padding: 0.625rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .select-input:focus {
    border-color: var(--primary-accent);
  }

  .checkbox-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #sort-words-input,
  #sort-words-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #sort-words-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { sortWords } from './logic';

  class SortWordsTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private separatorEl!: HTMLSelectElement;
    private customSeparatorGroupEl!: HTMLDivElement;
    private customSeparatorEl!: HTMLInputElement;
    private orderEl!: HTMLSelectElement;
    private caseEl!: HTMLInputElement;
    private uniqEl!: HTMLInputElement;
    private punctEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#sort-words-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#sort-words-output') as HTMLTextAreaElement;
      this.separatorEl = this.querySelector('#sort-separator') as HTMLSelectElement;
      this.customSeparatorGroupEl = this.querySelector('#custom-separator-group') as HTMLDivElement;
      this.customSeparatorEl = this.querySelector('#custom-separator') as HTMLInputElement;
      this.orderEl = this.querySelector('#sort-order') as HTMLSelectElement;
      this.caseEl = this.querySelector('#opt-case') as HTMLInputElement;
      this.uniqEl = this.querySelector('#opt-uniq') as HTMLInputElement;
      this.punctEl = this.querySelector('#opt-punct') as HTMLInputElement;

      // Realtime sorting on input/settings change
      const triggers = [
        this.inputEl,
        this.customSeparatorEl
      ];
      triggers.forEach(el => el.addEventListener('input', () => this.handleSort()));

      const changeTriggers = [
        this.orderEl,
        this.caseEl,
        this.uniqEl,
        this.punctEl
      ];
      changeTriggers.forEach(el => el.addEventListener('change', () => this.handleSort()));

      this.separatorEl.addEventListener('change', () => {
        if (this.separatorEl.value === 'custom') {
          this.customSeparatorGroupEl.style.display = 'flex';
        } else {
          this.customSeparatorGroupEl.style.display = 'none';
        }
        this.handleSort();
      });

      // Actions click
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'sort') this.handleSort();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });
    }

    private handleSort() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        order: this.orderEl.value as 'asc' | 'desc',
        separator: this.separatorEl.value as any,
        customSeparator: this.customSeparatorEl.value,
        caseSensitive: this.caseEl.checked,
        removeDuplicates: this.uniqEl.checked,
        ignorePunctuation: this.punctEl.checked
      };

      const sorted = sortWords(text, options);
      this.outputEl.value = sorted;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.separatorEl.value = 'newline';
      this.customSeparatorGroupEl.style.display = 'none';
      this.customSeparatorEl.value = '';
      this.orderEl.value = 'asc';
      this.caseEl.checked = false;
      this.uniqEl.checked = false;
      this.punctEl.checked = true;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.separatorEl.value = 'newline';
      this.customSeparatorGroupEl.style.display = 'none';
      this.inputEl.value = "Banana\nApple\nCherry\nOrange\napple\nBanana\nGrape";
      this.handleSort();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }
  }

  if (!customElements.get('sort-words-tool')) {
    customElements.define('sort-words-tool', SortWordsTool);
  }
</script>
