---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<remove-emdash-tool class="tool-workspace">
  <!-- Controls Panel -->
  <div class="tool-controls glass-panel">
    <div class="control-actions">
      <!-- Replacement option -->
      <div class="control-group">
        <label for="replacement-select" class="label">Replace Dashes with:</label>
        <select id="replacement-select" class="select select-compact">
          <option value="hyphen">Standard Hyphen (-)</option>
          <option value="doubleHyphen">Double Hyphen (--)</option>
          <option value="space">Space (" ")</option>
          <option value="empty">Remove completely</option>
          <option value="custom">Custom text</option>
        </select>
      </div>

      <!-- Custom text field (initially hidden) -->
      <div class="control-group hidden" id="custom-value-container">
        <label for="custom-input" class="label">Custom:</label>
        <input type="text" id="custom-input" class="input input-compact" placeholder="e.g. _" style="max-width: 100px;" />
      </div>
    </div>
    <div class="control-danger">
      <button data-action="clear" class="btn btn-danger btn-sm">
        <Icon name="Trash2" size={14} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <!-- Dual Pane Grid -->
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea
        id="text-input"
        placeholder="Type or paste text with em (—) or en (–) dashes here..."
        aria-label="Text Input"
      ></textarea>
      
      <!-- Live Stats -->
      <div class="stats-row">
        <div class="stat-item"><span class="stat-label">Dashes Found:</span> <strong id="stat-count">0</strong></div>
      </div>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">{t('common.Result')}</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      <textarea
        id="text-output"
        readonly
        placeholder="Result will appear here..."
        aria-label="Result Output"
      ></textarea>
    </div>
  </div>
</remove-emdash-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  .input-compact {
    padding: 6px 10px;
    font-size: 13px;
    min-height: auto;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 380px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #text-input, #text-output {
    flex: 1;
    width: 100%;
    min-height: 260px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: vertical;
    outline: none;
  }

  .stats-row {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { removeEmDash, type RemoveEmDashOptions } from './logic';

  class RemoveEmDashTool extends HTMLElement {
    private textInput!: HTMLTextAreaElement;
    private textOutput!: HTMLTextAreaElement;
    private replSelect!: HTMLSelectElement;
    private customContainer!: HTMLElement;
    private customInput!: HTMLInputElement;
    private statCount!: HTMLElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.textInput = this.querySelector('#text-input') as HTMLTextAreaElement;
      this.textOutput = this.querySelector('#text-output') as HTMLTextAreaElement;
      this.replSelect = this.querySelector('#replacement-select') as HTMLSelectElement;
      this.customContainer = this.querySelector('#custom-value-container') as HTMLElement;
      this.customInput = this.querySelector('#custom-input') as HTMLInputElement;
      this.statCount = this.querySelector('#stat-count') as HTMLElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.textInput.addEventListener('input', () => this.handleProcess());
      this.replSelect.addEventListener('change', () => {
        if (this.replSelect.value === 'custom') {
          this.customContainer.classList.remove('hidden');
        } else {
          this.customContainer.classList.add('hidden');
        }
        this.handleProcess();
      });
      this.customInput.addEventListener('input', () => this.handleProcess());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (action === 'copy') this.handleCopy();
      });
    }

    private handleProcess() {
      const text = this.textInput.value;
      const replacement = this.replSelect.value as RemoveEmDashOptions['replacement'];
      const customValue = this.customInput.value;
      
      this.textOutput.value = removeEmDash(text, { replacement, customValue });

      // Count em and en dashes
      const emCount = (text.match(/\u2014/g) || []).length;
      const enCount = (text.match(/\u2013/g) || []).length;
      this.statCount.textContent = (emCount + enCount).toString();
    }

    private handleClear() {
      this.textInput.value = '';
      this.handleProcess();
      this.textInput.focus();
    }

    private handleLoadSample() {
      this.textInput.value = 'First point\u2014it is crucial\u2014to review the data (2020\u20132025).';
      this.handleProcess();
    }

    private async handleCopy() {
      const text = this.textOutput.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text', err);
      }
    }
  }

  if (!customElements.get('remove-em-dash-tool')) {
    customElements.define('remove-em-dash-tool', RemoveEmDashTool);
  }
</script>
