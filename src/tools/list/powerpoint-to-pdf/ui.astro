---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<!-- Load external zip and rendering libraries from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" is:inline></script>

<pptx-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Convert PowerPoint to PDF</h3>
      <p class="converter-subtitle">Convert PowerPoint presentations (.pptx) to PDF format locally in your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="pptx-dropzone">
      <input type="file" id="pptx-file-input" accept=".pptx" class="hidden-input" aria-label="Upload PowerPoint presentation" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PPTX file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports PowerPoint .pptx documents (Max 30MB)</p>
      </div>
    </div>

    <!-- Preview & Configuration Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pptx</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Slides Preview Container -->
      <div class="preview-box">
        <h4 class="section-subtitle">Slides Preview</h4>
        
        <div class="slide-navigation">
          <button class="btn btn-secondary btn-sm" id="btn-prev-slide" disabled>◀ Previous Slide</button>
          <span class="slide-indicator">Slide <span id="current-slide-num">1</span> of <span id="total-slides-num">1</span></span>
          <button class="btn btn-secondary btn-sm" id="btn-next-slide" disabled>Next Slide ▶</button>
        </div>

        <div class="preview-viewport">
          <div class="pptx-slide-card" id="pptx-slide-viewer">
            <!-- Parsed Slide Content goes here -->
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-convert" class="btn btn-primary btn-lg">
          Convert to PDF
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Extracting presentation slides, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Conversion Complete!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download PDF Document
        </a>
      </div>
    </div>
  </div>
</pptx-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  /* Slide Preview Section */
  .preview-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .slide-navigation {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .slide-indicator {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .preview-viewport {
    background: #2b2b2b; /* contrasting dark backdrop */
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    justify-content: center;
    width: 100%;
    overflow-x: auto;
  }

  .pptx-slide-card {
    width: 640px;
    height: 360px; /* 16:9 Aspect Ratio */
    background: #ffffff;
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-sm);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow-y: auto;
    color: #333333;
    font-family: Calibri, Arial, sans-serif;
  }

  .pptx-slide-card h1 {
    font-size: 24px;
    font-weight: bold;
    color: #000;
    margin-top: 0;
    margin-bottom: 1.5rem;
    border-bottom: 1.5px solid #eaeaea;
    padding-bottom: 8px;
  }

  .pptx-slide-card p {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 0;
    margin-bottom: 8px;
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class PowerpointToPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private btnPrevSlideEl!: HTMLButtonElement;
    private btnNextSlideEl!: HTMLButtonElement;
    private currentSlideNumEl!: HTMLSpanElement;
    private totalSlidesNumEl!: HTMLSpanElement;
    private slideViewerEl!: HTMLDivElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnConvertEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    
    // Array of parsed slide HTML contents
    private slideHtmlList: string[] = [];
    private activeSlideIndex: number = 0;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#pptx-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#pptx-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.btnPrevSlideEl = this.querySelector('#btn-prev-slide') as HTMLButtonElement;
      this.btnNextSlideEl = this.querySelector('#btn-next-slide') as HTMLButtonElement;
      this.currentSlideNumEl = this.querySelector('#current-slide-num') as HTMLSpanElement;
      this.totalSlidesNumEl = this.querySelector('#total-slides-num') as HTMLSpanElement;
      this.slideViewerEl = this.querySelector('#pptx-slide-viewer') as HTMLDivElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnConvertEl = this.querySelector('#btn-convert') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Navigation
      this.btnPrevSlideEl.addEventListener('click', () => this.changeSlide(-1));
      this.btnNextSlideEl.addEventListener('click', () => this.changeSlide(1));

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnConvertEl.addEventListener('click', () => this.runConversion());
    }

    private async handleFile(file: File) {
      if (!file.name.endsWith('.pptx')) {
        alert('Please select a valid PowerPoint (.pptx) file.');
        return;
      }

      if (typeof window.JSZip === 'undefined') {
        alert('Zip utility library is loading. Please wait a moment.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingTextEl.textContent = 'Unzipping presentation...';

      try {
        const arrayBuffer = await file.arrayBuffer();
        const zip = await window.JSZip.loadAsync(arrayBuffer);

        // Find slide keys
        const slideKeys = Object.keys(zip.files)
          .filter(key => key.match(/^ppt\/slides\/slide[0-9]+\.xml$/))
          .sort((a, b) => {
            const numA = parseInt(a.replace(/[^0-9]/g, ''), 10);
            const numB = parseInt(b.replace(/[^0-9]/g, ''), 10);
            return numA - numB;
          });

        if (slideKeys.length === 0) {
          throw new Error('No slides found in the presentation.');
        }

        this.slideHtmlList = [];
        this.activeSlideIndex = 0;

        const domParser = new DOMParser();

        // Extract slide contents
        for (let idx = 0; idx < slideKeys.length; idx++) {
          const key = slideKeys[idx];
          this.loadingTextEl.textContent = `Parsing slide ${idx + 1} of ${slideKeys.length}...`;
          
          const xmlStr = await zip.files[key].async('string');
          const slideDoc = domParser.parseFromString(xmlStr, 'application/xml');

          // Extract text runs inside <a:p> elements
          const paragraphs = slideDoc.getElementsByTagName('a:p');
          let slideContent = '';
          let isTitle = true;

          for (const p of paragraphs) {
            const runs = p.getElementsByTagName('a:t');
            const text = Array.from(runs).map(r => r.textContent).join(' ').trim();
            if (text) {
              if (isTitle) {
                slideContent += `<h1>${text}</h1>\n`;
                isTitle = false;
              } else {
                slideContent += `<p>${text}</p>\n`;
              }
            }
          }

          if (!slideContent) {
            slideContent = '<p style="color: grey; text-align: center; margin-top: 30%;">[Empty Slide]</p>';
          }

          this.slideHtmlList.push(slideContent);
        }

        this.totalSlidesNumEl.textContent = this.slideHtmlList.length.toString();
        this.renderCurrentSlide();

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.add('hidden');
      } catch (err) {
        console.error(err);
        alert(`Error parsing PowerPoint file: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.reset();
      }
    }

    private renderCurrentSlide() {
      if (this.slideHtmlList.length === 0) return;

      this.currentSlideNumEl.textContent = (this.activeSlideIndex + 1).toString();
      this.btnPrevSlideEl.disabled = this.activeSlideIndex === 0;
      this.btnNextSlideEl.disabled = this.activeSlideIndex === this.slideHtmlList.length - 1;

      this.slideViewerEl.innerHTML = this.slideHtmlList[this.activeSlideIndex];
    }

    private changeSlide(dir: number) {
      const target = this.activeSlideIndex + dir;
      if (target >= 0 && target < this.slideHtmlList.length) {
        this.activeSlideIndex = target;
        this.renderCurrentSlide();
      }
    }

    private reset() {
      this.selectedFile = null;
      this.slideHtmlList = [];
      this.activeSlideIndex = 0;
      this.fileInputEl.value = '';
      this.slideViewerEl.innerHTML = '';
      
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    private async runConversion() {
      if (!this.selectedFile || this.slideHtmlList.length === 0) return;

      if (typeof window.jspdf === 'undefined' || typeof window.html2canvas === 'undefined') {
        alert('Rendering libraries are still loading. Please wait.');
        return;
      }

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingTextEl.textContent = 'Compiling slides into PDF pages...';

      try {
        const { jsPDF } = window.jspdf;

        // Landscape A4 sizes: 841.89 x 595.28 pt
        const doc = new jsPDF({
          orientation: 'landscape',
          unit: 'pt',
          format: 'a4'
        });

        // Loop and render slide HTML sequentially
        for (let idx = 0; idx < this.slideHtmlList.length; idx++) {
          this.loadingTextEl.textContent = `Rendering slide page ${idx + 1} of ${this.slideHtmlList.length}...`;

          this.slideViewerEl.innerHTML = this.slideHtmlList[idx];

          const canvas = await window.html2canvas(this.slideViewerEl, {
            scale: 2.0,
            useCORS: true,
            backgroundColor: '#ffffff',
            logging: false
          });

          const imgData = canvas.toDataURL('image/jpeg', 0.95);
          
          if (idx > 0) {
            doc.addPage();
          }

          doc.addImage(imgData, 'JPEG', 0, 0, 841.89, 595.28);
        }

        // Restore original active slide
        this.renderCurrentSlide();

        const pdfBlob = doc.output('blob');
        const url = URL.createObjectURL(pdfBlob);

        this.downloadBtnEl.href = url;
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        this.downloadBtnEl.download = `${baseName}.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error rendering PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('pptx-pdf-tool')) {
    customElements.define('pptx-pdf-tool', PowerpointToPdfTool);
  }
</script>
