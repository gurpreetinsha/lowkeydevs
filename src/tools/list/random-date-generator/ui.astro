---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<rand-date-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Controls Form -->
    <div class="generator-controls">
      <div class="inputs-grid">
        <div class="form-group">
          <label for="date-start" class="label">Start Date</label>
          <input type="date" id="date-start" class="input" />
        </div>
        <div class="form-group">
          <label for="date-end" class="label">End Date</label>
          <input type="date" id="date-end" class="input" />
        </div>
      </div>

      <div class="options-grid">
        <div class="form-group">
          <label for="date-qty" class="label">{t('common.Quantity')}</label>
          <input type="number" id="date-qty" value="5" min="1" max="1000" class="input" />
        </div>
        <div class="form-group">
          <label for="date-format" class="label">Output Format</label>
          <select id="date-format" class="select">
            <option value="YYYY-MM-DD">YYYY-MM-DD</option>
            <option value="MM/DD/YYYY">MM/DD/YYYY</option>
            <option value="DD/MM/YYYY">DD/MM/YYYY</option>
            <option value="ISO">ISO 8601 String</option>
          </select>
        </div>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Calendar" size={18} />
          Generate Dates
        </button>
      </div>
    </div>

    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated Dates</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy All')}</span>
        </button>
      </div>
      <textarea
        id="date-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated dates will appear here..."
        aria-label="Generated dates output"
      ></textarea>
    </div>
  </div>
</rand-date-tool>

<style>
  .tool-workspace {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .inputs-grid, .options-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pane-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 150px;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
    background-color: var(--bg);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
    outline: none;
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
  }

  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success);
  }

  #btn-copy.copied {
    border-color: var(--success);
  }
</style>

<script>
  import { generateRandomDates, type DateGenOptions } from './logic';

  class RandDateTool extends HTMLElement {
    private startInput!: HTMLInputElement;
    private endInput!: HTMLInputElement;
    private qtyInput!: HTMLInputElement;
    private formatSelect!: HTMLSelectElement;
    private outputEl!: HTMLTextAreaElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.startInput = this.querySelector('#date-start') as HTMLInputElement;
      this.endInput = this.querySelector('#date-end') as HTMLInputElement;
      this.qtyInput = this.querySelector('#date-qty') as HTMLInputElement;
      this.formatSelect = this.querySelector('#date-format') as HTMLSelectElement;
      this.outputEl = this.querySelector('#date-output') as HTMLTextAreaElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      this.btnGenerate.addEventListener('click', () => this.handleGenerate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'copy') this.handleCopy();
      });

      // Default range: Jan 1st current year to Dec 31st current year
      const year = new Date().getFullYear();
      this.startInput.value = `${year}-01-01`;
      this.endInput.value = `${year}-12-31`;

      this.handleGenerate();
    }

    private handleGenerate() {
      const startDate = this.startInput.value;
      const endDate = this.endInput.value;
      const quantity = parseInt(this.qtyInput.value, 10);
      const format = this.formatSelect.value as DateGenOptions['format'];

      if (!startDate || !endDate || isNaN(quantity)) {
        this.outputEl.value = 'Please select valid start and end dates.';
        return;
      }

      if (Date.parse(startDate) > Date.parse(endDate)) {
        this.outputEl.value = 'Start date cannot be after end date.';
        return;
      }

      const list = generateRandomDates({ startDate, endDate, quantity, format });
      this.outputEl.value = list.join('\n');
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text || text.startsWith('Please') || text.startsWith('Start date')) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy All') || 'Copy All');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy dates', err);
      }
    }
  }

  if (!customElements.get('rand-date-tool')) {
    customElements.define('rand-date-tool', RandDateTool);
  }
</script>
