---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<unicode-converter-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <!-- Mode Select Toggle -->
    <div class="toggle-group" role="radiogroup" aria-label="Unicode Conversion Mode">
      <button data-mode="decode" class="toggle-btn active" role="radio" aria-checked="true">
        Unicode to Text
      </button>
      <button data-mode="encode" class="toggle-btn" role="radio" aria-checked="false">
        Text to Unicode
      </button>
    </div>

    <!-- Format Selector (only active during Encode mode) -->
    <div class="control-group" id="format-group" style="display: none;">
      <label for="unicode-format-select" class="label">{t('common.Format')}</label>
      <select id="unicode-format-select" class="select select-compact">
        <option value="js">JS Escape (\\uXXXX)</option>
        <option value="js-brace">JS Braced (\\u&#123;XXXX&#125;)</option>
        <option value="html-dec">HTML Decimal (&#DD;)</option>
        <option value="html-hex">HTML Hex (&#xXX;)</option>
        <option value="css">CSS Escape (\\XXXX)</option>
        <option value="u-plus">Unicode Point (U+XXXX)</option>
      </select>
    </div>
    
    <div class="control-actions">
      <button data-action="clear" class="btn btn-danger btn-compact-sm">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="input-pane-title">Unicode Input</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="converter-input" 
        placeholder="Paste Unicode escape codes here..." 
        aria-label="Input content"
      ></textarea>
    </div>

    <!-- Output Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="output-pane-title">Plain Text Output</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      
      <div class="output-container">
        <textarea 
          id="converter-output" 
          placeholder="Plain text output will appear here..." 
          readonly 
          aria-label="Output content"
        ></textarea>
      </div>
    </div>
  </div>
</unicode-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Toggle Button Styles */
  .toggle-group {
    display: flex;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    padding: 0.25rem;
    border-radius: var(--radius-md);
  }

  .toggle-btn {
    border: none;
    background: none;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
  }

  .toggle-btn.active {
    background-color: var(--surface-color);
    color: var(--primary-accent);
    box-shadow: var(--shadow-sm);
  }

  .select-compact {
    padding: 0.5rem 2rem 0.5rem 1rem;
    font-size: 0.9rem;
    width: auto;
    cursor: pointer;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-compact-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* Grid Panes */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #converter-input,
  #converter-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #converter-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { unicodeToText, textToUnicode } from './logic';

  class UnicodeConverterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private inputPaneTitle!: HTMLElement;
    private outputPaneTitle!: HTMLElement;
    private formatGroupEl!: HTMLDivElement;
    private formatSelectEl!: HTMLSelectElement;
    private mode: 'encode' | 'decode' = 'decode';

    connectedCallback() {
      this.inputEl = this.querySelector('#converter-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#converter-output') as HTMLTextAreaElement;
      this.inputPaneTitle = this.querySelector('#input-pane-title') as HTMLElement;
      this.outputPaneTitle = this.querySelector('#output-pane-title') as HTMLElement;
      this.formatGroupEl = this.querySelector('#format-group') as HTMLDivElement;
      this.formatSelectEl = this.querySelector('#unicode-format-select') as HTMLSelectElement;

      // Event listener delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();

        const dataMode = button.getAttribute('data-mode') as 'encode' | 'decode' | null;
        if (dataMode) {
          this.setMode(dataMode);
        }
      });

      // Live processing as user types
      this.inputEl.addEventListener('input', () => this.processConversion());
      this.formatSelectEl.addEventListener('change', () => this.processConversion());
    }

    private setMode(mode: 'encode' | 'decode') {
      if (this.mode === mode) return;
      this.mode = mode;

      // Update active state in toggle buttons
      const toggleButtons = this.querySelectorAll('.toggle-btn');
      toggleButtons.forEach(btn => {
        const m = btn.getAttribute('data-mode');
        if (m === mode) {
          btn.classList.add('active');
          btn.setAttribute('aria-checked', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-checked', 'false');
        }
      });

      // Update pane headers
      if (mode === 'encode') {
        this.inputPaneTitle.textContent = 'Plain Text Input';
        this.outputPaneTitle.textContent = 'Unicode Output';
        this.inputEl.placeholder = 'Type or paste content here...';
        this.outputEl.placeholder = 'Unicode escapes will appear here...';
        this.formatGroupEl.style.display = 'flex';
      } else {
        this.inputPaneTitle.textContent = 'Unicode Input';
        this.outputPaneTitle.textContent = 'Plain Text Output';
        this.inputEl.placeholder = 'Paste Unicode escape codes here...';
        this.outputEl.placeholder = 'Plain text output will appear here...';
        this.formatGroupEl.style.display = 'none';
      }

      // Swap values
      const currentInput = this.inputEl.value;
      const currentOutput = this.outputEl.value;
      
      this.inputEl.value = currentOutput;
      this.outputEl.value = currentInput;

      this.processConversion();
    }

    private processConversion() {
      const val = this.inputEl.value;
      if (!val) {
        this.clearOutput();
        return;
      }

      if (this.mode === 'encode') {
        const format = this.formatSelectEl.value;
        const encoded = textToUnicode(val, format);
        this.outputEl.value = encoded;
      } else {
        const decoded = unicodeToText(val);
        this.outputEl.value = decoded;
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.clearOutput();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      if (this.mode === 'encode') {
        this.inputEl.value = "Hello World! 🌎";
      } else {
        this.inputEl.value = "Hello \\u{1f30e}! HTML entities: &#76;&#111;&#119;&#75;&#101;&#121;";
      }
      this.processConversion();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }

    private clearOutput() {
      this.outputEl.value = '';
    }
  }

  if (!customElements.get('unicode-converter-tool')) {
    customElements.define('unicode-converter-tool', UnicodeConverterTool);
  }
</script>
