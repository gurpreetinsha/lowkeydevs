---
import Icon from '../../../components/base/Icon.astro';
---

<duplicate-word-finder-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="options-flex">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-ignore-case" checked />
        <span class="checkmark"></span>
        Ignore Casing
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-ignore-punctuation" checked />
        <span class="checkmark"></span>
        Ignore Punctuation
      </label>

      <div class="control-group">
        <label for="opt-remove-mode" class="label">Removal Mode</label>
        <select id="opt-remove-mode" class="select select-compact">
          <option value="keep-first">Keep First Occurrence</option>
          <option value="remove-all">Remove All Duplicates</option>
        </select>
      </div>
    </div>

    <div class="control-actions">
      <button data-action="remove-duplicates" class="btn btn-primary">
        <Icon name="ListFilter" size={16} />
        Remove Duplicates
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="duplicate-input" 
        placeholder="Paste your text here to find duplicates..." 
        aria-label="Input Text"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Duplicate Analysis</span>
      </div>

      <div class="analysis-results">
        <!-- Success/No Duplicates State -->
        <div id="no-duplicates-banner" class="success-banner">
          <Icon name="Check" size={16} />
          <span>No duplicate words found.</span>
        </div>

        <!-- Duplicates Table -->
        <div id="duplicates-table-container" hidden>
          <span class="sub-title">Repeated Words List</span>
          <div class="badge-container" id="duplicates-badge-list">
            <!-- Dynamic Badges will go here -->
          </div>
        </div>

        <div class="output-wrapper" id="cleaned-output-container" hidden>
          <div class="pane-header output-inner-header">
            <span class="pane-title">Cleaned Text</span>
            <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
              <Icon name="Clipboard" size={14} class="copy-icon" />
              <Icon name="Check" size={14} class="check-icon" />
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <textarea 
            id="duplicate-output" 
            placeholder="Cleaned text will appear here..." 
            readonly
            aria-label="Cleaned output"
          ></textarea>
        </div>
      </div>
    </div>
  </div>
</duplicate-word-finder-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem 1.5rem;
    gap: 1.5rem;
  }

  .options-flex {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .select-compact {
    padding: 0.5rem 2rem 0.5rem 1rem;
    font-size: 0.9rem;
    width: auto;
    cursor: pointer;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #duplicate-input,
  #duplicate-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #duplicate-output {
    color: var(--text-secondary);
  }

  .analysis-results {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
  }

  .success-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: hsla(142, 70%, 45%, 0.1);
    border: 1px solid hsla(142, 70%, 45%, 0.2);
    color: var(--success-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
  }

  .sub-title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .badge-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-height: 120px;
    overflow-y: auto;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
  }

  .dup-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.85rem;
  }

  .dup-count {
    background-color: var(--primary-glow);
    color: var(--primary-accent);
    font-weight: 600;
    padding: 0.05rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .output-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .output-inner-header {
    border-bottom: none;
    padding-bottom: 0.5rem;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { findDuplicateWords, removeDuplicateWords } from './logic';

  class DuplicateWordFinderTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private optIgnoreCaseEl!: HTMLInputElement;
    private optIgnorePunctuationEl!: HTMLInputElement;
    private optRemoveModeEl!: HTMLSelectElement;

    private noDupsBannerEl!: HTMLDivElement;
    private tableContainerEl!: HTMLDivElement;
    private badgeListEl!: HTMLDivElement;
    private cleanedOutputContainerEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#duplicate-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#duplicate-output') as HTMLTextAreaElement;
      this.optIgnoreCaseEl = this.querySelector('#opt-ignore-case') as HTMLInputElement;
      this.optIgnorePunctuationEl = this.querySelector('#opt-ignore-punctuation') as HTMLInputElement;
      this.optRemoveModeEl = this.querySelector('#opt-remove-mode') as HTMLSelectElement;

      this.noDupsBannerEl = this.querySelector('#no-duplicates-banner') as HTMLDivElement;
      this.tableContainerEl = this.querySelector('#duplicates-table-container') as HTMLDivElement;
      this.badgeListEl = this.querySelector('#duplicates-badge-list') as HTMLDivElement;
      this.cleanedOutputContainerEl = this.querySelector('#cleaned-output-container') as HTMLDivElement;

      // Event listener actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'remove-duplicates') this.handleRemoveDuplicates();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Scan live
      this.inputEl.addEventListener('input', () => this.analyzeDuplicates());
      this.optIgnoreCaseEl.addEventListener('change', () => this.analyzeDuplicates());
      this.optIgnorePunctuationEl.addEventListener('change', () => this.analyzeDuplicates());
    }

    private analyzeDuplicates() {
      const text = this.inputEl.value;
      if (!text.trim()) {
        this.showNoDuplicates();
        return;
      }

      const duplicates = findDuplicateWords(text, {
        ignoreCase: this.optIgnoreCaseEl.checked,
        ignorePunctuation: this.optIgnorePunctuationEl.checked
      });

      if (duplicates.length === 0) {
        this.showNoDuplicates();
      } else {
        this.showDuplicates(duplicates);
      }
    }

    private showNoDuplicates() {
      this.noDupsBannerEl.removeAttribute('hidden');
      this.tableContainerEl.setAttribute('hidden', 'true');
      this.cleanedOutputContainerEl.setAttribute('hidden', 'true');
      this.outputEl.value = '';
    }

    private showDuplicates(duplicates: Array<{ word: string; count: number }>) {
      this.noDupsBannerEl.setAttribute('hidden', 'true');
      this.tableContainerEl.removeAttribute('hidden');
      this.cleanedOutputContainerEl.removeAttribute('hidden');

      this.badgeListEl.innerHTML = '';
      duplicates.forEach(dup => {
        const badge = document.createElement('div');
        badge.className = 'dup-badge';
        badge.innerHTML = `
          <span>${dup.word}</span>
          <span class="dup-count">${dup.count}x</span>
        `;
        this.badgeListEl.appendChild(badge);
      });

      // Run removal automatically to update the preview
      this.handleRemoveDuplicates(true);
    }

    private handleRemoveDuplicates(silent = false) {
      const text = this.inputEl.value;
      if (!text.trim()) return;

      const options = {
        ignoreCase: this.optIgnoreCaseEl.checked,
        ignorePunctuation: this.optIgnorePunctuationEl.checked,
        removeMode: this.optRemoveModeEl.value as 'keep-first' | 'remove-all'
      };

      const result = removeDuplicateWords(text, options);
      this.outputEl.value = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.showNoDuplicates();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "The writing process is a process of rewriting and editing editing. If you write write write, you will get better at writing writing writing.";
      this.analyzeDuplicates();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }
  }

  if (!customElements.get('duplicate-word-finder-tool')) {
    customElements.define('duplicate-word-finder-tool', DuplicateWordFinderTool);
  }
</script>
