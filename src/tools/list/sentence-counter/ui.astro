---
import Icon from '../../../components/base/Icon.astro';
---

<sentence-counter-tool class="tool-workspace">
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="sentence-counter-input" 
        placeholder="Type or paste your text here..." 
        aria-label="Input Text to Count"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger">
          <Icon name="Trash2" size={16} />
          Clear Input
        </button>
        <button data-action="copy-report" class="btn btn-secondary">
          <Icon name="Clipboard" size={16} />
          Copy Stats Report
        </button>
      </div>
    </div>

    <div class="stats-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Text Statistics</span>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon-wrapper sentences">
            <Icon name="Type" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Sentences</span>
            <span class="stat-val" id="stat-sentences">0</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon-wrapper words">
            <Icon name="FileText" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Words</span>
            <span class="stat-val" id="stat-words">0</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon-wrapper characters">
            <Icon name="Hash" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Characters (all)</span>
            <span class="stat-val" id="stat-chars-all">0</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon-wrapper characters-no-space">
            <Icon name="Hash" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Characters (no spaces)</span>
            <span class="stat-val" id="stat-chars-no-space">0</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon-wrapper paragraphs">
            <Icon name="Notebook" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Paragraphs</span>
            <span class="stat-val" id="stat-paragraphs">0</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon-wrapper avg-length">
            <Icon name="Info" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Avg Sentence Length</span>
            <span class="stat-val" id="stat-avg-length">0.0<span class="unit"> words</span></span>
          </div>
        </div>

        <div class="stat-card full-width">
          <div class="stat-icon-wrapper reading-time">
            <Icon name="Clock" size={20} />
          </div>
          <div class="stat-info">
            <span class="stat-label">Estimated Reading Time</span>
            <span class="stat-val" id="stat-reading-time">0.00<span class="unit"> minutes</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</sentence-counter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 480px;
    padding: 1.5rem;
  }

  .stats-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #sentence-counter-input {
    flex: 1;
    width: 100%;
    min-height: 320px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Stats Styling */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    background: hsla(224, 25%, 15%, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
  }

  .stat-card.full-width {
    grid-column: span 2;
  }

  @media (max-width: 480px) {
    .stat-card.full-width {
      grid-column: span 1;
    }
  }

  .stat-icon-wrapper {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Diverse colors for icons */
  .sentences { background: rgba(139, 92, 246, 0.15); color: hsl(263, 90%, 64%); }
  .words { background: rgba(59, 130, 246, 0.15); color: hsl(217, 91%, 60%); }
  .characters { background: rgba(16, 185, 129, 0.15); color: hsl(142, 70%, 45%); }
  .characters-no-space { background: rgba(245, 158, 11, 0.15); color: hsl(38, 92%, 50%); }
  .paragraphs { background: rgba(236, 72, 153, 0.15); color: hsl(330, 81%, 60%); }
  .avg-length { background: rgba(99, 102, 241, 0.15); color: hsl(239, 84%, 67%); }
  .reading-time { background: rgba(20, 184, 166, 0.15); color: hsl(171, 66%, 44%); }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-val {
    font-size: 1.35rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-val .unit {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }
</style>

<script>
  import { calculateTextStats } from './logic';

  class SentenceCounterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private sentencesEl!: HTMLSpanElement;
    private wordsEl!: HTMLSpanElement;
    private charsAllEl!: HTMLSpanElement;
    private charsNoSpaceEl!: HTMLSpanElement;
    private paragraphsEl!: HTMLSpanElement;
    private avgLengthEl!: HTMLSpanElement;
    private readingTimeEl!: HTMLSpanElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#sentence-counter-input') as HTMLTextAreaElement;
      this.sentencesEl = this.querySelector('#stat-sentences') as HTMLSpanElement;
      this.wordsEl = this.querySelector('#stat-words') as HTMLSpanElement;
      this.charsAllEl = this.querySelector('#stat-chars-all') as HTMLSpanElement;
      this.charsNoSpaceEl = this.querySelector('#stat-chars-no-space') as HTMLSpanElement;
      this.paragraphsEl = this.querySelector('#stat-paragraphs') as HTMLSpanElement;
      this.avgLengthEl = this.querySelector('#stat-avg-length') as HTMLSpanElement;
      this.readingTimeEl = this.querySelector('#stat-reading-time') as HTMLSpanElement;

      // Listen for text input
      this.inputEl.addEventListener('input', () => this.updateStats());

      // Listen for action clicks
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (action === 'copy-report') this.handleCopyReport();
      });
    }

    private updateStats() {
      const text = this.inputEl.value;
      const stats = calculateTextStats(text);

      this.sentencesEl.textContent = stats.sentences.toLocaleString();
      this.wordsEl.textContent = stats.words.toLocaleString();
      this.charsAllEl.textContent = stats.characters.toLocaleString();
      this.charsNoSpaceEl.textContent = stats.charactersNoSpaces.toLocaleString();
      this.paragraphsEl.textContent = stats.paragraphs.toLocaleString();
      this.avgLengthEl.innerHTML = `${stats.averageSentenceLength.toFixed(1)}<span class="unit"> words/sent</span>`;
      this.readingTimeEl.innerHTML = `${stats.readingTimeMin.toFixed(2)}<span class="unit"> min</span>`;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.updateStats();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "Hey there! Welcome to the Sentence Counter. This is a very cool tool designed by LowKeyDevs. Feel free to replace this text with your own! " +
        "How fast can you read this paragraph? An average reader takes about 5 seconds. Let us know if you find it helpful!\n\nHere is a second paragraph just to test the paragraph counter. It works perfectly.";
      this.updateStats();
    }

    private async handleCopyReport() {
      const text = this.inputEl.value;
      const stats = calculateTextStats(text);
      
      const report = `LowKeyDevs Text Report:
-------------------------
Sentences: ${stats.sentences}
Words: ${stats.words}
Characters (All): ${stats.characters}
Characters (No spaces): ${stats.charactersNoSpaces}
Paragraphs: ${stats.paragraphs}
Avg Sentence Length: ${stats.averageSentenceLength} words/sentence
Estimated Reading Time: ${stats.readingTimeMin} minutes
-------------------------`;

      try {
        await navigator.clipboard.writeText(report);
        const copyBtn = this.querySelector('button[data-action="copy-report"]') as HTMLButtonElement;
        const originalHtml = copyBtn.innerHTML;

        copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="success-color"><path d="M20 6 9 17l-5-5"/></svg> Copied!`;
        
        setTimeout(() => {
          copyBtn.innerHTML = originalHtml;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy report', err);
      }
    }
  }

  if (!customElements.get('sentence-counter-tool')) {
    customElements.define('sentence-counter-tool', SentenceCounterTool);
  }
</script>
