---
import Icon from '../../../components/base/Icon.astro';
---

<hash-generator-tool class="tool-workspace">
  <div class="hash-layout">
    <!-- Input Panel -->
    <div class="input-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Plain Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea
        id="hash-input"
        placeholder="Type or paste text to generate cryptographic hashes in real-time..."
        aria-label="Input plain text for hashing"
      ></textarea>
      
      <div class="action-row">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          Clear
        </button>
      </div>
    </div>

    <!-- Outputs List Panel -->
    <div class="outputs-pane glass-panel">
      <h3 class="pane-title border-bottom pb-2">Cryptographic Digests</h3>
      
      <div class="hash-fields-list mt-4">
        <!-- MD5 Field -->
        <div class="hash-field-group">
          <div class="hash-header">
            <span class="hash-name">MD5</span>
            <button data-copy-id="hash-md5" class="btn btn-secondary btn-sm btn-copy-hash" aria-label="Copy MD5 hash">
              <Icon name="Clipboard" size={12} class="copy-icon" />
              <Icon name="Check" size={12} class="check-icon" />
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <div class="hash-value-container">
            <input type="text" id="hash-md5" class="input hash-input-val" readonly value="d41d8cd98f00b204e9800998ecf8427e" />
          </div>
        </div>

        <!-- SHA-1 Field -->
        <div class="hash-field-group">
          <div class="hash-header">
            <span class="hash-name">SHA-1</span>
            <button data-copy-id="hash-sha1" class="btn btn-secondary btn-sm btn-copy-hash" aria-label="Copy SHA-1 hash">
              <Icon name="Clipboard" size={12} class="copy-icon" />
              <Icon name="Check" size={12} class="check-icon" />
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <div class="hash-value-container">
            <input type="text" id="hash-sha1" class="input hash-input-val" readonly value="da39a3ee5e6b4b0d3255bfef95601890afd80709" />
          </div>
        </div>

        <!-- SHA-256 Field -->
        <div class="hash-field-group">
          <div class="hash-header">
            <span class="hash-name">SHA-256</span>
            <button data-copy-id="hash-sha256" class="btn btn-secondary btn-sm btn-copy-hash" aria-label="Copy SHA-256 hash">
              <Icon name="Clipboard" size={12} class="copy-icon" />
              <Icon name="Check" size={12} class="check-icon" />
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <div class="hash-value-container">
            <input type="text" id="hash-sha256" class="input hash-input-val" readonly value="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" />
          </div>
        </div>

        <!-- SHA-512 Field -->
        <div class="hash-field-group">
          <div class="hash-header">
            <span class="hash-name">SHA-512</span>
            <button data-copy-id="hash-sha512" class="btn btn-secondary btn-sm btn-copy-hash" aria-label="Copy SHA-512 hash">
              <Icon name="Clipboard" size={12} class="copy-icon" />
              <Icon name="Check" size={12} class="check-icon" />
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <div class="hash-value-container">
            <textarea id="hash-sha512" class="textarea hash-input-val textarea-compact" readonly>cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e</textarea>
          </div>
        </div>
      </div>
    </div>
  </div>
</hash-generator-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .hash-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 800px) {
    .hash-layout {
      grid-template-columns: 1fr;
    }
  }

  .input-pane, .outputs-pane {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .input-pane {
    min-height: 380px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .pb-2 { padding-bottom: 0.5rem; }
  .border-bottom { border-bottom: 1px solid var(--border-color); }

  #hash-input {
    flex: 1;
    width: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    resize: none;
    outline: none;
  }

  .action-row {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .mt-4 { margin-top: 1rem; }

  /* Output items list */
  .hash-fields-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hash-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hash-name {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hash-input-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.75rem;
    color: var(--text-secondary);
    user-select: all;
  }

  .textarea-compact {
    min-height: 60px;
    resize: none;
    outline: none;
    width: 100%;
    border-radius: var(--radius-md);
  }

  /* Copy Buttons styling inside list */
  .btn-copy-hash {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    gap: 0.25rem;
  }

  .btn-copy-hash .copy-icon, .btn-copy-hash .check-icon {
    width: 12px;
    height: 12px;
  }

  .btn-copy-hash .check-icon {
    display: none;
  }

  .btn-copy-hash.copied .copy-icon {
    display: none;
  }

  .btn-copy-hash.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  .btn-copy-hash.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { generateMd5, generateSha } from './logic';

  class HashGeneratorTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private md5El!: HTMLInputElement;
    private sha1El!: HTMLInputElement;
    private sha256El!: HTMLInputElement;
    private sha512El!: HTMLTextAreaElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#hash-input') as HTMLTextAreaElement;
      this.md5El = this.querySelector('#hash-md5') as HTMLInputElement;
      this.sha1El = this.querySelector('#hash-sha1') as HTMLInputElement;
      this.sha256El = this.querySelector('#hash-sha256') as HTMLInputElement;
      this.sha512El = this.querySelector('#hash-sha512') as HTMLTextAreaElement;

      // Realtime input listener
      this.inputEl.addEventListener('input', () => this.handleHashCalculation());

      // Actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        const copyId = button.getAttribute('data-copy-id');

        if (action === 'clear') {
          this.handleClear();
        } else if (action === 'load-sample') {
          this.handleLoadSample();
        } else if (copyId) {
          const valEl = this.querySelector(`#${copyId}`) as (HTMLInputElement | HTMLTextAreaElement);
          if (valEl) this.handleCopy(button, valEl.value);
        }
      });

      // Default values
      this.handleHashCalculation();
    }

    private async handleHashCalculation() {
      const val = this.inputEl.value;

      // MD5
      const md5Result = generateMd5(val);
      this.md5El.value = md5Result;

      // SHA-1, SHA-256, SHA-512
      try {
        if (!val) {
          // If empty, set the standard hashes for empty string
          this.sha1El.value = 'da39a3ee5e6b4b0d3255bfef95601890afd80709';
          this.sha256El.value = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855';
          this.sha512El.value = 'cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e';
          return;
        }

        const sha1Result = await generateSha(val, 'SHA-1');
        this.sha1El.value = sha1Result;

        const sha256Result = await generateSha(val, 'SHA-256');
        this.sha256El.value = sha256Result;

        const sha512Result = await generateSha(val, 'SHA-512');
        this.sha512El.value = sha512Result;
      } catch (err) {
        console.error('Failed calculating SHA digests', err);
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleHashCalculation();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "The quick brown fox jumps over the lazy dog";
      this.handleHashCalculation();
    }

    private async handleCopy(btn: HTMLButtonElement, text: string) {
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = btn.querySelector('.copy-text') as HTMLSpanElement;

        btn.classList.add('copied');
        if (copyText) copyText.textContent = 'Copied!';

        setTimeout(() => {
          btn.classList.remove('copied');
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy hash value', err);
      }
    }
  }

  if (!customElements.get('hash-generator-tool')) {
    customElements.define('hash-generator-tool', HashGeneratorTool);
  }
</script>
