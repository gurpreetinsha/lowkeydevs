---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<double-struck-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="ds-input" 
        placeholder="Type here to convert to hollow double-struck letters..." 
        aria-label="Double Struck Text Input"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          {t('common.Clear')}
        </button>
      </div>
    </div>

    <!-- Big Preview Pane -->
    <div class="editor-pane glass-panel preview-pane">
      <div class="pane-header">
        <span class="pane-title">Primary Double-Struck Output</span>
        <button id="ds-main-copy" class="btn btn-primary btn-sm">
          <Icon name="Copy" size={14} />
          Copy Main Output
        </button>
      </div>
      <div class="ds-big-display" id="ds-primary-display">
        𝕕𝕠𝕦𝕓𝕝𝕖-𝕤𝕥𝕣𝕦𝕔𝕜
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="results-section glass-panel">
    <h3 class="section-title">Double-Struck Variations</h3>
    
    <div class="results-list" id="ds-results">
      <div class="empty-state">
        Type some text above to see double-struck variations...
      </div>
    </div>
  </div>
</double-struck-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 250px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #ds-input {
    flex: 1;
    width: 100%;
    min-height: 150px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Big Display Preview */
  .preview-pane {
    background: var(--card-bg);
  }

  .ds-big-display {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    font-weight: bold;
    text-align: center;
    color: var(--primary-accent);
    word-break: break-all;
    padding: 1.5rem;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
  }

  /* Results List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: var(--primary-accent);
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.2rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: var(--success-color) !important;
    color: var(--success-color) !important;
  }
</style>

<script>
  import { generateDoubleStruck } from './logic';

  class DoubleStruckTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private primaryDisplayEl!: HTMLDivElement;
    private resultsEl!: HTMLDivElement;
    private copyMainBtn!: HTMLButtonElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#ds-input') as HTMLTextAreaElement;
      this.primaryDisplayEl = this.querySelector('#ds-primary-display') as HTMLDivElement;
      this.resultsEl = this.querySelector('#ds-results') as HTMLDivElement;
      this.copyMainBtn = this.querySelector('#ds-main-copy') as HTMLButtonElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());

      this.copyMainBtn.addEventListener('click', () => {
        const text = this.primaryDisplayEl.textContent || '';
        this.copyToClipboard(this.copyMainBtn, text);
      });

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private handleUpdate() {
      const text = this.inputEl.value;

      if (!text) {
        this.primaryDisplayEl.textContent = '𝕕𝕠𝕦𝕓𝕝𝕖-𝕤𝕥𝕣𝕦𝕔𝕜';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see double-struck variations...
          </div>
        `;
        return;
      }

      const fonts = generateDoubleStruck(text);
      
      if (fonts.length > 0) {
        this.primaryDisplayEl.textContent = fonts[0].text;
      }

      this.resultsEl.innerHTML = fonts.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="ds-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = 'Blackboard';
      this.handleUpdate();
    }

    private async copyToClipboard(btn: HTMLButtonElement, text: string) {
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const originalText = btn.innerHTML;
        btn.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');
        btn.classList.add('copied-btn');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Copy failed', err);
      }
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#ds-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      this.copyToClipboard(button, text);
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('double-struck-tool')) {
    customElements.define('double-struck-tool', DoubleStruckTool);
  }
</script>
