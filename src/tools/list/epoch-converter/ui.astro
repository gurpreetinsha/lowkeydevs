---
import Icon from '../../../components/base/Icon.astro';
---

<epoch-converter-tool class="tool-workspace">
  <!-- Live Clock Banner -->
  <div class="live-clock-banner glass-panel">
    <div class="clock-label">
      <span class="live-indicator"></span>
      Unix Epoch Time:
    </div>
    <div class="clock-timestamp" id="live-timestamp-seconds">0000000000</div>
    <div class="clock-actions">
      <button data-action="toggle-clock" class="btn btn-secondary btn-sm" id="btn-toggle-clock" aria-label="Pause real-time clock">
        <span class="btn-clock-text">Pause</span>
      </button>
      <button data-action="copy-clock" class="btn btn-secondary btn-sm" id="btn-copy-clock" aria-label="Copy live timestamp">
        <Icon name="Clipboard" size={14} class="copy-icon" />
        <Icon name="Check" size={14} class="check-icon" />
        <span class="copy-text">Copy</span>
      </button>
    </div>
  </div>

  <div class="converter-grid">
    <!-- Unix Timestamp to Date Panel -->
    <div class="converter-panel glass-panel">
      <h3 class="panel-title">Convert Unix Timestamp to Date</h3>
      
      <div class="form-group mt-4">
        <label for="input-timestamp" class="label">Unix Timestamp</label>
        <div class="input-with-action">
          <input
            type="text"
            id="input-timestamp"
            class="input"
            placeholder="e.g. 1719878400 or 1719878400000"
            aria-label="Input unix timestamp"
          />
          <button data-action="load-current" class="btn btn-secondary btn-sm">Use Current</button>
        </div>
      </div>

      <div class="results-display mt-4">
        <div class="result-row">
          <span class="result-label">Detected Unit:</span>
          <strong id="ts-detected-unit" class="result-val text-accent">Seconds</strong>
        </div>
        <div class="result-row">
          <span class="result-label">GMT (UTC):</span>
          <div class="result-copy-container">
            <span id="ts-result-gmt" class="result-val text-mono">Enter a timestamp</span>
            <button data-copy-id="ts-result-gmt" class="btn-icon-copy" aria-label="Copy UTC date">
              <Icon name="Clipboard" size={14} />
            </button>
          </div>
        </div>
        <div class="result-row">
          <span class="result-label">Local Time:</span>
          <div class="result-copy-container">
            <span id="ts-result-local" class="result-val text-mono">Enter a timestamp</span>
            <button data-copy-id="ts-result-local" class="btn-icon-copy" aria-label="Copy Local date">
              <Icon name="Clipboard" size={14} />
            </button>
          </div>
        </div>
      </div>
      
      <div id="ts-error-banner" class="error-banner mt-4" hidden>
        <Icon name="Info" size={16} />
        <span id="ts-error-message"></span>
      </div>
    </div>

    <!-- Human Date to Unix Timestamp Panel -->
    <div class="converter-panel glass-panel">
      <h3 class="panel-title">Convert Date to Unix Timestamp</h3>
      
      <div class="date-fields-grid mt-4">
        <div class="form-group">
          <label for="date-year" class="label">Year</label>
          <input type="number" id="date-year" class="input input-compact" value="2026" />
        </div>
        <div class="form-group">
          <label for="date-month" class="label">Month</label>
          <input type="number" id="date-month" class="input input-compact" min="1" max="12" value="7" />
        </div>
        <div class="form-group">
          <label for="date-day" class="label">Day</label>
          <input type="number" id="date-day" class="input input-compact" min="1" max="31" value="4" />
        </div>
        <div class="form-group">
          <label for="date-hour" class="label">Hr (24h)</label>
          <input type="number" id="date-hour" class="input input-compact" min="0" max="23" value="12" />
        </div>
        <div class="form-group">
          <label for="date-minute" class="label">Min</label>
          <input type="number" id="date-minute" class="input input-compact" min="0" max="59" value="0" />
        </div>
        <div class="form-group">
          <label for="date-second" class="label">Sec</label>
          <input type="number" id="date-second" class="input input-compact" min="0" max="59" value="0" />
        </div>
      </div>

      <div class="form-group mt-4">
        <label class="label">Timezone Choice</label>
        <div class="timezone-selector">
          <label class="radio-label">
            <input type="radio" name="date-tz" value="utc" checked />
            <span class="radio-circle"></span>
            UTC (GMT)
          </label>
          <label class="radio-label">
            <input type="radio" name="date-tz" value="local" />
            <span class="radio-circle"></span>
            Local Time
          </label>
        </div>
      </div>

      <div class="results-display mt-4">
        <div class="result-row">
          <span class="result-label">Epoch Seconds:</span>
          <div class="result-copy-container">
            <strong id="date-result-sec" class="result-val text-accent text-mono">0000000000</strong>
            <button data-copy-id="date-result-sec" class="btn-icon-copy" aria-label="Copy epoch seconds">
              <Icon name="Clipboard" size={14} />
            </button>
          </div>
        </div>
        <div class="result-row">
          <span class="result-label">Epoch Milliseconds:</span>
          <div class="result-copy-container">
            <strong id="date-result-ms" class="result-val text-secondary-accent text-mono">0000000000000</strong>
            <button data-copy-id="date-result-ms" class="btn-icon-copy" aria-label="Copy epoch milliseconds">
              <Icon name="Clipboard" size={14} />
            </button>
          </div>
        </div>
      </div>

      <div id="date-error-banner" class="error-banner mt-4" hidden>
        <Icon name="Info" size={16} />
        <span id="date-error-message"></span>
      </div>
    </div>
  </div>
</epoch-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .live-clock-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    background: linear-gradient(135deg, #FFFFFF 0%, var(--secondary-bg) 100%);
    border: 1px solid var(--border-color);
  }

  .clock-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .live-indicator {
    width: 8px;
    height: 8px;
    background-color: var(--success-color);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px var(--success-color);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }

  .clock-timestamp {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }

  .clock-actions {
    display: flex;
    gap: 0.5rem;
  }

  .converter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 850px) {
    .converter-grid {
      grid-template-columns: 1fr;
    }
    .live-clock-banner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  .converter-panel {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .mt-4 { margin-top: 1rem; }

  .input-with-action {
    display: flex;
    gap: 0.5rem;
  }

  .input-with-action .input {
    flex: 1;
  }

  /* Date inputs grid */
  .date-fields-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .input-compact {
    padding: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }

  .timezone-selector {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.25rem;
  }

  /* Custom radio styles (consistent with url encoder) */
  .radio-label {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 1.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .radio-label input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .radio-circle {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 16px;
    width: 16px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .radio-label:hover input ~ .radio-circle {
    border-color: var(--primary-accent);
  }

  .radio-label input:checked ~ .radio-circle {
    border-color: var(--primary-accent);
    background-color: var(--primary-accent);
  }

  .radio-circle:after {
    content: "";
    position: absolute;
    display: none;
  }

  .radio-label input:checked ~ .radio-circle:after {
    display: block;
  }

  .radio-label .radio-circle:after {
    top: 4px;
    left: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
  }

  /* Result displays */
  .results-display {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 0.5rem;
  }

  .result-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .result-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .result-copy-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 70%;
  }

  .result-val {
    font-size: 0.9rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .text-accent {
    color: var(--primary-accent);
  }

  .text-secondary-accent {
    color: var(--secondary-accent);
  }

  .text-mono {
    font-family: var(--font-mono);
  }

  .btn-icon-copy {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .btn-icon-copy:hover {
    color: var(--primary-accent);
  }

  /* Error banner */
  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Copy Button Live Clock states */
  #btn-copy-clock .check-icon {
    display: none;
  }

  #btn-copy-clock.copied .copy-icon {
    display: none;
  }

  #btn-copy-clock.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy-clock.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { isMilliseconds, epochToUtc, epochToLocal, humanDateToEpoch } from './logic';

  class EpochConverterTool extends HTMLElement {
    private liveValEl!: HTMLDivElement;
    private btnToggleClock!: HTMLButtonElement;
    private btnCopyClock!: HTMLButtonElement;
    
    // TS-to-Date fields
    private inputTsEl!: HTMLInputElement;
    private tsUnitEl!: HTMLParagraphElement;
    private tsGmtEl!: HTMLSpanElement;
    private tsLocalEl!: HTMLSpanElement;
    private tsErrorBanner!: HTMLDivElement;
    private tsErrorMessage!: HTMLSpanElement;

    // Date-to-TS fields
    private inputYear!: HTMLInputElement;
    private inputMonth!: HTMLInputElement;
    private inputDay!: HTMLInputElement;
    private inputHour!: HTMLInputElement;
    private inputMinute!: HTMLInputElement;
    private inputSecond!: HTMLInputElement;
    private dateResultSec!: HTMLStrongElement;
    private dateResultMs!: HTMLStrongElement;
    private dateErrorBanner!: HTMLDivElement;
    private dateErrorMessage!: HTMLSpanElement;

    // State
    private isClockPaused = false;
    private clockTimerId: any = null;

    connectedCallback() {
      // Clock
      this.liveValEl = this.querySelector('#live-timestamp-seconds') as HTMLDivElement;
      this.btnToggleClock = this.querySelector('#btn-toggle-clock') as HTMLButtonElement;
      this.btnCopyClock = this.querySelector('#btn-copy-clock') as HTMLButtonElement;

      // Ts-to-Date
      this.inputTsEl = this.querySelector('#input-timestamp') as HTMLInputElement;
      this.tsUnitEl = this.querySelector('#ts-detected-unit') as HTMLParagraphElement;
      this.tsGmtEl = this.querySelector('#ts-result-gmt') as HTMLSpanElement;
      this.tsLocalEl = this.querySelector('#ts-result-local') as HTMLSpanElement;
      this.tsErrorBanner = this.querySelector('#ts-error-banner') as HTMLDivElement;
      this.tsErrorMessage = this.querySelector('#ts-error-message') as HTMLSpanElement;

      // Date-to-Ts
      this.inputYear = this.querySelector('#date-year') as HTMLInputElement;
      this.inputMonth = this.querySelector('#date-month') as HTMLInputElement;
      this.inputDay = this.querySelector('#date-day') as HTMLInputElement;
      this.inputHour = this.querySelector('#date-hour') as HTMLInputElement;
      this.inputMinute = this.querySelector('#date-minute') as HTMLInputElement;
      this.inputSecond = this.querySelector('#date-second') as HTMLInputElement;
      this.dateResultSec = this.querySelector('#date-result-sec') as HTMLStrongElement;
      this.dateResultMs = this.querySelector('#date-result-ms') as HTMLStrongElement;
      this.dateErrorBanner = this.querySelector('#date-error-banner') as HTMLDivElement;
      this.dateErrorMessage = this.querySelector('#date-error-message') as HTMLSpanElement;

      // Initialize date inputs to current date
      this.initializeDateFields();

      // Start live clock
      this.startClock();

      // Listeners
      this.btnToggleClock.addEventListener('click', () => this.toggleClock());
      this.btnCopyClock.addEventListener('click', () => this.handleCopyClock());

      this.inputTsEl.addEventListener('input', () => this.handleConvertTs());

      // Trigger convert for human dates on input change
      const dateInputs = [
        this.inputYear, this.inputMonth, this.inputDay,
        this.inputHour, this.inputMinute, this.inputSecond
      ];
      dateInputs.forEach(input => {
        input.addEventListener('input', () => this.handleConvertHumanDate());
      });

      this.querySelectorAll('input[name="date-tz"]').forEach(radio => {
        radio.addEventListener('change', () => this.handleConvertHumanDate());
      });

      // Buttons
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        
        // Copy buttons
        const copyBtn = target.closest('[data-copy-id]');
        if (copyBtn) {
          const id = copyBtn.getAttribute('data-copy-id');
          if (id) {
            const el = this.querySelector(`#${id}`) as HTMLElement;
            if (el) this.copyText(el.textContent || '');
          }
          return;
        }

        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'load-current') {
          this.inputTsEl.value = Math.floor(Date.now() / 1000).toString();
          this.handleConvertTs();
        }
      });

      // Default value
      this.inputTsEl.value = Math.floor(Date.now() / 1000).toString();
      this.handleConvertTs();
      this.handleConvertHumanDate();
    }

    disconnectedCallback() {
      this.stopClock();
    }

    private startClock() {
      this.clockTimerId = setInterval(() => {
        if (!this.isClockPaused) {
          this.liveValEl.textContent = Math.floor(Date.now() / 1000).toString();
        }
      }, 1000);
      this.liveValEl.textContent = Math.floor(Date.now() / 1000).toString();
    }

    private stopClock() {
      if (this.clockTimerId) {
        clearInterval(this.clockTimerId);
        this.clockTimerId = null;
      }
    }

    private toggleClock() {
      this.isClockPaused = !this.isClockPaused;
      const textSpan = this.btnToggleClock.querySelector('.btn-clock-text') as HTMLSpanElement;
      textSpan.textContent = this.isClockPaused ? 'Resume' : 'Pause';
      
      const indicator = this.querySelector('.live-indicator') as HTMLElement;
      if (this.isClockPaused) {
        indicator.style.backgroundColor = 'var(--text-muted)';
        indicator.style.boxShadow = 'none';
      } else {
        indicator.style.backgroundColor = 'var(--success-color)';
        indicator.style.boxShadow = '0 0 8px var(--success-color)';
      }
    }

    private async handleCopyClock() {
      const text = this.liveValEl.textContent;
      if (!text) return;
      await this.copyText(text);

      const copyText = this.btnCopyClock.querySelector('.copy-text') as HTMLSpanElement;
      this.btnCopyClock.classList.add('copied');
      copyText.textContent = 'Copied!';

      setTimeout(() => {
        this.btnCopyClock.classList.remove('copied');
        copyText.textContent = 'Copy';
      }, 2000);
    }

    private initializeDateFields() {
      const d = new Date();
      this.inputYear.value = d.getUTCFullYear().toString();
      this.inputMonth.value = (d.getUTCMonth() + 1).toString();
      this.inputDay.value = d.getUTCDate().toString();
      this.inputHour.value = d.getUTCHours().toString();
      this.inputMinute.value = d.getUTCMinutes().toString();
      this.inputSecond.value = d.getUTCSeconds().toString();
    }

    private handleConvertTs() {
      const valStr = this.inputTsEl.value.trim();
      if (!valStr) {
        this.tsGmtEl.textContent = 'Enter a timestamp';
        this.tsLocalEl.textContent = 'Enter a timestamp';
        this.tsUnitEl.textContent = '—';
        this.hideTsError();
        return;
      }

      const epoch = Number(valStr);
      if (isNaN(epoch)) {
        this.showTsError('Please enter a valid numeric Unix timestamp.');
        return;
      }

      try {
        const detect = isMilliseconds(epoch);
        this.tsUnitEl.textContent = detect ? 'Milliseconds (13 digits)' : 'Seconds (10 digits)';
        
        this.tsGmtEl.textContent = epochToUtc(epoch, detect);
        this.tsLocalEl.textContent = epochToLocal(epoch, detect);
        this.hideTsError();
      } catch (err: any) {
        this.showTsError(err.message);
      }
    }

    private handleConvertHumanDate() {
      const year = parseInt(this.inputYear.value, 10);
      const month = parseInt(this.inputMonth.value, 10);
      const day = parseInt(this.inputDay.value, 10);
      const hour = parseInt(this.inputHour.value, 10);
      const minute = parseInt(this.inputMinute.value, 10);
      const second = parseInt(this.inputSecond.value, 10);

      const checkedRadio = this.querySelector('input[name="date-tz"]:checked') as HTMLInputElement;
      const isUtc = checkedRadio?.value === 'utc';

      if (isNaN(year) || isNaN(month) || isNaN(day) || isNaN(hour) || isNaN(minute) || isNaN(second)) {
        this.showDateError('All date fields must be valid numbers.');
        return;
      }

      try {
        const result = humanDateToEpoch(year, month, day, hour, minute, second, 0, isUtc);
        this.dateResultSec.textContent = result.seconds.toString();
        this.dateResultMs.textContent = result.milliseconds.toString();
        this.hideDateError();
      } catch (err: any) {
        this.showDateError(err.message);
      }
    }

    private async copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    }

    private showTsError(msg: string) {
      this.tsErrorMessage.textContent = msg;
      this.tsErrorBanner.removeAttribute('hidden');
      this.tsGmtEl.textContent = '—';
      this.tsLocalEl.textContent = '—';
    }

    private hideTsError() {
      this.tsErrorBanner.setAttribute('hidden', 'true');
    }

    private showDateError(msg: string) {
      this.dateErrorMessage.textContent = msg;
      this.dateErrorBanner.removeAttribute('hidden');
      this.dateResultSec.textContent = '—';
      this.dateResultMs.textContent = '—';
    }

    private hideDateError() {
      this.dateErrorBanner.setAttribute('hidden', 'true');
    }
  }

  if (!customElements.get('epoch-converter-tool')) {
    customElements.define('epoch-converter-tool', EpochConverterTool);
  }
</script>
