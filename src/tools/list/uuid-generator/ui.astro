---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<uuid-generator-tool class="tool-workspace">
  <div class="generator-card glass-panel">
    <!-- Output Panel -->
    <div class="editor-pane">
      <div class="pane-header">
        <span class="pane-title">Generated UUIDs</span>
        <div class="header-actions">
          <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy" aria-label="Copy all UUIDs">
            <Icon name="Clipboard" size={14} class="copy-icon" />
            <Icon name="Check" size={14} class="check-icon" />
            <span class="copy-text">{t('common.Copy All')}</span>
          </button>
        </div>
      </div>
      <textarea
        id="uuid-output"
        class="textarea output-textarea"
        readonly
        placeholder="Generated UUIDs will appear here..."
        aria-label="Generated UUIDs output"
      ></textarea>
    </div>

    <!-- Controls Form -->
    <div class="generator-controls">
      <!-- Quantity Slider -->
      <div class="control-row">
        <div class="control-header">
          <label for="uuid-quantity" class="label">{t('common.Quantity')}</label>
          <span id="qty-val" class="qty-display">5</span>
        </div>
        <input
          type="range"
          id="uuid-quantity"
          min="1"
          max="50"
          value="5"
          class="slider"
          aria-label="UUID quantity slider"
        />
      </div>

      <!-- Checklist Toggles -->
      <div class="options-grid">
        <label class="checkbox-container">
          <input type="checkbox" id="opt-hyphens" checked />
          <span class="checkmark"></span>
          Include Hyphens
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-uppercase" />
          <span class="checkmark"></span>
          Uppercase (HEX)
        </label>
        <label class="checkbox-container">
          <input type="checkbox" id="opt-braces" />
          <span class="checkmark"></span>
          Wrap in Braces {}
        </label>
      </div>

      <div class="action-row">
        <button data-action="generate" class="btn btn-primary btn-generate" id="btn-generate">
          <Icon name="Shuffle" size={18} />
          Generate UUIDs
        </button>
      </div>
    </div>
  </div>
</uuid-generator-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .output-textarea {
    min-height: 180px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.6;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    resize: vertical;
    width: 100%;
    outline: none;
    user-select: all;
  }

  /* Controls */
  .generator-controls {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-display {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--primary-accent);
  }

  /* Custom Slider Styling */
  .slider {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--border-color);
    outline: none;
    transition: background 0.2s;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary-accent);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.1s ease, background-color 0.2s ease;
  }

  .slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: var(--primary-gradient);
  }

  .slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: none;
    border-radius: 50%;
    background: var(--primary-accent);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.1s ease, background-color 0.2s ease;
  }

  .slider::-moz-range-thumb:hover {
    transform: scale(1.15);
    background: var(--primary-gradient);
  }

  /* Checkbox Grid */
  .options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .options-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Styled Checkbox Label */
  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-secondary);
    user-select: none;
    min-height: 20px;
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 18px;
    width: 18px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--primary-accent);
  }

  .checkbox-container input:checked ~ .checkmark {
    background: var(--primary-gradient);
    border-color: transparent;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkmark:after {
    display: block;
  }

  .checkbox-container .checkmark:after {
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Actions */
  .action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .btn-generate {
    width: 100%;
    padding: 0.75rem 1.5rem;
  }

  /* Copy button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { generateUuids } from './logic';

  class UuidGeneratorTool extends HTMLElement {
    private outputEl!: HTMLTextAreaElement;
    private qtySlider!: HTMLInputElement;
    private qtyVal!: HTMLSpanElement;
    private optHyphens!: HTMLInputElement;
    private optUppercase!: HTMLInputElement;
    private optBraces!: HTMLInputElement;
    private btnGenerate!: HTMLButtonElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.outputEl = this.querySelector('#uuid-output') as HTMLTextAreaElement;
      this.qtySlider = this.querySelector('#uuid-quantity') as HTMLInputElement;
      this.qtyVal = this.querySelector('#qty-val') as HTMLSpanElement;
      this.optHyphens = this.querySelector('#opt-hyphens') as HTMLInputElement;
      this.optUppercase = this.querySelector('#opt-uppercase') as HTMLInputElement;
      this.optBraces = this.querySelector('#opt-braces') as HTMLInputElement;
      this.btnGenerate = this.querySelector('#btn-generate') as HTMLButtonElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Quantity slider update
      this.qtySlider.addEventListener('input', () => {
        this.qtyVal.textContent = this.qtySlider.value;
      });

      // Actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'generate') this.handleGenerate();
        if (action === 'copy') this.handleCopy();
      });

      // Auto-generate on load
      this.handleGenerate();
    }

    private handleGenerate() {
      const quantity = parseInt(this.qtySlider.value, 10);
      const uppercase = this.optUppercase.checked;
      const hyphens = this.optHyphens.checked;
      const braces = this.optBraces.checked;

      const uuids = generateUuids({ quantity, uppercase, hyphens, braces });
      this.outputEl.value = uuids.join('\n');
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy All') || 'Copy All');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy UUIDs', err);
      }
    }
  }

  if (!customElements.get('uuid-generator-tool')) {
    customElements.define('uuid-generator-tool', UuidGeneratorTool);
  }
</script>
