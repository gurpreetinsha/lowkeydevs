---
import Icon from '../../../components/base/Icon.astro';
---

<base64-converter-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <!-- Mode Select (Encode vs Decode Toggle) -->
    <div class="toggle-group" role="radiogroup" aria-label="Base64 Conversion Mode">
      <button data-mode="encode" class="toggle-btn active" role="radio" aria-checked="true">
        Encode Text
      </button>
      <button data-mode="decode" class="toggle-btn" role="radio" aria-checked="false">
        Decode Base64
      </button>
    </div>
    
    <div class="control-actions">
      <button data-action="clear" class="btn btn-danger btn-compact-sm">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="input-pane-title">Plain Text Input</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="converter-input" 
        placeholder="Type or paste content here..." 
        aria-label="Input content"
      ></textarea>
    </div>

    <!-- Output Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title" id="output-pane-title">Base64 Output</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      
      <div class="output-container">
        <div id="converter-error-banner" class="error-banner" hidden>
          <Icon name="Info" size={16} />
          <span id="error-message"></span>
        </div>
        <textarea 
          id="converter-output" 
          placeholder="Output will appear here..." 
          readonly 
          aria-label="Output content"
        ></textarea>
      </div>
    </div>
  </div>
</base64-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    gap: 1rem;
  }

  /* Toggle Button Styles */
  .toggle-group {
    display: flex;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    padding: 0.25rem;
    border-radius: var(--radius-md);
  }

  .toggle-btn {
    border: none;
    background: none;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
  }

  .toggle-btn.active {
    background-color: var(--surface-color);
    color: var(--primary-accent);
    box-shadow: var(--shadow-sm);
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-compact-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* Grid Panes */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #converter-input,
  #converter-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #converter-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { encodeBase64, decodeBase64 } from './logic';

  class Base64ConverterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private inputPaneTitle!: HTMLElement;
    private outputPaneTitle!: HTMLElement;
    private errorBannerEl!: HTMLDivElement;
    private errorMessageEl!: HTMLSpanElement;
    private mode: 'encode' | 'decode' = 'encode';

    connectedCallback() {
      this.inputEl = this.querySelector('#converter-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#converter-output') as HTMLTextAreaElement;
      this.inputPaneTitle = this.querySelector('#input-pane-title') as HTMLElement;
      this.outputPaneTitle = this.querySelector('#output-pane-title') as HTMLElement;
      this.errorBannerEl = this.querySelector('#converter-error-banner') as HTMLDivElement;
      this.errorMessageEl = this.querySelector('#error-message') as HTMLSpanElement;

      // Event listener delegation for actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();

        const dataMode = button.getAttribute('data-mode') as 'encode' | 'decode' | null;
        if (dataMode) {
          this.setMode(dataMode);
        }
      });

      // Live processing as user types
      this.inputEl.addEventListener('input', () => this.processConversion());
    }

    private setMode(mode: 'encode' | 'decode') {
      if (this.mode === mode) return;
      this.mode = mode;

      // Update active state in toggle buttons
      const toggleButtons = this.querySelectorAll('.toggle-btn');
      toggleButtons.forEach(btn => {
        const m = btn.getAttribute('data-mode');
        if (m === mode) {
          btn.classList.add('active');
          btn.setAttribute('aria-checked', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-checked', 'false');
        }
      });

      // Update pane headers
      if (mode === 'encode') {
        this.inputPaneTitle.textContent = 'Plain Text Input';
        this.outputPaneTitle.textContent = 'Base64 Output';
        this.inputEl.placeholder = 'Type or paste content here...';
        this.outputEl.placeholder = 'Base64 output will appear here...';
      } else {
        this.inputPaneTitle.textContent = 'Base64 Input';
        this.outputPaneTitle.textContent = 'Plain Text Output';
        this.inputEl.placeholder = 'Paste Base64 string here...';
        this.outputEl.placeholder = 'Plain text output will appear here...';
      }

      // Swap the input and output values to allow chain conversions!
      const currentInput = this.inputEl.value;
      const currentOutput = this.outputEl.value;
      
      this.inputEl.value = currentOutput;
      this.outputEl.value = currentInput;

      this.processConversion();
    }

    private processConversion() {
      const val = this.inputEl.value;
      if (!val) {
        this.clearOutput();
        return;
      }

      try {
        if (this.mode === 'encode') {
          const encoded = encodeBase64(val);
          this.outputEl.value = encoded;
        } else {
          const decoded = decodeBase64(val);
          this.outputEl.value = decoded;
        }
        this.hideError();
      } catch (err: any) {
        this.showError(err.message || 'Error occurred during processing.');
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.clearOutput();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      if (this.mode === 'encode') {
        this.inputEl.value = "LowKeyDevs is the fastest, cleanest tools site on the internet! 🚀 Check out our tools: formatters, converters, and security generators. Fully private and offline-first.";
      } else {
        // Base64 for "LowKeyDevs is the fastest..."
        this.inputEl.value = "TG93S2V5RGV2cyBpcyB0aGUgZmFzdGVzdCwgY2xlYW5lc3QgdG9vbHMgc2l0ZSBvbiB0aGUgaW50ZXJuZXQhIO🚀IENoZWNrIG91dCBvdXIgdG9vbHM6IGZvcm1hdHRlcnMsIGNvbnZlcnRlcnMsIGFuZCBzZWN1cml0eSBnZW5lcmF0b3JzLiBGdWxseSBwcml2YXRlIGFuZCBvZmZsaW5lLWZpcnN0Lg==";
        // Fix emoji base64 sample specifically
        this.inputEl.value = "TG93S2V5RGV2cyBpcyB0aGUgZmFzdGVzdCwgY2xlYW5lc3QgdG9vbHMgc2l0ZSBvbiB0aGUgaW50ZXJuZXQhIPCfm4EgQ2hlY2sgb3V0IG91ciB0b29sczogZm9ybWF0dGVycywgY29udmVydGVycywgYW5kIHNlY3VyaXR5IGdlbmVyYXRvcnMuIEZ1bGx5IHByaXZhdGUgYW5kIG9mZmxpbmUtZmlyc3Qu";
      }
      this.processConversion();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }

    private clearOutput() {
      this.outputEl.value = '';
      this.hideError();
    }

    private showError(msg: string) {
      this.errorMessageEl.textContent = msg;
      this.errorBannerEl.removeAttribute('hidden');
      this.outputEl.value = '';
    }

    private hideError() {
      this.errorBannerEl.setAttribute('hidden', 'true');
      this.errorMessageEl.textContent = '';
    }
  }

  if (!customElements.get('base64-converter-tool')) {
    customElements.define('base64-converter-tool', Base64ConverterTool);
  }
</script>
