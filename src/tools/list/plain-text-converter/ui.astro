---
import { useTranslations } from '../../../utils/i18n';
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

import Icon from '../../../components/base/Icon.astro';
---

<plain-text-converter-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-strip-html" checked />
        <span class="checkmark"></span>
        Strip HTML Tags
      </label>
      
      <label class="checkbox-container">
        <input type="checkbox" id="opt-strip-markdown" checked />
        <span class="checkmark"></span>
        Strip Markdown Syntax
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-normalize-unicode" checked />
        <span class="checkmark"></span>
        Normalize Unicode Symbols (𝕿𝖍𝖎𝖘 -> This)
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-trim-lines" checked />
        <span class="checkmark"></span>
        Trim Leading/Trailing Spaces
      </label>

      <label class="checkbox-container">
        <input type="checkbox" id="opt-remove-duplicates" />
        <span class="checkmark"></span>
        Remove Duplicate Lines
      </label>
    </div>

    <div class="control-actions">
      <button data-action="convert" class="btn btn-primary">
        <Icon name="FileText" size={16} />
        Convert to Plain Text
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        {t('common.Clear')}
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="plain-text-input" 
        placeholder="Paste styled or rich text here..." 
        aria-label="Raw styled input text"
      ></textarea>
    </div>

    <!-- Output Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Clean Plain Text</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">{t('common.Copy')}</span>
        </button>
      </div>
      
      <div class="output-container">
        <textarea 
          id="plain-text-output" 
          placeholder="Cleaned plain text will appear here..." 
          readonly 
          aria-label="Plain text output"
        ></textarea>
      </div>
    </div>
  </div>
</plain-text-converter-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #plain-text-input,
  #plain-text-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #plain-text-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { convertToPlainText } from './logic';

  class PlainTextConverterTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private optStripHtmlEl!: HTMLInputElement;
    private optStripMarkdownEl!: HTMLInputElement;
    private optNormalizeUnicodeEl!: HTMLInputElement;
    private optTrimLinesEl!: HTMLInputElement;
    private optRemoveDuplicatesEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#plain-text-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#plain-text-output') as HTMLTextAreaElement;
      this.optStripHtmlEl = this.querySelector('#opt-strip-html') as HTMLInputElement;
      this.optStripMarkdownEl = this.querySelector('#opt-strip-markdown') as HTMLInputElement;
      this.optNormalizeUnicodeEl = this.querySelector('#opt-normalize-unicode') as HTMLInputElement;
      this.optTrimLinesEl = this.querySelector('#opt-trim-lines') as HTMLInputElement;
      this.optRemoveDuplicatesEl = this.querySelector('#opt-remove-duplicates') as HTMLInputElement;

      // Event listener delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'convert') this.handleConvert();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Live processing as user types
      this.inputEl.addEventListener('input', () => this.handleConvert());
      
      const options = [
        this.optStripHtmlEl,
        this.optStripMarkdownEl,
        this.optNormalizeUnicodeEl,
        this.optTrimLinesEl,
        this.optRemoveDuplicatesEl
      ];
      options.forEach(opt => opt.addEventListener('change', () => this.handleConvert()));
    }

    private handleConvert() {
      const val = this.inputEl.value;
      if (!val) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        stripHtml: this.optStripHtmlEl.checked,
        stripMarkdown: this.optStripMarkdownEl.checked,
        normalizeUnicode: this.optNormalizeUnicodeEl.checked,
        trimLines: this.optTrimLinesEl.checked,
        removeDuplicateLines: this.optRemoveDuplicatesEl.checked
      };

      const cleaned = convertToPlainText(val, options);
      this.outputEl.value = cleaned;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.optStripHtmlEl.checked = true;
      this.optStripMarkdownEl.checked = true;
      this.optNormalizeUnicodeEl.checked = true;
      this.optTrimLinesEl.checked = true;
      this.optRemoveDuplicatesEl.checked = false;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = `<h1>𝕿𝖍𝖎𝖘 𝕚𝕤 a Heading</h1>
<p>Here is some <b>HTML text</b> with mathematical 𝓤𝓷𝓲𝓬𝓸𝓭𝓮 symbols.</p>
# Markdown Title
And here is a **bold markdown** list item:
- First item
- First item
- Second item`;
      this.handleConvert();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = (window.__i18n?.t('common.Copied!') || 'Copied!');

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = (window.__i18n?.t('common.Copy') || 'Copy');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy', e);
      }
    }
  }

  if (!customElements.get('plain-text-converter-tool')) {
    customElements.define('plain-text-converter-tool', PlainTextConverterTool);
  }
</script>
