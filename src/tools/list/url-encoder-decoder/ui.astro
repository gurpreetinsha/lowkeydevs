---
import Icon from '../../../components/base/Icon.astro';
---

<url-encoder-decoder-tool class="tool-workspace">
  <!-- Controls Panel -->
  <div class="tool-controls glass-panel">
    <div class="control-group">
      <span class="label">Encoding Mode</span>
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="url-mode" value="all" checked />
          <span class="radio-circle"></span>
          Encode All Characters (Component)
        </label>
        <label class="radio-label">
          <input type="radio" name="url-mode" value="standard" />
          <span class="radio-circle"></span>
          Standard URL (Keep routing / ? @ : intact)
        </label>
      </div>
    </div>
    
    <div class="control-actions">
      <button data-action="encode" class="btn btn-primary btn-sm">
        <Icon name="Lock" size={14} />
        Encode
      </button>
      <button data-action="decode" class="btn btn-secondary btn-sm">
        <Icon name="RefreshCw" size={14} />
        Decode
      </button>
      <button data-action="clear" class="btn btn-danger btn-sm">
        <Icon name="Trash2" size={14} />
        Clear
      </button>
    </div>
  </div>

  <!-- Dual Pane Grid -->
  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea
        id="url-input"
        placeholder="Enter plain text to encode or percent-encoded text to decode..."
        aria-label="URL Input Text"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      
      <div class="output-container">
        <!-- Error Banner -->
        <div id="url-error-banner" class="error-banner" hidden>
          <Icon name="Info" size={16} />
          <span id="error-message"></span>
        </div>
        <textarea
          id="url-output"
          readonly
          placeholder="Result will appear here..."
          aria-label="URL Output Text"
        ></textarea>
      </div>
    </div>
  </div>
</url-encoder-decoder-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-group {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Custom Radio Styling */
  .radio-label {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 1.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-secondary);
    user-select: none;
  }

  .radio-label input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .radio-circle {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    height: 16px;
    width: 16px;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .radio-label:hover input ~ .radio-circle {
    border-color: var(--primary-accent);
  }

  .radio-label input:checked ~ .radio-circle {
    border-color: var(--primary-accent);
    background-color: var(--primary-accent);
  }

  .radio-circle:after {
    content: "";
    position: absolute;
    display: none;
  }

  .radio-label input:checked ~ .radio-circle:after {
    display: block;
  }

  .radio-label .radio-circle:after {
    top: 4px;
    left: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
  }

  .control-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #url-input, #url-output {
    flex: 1;
    width: 100%;
    min-height: 280px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    resize: none;
    outline: none;
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-color);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { encodeUrl, decodeUrl } from './logic';

  class UrlEncoderDecoderTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private errorBannerEl!: HTMLDivElement;
    private errorMessageEl!: HTMLSpanElement;
    private btnCopy!: HTMLButtonElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#url-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#url-output') as HTMLTextAreaElement;
      this.errorBannerEl = this.querySelector('#url-error-banner') as HTMLDivElement;
      this.errorMessageEl = this.querySelector('#error-message') as HTMLSpanElement;
      this.btnCopy = this.querySelector('#btn-copy') as HTMLButtonElement;

      // Event delegation
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'encode') this.handleEncode();
        if (action === 'decode') this.handleDecode();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });

      // Auto-validate and convert silently on type if it looks like URL
      this.inputEl.addEventListener('input', () => {
        const val = this.inputEl.value;
        if (val.includes('%')) {
          this.handleDecode(true);
        } else {
          this.handleEncode(true);
        }
      });
    }

    private getMode(): 'standard' | 'all' {
      const checkedInput = this.querySelector('input[name="url-mode"]:checked') as HTMLInputElement;
      return (checkedInput?.value || 'all') as 'standard' | 'all';
    }

    private handleEncode(silent = false) {
      const val = this.inputEl.value;
      if (!val.trim()) {
        this.clearOutput();
        return;
      }

      try {
        const mode = this.getMode();
        const result = encodeUrl(val, mode);
        this.outputEl.value = result;
        this.hideError();
      } catch (err: any) {
        if (!silent) {
          this.showError(`Encoding Error: ${err.message}`);
        }
      }
    }

    private handleDecode(silent = false) {
      const val = this.inputEl.value;
      if (!val.trim()) {
        this.clearOutput();
        return;
      }

      try {
        const result = decodeUrl(val);
        this.outputEl.value = result;
        this.hideError();
      } catch (err: any) {
        if (!silent) {
          this.showError(`Decoding Error: ${err.message}`);
        }
      }
    }

    private handleClear() {
      this.inputEl.value = '';
      this.clearOutput();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "https://example.com/search?query=hello world&category=developer tools!";
      this.handleEncode();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyText = this.btnCopy.querySelector('.copy-text') as HTMLSpanElement;

        this.btnCopy.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          this.btnCopy.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text', err);
      }
    }

    private clearOutput() {
      this.outputEl.value = '';
      this.hideError();
    }

    private showError(msg: string) {
      this.errorMessageEl.textContent = msg;
      this.errorBannerEl.removeAttribute('hidden');
      this.outputEl.value = '';
    }

    private hideError() {
      this.errorBannerEl.setAttribute('hidden', 'true');
      this.errorMessageEl.textContent = '';
    }
  }

  if (!customElements.get('url-encoder-decoder-tool')) {
    customElements.define('url-encoder-decoder-tool', UrlEncoderDecoderTool);
  }
</script>
