---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load pdf-lib from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<unlock-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Unlock PDF</h3>
      <p class="converter-subtitle">Remove passwords, restrictions, and encryption layers from your PDF locally.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="unlock-dropzone">
      <input type="file" id="unlock-file-input" accept=".pdf" class="hidden-input" aria-label="Upload password locked PDF" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your secured PDF here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 80MB)</p>
      </div>
    </div>

    <!-- Password Prompt Panel -->
    <div class="config-panel hidden" id="password-prompt-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Password input -->
      <div class="inputs-group">
        <div class="input-block">
          <label for="pdf-password" class="field-label">Document Password</label>
          <input type="password" id="pdf-password" class="field-input" placeholder="Enter password to unlock" aria-label="Document password" />
          <p class="field-error hidden" id="password-error">Incorrect password. Please try again.</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-unlock" class="btn btn-primary btn-lg">
          Unlock & Decrypt
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Decrypting document, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        PDF Unlocked & Restrictions Removed!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Unlocked PDF
        </a>
      </div>
    </div>
  </div>
</unlock-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  /* Input fields */
  .inputs-group {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .input-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .field-error {
    font-size: 0.8rem;
    color: var(--error);
    font-weight: 500;
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class UnlockPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private passwordPromptPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private passwordInputEl!: HTMLInputElement;
    private passwordErrorEl!: HTMLParagraphElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnUnlockEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    private arrayBuffer: ArrayBuffer | null = null;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#unlock-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#unlock-dropzone') as HTMLDivElement;
      this.passwordPromptPanelEl = this.querySelector('#password-prompt-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.passwordInputEl = this.querySelector('#pdf-password') as HTMLInputElement;
      this.passwordErrorEl = this.querySelector('#password-error') as HTMLParagraphElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnUnlockEl = this.querySelector('#btn-unlock') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnUnlockEl.addEventListener('click', () => this.runUnlock());
      this.passwordInputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') this.runUnlock();
      });
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.PDFLib === 'undefined') {
        alert('PDF manipulation library is still loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);
      this.passwordErrorEl.classList.add('hidden');
      this.passwordInputEl.value = '';

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        const { PDFDocument } = window.PDFLib;
        this.arrayBuffer = await file.arrayBuffer();

        // Try load without a password
        const pdfDoc = await PDFDocument.load(this.arrayBuffer);
        
        // If it loaded, it was already unlocked!
        // We can just save it back to strip any owner editing/copying blocks
        const pdfBytes = await pdfDoc.save();
        this.finishDecryption(pdfBytes);
      } catch (err) {
        // If it throws, check if it's password locked
        console.log('PDF load failed, checking password status:', err);
        
        this.loadingPanelEl.classList.add('hidden');
        this.passwordPromptPanelEl.classList.remove('hidden');
        this.passwordInputEl.focus();
      }
    }

    private async runUnlock() {
      if (!this.selectedFile || !this.arrayBuffer) return;

      const password = this.passwordInputEl.value;
      if (!password) {
        alert('Please enter a password.');
        return;
      }

      this.loadingPanelEl.classList.remove('hidden');
      this.passwordPromptPanelEl.classList.add('hidden');
      this.passwordErrorEl.classList.add('hidden');

      try {
        const { PDFDocument } = window.PDFLib;
        
        // Load with password
        const pdfDoc = await PDFDocument.load(this.arrayBuffer, { password });

        // Strip password security when saving back
        const pdfBytes = await pdfDoc.save();
        this.finishDecryption(pdfBytes);
      } catch (err) {
        console.error('Decryption failed:', err);
        
        this.loadingPanelEl.classList.add('hidden');
        this.passwordPromptPanelEl.classList.remove('hidden');
        this.passwordErrorEl.classList.remove('hidden');
        this.passwordInputEl.focus();
      }
    }

    private finishDecryption(pdfBytes: Uint8Array) {
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);

      this.downloadBtnEl.href = url;
      const baseName = this.selectedFile!.name.replace(/\.[^/.]+$/, "");
      this.downloadBtnEl.download = `${baseName}_unlocked.pdf`;

      this.loadingPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.remove('hidden');
      this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
    }

    private reset() {
      this.selectedFile = null;
      this.arrayBuffer = null;
      this.fileInputEl.value = '';
      this.passwordInputEl.value = '';
      this.dropzoneEl.classList.remove('hidden');
      this.passwordPromptPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }
  }

  if (!customElements.get('unlock-pdf-tool')) {
    customElements.define('unlock-pdf-tool', UnlockPdfTool);
  }
</script>
