---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF.js and PDFLib from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<repair-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Repair PDF</h3>
      <p class="converter-subtitle">Fix corrupted, unreadable, or broken PDF documents locally in your browser.</p>
    </div>

    <!-- Dropzone -->
    <div class="dropzone" id="repair-dropzone">
      <input type="file" id="repair-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF to repair" />
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your damaged PDF here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 50MB)</p>
      </div>
    </div>

    <!-- Config / Selection -->
    <div class="config-panel hidden" id="repair-config-panel">
      <div class="file-details">
        <div class="file-info-row">
          <span class="file-label">Selected File:</span>
          <span class="file-value" id="file-name">document.pdf</span>
        </div>
        <div class="file-info-row">
          <span class="file-label">File Size:</span>
          <span class="file-value" id="file-size">0 KB</span>
        </div>
      </div>

      <div class="repair-modes">
        <h4 class="section-subtitle">Select Repair Mode</h4>
        
        <div class="mode-option active" id="mode-standard">
          <input type="radio" id="radio-standard" name="repair-mode" value="standard" checked class="hidden-radio" />
          <div class="mode-details">
            <span class="mode-title">Standard Repair (Structural)</span>
            <span class="mode-desc">Rebuilds cross-reference tables (XREFs), repairs corrupted stream headings, and resets object indexes. Preserves selectable text.</span>
          </div>
        </div>

        <div class="mode-option" id="mode-deep">
          <input type="radio" id="radio-deep" name="repair-mode" value="deep" class="hidden-radio" />
          <div class="mode-details">
            <span class="mode-title">Deep Repair (Re-Image Reconstruction)</span>
            <span class="mode-desc">Uses PDF rendering to visually reconstruct each page as a new rasterized PDF vector page. Resolves severe corruptions that Standard Repair cannot fix.</span>
          </div>
        </div>
      </div>

      <div class="converter-actions">
        <button id="btn-start-repair" class="btn btn-primary btn-lg">
          Start Repair Process
        </button>
        <button id="btn-cancel" class="btn btn-secondary">
          Cancel
        </button>
      </div>
    </div>

    <!-- Loading / Status -->
    <div class="converter-loading hidden" id="repair-loading-panel">
      <div class="spinner"></div>
      <p id="loading-status">Repairing document structure...</p>
    </div>

    <!-- Results Panel -->
    <div class="converter-results hidden" id="repair-results-panel">
      <div class="divider"></div>
      
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        PDF Repaired Successfully!
      </div>

      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Repaired PDF
        </a>
      </div>
    </div>
  </div>
</repair-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .config-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .file-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .file-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .file-value {
    color: var(--text-primary);
    font-weight: 600;
  }

  .repair-modes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-subtitle {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mode-option {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    cursor: pointer;
    background: var(--surface);
    transition: all 0.2s ease;
    display: flex;
    gap: 0.75rem;
  }

  .mode-option:hover {
    border-color: var(--border-hover);
  }

  .mode-option.active {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-radio {
    display: none;
  }

  .mode-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mode-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mode-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .converter-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--success-subtle);
    color: var(--success);
  }

  .download-box {
    display: flex;
    justify-content: center;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals = 2) {
    if (!+bytes) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
  }

  class RepairPdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;

    private fileNameEl!: HTMLSpanElement;
    private fileSizeEl!: HTMLSpanElement;
    private modeStandardEl!: HTMLDivElement;
    private modeDeepEl!: HTMLDivElement;
    private radioStandardEl!: HTMLInputElement;
    private radioDeepEl!: HTMLInputElement;

    private btnStartRepairEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnDownloadEl!: HTMLAnchorElement;
    private loadingStatusEl!: HTMLParagraphElement;

    private selectedFile: File | null = null;
    private repairMode: 'standard' | 'deep' = 'standard';

    connectedCallback() {
      this.fileInputEl = this.querySelector('#repair-file-input')!;
      this.dropzoneEl = this.querySelector('#repair-dropzone')!;
      this.configPanelEl = this.querySelector('#repair-config-panel')!;
      this.loadingPanelEl = this.querySelector('#repair-loading-panel')!;
      this.resultsPanelEl = this.querySelector('#repair-results-panel')!;

      this.fileNameEl = this.querySelector('#file-name')!;
      this.fileSizeEl = this.querySelector('#file-size')!;
      this.modeStandardEl = this.querySelector('#mode-standard')!;
      this.modeDeepEl = this.querySelector('#mode-deep')!;
      this.radioStandardEl = this.querySelector('#radio-standard')!;
      this.radioDeepEl = this.querySelector('#radio-deep')!;

      this.btnStartRepairEl = this.querySelector('#btn-start-repair')!;
      this.btnCancelEl = this.querySelector('#btn-cancel')!;
      this.btnDownloadEl = this.querySelector('#btn-download')!;
      this.loadingStatusEl = this.querySelector('#loading-status')!;

      // Drop Events
      this.fileInputEl.addEventListener('change', (e) => this.handleFileSelect(e));
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });
      this.dropzoneEl.addEventListener('dragleave', () => this.dropzoneEl.classList.remove('dragover'));
      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });

      // Mode Click Events
      this.modeStandardEl.addEventListener('click', () => this.selectMode('standard'));
      this.modeDeepEl.addEventListener('click', () => this.selectMode('deep'));

      // Action Buttons
      this.btnStartRepairEl.addEventListener('click', () => this.startRepair());
      this.btnCancelEl.addEventListener('click', () => this.reset());
    }

    private handleFileSelect(e: Event) {
      const target = e.target as HTMLInputElement;
      if (target.files?.length) {
        this.processFile(target.files[0]);
      }
    }

    private processFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;
      this.fileNameEl.textContent = file.name;
      this.fileSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
    }

    private selectMode(mode: 'standard' | 'deep') {
      this.repairMode = mode;
      if (mode === 'standard') {
        this.modeStandardEl.classList.add('active');
        this.modeDeepEl.classList.remove('active');
        this.radioStandardEl.checked = true;
      } else {
        this.modeDeepEl.classList.add('active');
        this.modeStandardEl.classList.remove('active');
        this.radioDeepEl.checked = true;
      }
    }

    private async startRepair() {
      if (!this.selectedFile) return;

      if (typeof window.PDFLib === 'undefined') {
        alert('Libraries are loading. Please try again in a moment.');
        return;
      }

      this.configPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingStatusEl.textContent = 'Initializing repair algorithms...';

      try {
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        let repairedBytes: Uint8Array;

        if (this.repairMode === 'standard') {
          this.loadingStatusEl.textContent = 'De-serializing structures and fixing table mapping...';
          const { PDFDocument } = window.PDFLib;
          
          // Try loading with ignoreEncryption to handle mild structure error
          const pdfDoc = await PDFDocument.load(arrayBuffer, { ignoreEncryption: true });
          
          // Perform a safe re-indexing by copying pages to a new document
          const cleanPdf = await PDFDocument.create();
          const copiedPages = await cleanPdf.copyPages(pdfDoc, pdfDoc.getPageIndices());
          copiedPages.forEach(page => cleanPdf.addPage(page));

          repairedBytes = await cleanPdf.save();
        } else {
          // Deep Repair (Render to Image -> Save as PDF)
          this.loadingStatusEl.textContent = 'Reconstructing pages visually (this might take a few moments)...';
          if (typeof window.pdfjsLib === 'undefined') {
            throw new Error('PDF.js rendering engine is not loaded. Try reloading page.');
          }

          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
          
          const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
          const pdfjsDoc = await loadingTask.promise;
          const { PDFDocument } = window.PDFLib;
          const cleanPdf = await PDFDocument.create();

          for (let i = 1; i <= pdfjsDoc.numPages; i++) {
            this.loadingStatusEl.textContent = `Rebuilding page ${i} of ${pdfjsDoc.numPages}...`;
            const page = await pdfjsDoc.getPage(i);
            const viewport = page.getViewport({ scale: 2.0 }); // High-quality rendering

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d')!;
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            await page.render({ canvasContext: ctx, viewport }).promise;

            const imgDataUrl = canvas.toDataURL('image/jpeg', 0.92);
            const embeddedImg = await cleanPdf.embedJpg(imgDataUrl);

            // Add standard A4 / custom sized page
            const newPage = cleanPdf.addPage([viewport.width / 2.0, viewport.height / 2.0]);
            newPage.drawImage(embeddedImg, {
              x: 0,
              y: 0,
              width: viewport.width / 2.0,
              height: viewport.height / 2.0
            });
          }

          repairedBytes = await cleanPdf.save();
        }

        const blob = new Blob([repairedBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        this.btnDownloadEl.href = url;
        this.btnDownloadEl.download = `${this.selectedFile.name.replace('.pdf', '')}_repaired.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.resultsPanelEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert(`Failed to repair PDF file: ${err instanceof Error ? err.message : 'Structure too damaged to recover'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.fileInputEl.value = '';
      this.selectMode('standard');

      this.configPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.dropzoneEl.classList.remove('hidden');
    }
  }

  if (!customElements.get('repair-pdf-tool')) {
    customElements.define('repair-pdf-tool', RepairPdfTool);
  }
</script>
