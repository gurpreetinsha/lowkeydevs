---
import Icon from '../../../components/base/Icon.astro';
---

<cute-font-tool class="tool-workspace">
  <div class="editor-grid">
    <!-- Input Pane -->
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="cute-input" 
        placeholder="Type or paste text here to make it cute..." 
        aria-label="Cute Text Input"
      ></textarea>
      <div class="control-actions">
        <button data-action="clear" class="btn btn-danger btn-sm">
          <Icon name="Trash2" size={14} />
          Clear
        </button>
      </div>
    </div>

    <!-- Cute Card Preview Pane -->
    <div class="editor-pane glass-panel simulator-pane">
      <div class="pane-header">
        <span class="pane-title">Aesthetic Preview</span>
      </div>
      
      <div class="cute-preview-card">
        <div class="cute-sparkles-top">✨ ﾟ･ : * ✧ * : ･ ﾟ✨</div>
        <div class="cute-text-preview" id="cute-text-preview-el">ʚ soft text ɞ</div>
        <div class="cute-sparkles-bottom">🎀 🧸 🌸 🧸 🎀</div>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="results-section glass-panel">
    <h3 class="section-title">Copy Cute Fonts</h3>
    
    <div class="results-list" id="cute-results">
      <div class="empty-state">
        Type some text above to see cute font styles...
      </div>
    </div>
  </div>
</cute-font-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    min-height: 400px;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #cute-input {
    flex: 1;
    width: 100%;
    min-height: 250px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Cute Preview Card */
  .simulator-pane {
    background: var(--card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cute-preview-card {
    width: 100%;
    max-width: 320px;
    min-height: 200px;
    background: var(--surface-elevated);
    border: 1px dashed var(--border-hover);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    box-shadow: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .cute-sparkles-top {
    font-size: 0.85rem;
    letter-spacing: 2px;
    font-weight: 500;
  }

  .cute-text-preview {
    font-size: 1.35rem;
    font-weight: 600;
    word-break: break-word;
    padding: 1rem 0;
    line-height: 1.4;
  }

  .cute-sparkles-bottom {
    font-size: 1.1rem;
    display: flex;
    gap: 0.5rem;
  }

  /* Results List */
  .results-section {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .results-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .results-list {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
  }

  .result-card:hover {
    border-color: #ff69b4;
    background-color: var(--surface-hover);
  }

  .result-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .result-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .result-text {
    font-size: 1.1rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }

  .copied-btn {
    border-color: #ff69b4 !important;
    color: #ff69b4 !important;
  }
</style>

<script>
  import { generateCuteFonts } from './logic';

  class CuteFontTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private resultsEl!: HTMLDivElement;
    private previewBodyEl!: HTMLDivElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#cute-input') as HTMLTextAreaElement;
      this.resultsEl = this.querySelector('#cute-results') as HTMLDivElement;
      this.previewBodyEl = this.querySelector('#cute-text-preview-el') as HTMLDivElement;

      this.inputEl.addEventListener('input', () => this.handleUpdate());

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'clear') this.handleClear();
        if (action === 'load-sample') this.handleLoadSample();
        if (button.classList.contains('btn-copy')) {
          const index = parseInt(button.getAttribute('data-index') || '0');
          this.handleCopy(button, index);
        }
      });

      this.handleLoadSample();
    }

    private handleUpdate() {
      const text = this.inputEl.value;

      if (!text) {
        this.previewBodyEl.textContent = 'ʚ soft text ɞ';
        this.resultsEl.innerHTML = `
          <div class="empty-state">
            Type some text above to see cute font styles...
          </div>
        `;
        return;
      }

      const fonts = generateCuteFonts(text);
      
      // Update preview to use the first converted cute font style
      if (fonts.length > 0) {
        this.previewBodyEl.textContent = fonts[0].text;
      } else {
        this.previewBodyEl.textContent = text;
      }

      this.resultsEl.innerHTML = fonts.map((res, index) => `
        <div class="result-card">
          <div class="result-info">
            <span class="result-label">${res.name}</span>
            <div class="result-text" id="cute-text-${index}">${this.escapeHtml(res.text)}</div>
          </div>
          <button class="btn btn-secondary btn-sm btn-copy" data-index="${index}" aria-label="Copy ${res.name}">
            Copy
          </button>
        </div>
      `).join('');
    }

    private handleClear() {
      this.inputEl.value = '';
      this.handleUpdate();
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = 'sweet sugar';
      this.handleUpdate();
    }

    private async handleCopy(button: HTMLButtonElement, index: number) {
      const textEl = this.querySelector(`#cute-text-${index}`) as HTMLDivElement;
      if (!textEl) return;

      const text = textEl.textContent || '';
      
      try {
        await navigator.clipboard.writeText(text);
        
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied-btn');

        this.previewBodyEl.textContent = text;

        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied-btn');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('cute-font-tool')) {
    customElements.define('cute-font-tool', CuteFontTool);
  }
</script>
