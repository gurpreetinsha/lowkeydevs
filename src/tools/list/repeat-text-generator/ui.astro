---
import Icon from '../../../components/base/Icon.astro';
---

<repeat-text-tool class="tool-workspace">
  <div class="tool-controls glass-panel">
    <div class="settings-grid">
      <div class="form-group">
        <label for="repeat-count" class="label">Repeat Count</label>
        <input type="number" id="repeat-count" value="10" min="1" max="10000" class="input" />
      </div>

      <div class="form-group">
        <label for="repeat-separator" class="label">Separator</label>
        <select id="repeat-separator" class="select-input">
          <option value="newline">Newline</option>
          <option value="space">Space</option>
          <option value="comma">Comma</option>
          <option value="tab">Tab</option>
          <option value="none">None</option>
          <option value="custom">Custom Separator</option>
        </select>
      </div>

      <div class="form-group" id="custom-separator-group" style="display: none;">
        <label for="custom-separator" class="label">Custom Separator</label>
        <input type="text" id="custom-separator" placeholder="e.g. - or |" class="input" />
      </div>
    </div>

    <div class="checkbox-options-grid">
      <label class="checkbox-container">
        <input type="checkbox" id="opt-index" />
        <span class="checkmark"></span>
        Prepend Index Numbers (e.g. 1. text)
      </label>
    </div>

    <div class="control-actions">
      <button data-action="repeat" class="btn btn-primary">
        <Icon name="Repeat" size={16} />
        Generate Repeated Text
      </button>
      <button data-action="clear" class="btn btn-danger">
        <Icon name="Trash2" size={16} />
        Clear
      </button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Input Phrase / Text</span>
        <button data-action="load-sample" class="btn-text">Load Sample</button>
      </div>
      <textarea 
        id="repeat-input" 
        placeholder="Type the word or sentence to repeat..." 
        aria-label="Input Text to Repeat"
      ></textarea>
    </div>

    <div class="editor-pane glass-panel">
      <div class="pane-header">
        <span class="pane-title">Repeated Result</span>
        <button data-action="copy" class="btn btn-secondary btn-sm" id="btn-copy">
          <Icon name="Clipboard" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon" />
          <span class="copy-text">Copy</span>
        </button>
      </div>
      <div class="output-container">
        <textarea 
          id="repeat-output" 
          placeholder="Repeated output will appear here..." 
          readonly
          aria-label="Repeated Output Text"
        ></textarea>
      </div>
    </div>
  </div>
</repeat-text-tool>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
  }

  .select-input {
    width: 100%;
    padding: 0.625rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .select-input:focus {
    border-color: var(--primary-accent);
  }

  .checkbox-options-grid {
    display: flex;
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  /* Custom Checkbox Styles */
  .checkbox-container {
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-left: 2rem;
    cursor: pointer;
    font-size: 0.925rem;
    color: var(--text-secondary);
    user-select: none;
    transition: color 0.2s ease;
  }

  .checkbox-container:hover {
    color: var(--text-primary);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkmark {
    position: absolute;
    left: 0;
    height: 1.25rem;
    width: 1.25rem;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .checkbox-container:hover input ~ .checkmark {
    border-color: var(--border-hover);
  }

  .checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-accent);
    border-color: var(--primary-accent);
  }

  .checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 6px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-container input:checked ~ .checkmark::after {
    display: block;
  }

  .control-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 400px;
    padding: 1.25rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--primary-accent);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: var(--font-display);
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .btn-text:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  #repeat-input,
  #repeat-output {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    resize: none;
    outline: none;
  }

  #repeat-output {
    color: var(--text-secondary);
  }

  .output-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Copy Button states */
  #btn-copy .check-icon {
    display: none;
  }

  #btn-copy.copied .copy-icon {
    display: none;
  }

  #btn-copy.copied .check-icon {
    display: inline-block;
    color: var(--success-color);
  }

  #btn-copy.copied {
    border-color: var(--success-color);
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { repeatText } from './logic';

  class RepeatTextTool extends HTMLElement {
    private inputEl!: HTMLTextAreaElement;
    private outputEl!: HTMLTextAreaElement;
    private countEl!: HTMLInputElement;
    private separatorEl!: HTMLSelectElement;
    private customSeparatorGroupEl!: HTMLDivElement;
    private customSeparatorEl!: HTMLInputElement;
    private indexEl!: HTMLInputElement;

    connectedCallback() {
      this.inputEl = this.querySelector('#repeat-input') as HTMLTextAreaElement;
      this.outputEl = this.querySelector('#repeat-output') as HTMLTextAreaElement;
      this.countEl = this.querySelector('#repeat-count') as HTMLInputElement;
      this.separatorEl = this.querySelector('#repeat-separator') as HTMLSelectElement;
      this.customSeparatorGroupEl = this.querySelector('#custom-separator-group') as HTMLDivElement;
      this.customSeparatorEl = this.querySelector('#custom-separator') as HTMLInputElement;
      this.indexEl = this.querySelector('#opt-index') as HTMLInputElement;

      // Realtime repeat
      this.inputEl.addEventListener('input', () => this.handleRepeat());
      this.countEl.addEventListener('input', () => this.handleRepeat());
      this.customSeparatorEl.addEventListener('input', () => this.handleRepeat());
      this.indexEl.addEventListener('change', () => this.handleRepeat());

      this.separatorEl.addEventListener('change', () => {
        if (this.separatorEl.value === 'custom') {
          this.customSeparatorGroupEl.style.display = 'flex';
        } else {
          this.customSeparatorGroupEl.style.display = 'none';
        }
        this.handleRepeat();
      });

      // Actions click
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest('button');
        if (!button) return;

        const action = button.getAttribute('data-action');
        if (action === 'repeat') this.handleRepeat();
        if (action === 'clear') this.handleClear();
        if (action === 'copy') this.handleCopy();
        if (action === 'load-sample') this.handleLoadSample();
      });
    }

    private handleRepeat() {
      const text = this.inputEl.value;
      if (!text) {
        this.outputEl.value = '';
        return;
      }

      const options = {
        count: parseInt(this.countEl.value) || 10,
        separator: this.separatorEl.value as any,
        customSeparator: this.customSeparatorEl.value,
        prependIndex: this.indexEl.checked
      };

      const result = repeatText(text, options);
      this.outputEl.value = result;
    }

    private handleClear() {
      this.inputEl.value = '';
      this.outputEl.value = '';
      this.countEl.value = '10';
      this.separatorEl.value = 'newline';
      this.customSeparatorGroupEl.style.display = 'none';
      this.customSeparatorEl.value = '';
      this.indexEl.checked = false;
      this.inputEl.focus();
    }

    private handleLoadSample() {
      this.inputEl.value = "Lowkeydevs Rocks!";
      this.countEl.value = '5';
      this.separatorEl.value = 'newline';
      this.indexEl.checked = true;
      this.handleRepeat();
    }

    private async handleCopy() {
      const text = this.outputEl.value;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyBtn = this.querySelector('#btn-copy') as HTMLButtonElement;
        const copyText = copyBtn.querySelector('.copy-text') as HTMLSpanElement;

        copyBtn.classList.add('copied');
        copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (e) {
        console.error('Failed to copy text', e);
      }
    }
  }

  if (!customElements.get('repeat-text-tool')) {
    customElements.define('repeat-text-tool', RepeatTextTool);
  }
</script>

