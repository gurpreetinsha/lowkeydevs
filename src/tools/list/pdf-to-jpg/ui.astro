---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load external libraries from CDNs -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" is:inline></script>

<pdf-jpg-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Convert PDF to JPG</h3>
      <p class="converter-subtitle">Render PDF pages to high-quality JPG images locally inside your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="jpg-dropzone">
      <input type="file" id="jpg-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 80MB)</p>
      </div>
    </div>

    <!-- Config Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Settings -->
      <div class="settings-group">
        <h4 class="section-subtitle">Image Output Settings</h4>
        <div class="settings-card">
          <div class="setting-item">
            <label for="img-resolution" class="field-label">Resolution / Quality</label>
            <select id="img-resolution" class="field-input">
              <option value="1">Standard Quality (1x Scale)</option>
              <option value="2" selected>High Quality (2x Scale - Recommended)</option>
              <option value="3">Ultra Quality (3x Scale - Heavy File)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Select Pages Grid -->
      <div class="pages-grid-section">
        <div class="section-header">
          <h4 class="section-subtitle">Select Pages to Convert</h4>
          <div class="selection-actions">
            <button id="btn-select-all" class="btn btn-sm btn-secondary">Select All</button>
            <button id="btn-select-none" class="btn btn-sm btn-secondary">Clear All</button>
          </div>
        </div>
        <div class="pages-preview-grid" id="pages-grid"></div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-convert" class="btn btn-primary btn-lg">
          Convert Pages
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Rendering PDF pages, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Conversion Complete!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download All Images (ZIP)
        </a>
      </div>

      <!-- Individual download grid -->
      <div class="converted-grid-section">
        <h4 class="section-subtitle">Converted Pages</h4>
        <div class="converted-grid" id="converted-grid"></div>
      </div>
    </div>
  </div>
</pdf-jpg-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .settings-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .settings-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  /* Page Grid Area */
  .pages-grid-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .selection-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
  }

  .pages-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 1rem;
    max-height: 300px;
    overflow-y: auto;
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .page-card {
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .page-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .page-card.selected {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .page-card-checkbox {
    position: absolute;
    top: 6px;
    left: 6px;
    accent-color: var(--accent);
    cursor: pointer;
    width: 15px;
    height: 15px;
  }

  .page-card-canvas {
    width: 100%;
    height: 140px;
    object-fit: contain;
    background: #fff;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-sm);
  }

  .page-card-label {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Converted grid individual downloads */
  .converted-grid-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .converted-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .converted-card {
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .converted-thumb {
    width: 100%;
    height: 150px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    background: white;
  }

  .btn-download-single {
    width: 100%;
    padding: 0.4rem;
    font-size: 0.75rem;
    text-align: center;
    border-radius: var(--radius-sm);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .btn-download-single:hover {
    border-color: var(--border-hover);
    background: var(--surface);
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class PdfToJpgTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private pagesGridEl!: HTMLDivElement;
    private imgResolutionEl!: HTMLSelectElement;
    private btnSelectAllEl!: HTMLButtonElement;
    private btnSelectNoneEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnConvertEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private loadingTextEl!: HTMLParagraphElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;
    private convertedGridEl!: HTMLDivElement;

    private selectedFile: File | null = null;
    private pdfjsDoc: any = null;
    private pageChecked: boolean[] = [];

    connectedCallback() {
      this.fileInputEl = this.querySelector('#jpg-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#jpg-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.pagesGridEl = this.querySelector('#pages-grid') as HTMLDivElement;
      this.imgResolutionEl = this.querySelector('#img-resolution') as HTMLSelectElement;
      this.btnSelectAllEl = this.querySelector('#btn-select-all') as HTMLButtonElement;
      this.btnSelectNoneEl = this.querySelector('#btn-select-none') as HTMLButtonElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnConvertEl = this.querySelector('#btn-convert') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.loadingTextEl = this.querySelector('#loading-text') as HTMLParagraphElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;
      this.convertedGridEl = this.querySelector('#converted-grid') as HTMLDivElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      this.btnSelectAllEl.addEventListener('click', () => this.toggleAllCheckboxes(true));
      this.btnSelectNoneEl.addEventListener('click', () => this.toggleAllCheckboxes(false));

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnConvertEl.addEventListener('click', () => this.runConversion());
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.pdfjsLib === 'undefined') {
        alert('PDF.js renderer is still loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingTextEl.textContent = 'Analyzing PDF structure...';

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        
        const arrayBuffer = await file.arrayBuffer();
        const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        this.pdfjsDoc = await loadingTask.promise;
        const numPages = this.pdfjsDoc.numPages;

        this.pageChecked = new Array(numPages).fill(true);
        this.pagesGridEl.innerHTML = '';

        // Draw thumbnails asynchronously inside pages-grid
        for (let i = 1; i <= numPages; i++) {
          this.loadingTextEl.textContent = `Drawing thumbnails: Page ${i} of ${numPages}...`;
          
          const page = await this.pdfjsDoc.getPage(i);
          const viewport = page.getViewport({ scale: 0.25 }); // small thumbnail scale
          
          const canvas = document.createElement('canvas');
          canvas.className = 'page-card-canvas';
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            await page.render({ canvasContext: ctx, viewport }).promise;
          }

          // Build Page card
          const pageCard = document.createElement('div');
          pageCard.className = 'page-card selected';
          pageCard.dataset.index = (i - 1).toString();

          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'page-card-checkbox';
          checkbox.checked = true;
          checkbox.addEventListener('change', (e) => {
            e.stopPropagation();
            const checked = checkbox.checked;
            this.pageChecked[i - 1] = checked;
            pageCard.classList.toggle('selected', checked);
          });

          pageCard.addEventListener('click', () => {
            checkbox.checked = !checkbox.checked;
            const checked = checkbox.checked;
            this.pageChecked[i - 1] = checked;
            pageCard.classList.toggle('selected', checked);
          });

          const label = document.createElement('span');
          label.className = 'page-card-label';
          label.textContent = `Page ${i}`;

          pageCard.appendChild(checkbox);
          pageCard.appendChild(canvas);
          pageCard.appendChild(label);
          this.pagesGridEl.appendChild(pageCard);
        }

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.add('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to parse PDF document.');
        this.reset();
      }
    }

    private toggleAllCheckboxes(checked: boolean) {
      this.pageChecked.fill(checked);
      this.querySelectorAll('.page-card-checkbox').forEach(cb => {
        (cb as HTMLInputElement).checked = checked;
      });
      this.querySelectorAll('.page-card').forEach(card => {
        card.classList.toggle('selected', checked);
      });
    }

    private reset() {
      this.selectedFile = null;
      this.pdfjsDoc = null;
      this.pageChecked = [];
      this.fileInputEl.value = '';
      this.pagesGridEl.innerHTML = '';
      this.convertedGridEl.innerHTML = '';
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
    }

    private async runConversion() {
      if (!this.selectedFile || !this.pdfjsDoc) return;

      const selectedPages = this.pageChecked.map((chk, i) => chk ? i + 1 : -1).filter(v => v !== -1);
      if (selectedPages.length === 0) {
        alert('Please select at least one page to convert.');
        return;
      }

      if (typeof window.JSZip === 'undefined') {
        alert('ZIP utility is still loading. Please wait.');
        return;
      }

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.convertedGridEl.innerHTML = '';

      try {
        const scale = parseFloat(this.imgResolutionEl.value);
        const zip = new window.JSZip();
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");

        const pagesData: { num: number; url: string; blob: Blob }[] = [];

        for (let i = 0; i < selectedPages.length; i++) {
          const pageNum = selectedPages[i];
          this.loadingTextEl.textContent = `Rendering page ${pageNum}: Image ${i + 1} of ${selectedPages.length}...`;

          const page = await this.pdfjsDoc.getPage(pageNum);
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;

          const ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('Canvas 2D context not available.');

          // Render canvas white background
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          await page.render({ canvasContext: ctx, viewport }).promise;

          // Convert canvas to jpeg blob
          const blob = await new Promise<Blob | null>((resolve) => {
            canvas.toBlob(resolve, 'image/jpeg', 0.9);
          });

          if (blob) {
            const url = URL.createObjectURL(blob);
            pagesData.push({ num: pageNum, url, blob });
            
            // Add to zip
            zip.file(`${baseName}_page_${pageNum}.jpg`, blob);
          }
        }

        // Generate ZIP
        const zipBlob = await zip.generateAsync({ type: 'blob' });
        const zipUrl = URL.createObjectURL(zipBlob);

        this.downloadBtnEl.href = zipUrl;
        this.downloadBtnEl.download = `${baseName}_images.zip`;

        // Render individual downloads grid
        pagesData.forEach(p => {
          const card = document.createElement('div');
          card.className = 'converted-card';

          const img = document.createElement('img');
          img.className = 'converted-thumb';
          img.src = p.url;
          img.alt = `Page ${p.num}`;

          const label = document.createElement('span');
          label.className = 'page-card-label';
          label.textContent = `Page ${p.num}`;

          const dl = document.createElement('a');
          dl.className = 'btn-download-single';
          dl.href = p.url;
          dl.download = `${baseName}_page_${p.num}.jpg`;
          dl.textContent = 'Download JPG';

          card.appendChild(img);
          card.appendChild(label);
          card.appendChild(dl);
          this.convertedGridEl.appendChild(card);
        });

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error rendering pages: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('pdf-jpg-tool')) {
    customElements.define('pdf-jpg-tool', PdfToJpgTool);
  }
</script>
