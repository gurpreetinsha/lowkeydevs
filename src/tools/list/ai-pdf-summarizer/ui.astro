---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDF.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js" is:inline></script>

<ai-pdf-summarizer-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">AI PDF Summarizer & Chat</h3>
      <p class="converter-subtitle">Extract text, summarize, translate, and chat with your PDF documents completely locally using your API keys.</p>
    </div>

    <!-- Dropzone -->
    <div class="dropzone" id="ai-dropzone">
      <input type="file" id="ai-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF to summarize" />
      <div class="dropzone-content">
        <Icon name="Sparkles" size={48} />
        <p class="dropzone-text">Drag & drop your PDF document here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 30MB)</p>
      </div>
    </div>

    <!-- Config pane: Keys & Settings -->
    <div class="config-panel hidden" id="ai-config-panel">
      <div class="file-details">
        <div class="file-info-row">
          <span class="file-label">Selected Document:</span>
          <span class="file-value" id="file-name">document.pdf</span>
        </div>
      </div>

      <div class="api-settings-grid">
        <div class="settings-group">
          <label for="ai-provider" class="field-label">AI Provider</label>
          <select id="ai-provider" class="field-input">
            <option value="gemini" selected>Google Gemini (Recommended)</option>
            <option value="openai">OpenAI ChatGPT</option>
            <option value="local">Local Mock / Heuristic Outline (No key required)</option>
          </select>
        </div>

        <div class="settings-group" id="api-key-group">
          <label for="ai-key" class="field-label">API Key</label>
          <input type="password" id="ai-key" class="field-input" placeholder="Paste your API key here..." />
          <span class="key-help-text">Stored safely in your browser's localStorage.</span>
        </div>
      </div>

      <div class="converter-actions">
        <button id="btn-process-doc" class="btn btn-primary btn-lg">
          Process Document
        </button>
        <button id="btn-cancel" class="btn btn-secondary">
          Cancel
        </button>
      </div>
    </div>

    <!-- Loading Panel -->
    <div class="converter-loading hidden" id="ai-loading-panel">
      <div class="spinner"></div>
      <p id="loading-status">Extracting page contents...</p>
    </div>

    <!-- Dashboard Interface (Split View) -->
    <div class="dashboard-interface hidden" id="dashboard-interface">
      <div class="dashboard-grid">
        
        <!-- Left Column: Document Data & Outline -->
        <div class="dashboard-pane pane-left">
          <div class="pane-header">
            <h4 class="pane-title">Document Insights</h4>
            <button id="btn-change-file" class="btn btn-secondary btn-sm">Upload Different File</button>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <span class="stat-num" id="stat-pages">0</span>
              <span class="stat-label">Pages</span>
            </div>
            <div class="stat-card">
              <span class="stat-num" id="stat-words">0</span>
              <span class="stat-label">Words</span>
            </div>
            <div class="stat-card">
              <span class="stat-num" id="stat-read-time">0m</span>
              <span class="stat-label">Read Time</span>
            </div>
          </div>

          <div class="extracted-text-view">
            <span class="field-label">Extracted Document Text</span>
            <textarea class="field-input text-preview" id="text-preview-area" readonly></textarea>
          </div>
        </div>

        <!-- Right Column: AI Chat Panel -->
        <div class="dashboard-pane pane-right">
          <div class="pane-header">
            <h4 class="pane-title">AI Assistant</h4>
            <div class="api-indicator" id="provider-badge">Gemini Mode</div>
          </div>

          <!-- Chat window -->
          <div class="chat-viewport" id="chat-viewport">
            <div class="chat-message system">
              Hello! I've loaded your PDF document text. You can use the Quick Actions below or type any question you have about the document details.
            </div>
          </div>

          <!-- Quick prompts -->
          <div class="quick-prompts">
            <button class="btn-prompt" data-prompt="Summarize the core message of this document in 3 paragraphs.">Summarize</button>
            <button class="btn-prompt" data-prompt="List the top 5 key takeaways and highlights from this document.">Takeaways</button>
            <button class="btn-prompt" data-prompt="Translate the main summary of this document into Spanish.">Translate (ES)</button>
            <button class="btn-prompt" data-prompt="Translate the main summary of this document into French.">Translate (FR)</button>
          </div>

          <!-- Message input -->
          <div class="chat-input-bar">
            <input type="text" id="chat-input-field" class="field-input" placeholder="Ask something about the document..." />
            <button id="btn-chat-send" class="btn btn-primary">Send</button>
          </div>
        </div>

      </div>
    </div>
  </div>
</ai-pdf-summarizer-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .config-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .file-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .file-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .file-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .file-value {
    color: var(--text-primary);
    font-weight: 600;
  }

  .api-settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .settings-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .key-help-text {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .converter-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  /* Dashboard Split Grid */
  .dashboard-interface {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
  }

  .dashboard-pane {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .pane-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .api-indicator {
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .extracted-text-view {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .text-preview {
    min-height: 250px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
    resize: vertical;
    flex-grow: 1;
    background: rgba(0,0,0,0.1);
  }

  /* Chat Window Styling */
  .chat-viewport {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: rgba(0,0,0,0.15);
    padding: 1rem;
    height: 300px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chat-message {
    padding: 0.75rem;
    border-radius: var(--radius-md);
    max-width: 85%;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .chat-message.system {
    background: var(--surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    align-self: flex-start;
  }

  .chat-message.user {
    background: var(--accent);
    color: var(--accent-on);
    align-self: flex-end;
    font-weight: 500;
  }

  .chat-message.ai {
    background: var(--surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border);
    align-self: flex-start;
    white-space: pre-wrap;
  }

  .quick-prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-prompt {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-prompt:hover {
    border-color: var(--accent);
    color: var(--text-primary);
    background: var(--accent-subtle);
  }

  .chat-input-bar {
    display: flex;
    gap: 0.5rem;
  }

  .chat-input-bar .field-input {
    flex-grow: 1;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 968px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  class AiPdfSummarizerTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private loadingPanelEl!: HTMLDivElement;
    private dashboardInterfaceEl!: HTMLDivElement;

    private fileNameEl!: HTMLSpanElement;
    private aiProviderSelectEl!: HTMLSelectElement;
    private apiKeyGroupEl!: HTMLDivElement;
    private aiKeyInputEl!: HTMLInputElement;
    private btnProcessDocEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;

    private statPagesEl!: HTMLSpanElement;
    private statWordsEl!: HTMLSpanElement;
    private statReadTimeEl!: HTMLSpanElement;
    private textPreviewAreaEl!: HTMLTextAreaElement;
    private btnChangeFileEl!: HTMLButtonElement;

    private providerBadgeEl!: HTMLDivElement;
    private chatViewportEl!: HTMLDivElement;
    private chatInputFieldEl!: HTMLInputElement;
    private btnChatSendEl!: HTMLButtonElement;

    private selectedFile: File | null = null;
    private extractedText = '';
    private totalPages = 0;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#ai-file-input')!;
      this.dropzoneEl = this.querySelector('#ai-dropzone')!;
      this.configPanelEl = this.querySelector('#ai-config-panel')!;
      this.loadingPanelEl = this.querySelector('#ai-loading-panel')!;
      this.dashboardInterfaceEl = this.querySelector('#dashboard-interface')!;

      this.fileNameEl = this.querySelector('#file-name')!;
      this.aiProviderSelectEl = this.querySelector('#ai-provider')!;
      this.apiKeyGroupEl = this.querySelector('#api-key-group')!;
      this.aiKeyInputEl = this.querySelector('#ai-key')!;
      this.btnProcessDocEl = this.querySelector('#btn-process-doc')!;
      this.btnCancelEl = this.querySelector('#btn-cancel')!;

      this.statPagesEl = this.querySelector('#stat-pages')!;
      this.statWordsEl = this.querySelector('#stat-words')!;
      this.statReadTimeEl = this.querySelector('#stat-read-time')!;
      this.textPreviewAreaEl = this.querySelector('#text-preview-area')!;
      this.btnChangeFileEl = this.querySelector('#btn-change-file')!;

      this.providerBadgeEl = this.querySelector('#provider-badge')!;
      this.chatViewportEl = this.querySelector('#chat-viewport')!;
      this.chatInputFieldEl = this.querySelector('#chat-input-field')!;
      this.btnChatSendEl = this.querySelector('#btn-chat-send')!;

      // Bind drag and drop
      this.fileInputEl.addEventListener('change', (e) => this.handleFileSelect(e));
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });
      this.dropzoneEl.addEventListener('dragleave', () => this.dropzoneEl.classList.remove('dragover'));
      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });

      // Provider change
      this.aiProviderSelectEl.addEventListener('change', () => this.handleProviderChange());

      // Actions
      this.btnProcessDocEl.addEventListener('click', () => this.startDocumentProcessing());
      this.btnCancelEl.addEventListener('click', () => this.reset());
      this.btnChangeFileEl.addEventListener('click', () => this.reset());

      // Chat binds
      this.btnChatSendEl.addEventListener('click', () => this.handleSendMessage());
      this.chatInputFieldEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') this.handleSendMessage();
      });

      // Quick prompt buttons
      this.querySelectorAll('.btn-prompt').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.target as HTMLButtonElement;
          const prompt = target.dataset.prompt || '';
          this.chatInputFieldEl.value = prompt;
          this.handleSendMessage();
        });
      });

      // Auto load API keys from local storage
      this.loadSavedKeys();
    }

    private handleFileSelect(e: Event) {
      const target = e.target as HTMLInputElement;
      if (target.files?.length) {
        this.processFile(target.files[0]);
      }
    }

    private processFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;
      this.fileNameEl.textContent = file.name;

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
    }

    private handleProviderChange() {
      const provider = this.aiProviderSelectEl.value;
      if (provider === 'local') {
        this.apiKeyGroupEl.classList.add('hidden');
      } else {
        this.apiKeyGroupEl.classList.remove('hidden');
        // Load key specifically for this provider
        const key = localStorage.getItem(`ai_key_${provider}`) || '';
        this.aiKeyInputEl.value = key;
      }
    }

    private loadSavedKeys() {
      const provider = this.aiProviderSelectEl.value;
      const key = localStorage.getItem(`ai_key_${provider}`) || '';
      this.aiKeyInputEl.value = key;
    }

    private async startDocumentProcessing() {
      if (!this.selectedFile) return;

      if (typeof window.pdfjsLib === 'undefined') {
        alert('PDF rendering engine is loading. Please wait.');
        return;
      }

      const provider = this.aiProviderSelectEl.value;
      const apiKey = this.aiKeyInputEl.value.trim();

      if (provider !== 'local' && !apiKey) {
        alert('Please enter your API key to use this AI provider.');
        return;
      }

      // Save key
      if (provider !== 'local') {
        localStorage.setItem(`ai_key_${provider}`, apiKey);
      }

      this.configPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingStatusEl.textContent = 'Extracting document text...';

      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdf = await window.pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;
        this.totalPages = pdf.numPages;

        let fullText = '';
        let wordCount = 0;

        for (let i = 1; i <= this.totalPages; i++) {
          this.loadingStatusEl.textContent = `Extracting page ${i} of ${this.totalPages}...`;
          const page = await pdf.getPage(i);
          const textContent = await page.getTextContent();
          const pageText = textContent.items.map((item: any) => item.str).join(' ');
          fullText += `--- Page ${i} ---\n${pageText}\n\n`;
          wordCount += pageText.split(/\s+/).filter(Boolean).length;
        }

        this.extractedText = fullText;

        // Update Left pane outline
        this.statPagesEl.textContent = this.totalPages.toString();
        this.statWordsEl.textContent = wordCount.toString();
        
        // Reading speed average: 200 words per minute
        const readTime = Math.ceil(wordCount / 200);
        this.statReadTimeEl.textContent = `${readTime}m`;

        this.textPreviewAreaEl.value = fullText;

        // Update badge and clean chat logs
        this.providerBadgeEl.textContent = `${provider} Mode`;
        this.chatViewportEl.innerHTML = `
          <div class="chat-message system">
            Hello! I've loaded your PDF document text. You can use the Quick Actions below or type any question you have about the document details.
          </div>
        `;

        this.loadingPanelEl.classList.add('hidden');
        this.dashboardInterfaceEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to parse text content from this PDF.');
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }

    private async handleSendMessage() {
      const userText = this.chatInputFieldEl.value.trim();
      if (!userText) return;

      this.addChatMessage('user', userText);
      this.chatInputFieldEl.value = '';

      // Set input disabled during processing
      this.chatInputFieldEl.disabled = true;
      this.btnChatSendEl.disabled = true;

      // Add temporary loading indicator
      const loader = this.addChatMessage('ai', 'Thinking...');

      try {
        const provider = this.aiProviderSelectEl.value;
        const apiKey = this.aiKeyInputEl.value.trim();

        if (provider === 'local') {
          // Heuristic Response
          setTimeout(() => {
            let heuristicSummary = `Here is a local outline of your document:\n`;
            heuristicSummary += `- Name: ${this.selectedFile?.name}\n`;
            heuristicSummary += `- Page Count: ${this.totalPages}\n`;
            heuristicSummary += `- Length: ${this.extractedText.length} characters\n\n`;
            heuristicSummary += `⚠️ [API Key Notice]: You are currently using Local Outline Mode. To ask questions, request detailed summaries, or translate text, select "Google Gemini" or "OpenAI ChatGPT" in settings and enter your API Key.`;
            loader.textContent = heuristicSummary;
            this.scrollChatToBottom();
          }, 600);
        } else if (provider === 'gemini') {
          const prompt = `You are a helpful AI document assistant. Answer the user's question accurately using only the provided document content. If you cannot find the answer, state that it is not found.

Document Text:
${this.extractedText.substring(0, 30000)} // Max token safety

User Question:
${userText}`;

          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              contents: [{ parts: [{ text: prompt }] }]
            })
          });

          if (!response.ok) {
            const data = await response.json();
            throw new Error(data.error?.message || 'API request failed.');
          }

          const data = await response.json();
          const aiResponse = data.candidates?.[0]?.content?.parts?.[0]?.text || 'No response generated.';
          loader.textContent = aiResponse;
        } else if (provider === 'openai') {
          const response = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${apiKey}`
            },
            body: JSON.stringify({
              model: 'gpt-4o-mini',
              messages: [
                {
                  role: 'system',
                  content: 'You are a helpful AI document assistant. Summarize, answer, or translate based strictly on the user document contents.'
                },
                {
                  role: 'user',
                  content: `Document text:\n${this.extractedText.substring(0, 30000)}\n\nQuestion:\n${userText}`
                }
              ]
            })
          });

          if (!response.ok) {
            const data = await response.json();
            throw new Error(data.error?.message || 'API request failed.');
          }

          const data = await response.json();
          const aiResponse = data.choices?.[0]?.message?.content || 'No response generated.';
          loader.textContent = aiResponse;
        }
      } catch (err: any) {
        console.error(err);
        loader.textContent = `Error: ${err.message || 'Failed to connect to AI provider. Verify your API key and connection.'}`;
      } finally {
        this.chatInputFieldEl.disabled = false;
        this.btnChatSendEl.disabled = false;
        this.chatInputFieldEl.focus();
        this.scrollChatToBottom();
      }
    }

    private addChatMessage(sender: 'user' | 'ai', text: string): HTMLDivElement {
      const msg = document.createElement('div');
      msg.className = `chat-message ${sender}`;
      msg.textContent = text;
      this.chatViewportEl.appendChild(msg);
      this.scrollChatToBottom();
      return msg;
    }

    private scrollChatToBottom() {
      this.chatViewportEl.scrollTop = this.chatViewportEl.scrollHeight;
    }

    private reset() {
      this.selectedFile = null;
      this.extractedText = '';
      this.totalPages = 0;
      this.fileInputEl.value = '';
      this.chatInputFieldEl.value = '';
      this.chatViewportEl.innerHTML = '';
      this.textPreviewAreaEl.value = '';

      this.dashboardInterfaceEl.classList.add('hidden');
      this.configPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.dropzoneEl.classList.remove('hidden');
      
      // Reload keys
      this.loadSavedKeys();
    }
  }

  if (!customElements.get('ai-pdf-summarizer-tool')) {
    customElements.define('ai-pdf-summarizer-tool', AiPdfSummarizerTool);
  }
</script>
