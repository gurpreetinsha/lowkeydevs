---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load PDFLib from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<pdf-forms-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Fill PDF Forms</h3>
      <p class="converter-subtitle">Fill out interactive PDF forms and flatten fields locally in your browser.</p>
    </div>

    <!-- Dropzone -->
    <div class="dropzone" id="forms-dropzone">
      <input type="file" id="forms-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF form to fill" />
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF form here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files</p>
      </div>
    </div>

    <!-- No fields alert -->
    <div class="no-fields-warning hidden" id="no-fields-panel">
      <p>⚠️ No interactive form fields (AcroForms) were detected in this PDF.</p>
      <p class="warning-subtext">You can still write on PDFs using our <strong>Edit PDF</strong> tool.</p>
      <button id="btn-warning-back" class="btn btn-secondary mt-4">Upload Different File</button>
    </div>

    <!-- Interactive Form filler UI -->
    <div class="config-panel hidden" id="forms-interface">
      <h4 class="section-subtitle">Detected Form Fields</h4>
      
      <form id="pdf-dynamic-form" class="dynamic-form-grid"></form>

      <div class="flatten-settings">
        <label class="checkbox-label">
          <input type="checkbox" id="check-flatten" />
          <span>Flatten Form Fields (Make read-only / un-editable)</span>
        </label>
      </div>

      <div class="converter-actions">
        <button id="btn-fill-download" class="btn btn-success btn-lg">
          Fill & Download PDF
        </button>
        <button id="btn-cancel" class="btn btn-secondary">
          Cancel
        </button>
      </div>
    </div>

    <!-- Loading / Status -->
    <div class="converter-loading hidden" id="forms-loading-panel">
      <div class="spinner"></div>
      <p id="loading-status">Parsing PDF form structure...</p>
    </div>

    <!-- Results Panel -->
    <div class="converter-results hidden" id="forms-results-panel">
      <div class="divider"></div>
      
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        Form Filled Successfully!
      </div>

      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Filled PDF
        </a>
      </div>
    </div>
  </div>
</pdf-forms-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .no-fields-warning {
    background: var(--error-subtle);
    border: 1px solid var(--error);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    color: var(--text-primary);
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .warning-subtext {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .config-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dynamic-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    max-height: 450px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .dynamic-form-grid::-webkit-scrollbar {
    width: 6px;
  }
  .dynamic-form-grid::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }

  .form-group-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group-item.full-width {
    grid-column: span 2;
  }

  .field-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    outline: none;
    font-size: 0.9rem;
    width: 100%;
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-primary);
    cursor: pointer;
  }

  .flatten-settings {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .converter-actions {
    display: flex;
    gap: 1rem;
  }

  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--success-subtle);
    color: var(--success);
  }

  .download-box {
    display: flex;
    justify-content: center;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  class PdfFormsTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private noFieldsPanelEl!: HTMLDivElement;
    private formsInterfaceEl!: HTMLDivElement;
    private dynamicFormEl!: HTMLFormElement;
    
    private checkFlattenEl!: HTMLInputElement;
    private btnFillDownloadEl!: HTMLButtonElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnWarningBackEl!: HTMLButtonElement;
    private btnDownloadEl!: HTMLAnchorElement;

    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;

    private selectedFile: File | null = null;
    private fieldRefs: { name: string; type: string }[] = [];

    connectedCallback() {
      this.fileInputEl = this.querySelector('#forms-file-input')!;
      this.dropzoneEl = this.querySelector('#forms-dropzone')!;
      this.noFieldsPanelEl = this.querySelector('#no-fields-panel')!;
      this.formsInterfaceEl = this.querySelector('#forms-interface')!;
      this.dynamicFormEl = this.querySelector('#pdf-dynamic-form')!;
      
      this.checkFlattenEl = this.querySelector('#check-flatten')!;
      this.btnFillDownloadEl = this.querySelector('#btn-fill-download')!;
      this.btnCancelEl = this.querySelector('#btn-cancel')!;
      this.btnWarningBackEl = this.querySelector('#btn-warning-back')!;
      this.btnDownloadEl = this.querySelector('#btn-download')!;

      this.loadingPanelEl = this.querySelector('#forms-loading-panel')!;
      this.resultsPanelEl = this.querySelector('#forms-results-panel')!;

      // Bind events
      this.fileInputEl.addEventListener('change', (e) => this.handleFileSelect(e));
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });
      this.dropzoneEl.addEventListener('dragleave', () => this.dropzoneEl.classList.remove('dragover'));
      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files.length) {
          this.processFile(e.dataTransfer.files[0]);
        }
      });

      this.btnFillDownloadEl.addEventListener('click', () => this.fillPdfForm());
      this.btnCancelEl.addEventListener('click', () => this.reset());
      this.btnWarningBackEl.addEventListener('click', () => this.reset());
    }

    private handleFileSelect(e: Event) {
      const target = e.target as HTMLInputElement;
      if (target.files?.length) {
        this.processFile(target.files[0]);
      }
    }

    private async processFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }
      this.selectedFile = file;

      if (typeof window.PDFLib === 'undefined') {
        alert('PDF library is loading. Please wait a moment.');
        return;
      }

      this.dropzoneEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');

      try {
        const { PDFDocument } = window.PDFLib;
        const arrayBuffer = await file.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);
        const form = pdfDoc.getForm();
        const fields = form.getFields();

        if (fields.length === 0) {
          this.loadingPanelEl.classList.add('hidden');
          this.noFieldsPanelEl.classList.remove('hidden');
          return;
        }

        this.fieldRefs = [];
        this.dynamicFormEl.innerHTML = '';

        fields.forEach(field => {
          const name = field.getName();
          const type = field.constructor.name; // e.g. PDFTextField, PDFCheckBox, etc.
          
          this.fieldRefs.push({ name, type });

          const formGroup = document.createElement('div');
          formGroup.className = 'form-group-item';

          const label = document.createElement('label');
          label.className = 'field-label';
          label.textContent = name;
          label.htmlFor = `field-${name}`;

          if (type === 'PDFTextField' || type === 'n') { // n is sometimes returned in minified bundles
            const input = document.createElement('input');
            input.type = 'text';
            input.id = `field-${name}`;
            input.name = name;
            input.className = 'field-input';
            
            // Get default text if exists
            try {
              input.value = (field as any).getText() || '';
            } catch (e) {}

            formGroup.appendChild(label);
            formGroup.appendChild(input);
          } else if (type === 'PDFCheckBox') {
            formGroup.className = 'form-group-item check-group';
            
            const checkLabel = document.createElement('label');
            checkLabel.className = 'checkbox-label';
            
            const input = document.createElement('input');
            input.type = 'checkbox';
            input.id = `field-${name}`;
            input.name = name;

            try {
              input.checked = (field as any).isChecked();
            } catch (e) {}

            const span = document.createElement('span');
            span.textContent = name;

            checkLabel.appendChild(input);
            checkLabel.appendChild(span);
            formGroup.appendChild(checkLabel);
          } else if (type === 'PDFDropdown') {
            const select = document.createElement('select');
            select.id = `field-${name}`;
            select.name = name;
            select.className = 'field-input';

            try {
              const options = (field as any).getOptions();
              const selected = (field as any).getSelected();
              options.forEach((opt: string) => {
                const option = document.createElement('option');
                option.value = opt;
                option.textContent = opt;
                if (selected.includes(opt)) {
                  option.selected = true;
                }
                select.appendChild(option);
              });
            } catch (e) {}

            formGroup.appendChild(label);
            formGroup.appendChild(select);
          } else if (type === 'PDFRadioGroup') {
            formGroup.appendChild(label);
            try {
              const options = (field as any).getOptions();
              const selected = (field as any).getSelected();
              options.forEach((opt: string) => {
                const optLabel = document.createElement('label');
                optLabel.className = 'checkbox-label';

                const input = document.createElement('input');
                input.type = 'radio';
                input.name = name;
                input.value = opt;
                if (selected === opt) {
                  input.checked = true;
                }
                const span = document.createElement('span');
                span.textContent = opt;

                optLabel.appendChild(input);
                optLabel.appendChild(span);
                formGroup.appendChild(optLabel);
              });
            } catch (e) {}
          } else {
            // General text box backup if types mismatch in compiled codes
            const input = document.createElement('input');
            input.type = 'text';
            input.id = `field-${name}`;
            input.name = name;
            input.className = 'field-input';

            formGroup.appendChild(label);
            formGroup.appendChild(input);
          }

          this.dynamicFormEl.appendChild(formGroup);
        });

        this.loadingPanelEl.classList.add('hidden');
        this.formsInterfaceEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to load PDF form components.');
        this.reset();
      }
    }

    private async fillPdfForm() {
      if (!this.selectedFile) return;

      this.formsInterfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.remove('hidden');
      this.loadingStatusEl.textContent = 'Injecting form values...';

      try {
        const { PDFDocument } = window.PDFLib;
        const arrayBuffer = await this.selectedFile.arrayBuffer();
        const pdfDoc = await PDFDocument.load(arrayBuffer);
        const form = pdfDoc.getForm();

        const formData = new FormData(this.dynamicFormEl);

        this.fieldRefs.forEach(ref => {
          try {
            const field = form.getField(ref.name);
            const value = formData.get(ref.name);

            if (ref.type === 'PDFTextField' || ref.type === 'n') {
              (field as any).setText((value as string) || '');
            } else if (ref.type === 'PDFCheckBox') {
              const isChecked = formData.has(ref.name);
              if (isChecked) {
                (field as any).check();
              } else {
                (field as any).uncheck();
              }
            } else if (ref.type === 'PDFDropdown') {
              if (value) {
                (field as any).select(value as string);
              }
            } else if (ref.type === 'PDFRadioGroup') {
              if (value) {
                (field as any).select(value as string);
              }
            } else {
              // Backup textbox fill
              try {
                (field as any).setText((value as string) || '');
              } catch (e) {}
            }
          } catch (e) {
            console.warn(`Error setting field ${ref.name}:`, e);
          }
        });

        // Flatten form if selected
        if (this.checkFlattenEl.checked) {
          this.loadingStatusEl.textContent = 'Flattening PDF form layers...';
          form.flatten();
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        this.btnDownloadEl.href = url;
        this.btnDownloadEl.download = `${this.selectedFile.name.replace('.pdf', '')}_filled.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.resultsPanelEl.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Failed to compile filled form.');
        this.loadingPanelEl.classList.add('hidden');
        this.formsInterfaceEl.classList.remove('hidden');
      }
    }

    private reset() {
      this.selectedFile = null;
      this.fieldRefs = [];
      this.fileInputEl.value = '';
      this.dynamicFormEl.innerHTML = '';
      this.checkFlattenEl.checked = false;

      this.noFieldsPanelEl.classList.add('hidden');
      this.formsInterfaceEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.dropzoneEl.classList.remove('hidden');
    }
  }

  if (!customElements.get('pdf-forms-tool')) {
    customElements.define('pdf-forms-tool', PdfFormsTool);
  }
</script>
