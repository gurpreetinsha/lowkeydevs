---
import Icon from '../../../components/base/Icon.astro';
---

<!-- Load pdf-lib from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<rotate-pdf-tool class="tool-workspace">
  <div class="converter-container glass-panel">
    <div class="converter-header">
      <h3 class="converter-title">Rotate PDF Pages</h3>
      <p class="converter-subtitle">Rotate document pages by 90° CW, 90° CCW, or 180° locally in your browser.</p>
    </div>

    <!-- Upload Box -->
    <div class="dropzone" id="rotate-dropzone">
      <input type="file" id="rotate-file-input" accept=".pdf" class="hidden-input" aria-label="Upload PDF file to rotate" />
      
      <div class="dropzone-content">
        <Icon name="FileText" size={48} />
        <p class="dropzone-text">Drag & drop your PDF file here or <span>browse</span></p>
        <p class="dropzone-subtext">Supports single PDF files (up to 80MB)</p>
      </div>
    </div>

    <!-- Config Panel -->
    <div class="config-panel hidden" id="config-panel">
      <!-- File Metadata Details -->
      <div class="file-details-card">
        <div class="detail-row">
          <span class="detail-label">File Name:</span>
          <span class="detail-value" id="doc-name">document.pdf</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">File Size:</span>
          <span class="detail-value" id="doc-size">0 KB</span>
        </div>
      </div>

      <!-- Settings Layout -->
      <div class="settings-group">
        <h4 class="section-subtitle">Rotation Setup</h4>
        
        <div class="settings-grid">
          <!-- Rotation Angle -->
          <div class="setting-item">
            <label for="rotate-angle" class="field-label">Rotation Angle</label>
            <select id="rotate-angle" class="field-input">
              <option value="90-cw" selected>90° Clockwise (Right)</option>
              <option value="90-ccw">90° Counter-Clockwise (Left)</option>
              <option value="180">180° Flip (Upside Down)</option>
            </select>
          </div>

          <!-- Page Range Selection -->
          <div class="setting-item">
            <label for="rotate-scope" class="field-label">Apply Rotation To</label>
            <select id="rotate-scope" class="field-input">
              <option value="all" selected>All Pages</option>
              <option value="odd">Odd Pages Only</option>
              <option value="even">Even Pages Only</option>
              <option value="custom">Custom Page Range</option>
            </select>
          </div>

          <!-- Custom range input (hidden by default) -->
          <div class="setting-item hidden" id="custom-range-block">
            <label for="custom-range" class="field-label">Custom Range (e.g. 1-3, 5)</label>
            <input type="text" id="custom-range" class="field-input" placeholder="Enter page numbers" aria-label="Custom page range" />
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="panel-actions">
        <button id="btn-cancel" class="btn btn-secondary">
          Select Another File
        </button>
        <button id="btn-apply" class="btn btn-primary btn-lg">
          Rotate & Save PDF
        </button>
      </div>
    </div>

    <!-- Progress / Loading Section -->
    <div class="converter-loading hidden" id="loading-panel">
      <div class="spinner"></div>
      <p id="loading-text">Rotating PDF pages, please wait...</p>
    </div>

    <!-- Status & Results Section -->
    <div class="converter-results hidden" id="results-panel">
      <div class="divider"></div>
      <div class="success-badge">
        <span class="badge-icon">✓</span>
        PDF Pages Rotated Successfully!
      </div>
      
      <div class="download-box">
        <a id="btn-download" class="btn btn-success btn-lg download-link">
          <Icon name="Download" size={18} />
          Download Rotated PDF
        </a>
      </div>
    </div>
  </div>
</rotate-pdf-tool>

<style>
  .tool-workspace {
    width: 100%;
  }

  .converter-container {
    width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .converter-header {
    text-align: center;
  }

  .converter-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .converter-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Dropzone Styling */
  .dropzone {
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: all 0.2s ease;
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
    text-align: center;
    padding: 1.5rem;
  }

  .dropzone-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .dropzone-text span {
    color: var(--accent);
    text-decoration: underline;
  }

  .dropzone-subtext {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Config Panel */
  .config-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .file-details-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .detail-value {
    color: var(--text-primary);
    font-weight: 600;
    word-break: break-all;
    text-align: right;
  }

  .section-subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  /* Settings Grid */
  .settings-group {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .field-input {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .field-input:focus {
    border-color: var(--accent);
  }

  .panel-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-secondary {
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--border-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-on);
    border: none;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .hidden {
    display: none !important;
  }

  .btn-lg {
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Success & Stats */
  .converter-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--border);
  }

  .success-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--success);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--success-subtle);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .download-box {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-success {
    background: var(--success);
    color: white;
    border: none;
  }

  .btn-success:hover {
    opacity: 0.9;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* Spinner */
  .converter-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  function formatBytes(bytes: number, decimals: number = 2): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  class RotatePdfTool extends HTMLElement {
    private fileInputEl!: HTMLInputElement;
    private dropzoneEl!: HTMLDivElement;
    private configPanelEl!: HTMLDivElement;
    private docNameEl!: HTMLSpanElement;
    private docSizeEl!: HTMLSpanElement;
    private rotateAngleEl!: HTMLSelectElement;
    private rotateScopeEl!: HTMLSelectElement;
    private customRangeBlockEl!: HTMLDivElement;
    private customRangeInputEl!: HTMLInputElement;
    private btnCancelEl!: HTMLButtonElement;
    private btnApplyEl!: HTMLButtonElement;
    private loadingPanelEl!: HTMLDivElement;
    private resultsPanelEl!: HTMLDivElement;
    private downloadBtnEl!: HTMLAnchorElement;

    private selectedFile: File | null = null;
    private arrayBuffer: ArrayBuffer | null = null;

    connectedCallback() {
      this.fileInputEl = this.querySelector('#rotate-file-input') as HTMLInputElement;
      this.dropzoneEl = this.querySelector('#rotate-dropzone') as HTMLDivElement;
      this.configPanelEl = this.querySelector('#config-panel') as HTMLDivElement;
      this.docNameEl = this.querySelector('#doc-name') as HTMLSpanElement;
      this.docSizeEl = this.querySelector('#doc-size') as HTMLSpanElement;
      this.rotateAngleEl = this.querySelector('#rotate-angle') as HTMLSelectElement;
      this.rotateScopeEl = this.querySelector('#rotate-scope') as HTMLSelectElement;
      this.customRangeBlockEl = this.querySelector('#custom-range-block') as HTMLDivElement;
      this.customRangeInputEl = this.querySelector('#custom-range') as HTMLInputElement;
      this.btnCancelEl = this.querySelector('#btn-cancel') as HTMLButtonElement;
      this.btnApplyEl = this.querySelector('#btn-apply') as HTMLButtonElement;
      this.loadingPanelEl = this.querySelector('#loading-panel') as HTMLDivElement;
      this.resultsPanelEl = this.querySelector('#results-panel') as HTMLDivElement;
      this.downloadBtnEl = this.querySelector('#btn-download') as HTMLAnchorElement;

      // Dropzone events
      this.dropzoneEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.add('dragover');
      });

      this.dropzoneEl.addEventListener('dragleave', () => {
        this.dropzoneEl.classList.remove('dragover');
      });

      this.dropzoneEl.addEventListener('drop', (e) => {
        e.preventDefault();
        this.dropzoneEl.classList.remove('dragover');
        if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
          this.handleFile(e.dataTransfer.files[0]);
        }
      });

      this.fileInputEl.addEventListener('change', () => {
        if (this.fileInputEl.files && this.fileInputEl.files.length > 0) {
          this.handleFile(this.fileInputEl.files[0]);
        }
      });

      // Scope select
      this.rotateScopeEl.addEventListener('change', () => {
        if (this.rotateScopeEl.value === 'custom') {
          this.customRangeBlockEl.classList.remove('hidden');
        } else {
          this.customRangeBlockEl.classList.add('hidden');
        }
      });

      this.btnCancelEl.addEventListener('click', () => {
        this.reset();
      });

      this.btnApplyEl.addEventListener('click', () => this.runRotation());
    }

    private async handleFile(file: File) {
      if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
        alert('Please upload a valid PDF file.');
        return;
      }

      if (typeof window.PDFLib === 'undefined') {
        alert('Libraries are loading. Please wait.');
        return;
      }

      this.selectedFile = file;
      this.docNameEl.textContent = file.name;
      this.docSizeEl.textContent = formatBytes(file.size);

      this.dropzoneEl.classList.add('hidden');
      this.configPanelEl.classList.remove('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        this.arrayBuffer = await file.arrayBuffer();
      } catch (err) {
        console.error(err);
        alert('Error reading PDF file.');
        this.reset();
      }
    }

    private reset() {
      this.selectedFile = null;
      this.arrayBuffer = null;
      this.fileInputEl.value = '';
      this.customRangeInputEl.value = '';
      
      this.dropzoneEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');
      this.loadingPanelEl.classList.add('hidden');
      this.customRangeBlockEl.classList.add('hidden');
      this.rotateScopeEl.value = 'all';
    }

    private parsePageRange(rangeStr: string, total: number): number[] {
      const indices: number[] = [];
      const parts = rangeStr.split(',');
      for (const part of parts) {
        const trimmed = part.trim();
        if (trimmed.includes('-')) {
          const [startStr, endStr] = trimmed.split('-');
          const start = parseInt(startStr, 10);
          const end = parseInt(endStr, 10);
          if (!isNaN(start) && !isNaN(end)) {
            for (let i = start; i <= end; i++) {
              if (i >= 1 && i <= total) indices.push(i - 1);
            }
          }
        } else {
          const num = parseInt(trimmed, 10);
          if (!isNaN(num) && num >= 1 && num <= total) {
            indices.push(num - 1);
          }
        }
      }
      return Array.from(new Set(indices));
    }

    private async runRotation() {
      if (!this.selectedFile || !this.arrayBuffer) return;

      this.loadingPanelEl.classList.remove('hidden');
      this.configPanelEl.classList.add('hidden');
      this.resultsPanelEl.classList.add('hidden');

      try {
        const { PDFDocument, degrees } = window.PDFLib;
        const pdfDoc = await PDFDocument.load(this.arrayBuffer);
        const pages = pdfDoc.getPages();
        const total = pages.length;

        const scope = this.rotateScopeEl.value;
        const angleSelect = this.rotateAngleEl.value;

        // Rotation degrees to add
        let addAngle = 90;
        if (angleSelect === '90-ccw') {
          addAngle = 270;
        } else if (angleSelect === '180') {
          addAngle = 180;
        }

        // Determine pages to rotate
        let targets: number[] = [];
        if (scope === 'all') {
          targets = Array.from({ length: total }, (_, i) => i);
        } else if (scope === 'odd') {
          targets = Array.from({ length: total }, (_, i) => i).filter(i => i % 2 === 0);
        } else if (scope === 'even') {
          targets = Array.from({ length: total }, (_, i) => i).filter(i => i % 2 === 1);
        } else {
          const rangeVal = this.customRangeInputEl.value;
          if (!rangeVal) {
            alert('Please specify page numbers for custom range.');
            this.loadingPanelEl.classList.add('hidden');
            this.configPanelEl.classList.remove('hidden');
            return;
          }
          targets = this.parsePageRange(rangeVal, total);
        }

        if (targets.length === 0) {
          alert('No pages selected to rotate.');
          this.loadingPanelEl.classList.add('hidden');
          this.configPanelEl.classList.remove('hidden');
          return;
        }

        for (const idx of targets) {
          const page = pages[idx];
          const currentRotation = page.getRotation().angle;
          const newRotation = (currentRotation + addAngle) % 360;
          page.setRotation(degrees(newRotation));
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        this.downloadBtnEl.href = url;
        const baseName = this.selectedFile.name.replace(/\.[^/.]+$/, "");
        this.downloadBtnEl.download = `${baseName}_rotated.pdf`;

        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
        this.resultsPanelEl.classList.remove('hidden');
        this.resultsPanelEl.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        alert(`Error rotating PDF: ${err instanceof Error ? err.message : 'Unknown error'}`);
        this.loadingPanelEl.classList.add('hidden');
        this.configPanelEl.classList.remove('hidden');
      }
    }
  }

  if (!customElements.get('rotate-pdf-tool')) {
    customElements.define('rotate-pdf-tool', RotatePdfTool);
  }
</script>
